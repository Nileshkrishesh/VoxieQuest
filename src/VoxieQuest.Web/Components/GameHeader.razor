@namespace VoxieQuest.Web.Components
@inject IAudioService AudioService

<div class="game-header-single-row">
    <!-- Big Back Arrow Button -->
    <button class="pill header-back-btn" @onclick="HandleBackClick" type="button" aria-label="Return to map">
        <ArrowBackIcon Size="20" />
        <span class="back-label">Map</span>
    </button>

    <!-- Game Title Sticker -->
    <div class="game-title-pill">
        <span class="title-text">@Title</span>
    </div>

    <!-- 10-Seed (or 5-Seed) Sprouting Flowers Stepper: Inline on same row! -->
    <div class="seeds-garden-track" role="progressbar" aria-valuenow="@CurrentRound" aria-valuemin="1" aria-valuemax="@TotalRounds">
        @for (int r = 1; r <= TotalRounds; r++)
        {
            var isCompleted = r < CurrentRound;
            var isCurrent = r == CurrentRound;
            <div class="seed-node @(isCompleted ? "bloomed" : (isCurrent ? "sprouting" : "dormant"))" 
                 title="Round @r">
                @if (isCompleted)
                {
                    <FlowerIcon Size="16" PetalColor="@GetFlowerPetalColor(r)" CenterColor="#FFC93C" />
                }
                else if (isCurrent)
                {
                    <div class="sprout-dot">
                        <span class="sprout-num">@r</span>
                    </div>
                }
                else
                {
                    <span class="dormant-dot">•</span>
                }
            </div>
        }
    </div>

    <!-- Star Counter -->
    <div class="star-pill-compact" title="Stars collected!">
        <StarIcon Size="18" FillColor="#FFC93C" />
        <span class="star-num">@Stars</span>
    </div>

    <!-- Sound Mute Toggle Button -->
    <button class="pill header-mute-btn" @onclick="ToggleMute" type="button" aria-label="Toggle Sound">
        <SpeakerIcon Size="18" IsMuted="@AudioService.IsMuted" FillColor="#2B2D42" />
    </button>
</div>

<style>
    .game-header-single-row {
        width: 100%;
        max-width: 960px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: clamp(4px, 1vw, 8px);
        padding: 4px 6px;
        background: var(--color-paper-light);
        border: var(--border-storybook);
        border-radius: var(--radius-pill);
        box-shadow: var(--shadow-hard-sm);
        z-index: 50;
        box-sizing: border-box;
        overflow: hidden;
        min-height: 48px;
    }

    .header-back-btn {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        background: var(--color-sunny-yellow);
        color: var(--color-storybook-ink);
        border: 2px solid var(--color-storybook-ink);
        border-radius: var(--radius-pill);
        padding: 4px 8px;
        font-family: var(--font-heading);
        font-weight: 700;
        font-size: 0.85rem;
        cursor: pointer;
        flex-shrink: 0;
        touch-action: manipulation;
    }

    .game-title-pill {
        background: var(--color-cloud-white);
        border: 2px solid var(--color-storybook-ink);
        border-radius: var(--radius-pill);
        padding: 3px 8px;
        text-align: center;
        flex-shrink: 1;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .title-text {
        font-family: var(--font-heading);
        font-size: clamp(0.78rem, 0.72rem + 0.3vw, 1.05rem);
        font-weight: 700;
        color: var(--color-storybook-ink);
    }

    /* Compact 10-Seed / Sprouting Stepper */
    .seeds-garden-track {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 2px;
        flex-shrink: 0;
        padding: 0 4px;
    }

    .seed-node {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 18px;
        height: 18px;
    }

    .sprout-dot {
        width: 16px;
        height: 16px;
        border-radius: 50%;
        background: var(--color-sunny-yellow);
        border: 1.5px solid var(--color-storybook-ink);
        display: flex;
        align-items: center;
        justify-content: center;
        animation: sprout-pulse 1.4s infinite alternate;
    }

    .sprout-num {
        font-family: var(--font-heading);
        font-size: 0.65rem;
        font-weight: 700;
        color: var(--color-storybook-ink);
    }

    .dormant-dot {
        font-size: 0.85rem;
        color: #94A3B8;
        line-height: 1;
    }

    .star-pill-compact {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        background: var(--color-bg-warmth);
        border: 2px solid var(--color-storybook-ink);
        border-radius: var(--radius-pill);
        padding: 3px 7px;
        font-family: var(--font-heading);
        font-size: 0.85rem;
        font-weight: 700;
        flex-shrink: 0;
    }

    .header-mute-btn {
        background: var(--color-cloud-white);
        border: 2px solid var(--color-storybook-ink);
        border-radius: var(--radius-pill);
        padding: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        flex-shrink: 0;
    }

    @@keyframes sprout-pulse {
        0% { transform: scale(0.9); }
        100% { transform: scale(1.15); }
    }

    @@media (max-width: 360px) {
        .back-label {
            display: none;
        }
        .game-header-single-row {
            padding: 3px 4px;
            gap: 3px;
        }
        .seeds-garden-track {
            gap: 1px;
        }
    }
</style>

@code {
    [Parameter] public string Title { get; set; } = "Quest";
    [Parameter] public int CurrentRound { get; set; } = 1;
    [Parameter] public int TotalRounds { get; set; } = 10;
    [Parameter] public int Stars { get; set; } = 0;
    [Parameter] public EventCallback OnBack { get; set; }

    private string GetFlowerPetalColor(int round) => (round % 4) switch
    {
        0 => "#5BC0EB", // Sky Blue
        1 => "#FF6B6B", // Coral
        2 => "#FFC93C", // Sunny Yellow
        _ => "#7ED9A8"  // Mint
    };

    private async Task HandleBackClick()
    {
        await AudioService.PlaySoundAsync(SoundEffect.Click);
        if (OnBack.HasDelegate)
        {
            await OnBack.InvokeAsync();
        }
    }

    private async Task ToggleMute()
    {
        await AudioService.SetMutedAsync(!AudioService.IsMuted);
    }
}
