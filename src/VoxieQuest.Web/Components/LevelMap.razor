@using VoxieQuest.Web.Models
@using VoxieQuest.Web.Services
@inject IDifficultyService DifficultyService
@inject NavigationManager NavigationManager

<div class="level-map-container storybook-panel">
    <div class="level-map-header">
        <div class="map-title-badge">
            <FlowerIcon Size="32" PetalColor="#FFC93C" CenterColor="#FF9F43" />
            <div>
                <h3 class="m-0 font-display">@GameTitle Trail</h3>
                <span class="subtext">Winding stepping stones through 4 magical zones!</span>
            </div>
        </div>

        <div class="map-tier-indicator">
            <span class="tier-pill tier-@State.CurrentTier.ToString().ToLowerInvariant()">
                @State.CurrentTier.ToFriendlyName() Tier
            </span>
        </div>
    </div>

    <div class="trail-viewport">
        <svg viewBox="0 0 800 680" class="trail-svg" preserveAspectRatio="xMidYMid meet">
            <defs>
                <linearGradient id="trailGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#FFE082" />
                    <stop offset="30%" stop-color="#80CBC4" />
                    <stop offset="70%" stop-color="#81D4FA" />
                    <stop offset="100%" stop-color="#C5CAE9" />
                </linearGradient>

                <filter id="activeGlow" x="-30%" y="-30%" width="160%" height="160%">
                    <feGaussianBlur stdDeviation="8" result="blur" />
                    <feComposite in="SourceGraphic" in2="blur" operator="over" />
                </filter>
            </defs>

            <!-- 4 Zone Backgrounds / Labels -->
            <!-- Zone 1: Sunny Meadow (Levels 1-3) -->
            <rect x="40" y="470" width="130" height="32" rx="16" fill="#DCFCE7" stroke="#2B2D42" stroke-width="2" />
            <text x="105" y="492" text-anchor="middle" font-family="var(--font-heading)" font-size="14" font-weight="700" fill="#15803D">1. Meadow</text>

            <!-- Zone 2: Crystal River (Levels 4-6) -->
            <rect x="580" y="410" width="130" height="32" rx="16" fill="#E0F2FE" stroke="#2B2D42" stroke-width="2" />
            <text x="645" y="432" text-anchor="middle" font-family="var(--font-heading)" font-size="14" font-weight="700" fill="#0369A1">2. River</text>

            <!-- Zone 3: Whispering Forest (Levels 7-8) -->
            <rect x="180" y="240" width="130" height="32" rx="16" fill="#FEF3C7" stroke="#2B2D42" stroke-width="2" />
            <text x="245" y="262" text-anchor="middle" font-family="var(--font-heading)" font-size="14" font-weight="700" fill="#B45309">3. Forest</text>

            <!-- Zone 4: Starry Mountain (Levels 9-10) -->
            <rect x="550" y="40" width="140" height="32" rx="16" fill="#F3E8FF" stroke="#2B2D42" stroke-width="2" />
            <text x="620" y="62" text-anchor="middle" font-family="var(--font-heading)" font-size="14" font-weight="700" fill="#6B21A8">4. Mountain</text>

            <!-- Hand-drawn winding path background ribbon -->
            <path d="M 100 600 C 250 620, 250 480, 400 480 C 550 480, 680 540, 700 420 C 720 300, 560 320, 420 320 C 260 320, 100 240, 150 140 C 200 40, 450 60, 680 80"
                  fill="none"
                  stroke="#2B2D42"
                  stroke-width="28"
                  stroke-linecap="round"
                  stroke-linejoin="round" />

            <path d="M 100 600 C 250 620, 250 480, 400 480 C 550 480, 680 540, 700 420 C 720 300, 560 320, 420 320 C 260 320, 100 240, 150 140 C 200 40, 450 60, 680 80"
                  fill="none"
                  stroke="url(#trailGrad)"
                  stroke-width="20"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-dasharray="14 10" />

            <!-- Decorative Hand-Drawn Picture-Book Elements (No Emojis!) -->
            <g class="garden-decor">
                <!-- Sunflower near Meadow -->
                <g transform="translate(60, 560)">
                    <circle cx="10" cy="10" r="14" fill="#FFC93C" stroke="#2B2D42" stroke-width="2" />
                    <circle cx="10" cy="10" r="7" fill="#FF9F43" />
                </g>
                <!-- Mushroom near Forest -->
                <g transform="translate(330, 510)">
                    <path d="M0,15 C-12,15 -14,0 0,-4 C14,0 12,15 0,15 Z" fill="#FF6B6B" stroke="#2B2D42" stroke-width="2" />
                    <rect x="-3" y="10" width="6" height="12" rx="2" fill="#FFF8E7" stroke="#2B2D42" stroke-width="1.5" />
                </g>
                <!-- River Waves -->
                <path d="M710,360 Q725,350 740,360 T770,360" stroke="#5BC0EB" stroke-width="3" stroke-linecap="round" fill="none" />
                <!-- Mountain Pine Tree -->
                <g transform="translate(500, 30)">
                    <polygon points="15,-10 5,12 25,12" fill="#7ED9A8" stroke="#2B2D42" stroke-width="2" />
                    <rect x="13" y="12" width="4" height="8" fill="#92400E" stroke="#2B2D42" stroke-width="1" />
                </g>
            </g>

            <!-- 10 Level Stepping Stones along the trail (64px circles with 4px navy border) -->
            @for (int i = 1; i <= 10; i++)
            {
                var lvl = i;
                var (cx, cy) = GetNodeCoordinates(lvl);
                var progress = State.Levels.TryGetValue(lvl, out var p) ? p : new LevelStarProgress { LevelNumber = lvl, IsUnlocked = (lvl == 1) };
                bool isCurrent = progress.IsUnlocked && !progress.IsCompleted && (lvl == 1 || (State.Levels.TryGetValue(lvl - 1, out var prev) && prev.IsCompleted));
                if (State.AllLevelsUnlocked && !progress.IsCompleted && lvl == 1) isCurrent = true;

                <g class="level-node @(isCurrent ? "node-current" : "") @(progress.IsCompleted ? "node-completed" : "") @(!progress.IsUnlocked ? "node-locked" : "")"
                   @onclick="() => SelectLevel(lvl, progress.IsUnlocked)">
                    
                    @if (isCurrent)
                    {
                        <!-- Golden pulse ring for active level -->
                        <circle cx="@cx" cy="@cy" r="42" fill="#FFC93C" opacity="0.4" class="pulsing-halo" filter="url(#activeGlow)" />
                    }

                    <!-- 64px Circle Stepping Stone (r=32) with 4px navy border -->
                    <circle cx="@cx" cy="@cy" r="32"
                            fill="@GetNodeFill(progress, isCurrent)"
                            stroke="#2B2D42"
                            stroke-width="4"
                            class="node-circle" />

                    @if (!progress.IsUnlocked)
                    {
                        <!-- Sleeping seed SVG - NEVER a red padlock! -->
                        <g transform="translate(@(cx - 14), @(cy - 14))">
                            <SleepingSeedIcon Size="28" FillColor="#FFF8E7" />
                        </g>
                    }
                    else
                    {
                        @if (progress.IsBossRound)
                        {
                            <g transform="translate(@(cx - 14), @(cy - 20))">
                                <TrophyIcon Size="28" CupColor="#FFC93C" />
                            </g>
                            <g><text x="@cx" y="@(cy + 18)" text-anchor="middle" font-family="var(--font-heading)" font-size="12" font-weight="700" fill="#2B2D42">Boss</text></g>
                        }
                        else
                        {
                            <!-- Standard Level Number -->
                            <g><text x="@cx" y="@(cy + 8)" text-anchor="middle" font-family="var(--font-heading)" font-size="20" font-weight="700" fill="#2B2D42">@lvl</text></g>
                        }

                        <!-- Completed Node: Green with a Star -->
                        @if (progress.IsCompleted)
                        {
                            <g transform="translate(@(cx - 12), @(cy + 18))">
                                <rect x="0" y="0" width="24" height="16" rx="8" fill="#2B2D42" />
                                <g transform="translate(4, 1)">
                                    <StarIcon Size="14" FillColor="#FFC93C" />
                                </g>
                            </g>
                        }
                    }
                </g>
            }
        </svg>
    </div>

    <!-- Stepping Stone Selected Popover Card -->
    @if (selectedLevelNumber > 0)
    {
        <div class="level-popover-card storybook-card animate-pop">
            <div class="popover-inner">
                <div class="popover-info">
                    <span class="popover-zone-tag">Level @selectedLevelNumber Adventure</span>
                    <h4 class="popover-game-title">@GameTitle</h4>
                    <p class="popover-instructions">Speak your answers clearly to earn shiny stars!</p>
                </div>
                <div class="popover-actions">
                    <BouncyButton Variant="BouncyButton.ButtonVariant.Yellow" 
                                  Text="Start Quest!" 
                                  OnClick="StartSelectedLevel">
                        <IconTemplate><NextIcon Size="20" /></IconTemplate>
                    </BouncyButton>
                    <button class="pill close-popover-btn" type="button" @onclick="() => selectedLevelNumber = 0">✕</button>
                </div>
            </div>
        </div>
    }

    <div class="trail-legend">
        <div class="legend-item">
            <SleepingSeedIcon Size="22" FillColor="#FFF8E7" />
            <span>Sleeping Seed (Locked)</span>
        </div>
        <div class="legend-item">
            <StarIcon Size="20" FillColor="#FFC93C" />
            <span>Current Adventure</span>
        </div>
        <div class="legend-item">
            <TrophyIcon Size="20" CupColor="#FFC93C" />
            <span>Boss Challenge (Levels 5 &amp; 10)</span>
        </div>
    </div>
</div>

<style>
    .level-map-container {
        background: var(--color-paper-light, #FFF8E7);
        border: var(--border-storybook, 4px solid #2B2D42);
        border-radius: var(--radius-lg, 24px);
        box-shadow: var(--shadow-hard-md, 5px 5px 0 #2B2D42);
        padding: clamp(1rem, 3vw, 1.5rem);
        margin-bottom: 2rem;
        user-select: none;
    }

    .level-map-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .map-title-badge {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .subtext {
        font-family: var(--font-body);
        font-size: 1.05rem;
        color: var(--color-storybook-ink);
        opacity: 0.85;
        font-weight: 700;
    }

    .tier-pill {
        display: inline-block;
        padding: 0.35rem 0.9rem;
        border: var(--border-storybook);
        border-radius: var(--radius-pill);
        font-family: var(--font-heading);
        font-weight: 700;
        font-size: 0.95rem;
        box-shadow: var(--shadow-hard-sm);
    }

    .tier-seedling { background: #C8E6C9; color: #1B5E20; }
    .tier-sapling { background: #BBDEFB; color: #0D47A1; }
    .tier-bigtree { background: #FFE082; color: #E65100; }

    .trail-viewport {
        width: 100%;
        max-width: 800px;
        margin: 0 auto;
        background: #F8FAFC;
        border: 3px dashed var(--color-storybook-ink);
        border-radius: var(--radius-lg);
        overflow: hidden;
        padding: 0.5rem;
    }

    .trail-svg {
        width: 100%;
        height: auto;
        display: block;
    }

    .level-node {
        cursor: pointer;
        transition: transform 0.2s var(--spring-squish);
    }

    .level-node:hover:not(.node-locked) {
        transform: scale(1.12);
    }

    .node-current {
        animation: mapBounce 1.8s infinite ease-in-out;
    }

    @@keyframes mapBounce {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-8px); }
    }

    .pulsing-halo {
        animation: haloPulse 2s infinite ease-in-out;
    }

    @@keyframes haloPulse {
        0%, 100% { transform: scale(1); opacity: 0.4; }
        50% { transform: scale(1.15); opacity: 0.7; }
    }

    /* Popover Card */
    .level-popover-card {
        background: #FFFFFF;
        border: var(--border-storybook);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-hard-md);
        padding: 1.25rem;
        margin-top: 1rem;
        border-top: 6px solid var(--color-sunny-yellow);
    }

    .popover-inner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .popover-zone-tag {
        font-family: var(--font-heading);
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--color-sky-blue);
        text-transform: uppercase;
    }

    .popover-game-title {
        font-family: var(--font-heading);
        font-size: 1.4rem;
        font-weight: 700;
        color: var(--color-storybook-ink);
        margin: 0.2rem 0;
    }

    .popover-instructions {
        font-family: var(--font-body);
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--color-storybook-ink);
        opacity: 0.85;
        margin: 0;
    }

    .popover-actions {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .close-popover-btn {
        background: var(--color-paper-light);
        border: var(--border-storybook);
        border-radius: var(--radius-pill);
        padding: 0.4rem 0.8rem;
        font-family: var(--font-heading);
        font-weight: 700;
        cursor: pointer;
    }

    .trail-legend {
        display: flex;
        justify-content: space-around;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
        margin-top: 1.25rem;
        padding-top: 1rem;
        border-top: 2px dashed #CBD5E1;
        font-family: var(--font-heading);
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--color-storybook-ink);
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

    @@media (max-width: 600px) {
        .trail-legend {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>

@code {
    [Parameter, EditorRequired]
    public SkillCategory Skill { get; set; }

    [Parameter]
    public string GameTitle { get; set; } = "Quest";

    [Parameter]
    public EventCallback<int> OnLevelSelected { get; set; }

    private int selectedLevelNumber = 0;
    private SkillDifficultyState State => DifficultyService.GetSkillState(Skill);

    protected override void OnInitialized()
    {
        DifficultyService.OnDifficultyChanged += HandleDifficultyChanged;
    }

    private void HandleDifficultyChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void SelectLevel(int levelNumber, bool isUnlocked)
    {
        if (!isUnlocked && !State.AllLevelsUnlocked) return;
        selectedLevelNumber = levelNumber;
    }

    private async Task StartSelectedLevel()
    {
        if (selectedLevelNumber > 0 && OnLevelSelected.HasDelegate)
        {
            await OnLevelSelected.InvokeAsync(selectedLevelNumber);
        }
    }

    private (int x, int y) GetNodeCoordinates(int level) => level switch
    {
        1 => (100, 600),
        2 => (240, 530),
        3 => (390, 480),
        4 => (560, 490),
        5 => (690, 420),
        6 => (580, 320),
        7 => (420, 320),
        8 => (220, 260),
        9 => (150, 140),
        10 => (680, 80),
        _ => (100, 600)
    };

    private string GetNodeFill(LevelStarProgress progress, bool isCurrent)
    {
        if (!progress.IsUnlocked) return "#ECEFF1";
        if (progress.IsBossRound) return "#FFE082";
        if (isCurrent) return "#FFC93C";
        if (progress.IsCompleted) return "#7ED9A8";
        return "#FFFFFF";
    }

    public void Dispose()
    {
        DifficultyService.OnDifficultyChanged -= HandleDifficultyChanged;
    }
}
