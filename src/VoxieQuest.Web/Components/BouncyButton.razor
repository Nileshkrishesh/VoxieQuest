@namespace VoxieQuest.Web.Components
@inject IAudioService AudioService

<button class="bouncy-btn bouncy-btn-@Variant.ToString().ToLowerInvariant() @(IsTall ? "bouncy-btn-tall" : "") @(Disabled ? "disabled" : "")"
        style="min-width:@(MinWidth)px; @Style"
        type="@Type"
        disabled="@Disabled"
        @onclick="HandleClick">
    @if (IconTemplate != null)
    {
        <span class="bouncy-btn-icon">@IconTemplate</span>
    }
    else if (!string.IsNullOrWhiteSpace(Icon))
    {
        <span class="bouncy-btn-icon">@Icon</span>
    }
    @if (!string.IsNullOrWhiteSpace(Text))
    {
        <span class="bouncy-btn-text">@Text</span>
    }
    @ChildContent
</button>

<style>
    .bouncy-btn {
        font-family: var(--font-heading);
        font-size: clamp(1.1rem, 1rem + 0.35vw, 1.35rem);
        font-weight: 700;
        min-height: 60px;
        padding: 0.75rem 1.75rem;
        border: var(--border-storybook);
        border-radius: var(--radius-pill);
        box-shadow: var(--shadow-hard-md);
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.65rem;
        position: relative;
        outline: none;
        user-select: none;
        text-decoration: none;
        transform: translateY(0);
        transition: transform 0.1s var(--spring-squish), box-shadow 0.1s ease;
        touch-action: manipulation;
    }

    .bouncy-btn-tall {
        min-height: 72px;
        padding: 1rem 2rem;
    }

    .bouncy-btn:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: var(--shadow-hard-lg);
    }

    /* Squishy tactile press */
    .bouncy-btn:active:not(:disabled) {
        transform: translateY(4px);
        box-shadow: var(--shadow-hard-pressed);
    }

    .bouncy-btn.disabled, .bouncy-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
        box-shadow: var(--shadow-hard-sm);
        transform: none !important;
    }

    /* Color Variants */
    .bouncy-btn-yellow {
        background-color: var(--color-sunny-yellow);
        color: var(--color-storybook-ink);
    }

    .bouncy-btn-coral {
        background-color: var(--color-coral);
        color: #FFFFFF;
    }

    .bouncy-btn-mint {
        background-color: var(--color-mint);
        color: var(--color-storybook-ink);
    }

    .bouncy-btn-blue {
        background-color: var(--color-sky-blue);
        color: #FFFFFF;
    }

    .bouncy-btn-orange {
        background-color: var(--color-soft-orange);
        color: #FFFFFF;
    }

    .bouncy-btn-white {
        background-color: var(--color-cloud-white);
        color: var(--color-storybook-ink);
    }

    .bouncy-btn-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .bouncy-btn-text {
        letter-spacing: 0.02em;
    }
</style>

@code {
    public enum ButtonVariant
    {
        Yellow,
        Coral,
        Mint,
        Blue,
        Orange,
        White
    }

    [Parameter] public string Text { get; set; } = string.Empty;
    [Parameter] public string Icon { get; set; } = string.Empty;
    [Parameter] public RenderFragment? IconTemplate { get; set; }
    [Parameter] public ButtonVariant Variant { get; set; } = ButtonVariant.Yellow;
    [Parameter] public int MinWidth { get; set; } = 130;
    [Parameter] public bool IsTall { get; set; } = true;
    [Parameter] public bool Disabled { get; set; } = false;
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public string Style { get; set; } = string.Empty;
    [Parameter] public SoundEffect Sound { get; set; } = SoundEffect.Click;
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private async Task HandleClick()
    {
        if (Disabled) return;

        await AudioService.PlaySoundAsync(Sound);

        if (OnClick.HasDelegate)
        {
            await OnClick.InvokeAsync();
        }
    }
}
