@namespace VoxieQuest.Web.Components
@using VoxieQuest.Web.Models
@inject IAudioService AudioService

<div class="gameshell-root @ThemeClass">
    <!-- Atmospheric Parallax Backdrop -->
    <ParallaxBackground Theme="@Theme" />

    <!-- Wide Screen Decorative Doodles (Only visible on wide desktop screens > 1200px) -->
    <div class="desktop-side-doodles left-doodles" aria-hidden="true">
        <StarIcon Size="32" FillColor="#FFC93C" Class="doodle-float-1" />
        <FlowerIcon Size="36" PetalColor="#7ED9A8" CenterColor="#FFC93C" Class="doodle-float-2" />
        <SleepingSeedIcon Size="28" FillColor="#FFF8E7" Class="doodle-float-3" />
    </div>
    <div class="desktop-side-doodles right-doodles" aria-hidden="true">
        <SunIcon Size="36" FillColor="#FFC93C" Class="doodle-float-2" />
        <StarIcon Size="28" FillColor="#5BC0EB" Class="doodle-float-3" />
        <FlowerIcon Size="32" PetalColor="#FF6B6B" CenterColor="#FFC93C" Class="doodle-float-1" />
    </div>

    <!-- Main Flex Layout Container (Takes 100dvh, zero overflow) -->
    <div class="gameshell-stage-container">
        <!-- 1. TOP ZONE: GameHeader (Fits on one row at 320px) -->
        <header class="gameshell-top-zone">
            <GameHeader Title="@GameTitle" 
                        CurrentRound="@CurrentRound" 
                        TotalRounds="@TotalRounds" 
                        Stars="@Stars" 
                        OnBack="HandleBack" />
        </header>

        <!-- 2. DUAL-PANE CONTAINER (Switches to Side-by-Side in Phone Landscape) -->
        <div class="gameshell-core-content">
            <!-- MIDDLE ZONE: SVG Visual Game Scene (Takes flex: 1, scales smoothly) -->
            <main class="gameshell-middle-scene">
                @SceneContent
            </main>

            <!-- QUESTION & FEEDBACK ZONE -->
            <div class="gameshell-question-zone">
                <QuestionCard Prompt="@Prompt"
                              HintText="@HintText"
                              ShowHint="@ShowHint"
                              MascotMood="@MascotMood"
                              OnRepeatPrompt="OnRepeatPrompt">
                    @QuestionExtraContent
                </QuestionCard>
            </div>
        </div>

        <!-- 3. BOTTOM ZONE: Live Response Banner + Both Voice & Written Answer Controls -->
        <footer class="gameshell-bottom-zone">
            <!-- Real-time Hearing & Immediate Evaluation Banner -->
            <div class="voice-feedback-bar">
                @if (!string.IsNullOrWhiteSpace(VoiceErrorMessage))
                {
                    <div class="heard-response-banner banner-miss" role="alert">
                        <span class="banner-icon">⚠️</span>
                        <span class="banner-text">@VoiceErrorMessage</span>
                    </div>
                }
                else if (MicButtonState == MicState.PermissionDenied)
                {
                    <div class="heard-response-banner banner-miss" role="alert">
                        <span class="banner-icon">🔒</span>
                        <span class="banner-text">Microphone access is blocked! Tap the lock icon in your address bar to allow, or use touch buttons below.</span>
                    </div>
                }
                else if (MicButtonState == MicState.Unsupported)
                {
                    <div class="heard-response-banner banner-miss" role="alert">
                        <span class="banner-icon">💻</span>
                        <span class="banner-text">Microphone recognition not supported in this browser. Please use the touch buttons below!</span>
                    </div>
                }
                else if (MicButtonState == MicState.NoSpeech)
                {
                    <div class="heard-response-banner banner-miss">
                        <span class="banner-icon">🤔</span>
                        <span class="banner-text">Didn't catch any speech! Tap the mic to try again or tap an answer below.</span>
                    </div>
                }
                else if (MicButtonState == MicState.RequestingPermission)
                {
                    <div class="heard-response-banner banner-listening">
                        <span class="banner-icon">🎤</span>
                        <span class="banner-text">Asking for microphone access... Please tap "Allow"!</span>
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(HeardTranscript))
                {
                    <div class="heard-response-banner @(LastResultStatus == true ? "banner-success" : (LastResultStatus == false ? "banner-miss" : "banner-hearing"))">
                        <span class="banner-icon">@(LastResultStatus == true ? "🎉" : (LastResultStatus == false ? "🤔" : "🗣️"))</span>
                        <span class="banner-text">Voxie heard: <strong>"@HeardTranscript"</strong></span>
                        @if (LastResultStatus == true)
                        {
                            <span class="banner-tag tag-success">✓ Correct! ⭐</span>
                        }
                        else if (LastResultStatus == false)
                        {
                            <span class="banner-tag tag-miss">Almost! Try again</span>
                        }
                        else
                        {
                            <span class="banner-tag tag-thinking">Checking...</span>
                        }
                    </div>
                }
                else if (IsListening || MicButtonState == MicState.Listening)
                {
                    <div class="heard-response-banner banner-listening">
                        <span class="banner-icon">🎤</span>
                        <span class="banner-text">Listening... Speak into mic or type/tap below!</span>
                    </div>
                }
                else
                {
                    <div class="heard-response-banner banner-ready">
                        <span class="banner-icon">✨</span>
                        <span class="banner-text">Tap mic to speak or use written answer below!</span>
                    </div>
                }
            </div>

            <!-- Unified Dual Input Deck: Voice Mic + Written Answer Options -->
            <div class="dual-input-deck">
                <!-- Voice Mic Station -->
                <div class="voice-station">
                    <MicButton IsListening="@IsListening" 
                               VolumeLevel="@VolumeLevel" 
                               State="@MicButtonState" 
                               OnToggleListening="OnToggleListening" />
                </div>

                <!-- Written Answer Station (Choice Chips + Text Input) -->
                <div class="written-station">
                    @if (PracticeChoices != null && PracticeChoices.Any())
                    {
                        <div class="written-chips-grid">
                            @for (int i = 0; i < PracticeChoices.Count; i++)
                            {
                                var choice = PracticeChoices[i];
                                var colorClass = i switch
                                {
                                    0 => "chip-yellow",
                                    1 => "chip-blue",
                                    2 => "chip-coral",
                                    _ => "chip-mint"
                                };
                                <button type="button" 
                                        class="storybook-choice-chip @colorClass" 
                                        @onclick="() => HandlePracticeSelect(choice)">
                                    <span class="chip-text">@choice</span>
                                </button>
                            }
                        </div>
                    }

                    <!-- Written Text Input Row -->
                    <div class="written-input-row">
                        <input class="written-text-box" 
                               type="text" 
                               placeholder="Or type answer here..." 
                               @bind="writtenAnswerText" 
                               @bind:event="oninput" 
                               @onkeydown="HandleWrittenKeyDown" 
                               aria-label="Type your answer" />
                        <button class="written-submit-btn" 
                                type="button" 
                                @onclick="SubmitWrittenAnswerAsync" 
                                disabled="@(string.IsNullOrWhiteSpace(writtenAnswerText))">
                            <span>Send ↵</span>
                        </button>
                    </div>
                </div>
            </div>
        </footer>
    </div>

    <!-- OVERLAYS: Feedback, Celebrations, Pause, Breaks & Error Screens -->
    <FeedbackBurst ShowSuccess="@ShowSuccessBurst" 
                   ShowEncourage="@ShowEncourageBurst" 
                   HintText="@HintText" />

    <RewardScreen IsOpen="@IsRewardOpen" 
                  StarsEarned="@StarsEarned" 
                  OnPlayAgain="OnPlayAgain" 
                  OnNextQuest="OnNextQuest" />

    <PauseSheet IsOpen="@isPauseOpen" 
                OnResume="() => isPauseOpen = false" 
                OnReturnToMap="HandleBack" />

    <SleepyBreakScreen IsOpen="@isSleepyBreakOpen" 
                       OnResume="() => isSleepyBreakOpen = false" 
                       OnWarmUp="HandleBack" />

    <!-- Mic Permission Denied Friendly Screen -->
    @if (IsMicDenied)
    {
        <div class="mic-denied-modal" role="alertdialog" aria-modal="true">
            <div class="storybook-card mic-denied-card bounce-in-anim">
                <FoxieFaceIcon Size="64" />
                <h3 class="denied-title">Microphone is Resting</h3>
                <p class="denied-subtext">No worries! You can play using friendly touch buttons!</p>
                <BouncyButton Variant="BouncyButton.ButtonVariant.Yellow" 
                              Text="Use Buttons Instead" 
                              IsTall="true" 
                              OnClick="HandleSwitchToButtons">
                    <IconTemplate><GamesIcon Size="24" /></IconTemplate>
                </BouncyButton>
            </div>
        </div>
    }
</div>

<style>
    .gameshell-root {
        position: relative;
        width: 100%;
        min-height: 100vh;
        min-height: 100dvh;
        height: 100%;
        max-width: 100%;
        overflow-x: hidden;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
        display: flex;
        justify-content: center;
        align-items: center;
        box-sizing: border-box;
        touch-action: manipulation;
    }

    .gameshell-stage-container {
        position: relative;
        z-index: 10;
        width: 100%;
        max-width: 1100px;
        min-height: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: clamp(4px, 1.2vh, 12px) clamp(6px, 1.8vw, 16px);
        padding-top: max(4px, env(safe-area-inset-top));
        padding-bottom: max(4px, env(safe-area-inset-bottom));
        box-sizing: border-box;
    }

    .gameshell-top-zone {
        width: 100%;
        flex-shrink: 0;
        margin-bottom: 2px;
    }

    .gameshell-core-content {
        flex: 1 1 auto;
        min-height: 0;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: center;
        gap: clamp(4px, 1vh, 8px);
        width: 100%;
    }

    .gameshell-middle-scene {
        flex: 1 1 auto;
        min-height: 0;
        max-height: clamp(140px, 32vh, 260px);
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
    }

    .gameshell-question-zone {
        flex-shrink: 0;
        width: 100%;
        max-width: 960px;
    }

    .gameshell-bottom-zone {
        flex-shrink: 0;
        width: 100%;
        max-width: 960px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
    }

    /* Live Voice Feedback Banner */
    .voice-feedback-bar {
        width: 100%;
        display: flex;
        justify-content: center;
        min-height: 28px;
    }

    .heard-response-banner {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 4px 14px;
        border: 2px solid var(--color-storybook-ink);
        border-radius: var(--radius-full);
        font-family: var(--font-heading);
        font-size: clamp(0.85rem, 2.4vw, 1.05rem);
        box-shadow: 2px 2px 0 var(--color-storybook-ink);
    }

    .banner-listening { background: #E8F4FD; color: var(--color-storybook-ink); }
    .banner-ready     { background: #FFF8E7; color: var(--color-storybook-ink); }
    .banner-hearing   { background: #FFF3B0; color: var(--color-storybook-ink); }
    .banner-success   { background: #E8FBF4; color: #1B4332; border-color: #2D6A4F; }
    .banner-miss      { background: #FFE8E8; color: #881337; border-color: var(--color-coral); }

    .banner-tag {
        padding: 2px 8px;
        border-radius: var(--radius-full);
        font-size: 0.82rem;
        font-weight: 700;
    }
    .tag-success  { background: var(--color-mint); color: var(--color-storybook-ink); }
    .tag-miss     { background: var(--color-coral); color: #FFFFFF; }
    .tag-thinking { background: var(--color-sunny-yellow); color: var(--color-storybook-ink); }

    /* Dual Input Deck (Voice + Written) */
    .dual-input-deck {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: clamp(8px, 2vw, 16px);
    }

    .voice-station {
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .written-station {
        flex: 1 1 auto;
        max-width: 480px;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    /* Choice Chips */
    .written-chips-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 6px;
        width: 100%;
    }

    .storybook-choice-chip {
        min-height: 40px;
        padding: 4px 10px;
        border: 2.5px solid var(--color-storybook-ink);
        border-radius: var(--radius-sm);
        box-shadow: 2px 3px 0 var(--color-storybook-ink);
        cursor: pointer;
        font-family: var(--font-heading);
        font-size: clamp(0.95rem, 2.5vw, 1.15rem);
        font-weight: 700;
        color: var(--color-storybook-ink);
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        transition: transform 0.1s var(--spring-squish), box-shadow 0.1s ease;
        touch-action: manipulation;
    }
    .storybook-choice-chip:hover {
        transform: translateY(-2px);
        box-shadow: 2px 4px 0 var(--color-storybook-ink);
    }
    .storybook-choice-chip:active {
        transform: translateY(2px);
        box-shadow: 0 1px 0 var(--color-storybook-ink);
    }

    .chip-yellow { background-color: var(--color-sunny-yellow); }
    .chip-blue   { background-color: var(--color-sky-blue); color: #FFFFFF; }
    .chip-coral  { background-color: var(--color-coral); color: #FFFFFF; }
    .chip-mint   { background-color: var(--color-mint); }

    /* Written Text Box Row */
    .written-input-row {
        display: flex;
        gap: 6px;
        width: 100%;
    }

    .written-text-box {
        flex: 1;
        min-width: 0;
        height: 38px;
        padding: 0 12px;
        border: 2.5px solid var(--color-storybook-ink);
        border-radius: var(--radius-sm);
        background: var(--color-cloud-white);
        box-shadow: 2px 2px 0 var(--color-storybook-ink);
        font-family: var(--font-body);
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--color-storybook-ink);
        outline: none;
    }
    .written-text-box:focus {
        border-color: var(--color-sky-blue);
        box-shadow: 2px 3px 0 var(--color-sky-blue);
    }

    .written-submit-btn {
        height: 38px;
        padding: 0 14px;
        border: 2.5px solid var(--color-storybook-ink);
        border-radius: var(--radius-sm);
        background: var(--color-mint);
        box-shadow: 2px 2px 0 var(--color-storybook-ink);
        cursor: pointer;
        font-family: var(--font-heading);
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--color-storybook-ink);
        white-space: nowrap;
        transition: transform 0.1s var(--spring-squish);
    }
    .written-submit-btn:hover:not(:disabled) {
        transform: translateY(-1px);
    }
    .written-submit-btn:active:not(:disabled) {
        transform: translateY(2px);
        box-shadow: 0 0 0 var(--color-storybook-ink);
    }
    .written-submit-btn:disabled {
        opacity: 0.45;
        cursor: not-allowed;
    }

    @@media (max-width: 600px) {
        .gameshell-stage-container {
            padding: 4px 6px;
        }
        .gameshell-core-content {
            gap: 4px;
        }
        .gameshell-middle-scene {
            max-height: clamp(130px, 28vh, 220px);
        }
        .gameshell-bottom-zone {
            gap: 4px;
        }
        .storybook-choice-chip {
            min-height: 36px;
            padding: 2px 6px;
            font-size: 0.95rem;
        }
        .written-text-box {
            height: 34px;
            font-size: 0.88rem;
            padding: 0 8px;
        }
        .written-submit-btn {
            height: 34px;
            padding: 0 10px;
            font-size: 0.88rem;
        }
    }

    /* Desktop Side Doodles (> 1200px) */
    .desktop-side-doodles {
        position: fixed;
        top: 20%;
        display: none;
        flex-direction: column;
        gap: 2.5rem;
        z-index: 5;
        pointer-events: none;
    }
    .left-doodles { left: 24px; }
    .right-doodles { right: 24px; }

    @@media (min-width: 1280px) {
        .desktop-side-doodles {
            display: flex;
        }
    }

    .doodle-float-1 { animation: doodle-bob 3s infinite ease-in-out alternate; }
    .doodle-float-2 { animation: doodle-bob 3.6s infinite ease-in-out alternate 0.5s; }
    .doodle-float-3 { animation: doodle-bob 2.8s infinite ease-in-out alternate 1s; }

    @@keyframes doodle-bob {
        0% { transform: translateY(0); }
        100% { transform: translateY(-12px); }
    }

    /* Phones in Landscape (max-height: 500px) */
    @@media (max-height: 500px) {
        .gameshell-stage-container {
            padding: 4px 8px;
        }
        .gameshell-core-content {
            flex-direction: row;
            align-items: center;
            gap: 12px;
        }
        .gameshell-middle-scene {
            width: 55%;
            height: 100%;
        }
        .gameshell-question-zone {
            width: 45%;
        }
        .gameshell-bottom-zone {
            min-height: 70px;
        }
    }

    /* Mic Denied Friendly Modal */
    .mic-denied-modal {
        position: fixed;
        top: 0; left: 0; width: 100vw; height: 100vh;
        background: rgba(43, 45, 66, 0.7);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
        z-index: 500;
    }

    .mic-denied-card {
        background: var(--color-paper-light);
        border: var(--border-storybook-heavy);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-hard-lg);
        padding: 2rem;
        text-align: center;
        max-width: 440px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.75rem;
    }

    .denied-title {
        font-family: var(--font-heading);
        font-size: 1.6rem;
        font-weight: 700;
        color: var(--color-storybook-ink);
        margin: 0;
    }

    .denied-subtext {
        font-family: var(--font-body);
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--color-sky-blue);
        margin: 0;
    }
</style>

@code {
    [Parameter] public string GameTitle { get; set; } = "Quest";
    [Parameter] public int CurrentRound { get; set; } = 1;
    [Parameter] public int TotalRounds { get; set; } = 10;
    [Parameter] public int Stars { get; set; } = 0;
    [Parameter] public ParallaxBackground.ParallaxTheme Theme { get; set; } = ParallaxBackground.ParallaxTheme.Hills;
    [Parameter] public string ThemeClass { get; set; } = "";

    [Parameter] public string Prompt { get; set; } = string.Empty;
    [Parameter] public string HintText { get; set; } = string.Empty;
    [Parameter] public bool ShowHint { get; set; } = false;
    [Parameter] public Mascot.MascotState MascotMood { get; set; } = Mascot.MascotState.Idle;

    [Parameter] public bool IsListening { get; set; } = false;
    [Parameter] public float VolumeLevel { get; set; } = 0.0f;
    [Parameter] public MicState MicButtonState { get; set; } = MicState.Idle;

    [Parameter] public bool IsPracticeMode { get; set; } = false;
    [Parameter] public List<string> PracticeChoices { get; set; } = new();

    [Parameter] public bool ShowSuccessBurst { get; set; } = false;
    [Parameter] public bool ShowEncourageBurst { get; set; } = false;

    [Parameter] public bool IsRewardOpen { get; set; } = false;
    [Parameter] public int StarsEarned { get; set; } = 3;

    [Parameter] public bool IsMicDenied { get; set; } = false;
    [Parameter] public string? VoiceErrorMessage { get; set; } = null;
    [Parameter] public string HeardTranscript { get; set; } = string.Empty;
    [Parameter] public bool? LastResultStatus { get; set; } = null;

    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public EventCallback OnRepeatPrompt { get; set; }
    [Parameter] public EventCallback OnToggleListening { get; set; }
    [Parameter] public EventCallback<string> OnSelectPracticeChoice { get; set; }
    [Parameter] public EventCallback OnPlayAgain { get; set; }
    [Parameter] public EventCallback OnNextQuest { get; set; }
    [Parameter] public EventCallback OnSwitchToPractice { get; set; }

    [Parameter] public RenderFragment? SceneContent { get; set; }
    [Parameter] public RenderFragment? QuestionExtraContent { get; set; }

    private bool isPauseOpen = false;
    private bool isSleepyBreakOpen = false;
    private string writtenAnswerText = string.Empty;

    private async Task HandleBack()
    {
        await AudioService.PlaySoundAsync(SoundEffect.Click);
        if (OnBack.HasDelegate)
        {
            await OnBack.InvokeAsync();
        }
    }

    private async Task HandlePracticeSelect(string answer)
    {
        await AudioService.PlaySoundAsync(SoundEffect.Pop);
        if (OnSelectPracticeChoice.HasDelegate)
        {
            await OnSelectPracticeChoice.InvokeAsync(answer);
        }
    }

    private async Task SubmitWrittenAnswerAsync()
    {
        if (string.IsNullOrWhiteSpace(writtenAnswerText)) return;
        var answer = writtenAnswerText.Trim();
        writtenAnswerText = string.Empty;
        await AudioService.PlaySoundAsync(SoundEffect.Pop);
        if (OnSelectPracticeChoice.HasDelegate)
        {
            await OnSelectPracticeChoice.InvokeAsync(answer);
        }
    }

    private async Task HandleWrittenKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SubmitWrittenAnswerAsync();
        }
    }

    private async Task HandleSwitchToButtons()
    {
        await AudioService.PlaySoundAsync(SoundEffect.Click);
        if (OnSwitchToPractice.HasDelegate)
        {
            await OnSwitchToPractice.InvokeAsync();
        }
    }
}
