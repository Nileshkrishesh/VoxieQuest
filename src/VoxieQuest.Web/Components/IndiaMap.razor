@using VoxieQuest.Web.Models
@using VoxieQuest.Web.Services
@inject IIndiaMapService IndiaMapService
@inject IAccessibilityService AccessibilityService
@implements IDisposable

<div class="india-map-card storybook-panel">
    <!-- Header Row & Passport Progress Counter -->
    <div class="map-header-row">
        <div class="map-title-group">
            <span class="map-badge-flag">🇮🇳</span>
            <div>
                <h3 class="m-0 font-display">Voxie Across India</h3>
                <p class="m-0 map-subheading">
                    Explore all 36 states &amp; territories, discover fun facts, and collect landmark stickers!
                </p>
            </div>
        </div>

        <div class="passport-summary-badge" title="Stickers collected in your India Explorer Passport">
            <span class="passport-icon">📖</span>
            <div class="passport-text-col">
                <span class="passport-count">@Passport.CollectedCount / @Passport.TotalStatesCount Stickers</span>
                <div class="passport-mini-bar">
                    <div class="passport-mini-fill" style="width: @(Passport.ExplorationPercentage)%"></div>
                </div>
            </div>
        </div>

        <!-- View Mode Switch: Visual SVG Map vs Accessible List View -->
        <div class="view-mode-toggle" role="group" aria-label="Map display mode">
            <button type="button" 
                    class="toggle-btn @(!isListView ? "active" : "")" 
                    @onclick="() => isListView = false"
                    aria-pressed="@(!isListView)">
                <span>🗺️ Map View</span>
            </button>
            <button type="button" 
                    class="toggle-btn @(isListView ? "active" : "")" 
                    @onclick="() => isListView = true"
                    aria-pressed="@isListView">
                <span>📋 Passport Album</span>
            </button>
        </div>
    </div>

    <!-- Active State Exploration & Mini-Game Stage -->
    @if (selectedState != null)
    {
        <div class="state-exploration-sheet storybook-card">
            <div class="sheet-header">
                <div class="sheet-title-badge">
                    <span class="sheet-landmark-icon">@selectedState.LandmarkIcon</span>
                    <div>
                        <h4 class="m-0 sheet-state-name">@selectedState.Name</h4>
                        <span class="sheet-capital-tag">Capital: @selectedState.Capital • Sticker: @selectedState.LandmarkName</span>
                    </div>
                </div>

                @if (IsCurrentStateUnlocked)
                {
                    <span class="pill status-unlocked-pill">
                        ⭐ Sticker Unlocked!
                    </span>
                }
                else
                {
                    <span class="pill status-locked-pill">
                        🔒 Solve riddle to earn sticker!
                    </span>
                }
            </div>

            <!-- Fun Fact Presentation from Voxie -->
            <div class="fun-fact-box">
                <span class="fact-bulb">💡</span>
                <p class="fact-text m-0">@selectedState.FunFact</p>
            </div>

            <!-- Mini-Game Challenge Card -->
            <div class="minigame-card">
                <div class="minigame-prompt-row">
                    <span class="prompt-icon">🧩</span>
                    <strong class="prompt-question">@selectedState.MiniGameQuestion</strong>
                </div>

                @if (showCelebration)
                {
                    <div class="celebration-banner">
                        <span class="celebration-star">✨</span>
                        <span class="celebration-msg">@celebrationText</span>
                    </div>
                }

                <!-- 3 Big Candy-Colored Mini-Game Choice Buttons -->
                <div class="choices-grid">
                    @foreach (var choice in selectedState.MiniGameChoices)
                    {
                        var isCorrect = string.Equals(choice, selectedState.CorrectAnswer, StringComparison.OrdinalIgnoreCase);
                        <button type="button" 
                                class="btn-candy-choice @(hasAnswered && isCorrect ? "btn-correct" : "")" 
                                @onclick="() => HandleAnswerSelected(choice)">
                            <span>@choice</span>
                        </button>
                    }
                </div>
            </div>
        </div>
    }

    @if (!isListView)
    {
        <!-- Visual Interactive SVG Map -->
        <div class="svg-map-wrapper">
            <!-- Floating Voxie Mascot Buddy -->
            <div class="mascot-companion @(isMascotWaving ? "mascot-waving" : "")">
                <div class="mascot-bubble">
                    <span class="bubble-text">@mascotSpeechText</span>
                </div>
                <div class="mascot-character" @onclick="TriggerMascotWave" title="Voxie waves at you!">
                    <span class="mascot-face">🦊</span>
                    <span class="mascot-paw">👋</span>
                </div>
            </div>

            <!-- SVG Map Canvas -->
            <svg viewBox="0 0 1000 1050" class="india-svg" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Interactive exploration map of India showing all states and collected landmark stickers">
                <defs>
                    <!-- Colorblind Accessible Patterns -->
                    <pattern id="pattern-unlocked" width="10" height="10" patternUnits="userSpaceOnUse">
                        <line x1="0" y1="10" x2="10" y2="0" stroke="#2E7D32" stroke-width="2" />
                    </pattern>
                </defs>

                <!-- Indian Ocean Backdrop -->
                <rect width="1000" height="1050" fill="#E0F7FA" rx="20" class="ocean-backdrop" />

                <!-- Ambient Map Decor -->
                <g class="map-decorations" opacity="0.6">
                    <g><text x="80" y="100" font-size="28">☁️</text></g>
                    <g><text x="860" y="140" font-size="24">☁️</text></g>
                    <g><text x="110" y="760" font-size="26">⛵</text></g>
                    <g><text x="880" y="660" font-size="26">🐬</text></g>
                    <g><text x="70" y="210" font-size="13" font-weight="900" fill="#006064">NORTH ↑</text></g>
                </g>

                <!-- Render 36 Indian States and Union Territories -->
                @foreach (var (code, def) in IndiaStateRegistry.States)
                {
                    var isSelected = string.Equals(selectedStateCode, code, StringComparison.OrdinalIgnoreCase);
                    var isUnlocked = Passport.UnlockedStateCodes.Contains(code);
                    var fill = isSelected ? "#FFE082" : (isUnlocked ? "#C8E6C9" : "#FFF9C4");

                    <g class="state-group @(isSelected ? "state-selected" : "") @(isUnlocked ? "state-unlocked" : "")"
                       tabindex="0"
                       role="button"
                       aria-label="@($"{def.Name}: {def.LandmarkName} sticker {(isUnlocked ? "collected" : "locked")}")"
                       @onclick="() => SelectState(code)"
                       @onkeydown="(e) => HandleStateKeyDown(e, code)">

                        <!-- State Boundary Polygon -->
                        <path d="@def.SvgPath"
                              fill="@fill"
                              stroke="#2C3E50"
                              stroke-width="@(isSelected ? "4.5" : "2.5")"
                              stroke-linejoin="round"
                              class="state-shape" />

                        @if (AccessibilityService.IsColorblindMode && isUnlocked)
                        {
                            <path d="@def.SvgPath" fill="url(#pattern-unlocked)" opacity="0.35" pointer-events="none" />
                        }

                        <!-- State Code Label -->
                        <g>
                            <text x="@def.LabelX" y="@(isUnlocked ? def.LabelY + 12 : def.LabelY)"
                                  text-anchor="middle"
                                  font-size="12"
                                  font-weight="900"
                                  fill="#1A252F"
                                  class="state-label">
                                @(code)
                            </text>
                        </g>

                        <!-- Unlocked Landmark Sticker Icon on Map! -->
                        @if (isUnlocked)
                        {
                            <g transform="translate(@(def.LabelX - 10), @(def.LabelY - 10))" class="map-sticker-icon">
                                <text font-size="20">@def.LandmarkIcon</text>
                            </g>
                        }
                    </g>
                }
            </svg>
        </div>
    }
    else
    {
        <!-- Passport Album List View -->
        <div class="accessible-list-view" role="region" aria-label="India Explorer Sticker Passport Album">
            <div class="passport-grid">
                @foreach (var (code, def) in IndiaStateRegistry.States)
                {
                    var isUnlocked = Passport.UnlockedStateCodes.Contains(code);
                    var isSelected = string.Equals(selectedStateCode, code, StringComparison.OrdinalIgnoreCase);

                    <div class="passport-card @(isUnlocked ? "card-unlocked" : "card-locked") @(isSelected ? "card-active" : "")"
                         tabindex="0"
                         role="button"
                         aria-label="@($"{def.Name}: {def.LandmarkName}")"
                         @onclick="() => SelectState(code)">
                        <div class="passport-card-icon">
                            @if (isUnlocked)
                            {
                                <span class="sticker-emoji">@def.LandmarkIcon</span>
                            }
                            else
                            {
                                <span class="lock-emoji">🔒</span>
                            }
                        </div>
                        <h5 class="m-0 passport-card-title">@def.Name</h5>
                        <span class="passport-card-landmark">@def.LandmarkName</span>
                        @if (isUnlocked)
                        {
                            <span class="passport-stamp">✓ Collected</span>
                        }
                        else
                        {
                            <span class="passport-stamp-pending">Tap to Learn</span>
                        }
                    </div>
                }
            </div>
        </div>
    }

    <!-- Picture-Book Legend -->
    <div class="map-legend-bar">
        <div class="legend-item">
            <span class="legend-swatch swatch-unlocked"></span>
            <span>⭐ Sticker Collected</span>
        </div>
        <div class="legend-item">
            <span class="legend-swatch swatch-locked"></span>
            <span>🌱 Tap State to Explore</span>
        </div>
        <div class="legend-item">
            <span class="legend-swatch swatch-selected"></span>
            <span>✨ Selected Adventure</span>
        </div>
    </div>
</div>

<style>
    .india-map-card {
        background: #FFFDF7;
        border: 4px solid #2C3E50;
        border-radius: 28px;
        box-shadow: 0 8px 0 #2C3E50;
        padding: 1.5rem;
        user-select: none;
    }

    .map-header-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 1.25rem;
    }

    .map-title-group {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .map-badge-flag {
        font-size: 2.5rem;
    }

    .map-subheading {
        font-size: 0.95rem;
        color: #455A64;
        font-weight: 600;
    }

    .passport-summary-badge {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        background: #FFF9C4;
        border: 2px solid #2C3E50;
        border-radius: 20px;
        padding: 0.45rem 1rem;
        box-shadow: 0 3px 0 #2C3E50;
    }

    .passport-icon {
        font-size: 1.8rem;
    }

    .passport-text-col {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
    }

    .passport-count {
        font-size: 0.92rem;
        font-weight: 800;
        color: #2C3E50;
    }

    .passport-mini-bar {
        width: 110px;
        height: 8px;
        background: #CFD8DC;
        border-radius: 4px;
        overflow: hidden;
    }

    .passport-mini-fill {
        height: 100%;
        background: #2E7D32;
        border-radius: 4px;
        transition: width 0.3s ease;
    }

    .view-mode-toggle {
        display: flex;
        background: #ECEFF1;
        border: 2px solid #2C3E50;
        border-radius: 20px;
        overflow: hidden;
    }

    .toggle-btn {
        background: transparent;
        border: none;
        padding: 0.45rem 0.9rem;
        font-weight: 800;
        font-size: 0.88rem;
        cursor: pointer;
        color: #37474F;
        transition: background 0.15s ease;
    }

    .toggle-btn.active {
        background: #2C3E50;
        color: #FFFFFF;
    }

    /* State Exploration Sheet */
    .state-exploration-sheet {
        background: #FFFFFF;
        border: 3px solid #2C3E50;
        border-radius: 24px;
        box-shadow: 0 6px 0 #2C3E50;
        padding: 1.25rem;
        margin-bottom: 1.5rem;
        animation: sheetPop 0.25s ease-out;
    }

    @@keyframes sheetPop {
        from { transform: translateY(-8px); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
    }

    .sheet-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-bottom: 0.75rem;
    }

    .sheet-title-badge {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .sheet-landmark-icon {
        font-size: 2.4rem;
    }

    .sheet-state-name {
        font-size: 1.4rem;
        color: #2C3E50;
    }

    .sheet-capital-tag {
        font-size: 0.88rem;
        color: #546E7A;
        font-weight: 700;
    }

    .status-unlocked-pill {
        background: #DCEDC8;
        border-color: #2E7D32;
        color: #1B5E20;
        font-weight: 800;
        font-size: 0.88rem;
    }

    .status-locked-pill {
        background: #FFF9C4;
        border-color: #FBC02D;
        color: #F57F17;
        font-weight: 800;
        font-size: 0.88rem;
    }

    .fun-fact-box {
        display: flex;
        align-items: flex-start;
        gap: 0.6rem;
        background: #F1F8E9;
        border: 2px dashed #81C784;
        border-radius: 16px;
        padding: 0.8rem 1rem;
        margin-bottom: 1rem;
    }

    .fact-bulb {
        font-size: 1.4rem;
        line-height: 1;
    }

    .fact-text {
        font-size: 0.95rem;
        color: #2E7D32;
        font-weight: 700;
        line-height: 1.4;
    }

    .minigame-card {
        background: #FFFDF7;
        border: 2px solid #2C3E50;
        border-radius: 18px;
        padding: 1rem;
    }

    .minigame-prompt-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.75rem;
    }

    .prompt-icon {
        font-size: 1.5rem;
    }

    .prompt-question {
        font-size: 1rem;
        color: #2C3E50;
    }

    .celebration-banner {
        background: #E8F5E9;
        border: 2px solid #4CAF50;
        border-radius: 12px;
        padding: 0.6rem 1rem;
        margin-bottom: 0.75rem;
        font-weight: 800;
        color: #2E7D32;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        animation: celebrateBounce 0.4s ease-out;
    }

    @@keyframes celebrateBounce {
        0% { transform: scale(0.9); }
        50% { transform: scale(1.04); }
        100% { transform: scale(1); }
    }

    .choices-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 0.75rem;
    }

    .btn-candy-choice {
        background: #FFFFFF;
        border: 3px solid #2C3E50;
        border-radius: 16px;
        box-shadow: 0 4px 0 #2C3E50;
        padding: 0.8rem;
        font-size: 0.95rem;
        font-weight: 800;
        color: #2C3E50;
        cursor: pointer;
        transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
        text-align: center;
    }

    .btn-candy-choice:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 0 #2C3E50;
        background: #FFF9C4;
    }

    .btn-candy-choice:active {
        transform: translateY(2px);
        box-shadow: 0 2px 0 #2C3E50;
    }

    .btn-correct {
        background: #C8E6C9 !important;
        border-color: #2E7D32 !important;
        box-shadow: 0 4px 0 #2E7D32 !important;
        color: #1B5E20 !important;
    }

    /* SVG Map Display */
    .svg-map-wrapper {
        position: relative;
        width: 100%;
        max-width: 880px;
        margin: 0 auto;
        background: #E0F7FA;
        border: 3px solid #2C3E50;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: inset 0 0 12px rgba(0, 96, 100, 0.15);
    }

    .india-svg {
        width: 100%;
        height: auto;
        display: block;
    }

    .state-group {
        cursor: pointer;
        outline: none;
    }

    .state-shape {
        transition: fill 0.2s ease, stroke-width 0.2s ease, filter 0.2s ease;
    }

    .state-group:hover .state-shape,
    .state-group:focus-visible .state-shape {
        filter: drop-shadow(0 0 6px rgba(255, 179, 0, 0.8));
        stroke-width: 4px;
    }

    .state-label {
        pointer-events: none;
        user-select: none;
    }

    .map-sticker-icon {
        animation: stickerWiggle 3s infinite ease-in-out;
        pointer-events: none;
    }

    @@keyframes stickerWiggle {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-3px); }
    }

    .mascot-companion {
        position: absolute;
        bottom: 16px;
        right: 16px;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        z-index: 10;
        pointer-events: none;
    }

    .mascot-bubble {
        background: #FFFFFF;
        border: 3px solid #2C3E50;
        border-radius: 18px;
        padding: 0.6rem 1rem;
        max-width: 260px;
        box-shadow: 0 4px 0 #2C3E50;
        margin-bottom: 8px;
        font-weight: 800;
        font-size: 0.9rem;
        color: #2C3E50;
        pointer-events: auto;
    }

    .mascot-character {
        display: flex;
        align-items: center;
        background: #FFD54F;
        border: 3px solid #2C3E50;
        border-radius: 50%;
        width: 64px;
        height: 64px;
        justify-content: center;
        box-shadow: 0 4px 0 #2C3E50;
        pointer-events: auto;
        cursor: pointer;
    }

    .mascot-face {
        font-size: 2rem;
    }

    .mascot-paw {
        font-size: 1.2rem;
        margin-left: -6px;
        margin-top: -12px;
    }

    .mascot-waving .mascot-paw {
        animation: pawWave 0.8s 3 ease-in-out;
    }

    @@keyframes pawWave {
        0%, 100% { transform: rotate(0deg); }
        50% { transform: rotate(25deg); }
    }

    /* Passport Album Grid */
    .passport-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
        gap: 0.75rem;
        margin: 1rem 0;
    }

    .passport-card {
        background: #FFFDE7;
        border: 2px solid #2C3E50;
        border-radius: 18px;
        padding: 0.75rem 0.5rem;
        text-align: center;
        cursor: pointer;
        box-shadow: 0 3px 0 #2C3E50;
        transition: transform 0.15s ease;
    }

    .passport-card:hover {
        transform: translateY(-2px);
    }

    .card-unlocked {
        background: #DCEDC8;
        border-color: #2E7D32;
    }

    .card-active {
        box-shadow: 0 0 0 3px #FFD54F, 0 4px 0 #2C3E50;
    }

    .passport-card-icon {
        font-size: 2.2rem;
        margin-bottom: 0.25rem;
    }

    .passport-card-title {
        font-size: 0.92rem;
        color: #2C3E50;
        font-weight: 800;
    }

    .passport-card-landmark {
        display: block;
        font-size: 0.75rem;
        color: #546E7A;
        font-weight: 700;
        margin: 0.2rem 0;
    }

    .passport-stamp {
        display: inline-block;
        font-size: 0.7rem;
        background: #2E7D32;
        color: #FFFFFF;
        padding: 0.15rem 0.4rem;
        border-radius: 8px;
        font-weight: 800;
    }

    .passport-stamp-pending {
        display: inline-block;
        font-size: 0.7rem;
        background: #ECEFF1;
        color: #455A64;
        padding: 0.15rem 0.4rem;
        border-radius: 8px;
        font-weight: 800;
    }

    .map-legend-bar {
        display: flex;
        justify-content: space-around;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
        margin-top: 1.25rem;
        padding-top: 1rem;
        border-top: 2px dashed #CFD8DC;
        font-size: 0.9rem;
        font-weight: 700;
        color: #37474F;
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .legend-swatch {
        width: 22px;
        height: 22px;
        border: 2px solid #2C3E50;
        border-radius: 6px;
    }

    .swatch-unlocked { background: #C8E6C9; }
    .swatch-locked { background: #FFF9C4; }
    .swatch-selected { background: #FFE082; }
</style>

@code {
    private IndiaPassportProgress Passport = new();
    private bool isListView = false;
    private string? selectedStateCode = "PB";
    private IndiaStateDefinition? selectedState;
    private bool isMascotWaving = false;
    private string mascotSpeechText = "Tap any state to explore its landmark sticker! 🦊✨";
    private bool showCelebration = false;
    private string celebrationText = "";
    private bool hasAnswered = false;

    private bool IsCurrentStateUnlocked => selectedStateCode != null && Passport.UnlockedStateCodes.Contains(selectedStateCode);

    protected override async Task OnInitializedAsync()
    {
        Passport = await IndiaMapService.GetPassportProgressAsync();
        selectedState = IndiaMapService.GetStateDetails(selectedStateCode ?? "PB");
        IndiaMapService.OnPassportChanged += HandlePassportChanged;
    }

    private void HandlePassportChanged()
    {
        InvokeAsync(async () =>
        {
            Passport = await IndiaMapService.GetPassportProgressAsync();
            StateHasChanged();
        });
    }

    private void SelectState(string code)
    {
        selectedStateCode = code;
        selectedState = IndiaMapService.GetStateDetails(code);
        showCelebration = false;
        hasAnswered = false;

        if (selectedState != null)
        {
            mascotSpeechText = $"Welcome to {selectedState.Name}! {selectedState.LandmarkIcon} {selectedState.LandmarkName}";
        }

        TriggerMascotWave();
    }

    private void HandleStateKeyDown(KeyboardEventArgs e, string code)
    {
        if (e.Key is "Enter" or " ")
        {
            SelectState(code);
        }
    }

    private async Task HandleAnswerSelected(string choice)
    {
        if (selectedState == null) return;
        hasAnswered = true;

        if (string.Equals(choice, selectedState.CorrectAnswer, StringComparison.OrdinalIgnoreCase))
        {
            await IndiaMapService.UnlockStateStickerAsync(selectedState.Code);
            celebrationText = selectedState.CelebrationCheer;
            showCelebration = true;
            mascotSpeechText = selectedState.CelebrationCheer;
            TriggerMascotWave();
        }
        else
        {
            showCelebration = false;
            mascotSpeechText = "Great try! Give it another thought and tap again! 🎈";
        }
    }

    private void TriggerMascotWave()
    {
        isMascotWaving = true;
        StateHasChanged();
        _ = Task.Delay(2400).ContinueWith(_ =>
        {
            isMascotWaving = false;
            InvokeAsync(StateHasChanged);
        });
    }

    public void Dispose()
    {
        IndiaMapService.OnPassportChanged -= HandlePassportChanged;
    }
}
