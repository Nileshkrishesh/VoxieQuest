@namespace VoxieQuest.Web.Components

<div class="storybook-card practice-panel-card">
    <div class="practice-title">
        🎮 Practice Mode: Tap your answer or type below!
    </div>

    <!-- Big Visual Choice Cards: 2x2 on phone, single row on laptop, min 64px tall -->
    <div class="practice-choices-grid">
        @foreach (var choice in choices)
        {
            <button class="btn-story btn-story-yellow practice-choice-btn" 
                    @onclick="() => ChooseAnswer(choice)" 
                    type="button">
                <span>@choice</span>
            </button>
        }
    </div>

    <!-- Keyboard Input Box with 16px text and touch target -->
    <div class="practice-input-row">
        <input type="text" 
               class="storybook-card practice-text-input" 
               placeholder="Or type answer here..." 
               @bind="keyboardInput" 
               @bind:event="oninput" 
               @onkeydown="HandleKeyDown" />
        <button class="btn-story btn-story-mint practice-submit-btn" 
                @onclick="SubmitKeyboardAnswer" 
                type="button">
            <span>OK ✓</span>
        </button>
    </div>
</div>

<style>
    .practice-panel-card {
        background: #FFFDF7;
        text-align: center;
        padding: clamp(0.85rem, 2.5vw, 1.25rem);
        margin-top: 1rem;
        width: 100%;
        box-sizing: border-box;
    }

    .practice-title {
        font-family: var(--font-heading);
        font-weight: 700;
        color: var(--color-sky-blue);
        font-size: clamp(0.95rem, 2.5vw, 1.15rem);
        margin-bottom: 0.75rem;
    }

    /* 2x2 grid on phone under 600px, 1 row on laptop 1024px and up */
    .practice-choices-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
        margin-bottom: 1rem;
        width: 100%;
        box-sizing: border-box;
    }

    @@media (min-width: 1024px) {
        .practice-choices-grid {
            grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
        }
    }

    .practice-choice-btn {
        min-height: 64px !important;
        min-width: 56px !important;
        font-size: clamp(1.1rem, 2.5vw, 1.35rem) !important;
        padding: 0.75rem 1rem !important;
        text-transform: capitalize;
        display: flex;
        align-items: center;
        justify-content: center;
        touch-action: manipulation;
    }

    .practice-input-row {
        display: flex;
        justify-content: center;
        gap: 12px;
        max-width: 440px;
        margin: 0 auto;
        width: 100%;
        box-sizing: border-box;
    }

    .practice-text-input {
        flex: 1;
        padding: 0.65rem 1rem;
        font-size: 16px !important;
        border-width: 2.5px;
        text-align: center;
        min-height: var(--tap-min);
        min-width: 0;
        touch-action: manipulation;
    }

    .practice-submit-btn {
        padding: 0.65rem 1.4rem !important;
        font-size: 1.1rem !important;
        min-height: var(--tap-min);
        min-width: 56px;
        display: flex;
        align-items: center;
        justify-content: center;
        touch-action: manipulation;
    }
</style>

@code {
    [Parameter]
    public QuestionItem? Question { get; set; }

    [Parameter]
    public EventCallback<string> OnAnswerSelected { get; set; }

    private List<string> choices = new();
    private string keyboardInput = "";

    protected override void OnParametersSet()
    {
        GenerateChoices();
    }

    private void GenerateChoices()
    {
        if (Question == null || string.IsNullOrWhiteSpace(Question.TargetAnswer)) return;

        var pool = GetDistractorPool(Question.Category);
        var random = new Random();

        var set = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
        {
            Question.TargetAnswer
        };

        foreach (var item in pool.OrderBy(_ => random.Next()))
        {
            if (set.Count >= 4) break;
            if (!set.Contains(item)) set.Add(item);
        }

        choices = set.OrderBy(_ => random.Next()).ToList();
    }

    private static List<string> GetDistractorPool(SkillCategory cat) => cat switch
    {
        SkillCategory.Phonics => new() { "bat", "hat", "rat", "sun", "log", "frog", "car", "star" },
        SkillCategory.Vocabulary => new() { "banana", "orange", "flower", "leaf", "bird", "apple", "tree" },
        SkillCategory.Numbers => new() { "two", "three", "four", "five", "six", "seven", "eight", "ten" },
        SkillCategory.Storytelling => new() { "open", "wait", "cross", "swim", "lantern", "compass", "help" },
        _ => new() { "cat", "dog", "sun", "star" }
    };

    private async Task ChooseAnswer(string ans)
    {
        if (OnAnswerSelected.HasDelegate)
        {
            await OnAnswerSelected.InvokeAsync(ans);
        }
    }

    private async Task SubmitKeyboardAnswer()
    {
        if (!string.IsNullOrWhiteSpace(keyboardInput))
        {
            var text = keyboardInput;
            keyboardInput = "";
            if (OnAnswerSelected.HasDelegate)
            {
                await OnAnswerSelected.InvokeAsync(text);
            }
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SubmitKeyboardAnswer();
        }
    }
}
