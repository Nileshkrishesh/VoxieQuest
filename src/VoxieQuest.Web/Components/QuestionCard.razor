@namespace VoxieQuest.Web.Components
@inject IAudioService AudioService

<div class="question-paper-card storybook-card-tilt">
    <!-- Top Row: Mascot + Speech Bubble with directional tail -->
    <div class="mascot-speech-row">
        <div class="mascot-anchor">
            <div class="mascot-desktop">
                <Mascot State="@MascotMood" Width="76" Height="76" />
            </div>
            <div class="mascot-mobile">
                <Mascot State="@MascotMood" Width="44" Height="44" />
            </div>
        </div>

        <div class="voxie-speech-bubble">
            <div class="bubble-tail" aria-hidden="true"></div>
            <div class="bubble-content">
                <span class="prompt-text">@Prompt</span>
                <div class="bubble-actions">
                    @if (OnRepeatPrompt.HasDelegate)
                    {
                        <button class="pill prompt-speak-btn" @onclick="HandleSpeakPrompt" type="button" aria-label="Read prompt aloud">
                            <SpeakerIcon Size="18" FillColor="#2B2D42" />
                            <span>Read Aloud</span>
                        </button>
                    }
                    @if (ShowHint && !string.IsNullOrWhiteSpace(HintText))
                    {
                        <span class="pill prompt-hint-pill">
                            <HintBulbIcon Size="18" />
                            <span>@HintText</span>
                        </span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Center Stage for Graphic / Question Content -->
    @if (ChildContent != null)
    {
        <div class="question-stage-content">
            @ChildContent
        </div>
    }
</div>

<style>
    .question-paper-card {
        background: var(--color-paper-light);
        border: var(--border-storybook);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-hard-md);
        padding: clamp(1rem, 2vw, 1.5rem);
        width: 100%;
        max-width: 960px;
        margin: 0 auto;
        position: relative;
    }

    .mascot-speech-row {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 0.75rem;
    }

    .mascot-anchor {
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Speech Bubble with directional tail */
    .voxie-speech-bubble {
        position: relative;
        background: var(--color-cloud-white);
        border: var(--border-storybook);
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-hard-sm);
        padding: 0.75rem 1.25rem;
        flex-grow: 1;
    }

    .bubble-tail {
        position: absolute;
        top: 24px;
        left: -12px;
        width: 0;
        height: 0;
        border-top: 10px solid transparent;
        border-bottom: 10px solid transparent;
        border-right: 12px solid var(--color-storybook-ink);
    }

    .bubble-tail::after {
        content: '';
        position: absolute;
        top: -8px;
        left: 3px;
        width: 0;
        height: 0;
        border-top: 8px solid transparent;
        border-bottom: 8px solid transparent;
        border-right: 10px solid var(--color-cloud-white);
    }

    .bubble-content {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }

    .prompt-text {
        font-family: var(--font-heading);
        font-size: clamp(1.2rem, 1.1rem + 0.5vw, 1.6rem);
        font-weight: 700;
        color: var(--color-storybook-ink);
        line-height: 1.3;
    }

    .bubble-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem;
    }

    .prompt-speak-btn {
        background: var(--color-bg-sky);
        border: var(--border-storybook-thin);
        border-radius: var(--radius-pill);
        padding: 0.3rem 0.85rem;
        font-family: var(--font-heading);
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--color-storybook-ink);
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        cursor: pointer;
        box-shadow: var(--shadow-hard-sm);
        transition: transform 0.1s var(--spring-squish);
    }
    .prompt-speak-btn:hover {
        transform: translateY(-2px);
    }
    .prompt-speak-btn:active {
        transform: translateY(2px);
    }

    .prompt-hint-pill {
        background: var(--color-sunny-yellow);
        border: var(--border-storybook-thin);
        border-radius: var(--radius-pill);
        padding: 0.3rem 0.85rem;
        font-family: var(--font-heading);
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--color-storybook-ink);
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        box-shadow: var(--shadow-hard-sm);
    }

    .question-stage-content {
        margin-top: 0.5rem;
    }

    .mascot-desktop { display: block; }
    .mascot-mobile { display: none; }

    @@media (max-width: 600px) {
        .question-paper-card {
            padding: 0.45rem 0.65rem;
            border-width: 3px;
            border-radius: var(--radius-md);
        }
        .mascot-speech-row {
            flex-direction: row;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 0.25rem;
        }
        .mascot-desktop { display: none; }
        .mascot-mobile { display: block; flex-shrink: 0; }
        .voxie-speech-bubble {
            padding: 0.4rem 0.65rem;
            border-width: 3px;
        }
        .bubble-tail {
            top: 14px;
            left: -8px;
            border-top: 6px solid transparent;
            border-bottom: 6px solid transparent;
            border-right: 8px solid var(--color-storybook-ink);
        }
        .bubble-tail::after {
            top: -5px;
            left: 2px;
            border-top: 5px solid transparent;
            border-bottom: 5px solid transparent;
            border-right: 7px solid var(--color-cloud-white);
        }
        .prompt-text {
            font-size: clamp(0.95rem, 3.2vw, 1.15rem);
            line-height: 1.25;
        }
        .bubble-actions {
            gap: 0.35rem;
        }
        .prompt-speak-btn, .prompt-hint-pill {
            padding: 0.2rem 0.55rem;
            font-size: 0.8rem;
        }
    }
</style>

@code {
    [Parameter] public string Prompt { get; set; } = string.Empty;
    [Parameter] public string HintText { get; set; } = string.Empty;
    [Parameter] public bool ShowHint { get; set; } = false;
    [Parameter] public Mascot.MascotState MascotMood { get; set; } = Mascot.MascotState.Idle;
    [Parameter] public EventCallback OnRepeatPrompt { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private async Task HandleSpeakPrompt()
    {
        await AudioService.PlaySoundAsync(SoundEffect.Click);
        if (OnRepeatPrompt.HasDelegate)
        {
            await OnRepeatPrompt.InvokeAsync();
        }
    }
}
