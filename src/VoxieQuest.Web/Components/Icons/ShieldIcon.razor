@namespace VoxieQuest.Web.Components.Icons

<svg width="@Size" height="@Size" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" class="@Class">
    <!-- Shield Crest Outline and Fill -->
    <path d="M16 3L5 7V16C5 22.5 10 27.5 16 29C22 27.5 27 22.5 27 16V7L16 3Z" 
          fill="@FillColor" 
          stroke="@StrokeColor" 
          stroke-width="2.5" 
          stroke-linejoin="round"/>
    
    <!-- Inner Emblem / Star on Shield -->
    <path d="M16 10L17.5 13.5L21.5 14L18.5 16.5L19.5 20.5L16 18.5L12.5 20.5L13.5 16.5L10.5 14L14.5 13.5L16 10Z" 
          fill="#FFFDF7" 
          stroke="@StrokeColor" 
          stroke-width="1.8" 
          stroke-linejoin="round"/>
</svg>

@code {
    [Parameter] public int Size { get; set; } = 28;
    [Parameter] public string FillColor { get; set; } = "#F78C6B"; // Soft Orange
    [Parameter] public string StrokeColor { get; set; } = "#2B2D42";
    [Parameter] public string Class { get; set; } = "";
}
