@namespace VoxieQuest.Web.Components.Icons

<svg width="@Size" height="@Size" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" class="@Class" aria-hidden="true">
    <!-- Bulb Glass -->
    <path d="M12 15C12 11.7 14.7 9 18 9C21.3 9 24 11.7 24 15C24 17.5 22.5 19.5 21 21V24H15V21C13.5 19.5 12 17.5 12 15Z" 
          fill="@FillColor" stroke="@StrokeColor" stroke-width="2.5" stroke-linejoin="round"/>
    <!-- Metal Screw Base -->
    <path d="M15 24H21M15.5 27H20.5M16.5 30H19.5" stroke="@StrokeColor" stroke-width="2.5" stroke-linecap="round"/>
    <!-- Light Glow Rays -->
    <path d="M18 3V5M8 9L9.5 10.5M28 9L26.5 10.5M5 16H7M31 16H29" stroke="@RayColor" stroke-width="2.5" stroke-linecap="round"/>
    <!-- Cute Filament -->
    <path d="M16 16C17 14 19 14 20 16" stroke="@StrokeColor" stroke-width="2" stroke-linecap="round"/>
</svg>

@code {
    [Parameter] public int Size { get; set; } = 32;
    [Parameter] public string FillColor { get; set; } = "#FFC93C";
    [Parameter] public string RayColor { get; set; } = "#FF9F43";
    [Parameter] public string StrokeColor { get; set; } = "#2B2D42";
    [Parameter] public string Class { get; set; } = "";
}
