@namespace VoxieQuest.Web.Components.Icons

<svg width="@Size" height="@Size" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" class="@Class" aria-hidden="true">
    <!-- Center Petal -->
    <path d="M18 5C14 12 14 22 18 27C22 22 22 12 18 5Z" fill="@PetalColor" stroke="@StrokeColor" stroke-width="2.5" stroke-linejoin="round"/>
    <!-- Left Petal -->
    <path d="M16 11C10 14 7 20 11 26C14 24 16 18 16 11Z" fill="@SidePetalColor" stroke="@StrokeColor" stroke-width="2.5" stroke-linejoin="round"/>
    <!-- Right Petal -->
    <path d="M20 11C26 14 29 20 25 26C22 24 20 18 20 11Z" fill="@SidePetalColor" stroke="@StrokeColor" stroke-width="2.5" stroke-linejoin="round"/>
    <!-- Water Pad Base -->
    <ellipse cx="18" cy="28" rx="14" ry="4" fill="#7ED9A8" stroke="@StrokeColor" stroke-width="2"/>
</svg>

@code {
    [Parameter] public int Size { get; set; } = 32;
    [Parameter] public string PetalColor { get; set; } = "#FF6B6B";
    [Parameter] public string SidePetalColor { get; set; } = "#FF9F43";
    [Parameter] public string StrokeColor { get; set; } = "#2B2D42";
    [Parameter] public string Class { get; set; } = "";
}
