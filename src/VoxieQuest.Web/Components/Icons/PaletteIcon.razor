@namespace VoxieQuest.Web.Components.Icons

<svg width="@Size" height="@Size" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" class="@Class">
    <!-- Palette Board -->
    <path d="M16 4C8 4 3 9 3 17C3 23 7 28 14 28C17 28 19 26 19 24C19 22 21 21 23 21H24C27.5 21 29 18 29 15C29 9 24 4 16 4Z" 
          fill="@BoardColor" 
          stroke="@StrokeColor" 
          stroke-width="2.5" 
          stroke-linejoin="round"/>

    <!-- Thumb Hole -->
    <circle cx="21" cy="16" r="2.2" fill="#FFFDF7" stroke="@StrokeColor" stroke-width="2"/>

    <!-- 4 Colorful Paint Dots -->
    <circle cx="9" cy="11" r="2" fill="#EF476F" stroke="@StrokeColor" stroke-width="1.5"/>
    <circle cx="15" cy="8" r="2" fill="#FFD166" stroke="@StrokeColor" stroke-width="1.5"/>
    <circle cx="21" cy="9" r="2" fill="#4EA8DE" stroke="@StrokeColor" stroke-width="1.5"/>
    <circle cx="10" cy="18" r="2" fill="#06D6A0" stroke="@StrokeColor" stroke-width="1.5"/>
</svg>

@code {
    [Parameter] public int Size { get; set; } = 32;
    [Parameter] public string BoardColor { get; set; } = "#FFF3B0"; // Warm Yellow Wood
    [Parameter] public string StrokeColor { get; set; } = "#2B2D42";
    [Parameter] public string Class { get; set; } = "";
}
