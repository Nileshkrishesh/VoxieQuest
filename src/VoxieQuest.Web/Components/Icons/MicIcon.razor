@namespace VoxieQuest.Web.Components.Icons

<svg width="@Size" height="@Size" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" class="@Class" aria-hidden="true">
    <!-- Mic Capsule -->
    <rect x="12" y="4" width="12" height="18" rx="6" fill="@FillColor" stroke="@StrokeColor" stroke-width="3"/>
    <!-- Mic Stand U-shape -->
    <path d="M8 15C8 20.5 12.5 25 18 25C23.5 25 28 20.5 28 15" stroke="@StrokeColor" stroke-width="3" stroke-linecap="round"/>
    <!-- Stem and Base -->
    <path d="M18 25V31M11 31H25" stroke="@StrokeColor" stroke-width="3" stroke-linecap="round"/>
    <!-- Grille lines -->
    <path d="M12 12H24" stroke="@StrokeColor" stroke-width="2.5" stroke-linecap="round"/>
</svg>

@code {
    [Parameter] public int Size { get; set; } = 32;
    [Parameter] public string FillColor { get; set; } = "#7ED9A8";
    [Parameter] public string StrokeColor { get; set; } = "#2B2D42";
    [Parameter] public string Class { get; set; } = "";
}
