@namespace VoxieQuest.Web.Components.Icons

<svg width="@Size" height="@Size" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" class="@Class" aria-hidden="true">
    <!-- Top Handle -->
    <path d="M14 8C14 4 22 4 22 8" stroke="@StrokeColor" stroke-width="2.5" stroke-linecap="round"/>
    <!-- Bag Main Body -->
    <rect x="7" y="8" width="22" height="23" rx="7" fill="@FillColor" stroke="@StrokeColor" stroke-width="3"/>
    <!-- Front Pocket -->
    <rect x="11" y="18" width="14" height="10" rx="3" fill="@PocketColor" stroke="@StrokeColor" stroke-width="2"/>
    <!-- Straps/Clips -->
    <line x1="11" y1="13" x2="11" y2="18" stroke="@StrokeColor" stroke-width="2.5" stroke-linecap="round"/>
    <line x1="25" y1="13" x2="25" y2="18" stroke="@StrokeColor" stroke-width="2.5" stroke-linecap="round"/>
</svg>

@code {
    [Parameter] public int Size { get; set; } = 32;
    [Parameter] public string FillColor { get; set; } = "#5BC0EB";
    [Parameter] public string PocketColor { get; set; } = "#FFC93C";
    [Parameter] public string StrokeColor { get; set; } = "#2B2D42";
    [Parameter] public string Class { get; set; } = "";
}
