@namespace VoxieQuest.Web.Components.Icons

<svg width="@Size" height="@Size" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" class="@Class">
    <!-- Exhaust Flames -->
    <path d="M13 25C13 29 16 31 16 31C16 31 19 29 19 25Z" fill="#FFD166" stroke="@StrokeColor" stroke-width="1.8"/>
    
    <!-- Left Fin -->
    <path d="M10 20C6 21 5 24 5 25C9 25 11 23 11 21Z" fill="#EF476F" stroke="@StrokeColor" stroke-width="2" stroke-linejoin="round"/>

    <!-- Right Fin -->
    <path d="M22 20C26 21 27 24 27 25C23 25 21 23 21 21Z" fill="#EF476F" stroke="@StrokeColor" stroke-width="2" stroke-linejoin="round"/>

    <!-- Rocket Fuselage -->
    <path d="M16 2C12 6 10 13 10 24H22C22 13 20 6 16 2Z" 
          fill="@FuselageColor" 
          stroke="@StrokeColor" 
          stroke-width="2.5" 
          stroke-linejoin="round"/>

    <!-- Nose Cone -->
    <path d="M16 2C13.5 5.5 12 9 11 11H21C20 9 18.5 5.5 16 2Z" fill="#EF476F" stroke="@StrokeColor" stroke-width="2"/>

    <!-- Porthole Window -->
    <circle cx="16" cy="16" r="3.2" fill="#E0F2FE" stroke="@StrokeColor" stroke-width="2"/>
</svg>

@code {
    [Parameter] public int Size { get; set; } = 32;
    [Parameter] public string FuselageColor { get; set; } = "#FFFDF7"; // Paper Cream
    [Parameter] public string StrokeColor { get; set; } = "#2B2D42";
    [Parameter] public string Class { get; set; } = "";
}
