@namespace VoxieQuest.Web.Components.Icons

<svg width="@Size" height="@Size" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" class="@Class" aria-hidden="true">
    <!-- Center Post -->
    <path d="M18 6V30M11 30H25" stroke="@StrokeColor" stroke-width="3" stroke-linecap="round"/>
    <!-- Top Fulcrum Beam -->
    <path d="M6 11H30" stroke="@StrokeColor" stroke-width="3" stroke-linecap="round"/>
    <!-- Left Pan -->
    <path d="M6 11L3 21H13L10 11" stroke="@StrokeColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M3 21C3 24 13 24 13 21" fill="@PanColor" stroke="@StrokeColor" stroke-width="2"/>
    <!-- Right Pan -->
    <path d="M26 11L23 21H33L30 11" stroke="@StrokeColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M23 21C23 24 33 24 33 21" fill="@PanColor" stroke="@StrokeColor" stroke-width="2"/>
    <!-- Center Pin -->
    <circle cx="18" cy="11" r="3" fill="#FFC93C" stroke="@StrokeColor" stroke-width="2"/>
</svg>

@code {
    [Parameter] public int Size { get; set; } = 32;
    [Parameter] public string PanColor { get; set; } = "#FFC93C";
    [Parameter] public string StrokeColor { get; set; } = "#2B2D42";
    [Parameter] public string Class { get; set; } = "";
}
