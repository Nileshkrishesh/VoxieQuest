@namespace VoxieQuest.Web.Components.Icons

<svg width="@Size" height="@Size" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" class="@Class">
    <!-- Fluffy Lion Mane -->
    <circle cx="16" cy="16" r="13" fill="@ManeColor" stroke="@StrokeColor" stroke-width="2.5"/>

    <!-- Round Ears -->
    <circle cx="9" cy="8" r="3" fill="@ManeColor" stroke="@StrokeColor" stroke-width="2"/>
    <circle cx="23" cy="8" r="3" fill="@ManeColor" stroke="@StrokeColor" stroke-width="2"/>

    <!-- Lion Face -->
    <circle cx="16" cy="16" r="8.5" fill="@FaceColor" stroke="@StrokeColor" stroke-width="2.2"/>

    <!-- Eyes -->
    <circle cx="13" cy="14" r="1.5" fill="#2B2D42"/>
    <circle cx="19" cy="14" r="1.5" fill="#2B2D42"/>

    <!-- Heart Nose & Whisker Muzzle -->
    <path d="M15 17L16 18.5L17 17H15Z" fill="#EF476F"/>
    <path d="M14 19C15 20.5 17 20.5 18 19" stroke="@StrokeColor" stroke-width="1.8" stroke-linecap="round"/>
</svg>

@code {
    [Parameter] public int Size { get; set; } = 32;
    [Parameter] public string ManeColor { get; set; } = "#F78C6B"; // Soft Orange
    [Parameter] public string FaceColor { get; set; } = "#FFD166"; // Sunny Yellow
    [Parameter] public string StrokeColor { get; set; } = "#2B2D42";
    [Parameter] public string Class { get; set; } = "";
}
