@namespace VoxieQuest.Web.Components

<div class="voxie-mascot-wrapper @GetStateClass()" style="display:inline-block; position:relative; width:@(Width)px; height:@(Height)px;">
    <svg width="@Width" height="@Height" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg" class="voxie-svg">
        <defs>
            <!-- Fox Fur Gradient -->
            <linearGradient id="foxFurGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#F78C6B" />
                <stop offset="100%" stop-color="#EF476F" />
            </linearGradient>

            <!-- Inner Ear Soft Tint -->
            <linearGradient id="innerEarGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#FFF9DB" />
                <stop offset="100%" stop-color="#FFE3E3" />
            </linearGradient>
        </defs>

        <!-- Tail (Bushy Fox Tail with White Tip) -->
        <g class="fox-tail-group @(State == MascotState.Happy ? "anim-tail-wag" : "anim-tail-lazy")" 
           transform-origin="70 145">
            <!-- Tail Body -->
            <path d="M70 145C45 155 15 140 10 110C5 80 30 65 55 75C80 85 75 125 70 145Z" 
                  fill="url(#foxFurGrad)" stroke="#2B2D42" stroke-width="4.5" stroke-linejoin="round"/>
            <!-- Fluffy White Tail Tip -->
            <path d="M10 110C8 92 20 80 35 76C42 84 38 95 48 98C40 108 30 112 10 110Z" 
                  fill="#FFFDF7" stroke="#2B2D42" stroke-width="4" stroke-linejoin="round"/>
        </g>

        <!-- Back Feet -->
        <ellipse cx="65" cy="172" rx="14" ry="9" fill="#FFFDF7" stroke="#2B2D42" stroke-width="4"/>
        <ellipse cx="135" cy="172" rx="14" ry="9" fill="#FFFDF7" stroke="#2B2D42" stroke-width="4"/>

        <!-- Fox Body -->
        <path d="M65 110C65 85 80 80 100 80C120 80 135 85 135 110C135 145 135 168 100 168C65 168 65 145 65 110Z" 
              fill="url(#foxFurGrad)" stroke="#2B2D42" stroke-width="4.5" stroke-linejoin="round"/>
        
        <!-- White Chest Fluff -->
        <path d="M82 105C82 105 100 125 100 148C100 125 118 105 118 105C125 120 115 155 100 155C85 155 75 120 82 105Z" 
              fill="#FFFDF7" stroke="#2B2D42" stroke-width="3.5" stroke-linejoin="round"/>

        <!-- Head Group (Includes Ears, Face, Snout) -->
        <g class="fox-head-group @GetHeadAnimationClass()" transform-origin="100 95">
            <!-- Left Big Ear -->
            <g class="fox-left-ear @GetEarAnimationClass()" transform-origin="60 65">
                <path d="M42 65C32 25 50 10 70 32C78 40 75 58 70 65Z" 
                      fill="url(#foxFurGrad)" stroke="#2B2D42" stroke-width="4.5" stroke-linejoin="round"/>
                <!-- Inner Ear -->
                <path d="M48 60C42 35 52 24 64 38C68 44 65 54 62 60Z" 
                      fill="url(#innerEarGrad)" stroke="#2B2D42" stroke-width="2.5"/>
            </g>

            <!-- Right Big Ear -->
            <g class="fox-right-ear @GetEarAnimationClass()" transform-origin="140 65">
                <path d="M158 65C168 25 150 10 130 32C122 40 125 58 130 65Z" 
                      fill="url(#foxFurGrad)" stroke="#2B2D42" stroke-width="4.5" stroke-linejoin="round"/>
                <!-- Inner Ear -->
                <path d="M152 60C158 35 148 24 136 38C132 44 135 54 138 60Z" 
                      fill="url(#innerEarGrad)" stroke="#2B2D42" stroke-width="2.5"/>
            </g>

            <!-- Fox Head Base Shape -->
            <path d="M50 72C35 88 40 108 55 118C75 130 125 130 145 118C160 108 165 88 150 72C135 56 65 56 50 72Z" 
                  fill="url(#foxFurGrad)" stroke="#2B2D42" stroke-width="4.5" stroke-linejoin="round"/>

            <!-- White Cheek Tufts -->
            <path d="M45 92C32 98 35 115 50 120C68 126 80 115 80 110C65 110 50 105 45 92Z" 
                  fill="#FFFDF7" stroke="#2B2D42" stroke-width="3.5" stroke-linejoin="round"/>
            <path d="M155 92C168 98 165 115 150 120C132 126 120 115 120 110C135 110 150 105 155 92Z" 
                  fill="#FFFDF7" stroke="#2B2D42" stroke-width="3.5" stroke-linejoin="round"/>

            <!-- Center Snout Base (Cream) -->
            <path d="M82 92C82 92 100 85 118 92C122 105 112 122 100 122C88 122 78 105 82 92Z" 
                  fill="#FFFDF7" stroke="#2B2D42" stroke-width="3.5" stroke-linejoin="round"/>

            <!-- Cute Black Button Nose -->
            <ellipse cx="100" cy="104" rx="6.5" ry="4.5" fill="#2B2D42"/>
            <ellipse cx="102" cy="102.5" rx="2" ry="1.2" fill="#FFFDF7"/>

            <!-- EYES & EXPRESSIONS (State-Dependent) -->
            @if (State == MascotState.Listening)
            {
                <!-- Attentive Looking Up Eyes -->
                <circle cx="75" cy="85" r="9" fill="#2B2D42"/>
                <circle cx="78" cy="82" r="3.5" fill="#FFFDF7"/>
                <circle cx="73" cy="88" r="1.5" fill="#FFFDF7"/>

                <circle cx="125" cy="85" r="9" fill="#2B2D42"/>
                <circle cx="128" cy="82" r="3.5" fill="#FFFDF7"/>
                <circle cx="123" cy="88" r="1.5" fill="#FFFDF7"/>

                <!-- Curious Open "O" Mouth -->
                <ellipse cx="100" cy="113" rx="4" ry="5" fill="#2B2D42"/>

                <!-- Listening Acoustic Sparkles near ears -->
                <path d="M30 40L33 44L38 46L33 48L30 52L27 48L22 46L27 44Z" fill="#FFD166" stroke="#2B2D42" stroke-width="1.5"/>
                <path d="M170 40L173 44L178 46L173 48L170 52L167 48L162 46L167 44Z" fill="#FFD166" stroke="#2B2D42" stroke-width="1.5"/>
            }
            else if (State == MascotState.Happy)
            {
                <!-- Joyful Squint Arcs (^ _ ^) -->
                <path d="M67 87C72 78 81 78 86 87" stroke="#2B2D42" stroke-width="4.5" stroke-linecap="round"/>
                <path d="M114 87C119 78 128 78 133 87" stroke="#2B2D42" stroke-width="4.5" stroke-linecap="round"/>

                <!-- Big Happy Smile with Tongue -->
                <path d="M90 110C90 118 110 118 110 110" stroke="#2B2D42" stroke-width="4" stroke-linecap="round" fill="#EF476F"/>

                <!-- Cheerful Stars -->
                <path d="M100 25L103 31L110 32L105 37L106 43L100 40L94 43L95 37L90 32L97 31Z" fill="#FFD166" stroke="#2B2D42" stroke-width="1.5"/>
            }
            else if (State == MascotState.Thinking)
            {
                <!-- Eyes looking sideways / thoughtfully up -->
                <circle cx="77" cy="84" r="8" fill="#2B2D42"/>
                <circle cx="79" cy="82" r="3" fill="#FFFDF7"/>

                <circle cx="127" cy="84" r="8" fill="#2B2D42"/>
                <circle cx="129" cy="82" r="3" fill="#FFFDF7"/>

                <!-- Thoughtful Wobbly Smile -->
                <path d="M94 112C98 115 106 113 108 110" stroke="#2B2D42" stroke-width="3.5" stroke-linecap="round"/>

                <!-- Floating Lightbulb / Star above head -->
                <circle cx="100" cy="28" r="8" fill="#FFD166" stroke="#2B2D42" stroke-width="2.5"/>
                <path d="M96 38H104" stroke="#2B2D42" stroke-width="2.5"/>
            }
            else if (State == MascotState.SadThenCheer)
            {
                <!-- Two-phase expression handled via CSS keyframes -->
                <g class="anim-sad-then-cheer-face">
                    <circle cx="75" cy="86" r="8" fill="#2B2D42"/>
                    <circle cx="77" cy="84" r="3" fill="#FFFDF7"/>
                    <circle cx="125" cy="86" r="8" fill="#2B2D42"/>
                    <circle cx="127" cy="84" r="3" fill="#FFFDF7"/>
                    <path d="M92 112C96 116 104 116 108 112" stroke="#2B2D42" stroke-width="4" stroke-linecap="round"/>
                </g>
            }
            else
            {
                <!-- IDLE Standard Friendly Eyes -->
                <circle cx="75" cy="86" r="8.5" fill="#2B2D42"/>
                <circle cx="78" cy="83.5" r="3.2" fill="#FFFDF7"/>
                <circle cx="73" cy="88" r="1.2" fill="#FFFDF7"/>

                <circle cx="125" cy="86" r="8.5" fill="#2B2D42"/>
                <circle cx="128" cy="83.5" r="3.2" fill="#FFFDF7"/>
                <circle cx="123" cy="88" r="1.2" fill="#FFFDF7"/>

                <!-- Gentle Warm Smile -->
                <path d="M93 111C97 115 103 115 107 111" stroke="#2B2D42" stroke-width="3.5" stroke-linecap="round"/>
            }

            <!-- Rosy Cheeks -->
            <ellipse cx="64" cy="98" rx="7" ry="4.5" fill="#EF476F" opacity="0.45"/>
            <ellipse cx="136" cy="98" rx="7" ry="4.5" fill="#EF476F" opacity="0.45"/>
        </g>

        <!-- Front Little Fox Paws -->
        <ellipse cx="86" cy="155" rx="9" ry="6" fill="#FFFDF7" stroke="#2B2D42" stroke-width="3.5"/>
        <ellipse cx="114" cy="155" rx="9" ry="6" fill="#FFFDF7" stroke="#2B2D42" stroke-width="3.5"/>
    </svg>
</div>

<style>
    /* Voxie CSS Keyframe Animations */
    .voxie-mascot-wrapper {
        user-select: none;
    }

    /* Idle Bobbing */
    .voxie-mascot-wrapper.state-idle .fox-head-group {
        animation: fox-idle-bob 3s ease-in-out infinite;
    }
    .voxie-mascot-wrapper.state-idle .fox-tail-group {
        animation: fox-tail-lazy 4s ease-in-out infinite;
    }

    /* Listening: Ears Wiggle */
    .voxie-mascot-wrapper.state-listening .fox-left-ear {
        animation: fox-left-ear-wiggle 0.5s ease-in-out infinite alternate;
    }
    .voxie-mascot-wrapper.state-listening .fox-right-ear {
        animation: fox-right-ear-wiggle 0.5s ease-in-out infinite alternate-reverse;
    }

    /* Happy: Tail Wags Fast & Head Bounces */
    .voxie-mascot-wrapper.state-happy .fox-tail-group {
        animation: fox-tail-wag-fast 0.3s ease-in-out infinite alternate;
    }
    .voxie-mascot-wrapper.state-happy .voxie-svg {
        animation: fox-happy-bounce 0.6s ease-in-out infinite alternate;
    }

    /* Thinking: Head Tilted Curious */
    .voxie-mascot-wrapper.state-thinking .fox-head-group {
        transform: rotate(9deg) translateY(-2px);
        transition: transform 0.3s ease;
    }

    /* SadThenCheer: Droop then perk up */
    .voxie-mascot-wrapper.state-sadthencheer .fox-head-group {
        animation: fox-sad-cheer 2.8s var(--spring-bounce) infinite;
    }
    .voxie-mascot-wrapper.state-sadthencheer .fox-left-ear,
    .voxie-mascot-wrapper.state-sadthencheer .fox-right-ear {
        animation: fox-ears-perk 2.8s var(--spring-bounce) infinite;
    }

    @@keyframes fox-idle-bob {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-4px); }
    }

    @@keyframes fox-tail-lazy {
        0%, 100% { transform: rotate(-6deg); }
        50% { transform: rotate(8deg); }
    }

    @@keyframes fox-tail-wag-fast {
        0% { transform: rotate(-18deg); }
        100% { transform: rotate(20deg); }
    }

    @@keyframes fox-left-ear-wiggle {
        0% { transform: rotate(-6deg); }
        100% { transform: rotate(10deg); }
    }

    @@keyframes fox-right-ear-wiggle {
        0% { transform: rotate(6deg); }
        100% { transform: rotate(-10deg); }
    }

    @@keyframes fox-happy-bounce {
        0% { transform: translateY(0); }
        100% { transform: translateY(-8px); }
    }

    @@keyframes fox-sad-cheer {
        0% { transform: translateY(3px) rotate(-3deg); }
        35% { transform: translateY(5px) rotate(-4deg); }
        60% { transform: translateY(-7px) rotate(3deg); }
        100% { transform: translateY(0) rotate(0); }
    }

    @@keyframes fox-ears-perk {
        0%, 35% { transform: rotate(-8deg); }
        60%, 100% { transform: rotate(6deg); }
    }
</style>

@code {
    /// <summary>Visual mascot state of Voxie the Fox.</summary>
    public enum MascotState
    {
        Idle,
        Listening,
        Happy,
        Thinking,
        SadThenCheer
    }

    [Parameter]
    public MascotState State { get; set; } = MascotState.Idle;

    [Parameter]
    public int Width { get; set; } = 150;

    [Parameter]
    public int Height { get; set; } = 150;

    private string GetStateClass() => State switch
    {
        MascotState.Listening => "state-listening",
        MascotState.Happy => "state-happy",
        MascotState.Thinking => "state-thinking",
        MascotState.SadThenCheer => "state-sadthencheer",
        _ => "state-idle"
    };

    private string GetHeadAnimationClass() => State switch
    {
        MascotState.Thinking => "anim-thinking-head",
        _ => ""
    };

    private string GetEarAnimationClass() => State switch
    {
        MascotState.Listening => "anim-ear-wiggle",
        _ => ""
    };
}
