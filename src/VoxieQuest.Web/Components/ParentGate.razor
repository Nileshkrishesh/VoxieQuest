@namespace VoxieQuest.Web.Components
@inject IAudioService AudioService

@if (IsVisible)
{
    <div class="parent-gate-overlay" role="dialog" aria-modal="true" aria-label="Grown-Ups Verification">
        <div class="storybook-card gate-card">
            <!-- Header with Shield Icon & Close Button -->
            <div class="gate-header-row">
                <div class="gate-title-group">
                    <ShieldIcon Size="32" FillColor="#FF6B6B" />
                    <h3 class="gate-title-text">@Title</h3>
                </div>
                <button class="pill gate-close-btn" type="button" @onclick="HandleCancel" aria-label="Close">✕</button>
            </div>

            <!-- Tab Switcher: 1-Tap Quick Math vs 4-Digit PIN / Year -->
            <div class="gate-tab-switcher">
                <button class="pill @(activeTab == GateTab.Math ? "active-tab" : "")" 
                        type="button" 
                        @onclick="() => SwitchTab(GateTab.Math)">
                    <span>➕ Quick Math (1-Tap)</span>
                </button>
                <button class="pill @(activeTab == GateTab.Pin ? "active-tab" : "")" 
                        type="button" 
                        @onclick="() => SwitchTab(GateTab.Pin)">
                    <span>🔢 PIN / Birth Year</span>
                </button>
            </div>

            @if (activeTab == GateTab.Math)
            {
                <!-- Mode 1: Quick Adult Math Challenge (Instant 1-Tap Choice Buttons) -->
                <div class="math-gate-zone">
                    <p class="gate-instructions">
                        Grown-ups check: Tap the correct answer below:
                    </p>

                    <!-- Large Equation Display -->
                    <div class="math-problem-banner">
                        <span class="math-equation-text">
                            @mathNum1 @mathOperator @mathNum2 = ?
                        </span>
                    </div>

                    <!-- 4 Instant-Tap Multiple Choice Buttons (2x2 Grid) -->
                    <div class="math-choices-grid">
                        @foreach (var choice in mathChoices)
                        {
                            <button class="pill math-choice-btn" 
                                    type="button" 
                                    @onclick="() => VerifyChoice(choice)">
                                @choice
                            </button>
                        }
                    </div>

                    <!-- Optional Manual Text Input for Desktop Keyboard -->
                    <div class="math-manual-input-row">
                        <input type="number" 
                               class="storybook-card math-number-box" 
                               placeholder="Or type here..." 
                               @bind="userMathAnswer" 
                               @onkeydown="HandleKeyDown" 
                               aria-label="Type math answer" />
                        <button class="pill math-submit-pill" type="button" @onclick="VerifyTypedAnswer">
                            <span>Check ➔</span>
                        </button>
                    </div>

                    @if (hasMathError)
                    {
                        <div class="gate-error-message" role="alert">
                            Almost! Here is a new question to try.
                        </div>
                    }
                </div>
            }
            else
            {
                <!-- Mode 2: 4-Digit PIN or Birth Year Verification -->
                <div class="pin-gate-zone">
                    <p class="gate-instructions">
                        Enter any grown-up birth year (e.g. <strong>1992</strong>) or PIN (<strong>1234</strong>):
                    </p>

                    <!-- PIN Dots / Digits Display -->
                    <div class="pin-display-card">
                        @for (int i = 0; i < 4; i++)
                        {
                            var digit = i < enteredPin.Length ? enteredPin[i].ToString() : "•";
                            <span class="pin-digit-slot @(i < enteredPin.Length ? "slot-filled" : "")">@digit</span>
                        }
                    </div>

                    <!-- Clean 3x4 On-Screen Keypad -->
                    <div class="pin-keypad-grid">
                        @for (int d = 1; d <= 9; d++)
                        {
                            var num = d.ToString();
                            <button class="pill pin-key-btn" type="button" @onclick="() => AppendDigit(num)">
                                @num
                            </button>
                        }
                        <button class="pill pin-key-btn key-clear" type="button" @onclick="ClearPin" title="Clear">
                            <span>C</span>
                        </button>
                        <button class="pill pin-key-btn" type="button" @onclick='() => AppendDigit("0")'>
                            0
                        </button>
                        <button class="pill pin-key-btn key-backspace" type="button" @onclick="BackspacePin" title="Delete">
                            <span>⌫</span>
                        </button>
                    </div>

                    @if (hasPinError)
                    {
                        <div class="gate-error-message" role="alert">
                            Please enter a valid adult year (before 2012) or 1234.
                        </div>
                    }
                </div>
            }

            <!-- Child-Safe Policy Footnote -->
            <div class="gate-safety-footnote">
                <span>🛡️ This barrier ensures children stay safely in learning gameplay.</span>
            </div>
        </div>
    </div>
}

