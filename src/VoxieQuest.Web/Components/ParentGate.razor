@code {
    private enum GateTab { Math, Pin }
    private GateTab activeTab = GateTab.Math; // Default to fast 1-tap math question

    [Parameter] public bool IsVisible { get; set; } = false;
    [Parameter] public string Title { get; set; } = "Grown-Ups Verification";
    [Parameter] public EventCallback<bool> OnVerified { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    // Math Challenge State
    private int mathNum1 = 14;
    private int mathNum2 = 18;
    private string mathOperator = "+";
    private int expectedMathAnswer = 32;
    private List<int> mathChoices = new();
    private int? userMathAnswer;
    private bool hasMathError = false;

    // PIN / Year State
    private string enteredPin = string.Empty;
    private bool hasPinError = false;

    protected override void OnInitialized()
    {
        GenerateMathChallenge();
    }

    protected override void OnParametersSet()
    {
        if (IsVisible)
        {
            hasMathError = false;
            hasPinError = false;
            userMathAnswer = null;
            enteredPin = string.Empty;
            GenerateMathChallenge();
        }
    }

    private void SwitchTab(GateTab tab)
    {
        activeTab = tab;
        hasMathError = false;
        hasPinError = false;
        enteredPin = string.Empty;
        if (tab == GateTab.Math)
        {
            GenerateMathChallenge();
        }
    }

    private void GenerateMathChallenge()
    {
        var rand = new Random();
        int opType = rand.Next(3);

        if (opType == 0)
        {
            // Addition: e.g. 14 + 18
            mathNum1 = rand.Next(12, 35);
            mathNum2 = rand.Next(11, 35);
            mathOperator = "+";
            expectedMathAnswer = mathNum1 + mathNum2;
        }
        else if (opType == 1)
        {
            // Subtraction: e.g. 45 - 18
            mathNum1 = rand.Next(25, 55);
            mathNum2 = rand.Next(10, 24);
            mathOperator = "-";
            expectedMathAnswer = mathNum1 - mathNum2;
        }
        else
        {
            // Multiplication: e.g. 7 x 8
            mathNum1 = rand.Next(6, 10);
            mathNum2 = rand.Next(6, 10);
            mathOperator = "×";
            expectedMathAnswer = mathNum1 * mathNum2;
        }

        // Generate 3 plausible distractors
        var choicesSet = new HashSet<int> { expectedMathAnswer };
        while (choicesSet.Count < 4)
        {
            int offset = rand.Next(-6, 7);
            if (offset == 0) offset = 2;
            int candidate = expectedMathAnswer + offset;
            if (candidate > 0 && candidate != expectedMathAnswer)
            {
                choicesSet.Add(candidate);
            }
        }

        mathChoices = choicesSet.OrderBy(_ => rand.Next()).ToList();
        userMathAnswer = null;
    }

    private async Task VerifyChoice(int chosen)
    {
        if (chosen == expectedMathAnswer)
        {
            hasMathError = false;
            await AudioService.PlaySoundAsync(SoundEffect.SuccessChime);
            await OnVerified.InvokeAsync(true);
        }
        else
        {
            hasMathError = true;
            await AudioService.PlaySoundAsync(SoundEffect.EncourageChime);
            GenerateMathChallenge();
        }
    }

    private async Task VerifyTypedAnswer()
    {
        if (userMathAnswer.HasValue && userMathAnswer.Value == expectedMathAnswer)
        {
            hasMathError = false;
            await AudioService.PlaySoundAsync(SoundEffect.SuccessChime);
            await OnVerified.InvokeAsync(true);
        }
        else
        {
            hasMathError = true;
            await AudioService.PlaySoundAsync(SoundEffect.EncourageChime);
            GenerateMathChallenge();
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await VerifyTypedAnswer();
        }
    }

    private async Task AppendDigit(string digit)
    {
        if (enteredPin.Length < 4)
        {
            enteredPin += digit;
            hasPinError = false;
            await AudioService.PlaySoundAsync(SoundEffect.Pop);

            if (enteredPin.Length == 4)
            {
                await ValidatePinAsync();
            }
        }
    }

    private void BackspacePin()
    {
        if (enteredPin.Length > 0)
        {
            enteredPin = enteredPin.Substring(0, enteredPin.Length - 1);
            hasPinError = false;
        }
    }

    private void ClearPin()
    {
        enteredPin = string.Empty;
        hasPinError = false;
    }

    private async Task ValidatePinAsync()
    {
        // 1234 is the universal adult default PIN
        // OR any birth year <= 2011 (adult / teenager age 15+)
        bool isCorrect = false;

        if (enteredPin == "1234")
        {
            isCorrect = true;
        }
        else if (int.TryParse(enteredPin, out int year) && year >= 1930 && year <= 2011)
        {
            isCorrect = true;
        }

        if (isCorrect)
        {
            hasPinError = false;
            await AudioService.PlaySoundAsync(SoundEffect.SuccessChime);
            await OnVerified.InvokeAsync(true);
        }
        else
        {
            hasPinError = true;
            await AudioService.PlaySoundAsync(SoundEffect.EncourageChime);
            enteredPin = string.Empty;
        }
    }

    private async Task HandleCancel()
    {
        await OnCancel.InvokeAsync();
    }
}
