@namespace VoxieQuest.Web.Components
@inject IAudioService AudioService

@if (IsOpen)
{
    <div class="sleepy-break-backdrop" role="dialog" aria-modal="true" aria-labelledby="break-title">
        <div class="sleepy-break-card bounce-in-card">
            <!-- Sleepy Foxie with Zzz -->
            <div class="sleepy-mascot-box">
                <Mascot State="Mascot.MascotState.Idle" Width="100" Height="100" />
                <div class="floating-zzz">
                    <span class="zzz-1">Z</span>
                    <span class="zzz-2">z</span>
                    <span class="zzz-3">z</span>
                </div>
            </div>

            <h2 id="break-title" class="break-title">
                Time for a Cozy Voxie Break!
            </h2>

            <p class="break-message">
                Your brain has been doing wonderful work! Let's take three deep breaths together.
            </p>

            <CalmSunTimer DurationSeconds="20" />

            <div class="break-actions">
                <BouncyButton Variant="BouncyButton.ButtonVariant.Yellow" 
                              Text="I'm Ready to Play!" 
                              IsTall="true" 
                              OnClick="HandleResume">
                    <IconTemplate>
                        <SunIcon Size="24" />
                    </IconTemplate>
                </BouncyButton>

                @if (OnWarmUp.HasDelegate)
                {
                    <BouncyButton Variant="BouncyButton.ButtonVariant.White" 
                                  Text="Try Easy Warm-Up" 
                                  IsTall="false" 
                                  OnClick="HandleWarmUp">
                        <IconTemplate>
                            <FlowerIcon Size="22" />
                        </IconTemplate>
                    </BouncyButton>
                }
            </div>
        </div>
    </div>
}

<style>
    .sleepy-break-backdrop {
        position: fixed;
        top: 0; left: 0; width: 100vw; height: 100vh;
        background: rgba(43, 45, 66, 0.75);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
        z-index: 1000;
    }

    .sleepy-break-card {
        background: var(--color-paper-light);
        border: var(--border-storybook-heavy);
        border-radius: var(--radius-lg);
        box-shadow: 10px 10px 0 var(--color-storybook-ink);
        padding: clamp(1.5rem, 3vw, 2.5rem);
        max-width: 520px;
        width: 100%;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
    }

    .sleepy-mascot-box {
        position: relative;
    }

    .floating-zzz {
        position: absolute;
        top: -10px;
        right: -25px;
        display: flex;
        flex-direction: column;
        font-family: var(--font-heading);
        font-weight: 700;
        color: var(--color-sky-blue);
    }

    .zzz-1 { font-size: 1.5rem; animation: zzz-float 2s infinite ease-in; }
    .zzz-2 { font-size: 1.2rem; animation: zzz-float 2s infinite ease-in 0.5s; }
    .zzz-3 { font-size: 0.9rem; animation: zzz-float 2s infinite ease-in 1s; }

    .break-title {
        font-family: var(--font-heading);
        font-size: clamp(1.6rem, 1.3rem + 0.8vw, 2.2rem);
        font-weight: 700;
        color: var(--color-storybook-ink);
        margin: 0;
    }

    .break-message {
        font-family: var(--font-body);
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--color-soft-orange);
        margin: 0;
    }

    .break-actions {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        width: 100%;
        max-width: 320px;
        margin-top: 0.5rem;
    }

    @@keyframes zzz-float {
        0% { transform: translateY(0) scale(0.8); opacity: 0; }
        50% { transform: translateY(-15px) scale(1.1); opacity: 1; }
        100% { transform: translateY(-30px) scale(1.3); opacity: 0; }
    }
</style>

@code {
    [Parameter] public bool IsOpen { get; set; } = false;
    [Parameter] public EventCallback OnResume { get; set; }
    [Parameter] public EventCallback OnWarmUp { get; set; }

    private async Task HandleResume()
    {
        await AudioService.PlaySoundAsync(SoundEffect.Click);
        if (OnResume.HasDelegate)
        {
            await OnResume.InvokeAsync();
        }
    }

    private async Task HandleWarmUp()
    {
        await AudioService.PlaySoundAsync(SoundEffect.Click);
        if (OnWarmUp.HasDelegate)
        {
            await OnWarmUp.InvokeAsync();
        }
    }
}
