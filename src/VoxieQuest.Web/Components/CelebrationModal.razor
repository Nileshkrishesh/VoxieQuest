@namespace VoxieQuest.Web.Components

@if (IsVisible)
{
    <div class="celebration-overlay">
        <div class="storybook-card celebration-card">
            <div class="celebration-stars-emoji">🎉 ⭐ 🌟</div>
            <h2 class="celebration-heading">
                HOORAY! YOU DID IT!
            </h2>
            <p class="celebration-desc">
                You earned <strong>@StarsEarned Stars</strong> with Voxie!
            </p>

            <div class="celebration-actions-row">
                <button class="btn-story btn-story-mint celebration-btn" @onclick="OnPlayAgain" type="button">
                    <span>Play More 🚀</span>
                </button>
                <button class="btn-story btn-story-coral celebration-btn" @onclick="OnReturnHome" type="button">
                    <span>Realms Map 🗺️</span>
                </button>
            </div>
        </div>
    </div>
}

<style>
    .celebration-overlay {
        position: fixed;
        inset: 0;
        width: 100vw;
        height: 100dvh;
        background: rgba(43, 45, 66, 0.65);
        backdrop-filter: blur(4px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10000;
        padding: clamp(1rem, 2.5vw, 1.5rem);
        box-sizing: border-box;
    }

    .celebration-card {
        max-width: 480px;
        max-height: 90dvh;
        overflow-y: auto;
        width: 100%;
        text-align: center;
        background: var(--color-sunny-yellow);
        border: var(--border-ink-thick);
        border-radius: var(--border-radius-lg);
        box-shadow: var(--shadow-chunky-lg);
        padding: clamp(1.25rem, 3vw, 2rem) clamp(1rem, 2.5vw, 1.75rem);
        animation: scale-up-celeb 0.45s var(--spring-bounce);
        box-sizing: border-box;
    }

    .celebration-stars-emoji {
        font-size: clamp(2.5rem, 6vw, 3.5rem);
        margin-bottom: 0.35rem;
    }

    .celebration-heading {
        font-size: clamp(1.5rem, 4vw, 2.2rem);
        color: var(--color-storybook-ink);
        margin-bottom: 0.5rem;
        font-weight: 800;
        line-height: 1.25;
    }

    .celebration-desc {
        font-size: clamp(1rem, 2.5vw, 1.2rem);
        font-weight: 700;
        color: var(--color-storybook-ink);
        margin-bottom: 1.25rem;
    }

    .celebration-actions-row {
        display: flex;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .celebration-btn {
        min-height: var(--tap-min);
        min-width: var(--tap-min);
        font-size: 1.05rem !important;
        padding: 0.65rem 1.4rem !important;
        flex: 1 1 160px;
        max-width: 220px;
    }

    @@keyframes scale-up-celeb {
        0% { transform: scale(0.65); opacity: 0; }
        100% { transform: scale(1); opacity: 1; }
    }
</style>

@code {
    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public int StarsEarned { get; set; } = 3;

    [Parameter]
    public EventCallback OnPlayAgain { get; set; }

    [Parameter]
    public EventCallback OnReturnHome { get; set; }
}
