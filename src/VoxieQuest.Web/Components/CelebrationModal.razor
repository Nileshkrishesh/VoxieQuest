@namespace VoxieQuest.Web.Components

@if (IsVisible)
{
    <div class="celebration-overlay">
        <div class="storybook-card celebration-card">
            <div class="celebration-trophy-stage">
                <span class="trophy-bounce">🏆</span>
                <span class="sparkle-orbit">✨</span>
            </div>
            <h2 class="celebration-heading">
                🎉 HOORAY! QUEST COMPLETE!
            </h2>
            <div class="stars-earned-banner">
                <span>⭐ +@StarsEarned Stars Collected! ⭐</span>
            </div>
            <p class="celebration-desc">
                Awesome work! Your skills grew in the Skill Garden!
            </p>

            <div class="celebration-actions-row">
                <button class="btn-candy btn-candy-mint celebration-btn" @onclick="OnPlayAgain" type="button">
                    <span>Play More 🚀</span>
                </button>
                <button class="btn-candy btn-candy-coral celebration-btn" @onclick="OnReturnHome" type="button">
                    <span>Realms Map 🗺️</span>
                </button>
            </div>
        </div>
    </div>
}

<style>
    .celebration-overlay {
        position: fixed;
        inset: 0;
        width: 100vw;
        height: 100dvh;
        background: rgba(15, 23, 42, 0.75);
        backdrop-filter: blur(8px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10000;
        padding: clamp(1rem, 2.5vw, 1.5rem);
        box-sizing: border-box;
    }

    .celebration-card {
        max-width: 480px;
        max-height: 90dvh;
        overflow-y: auto;
        width: 100%;
        text-align: center;
        background: linear-gradient(180deg, #FFFDF7 0%, #FEF9C3 60%, #FEF08A 100%);
        border: 4px solid var(--color-storybook-ink);
        border-radius: 32px;
        box-shadow: 0 12px 0 var(--color-storybook-ink), 0 20px 40px rgba(0, 0, 0, 0.2);
        padding: clamp(1.5rem, 3.5vw, 2.2rem) clamp(1rem, 2.5vw, 1.8rem);
        animation: scale-up-celeb 0.45s var(--spring-bounce);
        box-sizing: border-box;
    }

    .celebration-trophy-stage {
        position: relative;
        font-size: clamp(3.5rem, 8vw, 4.5rem);
        margin-bottom: 0.5rem;
        display: inline-block;
    }

    .trophy-bounce {
        display: inline-block;
        animation: trophy-wobble 2s infinite ease-in-out;
    }

    .sparkle-orbit {
        position: absolute;
        top: -10px;
        right: -14px;
        font-size: 2rem;
        animation: twinkle-stars 1.5s infinite alternate;
    }

    @@keyframes trophy-wobble {
        0%, 100% { transform: scale(1) rotate(0deg); }
        25% { transform: scale(1.1) rotate(-6deg); }
        75% { transform: scale(1.1) rotate(6deg); }
    }

    .celebration-heading {
        font-size: clamp(1.5rem, 4vw, 2.2rem);
        color: var(--color-storybook-ink);
        margin: 0.25rem 0 0.75rem 0;
        font-weight: 800;
        font-family: var(--font-heading);
        text-shadow: 1px 2px 0 rgba(0, 0, 0, 0.08);
    }

    .stars-earned-banner {
        display: inline-block;
        background: linear-gradient(180deg, #FEF08A 0%, #F59E0B 100%);
        border: 2.5px solid var(--color-storybook-ink);
        border-radius: var(--radius-pill);
        box-shadow: 0 4px 0 var(--color-storybook-ink);
        padding: 6px 18px;
        font-weight: 800;
        font-family: var(--font-heading);
        font-size: 1.15rem;
        color: #78350F;
        margin-bottom: 0.75rem;
    }

    .celebration-desc {
        font-size: clamp(1rem, 2.5vw, 1.15rem);
        font-weight: 700;
        color: #475569;
        margin-bottom: 1.5rem;
    }

    .celebration-actions-row {
        display: flex;
        justify-content: center;
        gap: 14px;
        flex-wrap: wrap;
    }

    .celebration-btn {
        min-height: var(--tap-min);
        flex: 1 1 160px;
        max-width: 220px;
    }

    @@keyframes scale-up-celeb {
        0% { transform: scale(0.65); opacity: 0; }
        100% { transform: scale(1); opacity: 1; }
    }
</style>

@code {
    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public int StarsEarned { get; set; } = 3;

    [Parameter]
    public EventCallback OnPlayAgain { get; set; }

    [Parameter]
    public EventCallback OnReturnHome { get; set; }
}
