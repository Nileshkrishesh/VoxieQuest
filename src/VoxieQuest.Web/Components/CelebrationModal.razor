@namespace VoxieQuest.Web.Components

@if (IsVisible)
{
    <div style="position:fixed; top:0; left:0; width:100vw; height:100vh; background:rgba(43,45,66,0.6); display:flex; align-items:center; justify-content:center; z-index:999; padding:1.5rem;">
        <div class="storybook-card" style="max-width:480px; width:100%; text-align:center; background:var(--color-sunny-yellow); animation:gentle-float 2s ease-in-out infinite;">
            <div style="font-size:3.5rem; margin-bottom:0.5rem;">🎉 ⭐ 🌟</div>
            <h2 style="font-size:2.2rem; color:var(--color-storybook-ink); margin-bottom:0.5rem;">
                HOORAY! YOU DID IT!
            </h2>
            <p style="font-size:1.2rem; font-weight:700; color:var(--color-storybook-ink); margin-bottom:1.25rem;">
                You earned <strong>@StarsEarned Stars</strong> with Voxie!
            </p>

            <div style="display:flex; justify-content:center; gap:1rem; flex-wrap:wrap;">
                <button class="btn-story btn-story-mint" @onclick="OnPlayAgain" type="button">
                    <span>Play More 🚀</span>
                </button>
                <button class="btn-story btn-story-coral" @onclick="OnReturnHome" type="button">
                    <span>Realms Map 🗺️</span>
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public int StarsEarned { get; set; } = 3;

    [Parameter]
    public EventCallback OnPlayAgain { get; set; }

    [Parameter]
    public EventCallback OnReturnHome { get; set; }
}
