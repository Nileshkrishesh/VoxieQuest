@page "/profile"
@inject IProgressService ProgressService
@inject IAudioService AudioService

<div class="profile-page-container">
    <!-- Profile Page Header -->
    <div class="storybook-card profile-header-card">
        <h2 class="profile-header-title">👤 Adventurer Profiles</h2>
        <p class="profile-header-sub">
            Choose who is playing or create a new profile! (Up to 4 adventurers)
        </p>
    </div>

    <!-- 4 Profile Slots Grid: 2 columns on phone, 4 on tablet & up -->
    <div class="profiles-grid">
        @foreach (var profile in ProgressService.Profiles)
        {
            var isActive = profile.Id == ProgressService.ActiveProfile?.Id;
            <div class="storybook-card profile-slot-card @(isActive ? "slot-active" : "")" 
                 @onclick="() => SelectProfile(profile.Id)">
                <div class="profile-avatar-emoji">
                    @GetAvatarEmoji(profile.Avatar)
                </div>
                <h3 class="profile-name-text">@profile.Name</h3>
                <div class="profile-stats-pill">
                    Age @profile.Age • ⭐ @profile.TotalStars Stars
                </div>
                <div class="profile-time-text">
                    ⏱️ Played: @profile.FormattedPlayTime
                </div>

                @if (isActive)
                {
                    <span class="pill status-pill-active">
                        ✓ Playing Now!
                    </span>
                }
                else
                {
                    <span class="pill status-pill-switch">
                        Tap to Switch
                    </span>
                }
            </div>
        }

        <!-- Add Profile Slot (if < 4) -->
        @if (ProgressService.Profiles.Count < 4)
        {
            <div class="storybook-card add-profile-slot" 
                 @onclick="ToggleNewProfileForm">
                <div class="add-plus-icon">➕</div>
                <h3 class="add-title-text">Add Adventurer</h3>
                <p class="add-slots-rem">@(4 - ProgressService.Profiles.Count) slots remaining</p>
            </div>
        }
    </div>

    <!-- Create Profile Card (Visible when toggled) -->
    @if (showNewForm && ProgressService.Profiles.Count < 4)
    {
        <div class="storybook-card new-profile-card">
            <h3 class="new-profile-title">🌟 Create New Adventurer</h3>
            <div class="new-profile-form-body">
                <div>
                    <label class="form-field-label">Child's Name:</label>
                    <input type="text" class="storybook-card profile-name-input" @bind="newName" placeholder="e.g. Leo, Maya, Sam" />
                </div>

                <div>
                    <label class="form-field-label">Choose Companion Avatar:</label>
                    <!-- Grid of big avatars: 2 cols on phone, 4 on tablet and up -->
                    <div class="avatar-picker-grid">
                        @foreach (var avatar in Enum.GetValues<AvatarType>())
                        {
                            <button type="button" 
                                    class="pill avatar-choice-btn @(newAvatar == avatar ? "avatar-selected" : "")" 
                                    @onclick="() => newAvatar = avatar">
                                <span class="avatar-choice-emoji">@GetAvatarEmoji(avatar)</span>
                                <span class="avatar-choice-name">@avatar.ToString().Replace("Chameleon","").Replace("Lion","").Replace("Penguin","").Replace("Monkey","")</span>
                            </button>
                        }
                    </div>
                </div>

                <div>
                    <label class="form-field-label">Age: @newAge years old</label>
                    <input type="range" min="5" max="10" step="1" @bind="newAge" style="width:100%; min-height:40px;" />
                </div>

                <div class="form-actions-row">
                    <button class="btn-story btn-story-mint save-adv-btn" type="button" @onclick="CreateProfile">
                        <span>Save Adventurer ✨</span>
                    </button>
                    <button class="btn-story btn-story-coral cancel-adv-btn" type="button" @onclick="ToggleNewProfileForm">
                        <span>Cancel</span>
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Active Profile Badges Showcase -->
    @if (ProgressService.ActiveProfile != null)
    {
        <div class="storybook-card badges-card">
            <h3 class="badges-title">
                🏆 @ProgressService.ActiveProfile.Name's Badges (@ProgressService.ActiveProfile.Badges.Count unlocked)
            </h3>
            <div class="badges-grid">
                <div class="badge-item">
                    <span class="badge-icon">🌟</span>
                    <span>First Step</span>
                </div>
                @if (ProgressService.ActiveProfile.Badges.Contains("star_collector_10"))
                {
                    <div class="badge-item" style="background:#FFF3B0;">
                        <span class="badge-icon">⭐</span>
                        <span>10 Stars</span>
                    </div>
                }
                @if (ProgressService.ActiveProfile.Badges.Contains("star_champion_50"))
                {
                    <div class="badge-item" style="background:#FFF3B0;">
                        <span class="badge-icon">👑</span>
                        <span>50 Stars</span>
                    </div>
                }
                @if (ProgressService.ActiveProfile.Badges.Contains("phonics_star"))
                {
                    <div class="badge-item" style="background:#D8F3DC;">
                        <span class="badge-icon">🏝️</span>
                        <span>Phonics Star</span>
                    </div>
                }
                @if (ProgressService.ActiveProfile.Badges.Contains("word_wizard"))
                {
                    <div class="badge-item" style="background:#E0AAFF;">
                        <span class="badge-icon">🌲</span>
                        <span>Word Wizard</span>
                    </div>
                }
                @if (ProgressService.ActiveProfile.Badges.Contains("number_ninja"))
                {
                    <div class="badge-item" style="background:#CAF0F8;">
                        <span class="badge-icon">🔢</span>
                        <span>Number Whiz</span>
                    </div>
                }
                @if (ProgressService.ActiveProfile.Badges.Contains("story_teller"))
                {
                    <div class="badge-item" style="background:#FFD6A5;">
                        <span class="badge-icon">🏰</span>
                        <span>Story Teller</span>
                    </div>
                }
            </div>
        </div>
    }
</div>

<style>
    .profile-page-container {
        display: flex;
        flex-direction: column;
        gap: clamp(1rem, 2.5vw, 1.5rem);
        width: 100%;
        max-width: 960px;
        margin: 0 auto;
        box-sizing: border-box;
    }

    .profile-header-card {
        background: var(--color-sunny-yellow);
        text-align: center;
        padding: clamp(1rem, 2vw, 1.5rem);
    }

    .profile-header-title {
        font-size: clamp(1.4rem, 3.5vw, 2rem);
        margin-bottom: 0.25rem;
    }

    .profile-header-sub {
        font-size: clamp(0.95rem, 2vw, 1.1rem);
        font-weight: 700;
        margin: 0;
    }

    /* Grid of profile slots: 2 cols on phone, 4 on tablet & up */
    .profiles-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: clamp(0.75rem, 2vw, 1rem);
    }

    @@media (min-width: 768px) {
        .profiles-grid {
            grid-template-columns: repeat(4, 1fr);
        }
    }

    .profile-slot-card {
        text-align: center;
        cursor: pointer;
        background: var(--color-cream-paper);
        border: var(--border-ink-thick);
        border-radius: var(--border-radius-md);
        box-shadow: var(--shadow-chunky-sm);
        padding: clamp(0.75rem, 2vw, 1.25rem) 0.5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        touch-action: manipulation;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    @@media (hover: hover) and (pointer: fine) {
        .profile-slot-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-chunky-md);
        }
    }

    .slot-active {
        border-color: var(--color-mint);
        background: #E8FBF4;
    }

    .profile-avatar-emoji {
        font-size: clamp(2.5rem, 6vw, 3.5rem);
        margin-bottom: 0.35rem;
    }

    .profile-name-text {
        font-size: clamp(1.1rem, 2.5vw, 1.3rem);
        margin-bottom: 0.25rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 100%;
    }

    .profile-stats-pill {
        font-weight: 700;
        color: var(--color-coral);
        font-size: 0.85rem;
        margin-bottom: 0.4rem;
    }

    .profile-time-text {
        font-size: 0.8rem;
        color: var(--color-storybook-ink);
        opacity: 0.8;
        margin-bottom: 0.65rem;
    }

    .status-pill-active {
        background: var(--color-mint);
        color: var(--color-storybook-ink);
        border-color: var(--color-storybook-ink);
        font-size: 0.85rem;
        min-height: 36px;
    }

    .status-pill-switch {
        background: white;
        font-size: 0.85rem;
        min-height: 36px;
    }

    .add-profile-slot {
        border-style: dashed;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        min-height: 200px;
        touch-action: manipulation;
    }

    .add-plus-icon {
        font-size: clamp(2rem, 5vw, 3rem);
        color: var(--color-sky-blue);
    }

    .add-title-text {
        font-size: 1.15rem;
        color: var(--color-sky-blue);
    }

    .add-slots-rem {
        font-size: 0.85rem;
        margin: 0;
    }

    .new-profile-card {
        background: #FFF3B0;
    }

    .new-profile-title {
        font-size: 1.4rem;
        margin-bottom: 1rem;
    }

    .new-profile-form-body {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        max-width: 520px;
    }

    .form-field-label {
        font-family: var(--font-heading);
        font-weight: 700;
        display: block;
        margin-bottom: 0.35rem;
    }

    .profile-name-input {
        width: 100%;
        padding: 0.65rem 1rem;
        font-size: 16px !important;
        border-width: 2.5px;
        min-height: var(--tap-min);
        box-sizing: border-box;
    }

    /* Avatar Picker: 2 cols on phone, 4 on tablet & up */
    .avatar-picker-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }

    @@media (min-width: 600px) {
        .avatar-picker-grid {
            grid-template-columns: repeat(4, 1fr);
        }
    }

    .avatar-choice-btn {
        min-height: var(--tap-min);
        min-width: var(--tap-min);
        padding: 0.5rem 0.6rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.2rem;
        background: white;
        border: 2px solid var(--color-storybook-ink);
        box-sizing: border-box;
    }

    .avatar-choice-emoji {
        font-size: 1.8rem;
    }

    .avatar-choice-name {
        font-size: 0.85rem;
        font-weight: 700;
    }

    .avatar-selected {
        background: var(--color-mint) !important;
        box-shadow: 0 3px 0 var(--color-storybook-ink);
    }

    .form-actions-row {
        display: flex;
        gap: 12px;
        margin-top: 0.5rem;
        flex-wrap: wrap;
    }

    .save-adv-btn, .cancel-adv-btn {
        min-height: var(--tap-min);
        min-width: var(--tap-min);
        font-size: 1rem !important;
        padding: 0.65rem 1.4rem !important;
    }

    .badges-card {
        background: white;
    }

    .badges-title {
        font-size: clamp(1.15rem, 2.5vw, 1.4rem);
        margin-bottom: 1rem;
    }

    .badges-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
        gap: 0.75rem;
    }
</style>

@code {
    private bool showNewForm = false;
    private string newName = "";
    private AvatarType newAvatar = AvatarType.VoxieChameleon;
    private int newAge = 6;

    private void ToggleNewProfileForm()
    {
        showNewForm = !showNewForm;
    }

    private async Task SelectProfile(string profileId)
    {
        await AudioService.PlaySoundAsync(SoundEffect.Pop);
        await ProgressService.SelectProfileAsync(profileId);
    }

    private async Task CreateProfile()
    {
        if (string.IsNullOrWhiteSpace(newName))
        {
            newName = "Adventurer " + (ProgressService.Profiles.Count + 1);
        }

        await AudioService.PlaySoundAsync(SoundEffect.SuccessChime);
        await ProgressService.CreateProfileAsync(newName, newAvatar, newAge);
        newName = "";
        showNewForm = false;
    }

    private static string GetAvatarEmoji(AvatarType avatar) => avatar switch
    {
        AvatarType.LeoLion => "🦁",
        AvatarType.PipPenguin => "🐧",
        AvatarType.MiaMonkey => "🐵",
        _ => "🦎"
    };
}
