@page "/classroom"
@page "/teacher"
@inject IClassroomService Classroom
@inject NavigationManager Navigation
@inject IAudioService AudioService

<div class="classroom-hub-container">
    <!-- Header Hero Card -->
    <div class="storybook-card classroom-hero-card">
        <div class="hero-header-flex">
            <div class="hero-title-group">
                <div class="hero-icon-title">
                    <HouseIcon Size="40" RoofColor="#5BC0EB" WallColor="#FFF8E7" DoorColor="#FFC93C" />
                    <h2 class="hero-main-title">Classroom Adventure</h2>
                </div>
                <p class="hero-description">
                    Play together with your class! Safe, private fun with zero passwords and zero emails.
                </p>
            </div>
            <a href="" class="pill hero-back-pill" title="Return to home">
                <ArrowBackIcon Size="20" />
                <span>Home</span>
            </a>
        </div>
    </div>

    <!-- Student Quick-Join Portal (Top for Easy Child Access) -->
    <div class="storybook-card student-join-card">
        <div class="student-join-inner">
            <div class="backpack-icon-wrap">
                <BackpackIcon Size="56" />
            </div>
            <h3 class="join-heading">Team Room Code</h3>
            <p class="join-instructions">
                Type the code from your teacher's board to join your class adventure!
            </p>

            <div class="code-entry-row">
                <input type="text" 
                       class="classroom-code-input" 
                       placeholder="OAK-742" 
                       maxlength="10" 
                       @bind="studentInputCode" 
                       @bind:event="oninput" 
                       aria-label="Enter Classroom Code" />

                <div class="join-btn-wrap">
                    <BouncyButton Variant="BouncyButton.ButtonVariant.Yellow" 
                                  Text="Join Team" 
                                  Disabled="@string.IsNullOrWhiteSpace(studentInputCode)"
                                  OnClick="HandleStudentJoin">
                        <IconTemplate><NextIcon Size="22" /></IconTemplate>
                    </BouncyButton>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(joinErrorMessage))
            {
                <div class="join-error-pill animate-pop">
                    <CrossIcon Size="20" BgColor="#FF6B6B" BorderColor="#2B2D42" CrossColor="#FFF8E7" />
                    <span>@joinErrorMessage</span>
                </div>
            }
        </div>
    </div>

    <!-- Teacher Station Management Section -->
    <div class="storybook-card teacher-station-card">
        <div class="teacher-header-row">
            <div>
                <h3 class="teacher-title">
                    <FoxieFaceIcon Size="32" />
                    <span>Teacher Station &amp; Room Creator</span>
                </h3>
                <p class="teacher-subtitle">
                    Start a class adventure! Code stays active while your class is playing.
                </p>
            </div>

            @if (activeTeacherRoom == null)
            {
                <BouncyButton Variant="BouncyButton.ButtonVariant.Mint" 
                              Text="Start Class Adventure" 
                              OnClick="CreateNewClassroomPod">
                    <IconTemplate><StarIcon Size="22" FillColor="#FFC93C" /></IconTemplate>
                </BouncyButton>
            }
        </div>

        @if (activeTeacherRoom != null)
        {
            <!-- Active Pod Live Dashboard -->
            <div class="active-pod-banner">
                <div class="pod-code-display">
                    <span class="code-label">BOARD ROOM CODE:</span>
                    <span class="code-value">@activeTeacherRoom.RoomCode</span>
                </div>

                <div class="pod-meta-info">
                    <div><strong>Today's Adventure:</strong> @activeTeacherRoom.ScenarioName</div>
                    <div><strong>Game:</strong> @activeTeacherRoom.TargetGameTitle</div>
                    <div><strong>Teams Playing:</strong> @activeTeacherRoom.ConnectedStations.Count Teams</div>
                </div>

                <button class="pill close-pod-btn" type="button" @onclick="CloseActivePod">
                    <span>Finish Class Session ✕</span>
                </button>
            </div>

            <!-- Group Debrief Discussion Cards -->
            <div class="debrief-section">
                <h4 class="debrief-heading">
                    <HintBulbIcon Size="24" />
                    <span>Class Circle Sharing Questions</span>
                </h4>
                <div class="debrief-cards-grid">
                    @foreach (var prompt in Classroom.GetDiscussionCards(activeTeacherRoom.TargetGameId))
                    {
                        <div class="debrief-card storybook-card">
                            <span class="card-quote-mark">“</span>
                            <p class="card-prompt-text">@prompt</p>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <!-- Scenario Selector Guide -->
            <div class="scenario-selector-grid">
                <div class="scenario-card storybook-card" @onclick='() => SetSelectedScenario("beacon-bridge", "Team Light Quest", "Optics & Light Refraction")'>
                    <div class="scenario-icon-box">
                        <BeaconIcon Size="44" />
                    </div>
                    <h4 class="scenario-title">Team Light Quest</h4>
                    <p class="scenario-desc">Physics &amp; Teamwork: 2-player light mirrors guiding ships safely home.</p>
                </div>

                <div class="scenario-card storybook-card" @onclick='() => SetSelectedScenario("tumble-scale", "Island Balance", "Mathematical Lever Torque & Fractions")'>
                    <div class="scenario-icon-box">
                        <ScaleIcon Size="44" />
                    </div>
                    <h4 class="scenario-title">Island Balance</h4>
                    <p class="scenario-desc">Maths &amp; Balance: Coconut and fruit weights on a friendly island seesaw.</p>
                </div>

                <div class="scenario-card storybook-card" @onclick='() => SetSelectedScenario("mood-garden", "Mood Garden Sanctuary", "Emotional Self-Regulation & Breath Pacing")'>
                    <div class="scenario-icon-box">
                        <LotusIcon Size="44" />
                    </div>
                    <h4 class="scenario-title">Mood Garden Sanctuary</h4>
                    <p class="scenario-desc">Social-Emotional: Gentle calm breathing and warm sunshine for baby animals.</p>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .classroom-hub-container {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        max-width: 960px;
        margin: 0 auto;
        padding-bottom: 2rem;
        width: 100%;
        box-sizing: border-box;
    }

    .classroom-hero-card {
        background: var(--color-paper-light);
        border: var(--border-storybook);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-hard-md);
        padding: clamp(1.2rem, 3vw, 1.8rem);
        border-top: 8px solid var(--color-sky-blue);
    }

    .hero-header-flex {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .hero-icon-title {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        margin-bottom: 0.25rem;
    }

    .hero-main-title {
        font-family: var(--font-heading);
        font-size: clamp(1.6rem, 3.5vw, 2.2rem);
        margin: 0;
        color: var(--color-storybook-ink);
    }

    .hero-description {
        font-family: var(--font-body);
        font-size: 1.15rem;
        font-weight: 700;
        margin: 0;
        color: var(--color-storybook-ink);
        opacity: 0.9;
    }

    .hero-back-pill {
        background: #FFFFFF;
        color: var(--color-storybook-ink);
        font-family: var(--font-heading);
        font-weight: 700;
        font-size: 1rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.4rem 0.9rem;
        border: var(--border-storybook);
        border-radius: var(--radius-pill);
        box-shadow: var(--shadow-hard-sm);
    }

    /* Student Join Card */
    .student-join-card {
        background: #FFFFFF;
        border: var(--border-storybook);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-hard-md);
        padding: clamp(1.5rem, 4vw, 2.5rem);
        border-top: 8px solid var(--color-sunny-yellow);
    }

    .student-join-inner {
        text-align: center;
        max-width: 520px;
        margin: 0 auto;
    }

    .backpack-icon-wrap {
        display: inline-flex;
        margin-bottom: 0.5rem;
        animation: gentle-wobble 2.5s infinite ease-in-out;
    }

    .join-heading {
        font-family: var(--font-heading);
        font-size: clamp(1.4rem, 3vw, 1.8rem);
        margin: 0 0 0.35rem 0;
        color: var(--color-storybook-ink);
    }

    .join-instructions {
        font-family: var(--font-body);
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--color-storybook-ink);
        opacity: 0.85;
        margin: 0 0 1.25rem 0;
    }

    /* Code Entry Form: Single Row >= 360px */
    .code-entry-row {
        display: flex;
        flex-direction: row;
        align-items: stretch;
        justify-content: center;
        gap: 0.75rem;
        width: 100%;
        max-width: 440px;
        margin: 0 auto;
    }

    .classroom-code-input {
        flex: 1;
        min-width: 0;
        height: 64px;
        font-family: var(--font-heading);
        font-size: 1.5rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 4px;
        text-align: center;
        background: var(--color-paper-light, #FFF8E7);
        border: var(--border-storybook, 4px solid #2B2D42);
        border-radius: var(--radius-md, 16px);
        box-shadow: var(--shadow-hard-sm, 3px 3px 0 #2B2D42);
        color: var(--color-storybook-ink);
        box-sizing: border-box;
        outline: none;
        transition: border-color 0.15s ease;
    }

    .classroom-code-input:focus {
        border-color: var(--color-sky-blue);
    }

    .join-btn-wrap {
        flex-shrink: 0;
        height: 64px;
        display: flex;
    }

    .join-btn-wrap ::deep button {
        height: 64px !important;
        min-height: 64px !important;
        padding: 0 1.5rem !important;
        font-size: 1.2rem !important;
    }

    .join-error-pill {
        margin-top: 1rem;
        background: #FEE2E2;
        border: 3px solid #DC2626;
        border-radius: var(--radius-pill);
        padding: 0.45rem 1rem;
        font-family: var(--font-body);
        font-size: 1rem;
        font-weight: 700;
        color: #991B1B;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    /* Teacher Station */
    .teacher-station-card {
        background: #FFFFFF;
        border: var(--border-storybook);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-hard-md);
        padding: clamp(1.2rem, 3vw, 1.8rem);
        border-top: 8px solid var(--color-mint);
    }

    .teacher-header-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 1.25rem;
    }

    .teacher-title {
        font-family: var(--font-heading);
        font-size: 1.4rem;
        font-weight: 700;
        color: var(--color-storybook-ink);
        margin: 0 0 0.25rem 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .teacher-subtitle {
        font-family: var(--font-body);
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--color-storybook-ink);
        opacity: 0.8;
        margin: 0;
    }

    /* Active Pod Banner */
    .active-pod-banner {
        background: #DCFCE7;
        border: var(--border-storybook);
        border-radius: var(--radius-lg);
        padding: 1.25rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
        box-shadow: var(--shadow-hard-md);
    }

    .pod-code-display {
        display: flex;
        flex-direction: column;
    }

    .code-label {
        font-family: var(--font-heading);
        font-size: 0.85rem;
        font-weight: 700;
        color: #166534;
        letter-spacing: 0.05em;
    }

    .code-value {
        font-family: var(--font-heading);
        font-size: 2.2rem;
        font-weight: 700;
        color: #15803D;
        letter-spacing: 0.08em;
    }

    .pod-meta-info {
        font-family: var(--font-body);
        font-size: 1.1rem;
        font-weight: 700;
        line-height: 1.5;
        color: var(--color-storybook-ink);
    }

    .close-pod-btn {
        background: #FEE2E2;
        color: #991B1B;
        border: var(--border-storybook);
        border-radius: var(--radius-pill);
        padding: 0.5rem 1rem;
        font-family: var(--font-heading);
        font-weight: 700;
        cursor: pointer;
        box-shadow: var(--shadow-hard-sm);
    }

    /* Debrief Section */
    .debrief-section {
        margin-top: 1.5rem;
    }

    .debrief-heading {
        font-family: var(--font-heading);
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--color-storybook-ink);
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0 0 1rem 0;
    }

    .debrief-cards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 1rem;
    }

    .debrief-card {
        background: var(--color-paper-light);
        border: var(--border-storybook);
        border-radius: var(--radius-md);
        padding: 1rem;
        box-shadow: var(--shadow-hard-sm);
    }

    .card-quote-mark {
        font-family: var(--font-heading);
        font-size: 2.2rem;
        color: var(--color-sunny-yellow);
        line-height: 0.8;
        display: block;
    }

    .card-prompt-text {
        font-family: var(--font-body);
        font-size: 1.05rem;
        font-weight: 700;
        line-height: 1.45;
        color: var(--color-storybook-ink);
        margin: 0.25rem 0 0 0;
    }

    /* Scenario Selection Cards */
    .scenario-selector-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 1.25rem;
    }

    .scenario-card {
        background: #FFFFFF;
        border: var(--border-storybook);
        border-radius: var(--radius-lg);
        padding: 1.25rem;
        cursor: pointer;
        box-shadow: var(--shadow-hard-md);
        transition: transform 0.15s ease, box-shadow 0.15s ease;
        touch-action: manipulation;
    }

    .scenario-card:hover {
        transform: translateY(-3px);
        box-shadow: var(--shadow-hard-lg);
    }

    .scenario-icon-box {
        margin-bottom: 0.5rem;
    }

    .scenario-title {
        font-family: var(--font-heading);
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--color-storybook-ink);
        margin: 0 0 0.35rem 0;
    }

    .scenario-desc {
        font-family: var(--font-body);
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--color-storybook-ink);
        opacity: 0.85;
        margin: 0;
        line-height: 1.4;
    }

    @@keyframes gentle-wobble {
        0%, 100% { transform: translateY(0) rotate(0deg); }
        50% { transform: translateY(-4px) rotate(2deg); }
    }
</style>

@code {
    private string studentInputCode = string.Empty;
    private string? joinErrorMessage;

    private ClassroomRoom? activeTeacherRoom;
    private string selectedGameId = "beacon-bridge";
    private string selectedGameTitle = "Team Light Quest";
    private string selectedScenario = "Optics & Light Refraction";

    private async Task SetSelectedScenario(string id, string title, string scenario)
    {
        selectedGameId = id;
        selectedGameTitle = title;
        selectedScenario = scenario;
        await CreateNewClassroomPod();
    }

    private async Task CreateNewClassroomPod()
    {
        activeTeacherRoom = await Classroom.CreateRoomAsync(
            selectedGameId, 
            selectedGameTitle, 
            selectedScenario, 
            "Guided peer exploration session."
        );
        await AudioService.PlaySoundAsync(SoundEffect.SuccessChime);
        StateHasChanged();
    }

    private async Task CloseActivePod()
    {
        if (activeTeacherRoom != null)
        {
            await Classroom.CloseRoomAsync(activeTeacherRoom.RoomCode);
            activeTeacherRoom = null;
            await AudioService.PlaySoundAsync(SoundEffect.Pop);
            StateHasChanged();
        }
    }

    private async Task HandleStudentJoin()
    {
        joinErrorMessage = null;
        if (string.IsNullOrWhiteSpace(studentInputCode)) return;

        var room = await Classroom.GetRoomAsync(studentInputCode);
        if (room != null)
        {
            await AudioService.PlaySoundAsync(SoundEffect.Fanfare);
            Navigation.NavigateTo($"games/{room.TargetGameId}");
        }
        else
        {
            joinErrorMessage = $"Room code '{studentInputCode.Trim().ToUpperInvariant()}' not found or has ended. Ask your teacher!";
            await AudioService.PlaySoundAsync(SoundEffect.EncourageChime);
        }
    }
}
