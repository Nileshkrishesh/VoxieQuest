@code {
    private Mascot.MascotState mascotState = Mascot.MascotState.Idle;
    private float currentVolume = 0.0f;
    private bool isTestingMic = false;

    protected override void OnInitialized()
    {
        VoiceService.OnVolumeChanged += HandleVolumeChanged;
    }

    private void HandleVolumeChanged(float vol)
    {
        currentVolume = vol;
        InvokeAsync(StateHasChanged);
    }

    private int GetActiveMicStars()
    {
        if (currentVolume < 0.05f) return 0;
        if (currentVolume < 0.18f) return 1;
        if (currentVolume < 0.35f) return 2;
        if (currentVolume < 0.55f) return 3;
        if (currentVolume < 0.75f) return 4;
        return 5;
    }

    private int GetGameStars(SkillCategory category)
    {
        if (ProgressService.ActiveProfile?.SkillProgressMap.TryGetValue(category, out var progress) == true)
        {
            if (progress.Correct >= 8) return 3;
            if (progress.Correct >= 3) return 2;
            if (progress.Attempts >= 1) return 1;
        }
        // Base encouragement level for all adventurers
        return 1;
    }

    private async Task HearVoxieWelcome()
    {
        mascotState = Mascot.MascotState.Happy;
        await AudioService.PlaySoundAsync(SoundEffect.Pop);
        await VoiceService.SpeakAsync("Ready to speak, play, and win stars?");
        await Task.Delay(1800);
        mascotState = Mascot.MascotState.Idle;
    }

    private async Task ToggleMicTest()
    {
        if (isTestingMic)
        {
            isTestingMic = false;
            await VoiceService.StopListeningAsync();
            currentVolume = 0.0f;
            mascotState = Mascot.MascotState.Idle;
        }
        else
        {
            isTestingMic = true;
            await AudioService.PlaySoundAsync(SoundEffect.Click);
            await VoiceService.StartListeningAsync();
            mascotState = Mascot.MascotState.Listening;
        }
    }

    private async Task NavigateTo(string page)
    {
        if (isTestingMic)
        {
            await VoiceService.StopListeningAsync();
            isTestingMic = false;
        }
        await AudioService.PlaySoundAsync(SoundEffect.Click);
        Navigation.NavigateTo(page);
    }

    public void Dispose()
    {
        VoiceService.OnVolumeChanged -= HandleVolumeChanged;
        if (isTestingMic)
        {
            _ = VoiceService.StopListeningAsync();
        }
    }
}
