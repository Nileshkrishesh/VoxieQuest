@page "/"
@page "/home"
@inject IProgressService ProgressService
@inject IVoiceService VoiceService
@inject IAudioService AudioService
@inject NavigationManager Navigation
@implements IDisposable

<div class="home-container">
    <!-- Top Welcome Hero Card -->
    <div class="storybook-card hero-welcome-card">
        <div class="hero-flex">
            <!-- Animated Voxie Mascot -->
            <div class="mascot-interactive" @onclick="HearVoxieWelcome" title="Tap Voxie to hear greeting!">
                <Mascot State="@mascotState" Width="130" Height="130" />
                <span class="tap-hint-pill">Tap Voxie!</span>
            </div>

            <!-- Welcoming Speech Bubble with Pointing Tail and Under 10 Words (No Quotes) -->
            <div class="hero-speech-container">
                <div class="speech-bubble-handdrawn">
                    <!-- Bubble tail pointing directly to Voxie Mascot -->
                    <div class="bubble-tail-left" aria-hidden="true"></div>
                    
                    <span class="bubble-text">
                        Ready to speak, play, and win stars?
                    </span>
                </div>

                <div class="hero-action-buttons">
                    <button class="btn-story btn-story-yellow hero-voice-btn" @onclick="HearVoxieWelcome" type="button">
                        <SpeakerIcon Size="22" IsMuted="false" FillColor="#FFFDF7" />
                        <span>Hear Voxie Speak!</span>
                    </button>
                    <button class="btn-story btn-story-coral hero-play-btn" @onclick='() => NavigateTo("game/letter-rocket")' type="button">
                        <RocketIcon Size="24" />
                        <span>Quick Play!</span>
                    </button>
                </div>
            </div>

            <!-- Live Wobbly Mic Buddy Widget with 5 Star Volume Lights (No Grey Bar) -->
            <div class="mic-live-widget @(isTestingMic ? "mic-widget-listening" : "")" 
                 @onclick="ToggleMicTest" 
                 title="Tap to test microphone!">
                <MicCharacter VolumeLevel="@currentVolume" 
                              IsListening="@isTestingMic" 
                              Size="105" 
                              ShowVolumeBar="false" />
                
                <!-- 5 Star Shapes Lighting up with Live Volume -->
                <div class="mic-volume-stars-row" title="Voice loudness volume stars">
                    @for (int s = 1; s <= 5; s++)
                    {
                        var isStarLit = s <= GetActiveMicStars();
                        <div class="mic-volume-star @(isStarLit ? "star-lit" : "star-unlit")">
                            <StarIcon Size="22" 
                                      IsActive="@isStarLit" 
                                      FillColor="#FFD166" 
                                      InactiveColor="#CBD5E1" />
                        </div>
                    }
                </div>

                <span class="mic-status-label">
                    @(isTestingMic ? "I'm listening! Speak aloud!" : "Tap to test your voice!")
                </span>
            </div>
        </div>
    </div>

    <!-- Section Heading: Pick a Game -->
    <div class="section-title-bar">
        <div class="title-with-icon">
            <GameControllerIcon Size="34" BodyColor="#FFD166" />
            <h2 class="title-fun">Pick a Game &amp; Speak!</h2>
        </div>
        <span class="title-sub">Tap any quest below to start playing aloud</span>
    </div>

    <!-- 5 Super-Fun Voice Games Responsive Grid (3 cols on laptop, 2 on tablet, 1 on phone) -->
    <div class="games-grid">
        <!-- Game 1: Letter Rocket -->
        <div class="game-card game-card-space" @onclick='() => NavigateTo("game/letter-rocket")'>
            <div class="card-badge">
                <StarIcon Size="16" FillColor="#FFD166" />
                <span>Letters &amp; Phonics</span>
            </div>
            
            <div class="card-icon-stage anim-float-slow">
                <RocketIcon Size="72" />
            </div>

            <h3 class="card-title">Letter Rocket</h3>
            <p class="card-desc">Shout the letter to launch the rocket into the starry galaxy!</p>
            
            <!-- Big Star-Progress Row Under Game -->
            <div class="game-star-progress-row" title="Explorer Mastery Stars">
                <span class="progress-label">Progress:</span>
                <div class="stars-trio">
                    <StarIcon Size="28" IsActive="@(GetGameStars(SkillCategory.Letters) >= 1)" FillColor="#FFD166" />
                    <StarIcon Size="28" IsActive="@(GetGameStars(SkillCategory.Letters) >= 2)" FillColor="#FFD166" />
                    <StarIcon Size="28" IsActive="@(GetGameStars(SkillCategory.Letters) >= 3)" FillColor="#FFD166" />
                </div>
            </div>

            <div class="card-footer">
                <span class="card-rounds">10 Rounds</span>
                <button class="btn-story btn-story-blue card-btn" type="button">
                    <span>Play ➔</span>
                </button>
            </div>
        </div>

        <!-- Game 2: Number Jump -->
        <div class="game-card game-card-pond" @onclick='() => NavigateTo("game/number-jump")'>
            <div class="card-badge">
                <StarIcon Size="16" FillColor="#FFD166" />
                <span>Counting &amp; Math</span>
            </div>
            
            <div class="card-icon-stage anim-float-mid">
                <FrogIcon Size="72" />
            </div>

            <h3 class="card-title">Number Jump</h3>
            <p class="card-desc">Say the magic sum number to help froggy leap across lily pads!</p>
            
            <!-- Big Star-Progress Row Under Game -->
            <div class="game-star-progress-row" title="Explorer Mastery Stars">
                <span class="progress-label">Progress:</span>
                <div class="stars-trio">
                    <StarIcon Size="28" IsActive="@(GetGameStars(SkillCategory.Numbers) >= 1)" FillColor="#FFD166" />
                    <StarIcon Size="28" IsActive="@(GetGameStars(SkillCategory.Numbers) >= 2)" FillColor="#FFD166" />
                    <StarIcon Size="28" IsActive="@(GetGameStars(SkillCategory.Numbers) >= 3)" FillColor="#FFD166" />
                </div>
            </div>

            <div class="card-footer">
                <span class="card-rounds">10 Rounds</span>
                <button class="btn-story btn-story-mint card-btn" type="button">
                    <span>Hop ➔</span>
                </button>
            </div>
        </div>

        <!-- Game 3: Color Splash -->
        <div class="game-card game-card-paint" @onclick='() => NavigateTo("game/color-splash")'>
            <div class="card-badge">
                <StarIcon Size="16" FillColor="#FFD166" />
                <span>Rainbow Colors</span>
            </div>
            
            <div class="card-icon-stage anim-float-slow">
                <PaletteIcon Size="72" />
            </div>

            <h3 class="card-title">Color Splash</h3>
            <p class="card-desc">Speak the color name to splash magical paint onto cartoon pictures!</p>
            
            <!-- Big Star-Progress Row Under Game -->
            <div class="game-star-progress-row" title="Explorer Mastery Stars">
                <span class="progress-label">Progress:</span>
                <div class="stars-trio">
                    <StarIcon Size="28" IsActive="@(GetGameStars(SkillCategory.Colors) >= 1)" FillColor="#FFD166" />
                    <StarIcon Size="28" IsActive="@(GetGameStars(SkillCategory.Colors) >= 2)" FillColor="#FFD166" />
                    <StarIcon Size="28" IsActive="@(GetGameStars(SkillCategory.Colors) >= 3)" FillColor="#FFD166" />
                </div>
            </div>

            <div class="card-footer">
                <span class="card-rounds">10 Rounds</span>
                <button class="btn-story btn-story-yellow card-btn" type="button">
                    <span>Splash ➔</span>
                </button>
            </div>
        </div>

        <!-- Game 4: Animal Safari -->
        <div class="game-card game-card-safari" @onclick='() => NavigateTo("game/animal-safari")'>
            <div class="card-badge">
                <StarIcon Size="16" FillColor="#FFD166" />
                <span>Animals &amp; Sounds</span>
            </div>
            
            <div class="card-icon-stage anim-float-mid">
                <SafariIcon Size="72" />
            </div>

            <h3 class="card-title">Animal Safari</h3>
            <p class="card-desc">Hear the animal sound &amp; call their name to invite them on the bus!</p>
            
            <!-- Big Star-Progress Row Under Game -->
            <div class="game-star-progress-row" title="Explorer Mastery Stars">
                <span class="progress-label">Progress:</span>
                <div class="stars-trio">
                    <StarIcon Size="28" IsActive="@(GetGameStars(SkillCategory.Animals) >= 1)" FillColor="#FFD166" />
                    <StarIcon Size="28" IsActive="@(GetGameStars(SkillCategory.Animals) >= 2)" FillColor="#FFD166" />
                    <StarIcon Size="28" IsActive="@(GetGameStars(SkillCategory.Animals) >= 3)" FillColor="#FFD166" />
                </div>
            </div>

            <div class="card-footer">
                <span class="card-rounds">10 Rounds</span>
                <button class="btn-story btn-story-coral card-btn" type="button">
                    <span>Safari ➔</span>
                </button>
            </div>
        </div>

        <!-- Game 5: Word Builder -->
        <div class="game-card game-card-blocks" @onclick='() => NavigateTo("game/word-builder")'>
            <div class="card-badge">
                <StarIcon Size="16" FillColor="#FFD166" />
                <span>Spelling &amp; Toys</span>
            </div>
            
            <div class="card-icon-stage anim-float-slow">
                <BlocksIcon Size="72" />
            </div>

            <h3 class="card-title">Word Builder</h3>
            <p class="card-desc">Say the word to snap blocks together and unlock surprise animated toys!</p>
            
            <!-- Big Star-Progress Row Under Game -->
            <div class="game-star-progress-row" title="Explorer Mastery Stars">
                <span class="progress-label">Progress:</span>
                <div class="stars-trio">
                    <StarIcon Size="28" IsActive="@(GetGameStars(SkillCategory.Spelling) >= 1)" FillColor="#FFD166" />
                    <StarIcon Size="28" IsActive="@(GetGameStars(SkillCategory.Spelling) >= 2)" FillColor="#FFD166" />
                    <StarIcon Size="28" IsActive="@(GetGameStars(SkillCategory.Spelling) >= 3)" FillColor="#FFD166" />
                </div>
            </div>

            <div class="card-footer">
                <span class="card-rounds">10 Rounds</span>
                <button class="btn-story btn-story-orange card-btn" type="button">
                    <span>Build ➔</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Quick Rewards Strip -->
    <div class="rewards-strip">
        <div class="reward-strip-card" @onclick='() => NavigateTo("garden")'>
            <FlowerIcon Size="36" PetalColor="#06D6A0" CenterColor="#FFD166" />
            <div>
                <h4 class="strip-title">Skill Garden</h4>
                <p class="strip-desc">Water your growing flowers with stars!</p>
            </div>
            <span class="strip-arrow">➔</span>
        </div>

        <div class="reward-strip-card" @onclick='() => NavigateTo("stickers")'>
            <StarIcon Size="36" FillColor="#FFD166" />
            <div>
                <h4 class="strip-title">Sticker Album</h4>
                <p class="strip-desc">Peel and stick your shiny badges!</p>
            </div>
            <span class="strip-arrow">➔</span>
        </div>

        <div class="reward-strip-card" @onclick='() => NavigateTo("trophies")'>
            <TrophyIcon Size="36" CupColor="#FFD166" />
            <div>
                <h4 class="strip-title">Trophy Shelf</h4>
                <p class="strip-desc">Admire your gold explorer cups!</p>
            </div>
            <span class="strip-arrow">➔</span>
        </div>
    </div>
</div>

<style>
    .home-container {
        display: flex;
        flex-direction: column;
        gap: 1.75rem;
    }

    /* Hero Card with subtle paper texture */
    .hero-welcome-card {
        background: linear-gradient(135deg, #FFFDF7 0%, #FFF3B0 55%, #FFE5EC 100%);
        background-image: 
            radial-gradient(rgba(43, 45, 66, 0.04) 1.5px, transparent 1.5px),
            linear-gradient(135deg, #FFFDF7 0%, #FFF3B0 55%, #FFE5EC 100%);
        background-size: 24px 24px, 100% 100%;
        border: 4px solid var(--color-storybook-ink);
        border-radius: 28px;
        box-shadow: 0 8px 0 var(--color-storybook-ink);
        padding: 1.5rem 2rem;
    }

    .hero-flex {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        flex-wrap: wrap;
    }

    .mascot-interactive {
        display: flex;
        flex-direction: column;
        align-items: center;
        cursor: pointer;
        transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .mascot-interactive:hover {
        transform: scale(1.08) rotate(-2deg);
    }

    .tap-hint-pill {
        background: var(--color-sunny-yellow);
        border: 2.5px solid var(--color-storybook-ink);
        border-radius: 999px;
        padding: 0.2rem 0.65rem;
        font-family: var(--font-heading);
        font-size: 0.8rem;
        font-weight: 800;
        margin-top: 0.25rem;
        box-shadow: 0 2px 0 var(--color-storybook-ink);
        color: var(--color-storybook-ink);
    }

    .hero-speech-container {
        flex: 1;
        min-width: 260px;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        position: relative;
    }

    /* Speech Bubble with Handdrawn Tail Pointing to Mascot (No Quote Marks) */
    .speech-bubble-handdrawn {
        position: relative;
        background: #FFFDF7;
        border: 4px solid var(--color-storybook-ink);
        border-radius: 24px;
        box-shadow: 0 6px 0 var(--color-storybook-ink);
        padding: 1.15rem 1.6rem;
    }

    .bubble-tail-left {
        position: absolute;
        left: -18px;
        top: 50%;
        transform: translateY(-50%);
        width: 0;
        height: 0;
        border-top: 12px solid transparent;
        border-bottom: 12px solid transparent;
        border-right: 18px solid var(--color-storybook-ink);
    }

    .bubble-tail-left::after {
        content: "";
        position: absolute;
        left: 4px;
        top: -9px;
        width: 0;
        height: 0;
        border-top: 9px solid transparent;
        border-bottom: 9px solid transparent;
        border-right: 15px solid #FFFDF7;
    }

    .bubble-text {
        font-family: var(--font-heading);
        font-size: 1.45rem;
        color: var(--color-storybook-ink);
        font-weight: 800;
        line-height: 1.35;
        display: block;
    }

    .hero-action-buttons {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .hero-voice-btn, .hero-play-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 1.1rem !important;
        padding: 0.65rem 1.25rem !important;
    }

    /* Mic Card with 5 Volume Stars and Real Wobble */
    .mic-live-widget {
        display: flex;
        flex-direction: column;
        align-items: center;
        background: #FFFFFF;
        border: 3.5px solid var(--color-storybook-ink);
        border-radius: 24px;
        padding: 0.85rem 1.25rem;
        box-shadow: 0 5px 0 var(--color-storybook-ink);
        cursor: pointer;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .mic-live-widget:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 0 var(--color-storybook-ink);
    }

    .mic-widget-listening {
        border-color: #06D6A0;
        box-shadow: 0 0 0 3px rgba(6, 214, 160, 0.4), 0 6px 0 var(--color-storybook-ink);
    }

    .mic-volume-stars-row {
        display: flex;
        gap: 0.35rem;
        align-items: center;
        justify-content: center;
        margin-top: 0.5rem;
        padding: 0.3rem 0.6rem;
        background: #F8FAFC;
        border: 2px solid var(--color-storybook-ink);
        border-radius: 999px;
    }

    .mic-volume-star {
        transition: transform 0.1s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .star-lit {
        transform: scale(1.22);
        animation: starPop 0.25s ease-out;
    }

    .star-unlit {
        opacity: 0.45;
        transform: scale(0.95);
    }

    @@keyframes starPop {
        0% { transform: scale(0.9); }
        50% { transform: scale(1.35); }
        100% { transform: scale(1.22); }
    }

    .mic-status-label {
        font-family: var(--font-heading);
        font-size: 0.85rem;
        font-weight: 800;
        color: var(--color-storybook-ink);
        margin-top: 0.4rem;
        text-align: center;
    }

    /* Section Heading */
    .section-title-bar {
        text-align: center;
        margin-top: 0.25rem;
    }

    .title-with-icon {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        justify-content: center;
    }

    .title-fun {
        font-size: 2.2rem;
        font-family: var(--font-heading);
        color: var(--color-storybook-ink);
        margin: 0;
        text-shadow: 2px 2px 0 #FFF9DB;
    }

    .title-sub {
        font-family: var(--font-body);
        font-size: 1.1rem;
        font-weight: 700;
        color: #64748B;
        display: block;
        margin-top: 0.25rem;
    }

    /* 
       RESPONSIVE GAMES GRID (Requirement 7)
       Laptop: 3 columns
       Tablet: 2 columns
       Phone: 1 column
    */
    .games-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
    }

    @@media (max-width: 960px) {
        .games-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 600px) {
        .games-grid {
            grid-template-columns: 1fr;
        }
    }

    /* Game Card with Paper Texture and Gentle Bounce */
    .game-card {
        border: 4px solid var(--color-storybook-ink);
        border-radius: 26px;
        box-shadow: 0 8px 0 var(--color-storybook-ink);
        padding: 1.5rem 1.25rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        cursor: pointer;
        position: relative;
        /* Gentle hover/press bounce (Requirement 6) */
        transition: transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.22s ease;
        /* Subtle paper texture overlay */
        background-image: 
            radial-gradient(rgba(43, 45, 66, 0.04) 1.5px, transparent 1.5px),
            radial-gradient(rgba(255, 255, 255, 0.6) 1.5px, transparent 1.5px);
        background-size: 20px 20px;
        background-position: 0 0, 10px 10px;
    }

    .game-card:hover {
        transform: translateY(-8px) scale(1.025);
        box-shadow: 0 14px 0 var(--color-storybook-ink);
    }

    .game-card:active {
        transform: translateY(3px) scale(0.98);
        box-shadow: 0 3px 0 var(--color-storybook-ink);
    }

    .game-card-space  { background-color: #BAE6FD; }
    .game-card-pond   { background-color: #A7F3D0; }
    .game-card-paint  { background-color: #FDE68A; }
    .game-card-safari { background-color: #FED7AA; }
    .game-card-blocks { background-color: #FBCFE8; }

    .card-badge {
        position: absolute;
        top: -14px;
        background: #FFFFFF;
        border: 2.5px solid var(--color-storybook-ink);
        border-radius: 999px;
        padding: 0.25rem 0.85rem;
        font-family: var(--font-heading);
        font-size: 0.84rem;
        font-weight: 800;
        box-shadow: 0 3px 0 var(--color-storybook-ink);
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
    }

    .card-icon-stage {
        margin-top: 0.5rem;
        margin-bottom: 0.5rem;
        filter: drop-shadow(0 3px 0 rgba(43, 45, 66, 0.2));
    }

    .card-title {
        font-family: var(--font-heading);
        font-size: 1.6rem;
        font-weight: 800;
        color: var(--color-storybook-ink);
        margin: 0 0 0.35rem 0;
    }

    .card-desc {
        font-family: var(--font-body);
        font-size: 0.98rem;
        font-weight: 700;
        color: #334155;
        line-height: 1.4;
        margin: 0 0 0.85rem 0;
        flex: 1;
    }

    /* Big Star-Progress Row Under Each Game (Requirement 6) */
    .game-star-progress-row {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        width: 100%;
        background: rgba(255, 255, 255, 0.75);
        border: 2.5px solid var(--color-storybook-ink);
        border-radius: 16px;
        padding: 0.4rem 0.75rem;
        margin-bottom: 1rem;
        box-shadow: 0 2px 0 var(--color-storybook-ink);
    }

    .progress-label {
        font-family: var(--font-heading);
        font-size: 0.88rem;
        font-weight: 800;
        color: var(--color-storybook-ink);
    }

    .stars-trio {
        display: flex;
        gap: 0.25rem;
        align-items: center;
    }

    .card-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        margin-top: auto;
    }

    .card-rounds {
        font-family: var(--font-heading);
        font-size: 0.92rem;
        font-weight: 800;
        color: var(--color-storybook-ink);
        background: #FFFFFF;
        border: 2px solid var(--color-storybook-ink);
        border-radius: 999px;
        padding: 0.25rem 0.65rem;
        box-shadow: 0 2px 0 var(--color-storybook-ink);
    }

    .card-btn {
        font-size: 1rem !important;
        padding: 0.5rem 1.25rem !important;
    }

    /* Rewards Quick Strip */
    .rewards-strip {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1rem;
        margin-top: 0.5rem;
    }

    .reward-strip-card {
        background: #FFFFFF;
        border: 3.5px solid var(--color-storybook-ink);
        border-radius: 20px;
        box-shadow: 0 5px 0 var(--color-storybook-ink);
        padding: 1rem 1.25rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        cursor: pointer;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .reward-strip-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 0 var(--color-storybook-ink);
    }

    .strip-title {
        font-family: var(--font-heading);
        font-size: 1.15rem;
        margin: 0;
        color: var(--color-storybook-ink);
    }

    .strip-desc {
        font-size: 0.85rem;
        font-weight: 700;
        color: #64748B;
        margin: 0;
    }

    .strip-arrow {
        margin-left: auto;
        font-family: var(--font-heading);
        font-size: 1.2rem;
        font-weight: 800;
        color: var(--color-storybook-ink);
    }

    /* Animations */
    .anim-float-slow {
        animation: floatSlow 3s ease-in-out infinite;
    }

    .anim-float-mid {
        animation: floatMid 2.4s ease-in-out infinite;
    }

    @@keyframes floatSlow {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-7px); }
    }

    @@keyframes floatMid {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-5px); }
    }

    @@media (max-width: 768px) {
        .hero-flex {
            flex-direction: column;
            text-align: center;
        }

        .hero-action-buttons {
            justify-content: center;
        }

        .bubble-tail-left {
            left: 50%;
            top: -18px;
            transform: translateX(-50%);
            border-left: 12px solid transparent;
            border-right: 12px solid transparent;
            border-bottom: 18px solid var(--color-storybook-ink);
            border-top: none;
        }

        .bubble-tail-left::after {
            left: -9px;
            top: 4px;
            border-left: 9px solid transparent;
            border-right: 9px solid transparent;
            border-bottom: 15px solid #FFFDF7;
