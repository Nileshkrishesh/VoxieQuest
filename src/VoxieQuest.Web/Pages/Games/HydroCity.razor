@page "/game/hydrocity"
@page "/games/hydrocity"
@inherits BaseGameComponent

<div class="game-viewport">
    <ParallaxBackground Theme="ParallaxBackground.ParallaxTheme.Clouds" />

    <!-- Top HUD -->
    <div class="storybook-card game-hud-card">
        <div class="hud-top-row">
            <button class="pill hud-back-btn" @onclick="ReturnToMapAsync" type="button" aria-label="Return to map">
                <span>◀ Map</span>
            </button>
            <h3 class="hud-game-title">
                🌊 @GameTitle
            </h3>
            <div class="star-badge hud-star-badge">
                <span>⭐</span>
                <span>@SessionStars</span>
            </div>
        </div>

        <div class="round-stepper">
            @for (int r = 1; r <= 5; r++)
            {
                var isCompleted = r < CurrentRound;
                var isCurrent = r == CurrentRound;
                <div class="round-dot @(isCompleted ? "completed" : "") @(isCurrent ? "current" : "")" title="Storm Level @r">
                    @(isCompleted ? "★" : r.ToString())
                </div>
            }
        </div>
    </div>

    <!-- HydroCity Watershed Grid Simulation -->
    <div class="storybook-card watershed-arena">
        <div class="storm-alert-bar @(isProtected ? "storm-safe" : "storm-warning")">
            <span>⛈️ Storm Surge: @ActiveStormTitle • Runoff: <strong>@currentRunoffPercent%</strong> (Target &lt; 25%)</span>
        </div>

        <!-- 4x4 City Grid SVG -->
        <div class="city-grid-wrapper">
            <svg width="100%" height="260" viewBox="0 0 360 260" preserveAspectRatio="xMidYMid meet">
                @for (int row = 0; row < 4; row++)
                {
                    for (int col = 0; col < 4; col++)
                    {
                        var index = row * 4 + col;
                        var cell = cityGrid[index];
                        var x = 20 + col * 80;
                        var y = 15 + row * 60;

                        <g transform="translate(@x, @y)" @onclick="() => CycleTile(index)" style="cursor:pointer;">
                            <!-- Tile Base -->
                            <rect width="75" height="55" rx="8" fill="@cell.BgColor" stroke="#2B2D42" stroke-width="2.5" />
                            <!-- Tile Icon & Label -->
                            <text x="37" y="32" font-size="22" text-anchor="middle">@cell.Emoji</text>
                            <text x="37" y="48" font-size="9" font-weight="800" font-family="var(--font-heading)" fill="#2B2D42" text-anchor="middle">@cell.Title</text>
                        </g>
                    }
                }
            </svg>
        </div>

        <!-- Water Absorption Meter -->
        <div class="watershed-meter-bar">
            <span>City Flood Protection:</span>
            <div class="meter-track">
                <div class="meter-fill @(isProtected ? "fill-safe" : "fill-danger")" style="width:@(100 - currentRunoffPercent)%"></div>
            </div>
            <span>@(100 - currentRunoffPercent)% Absorbed</span>
        </div>
    </div>

    <!-- Infrastructure Action Tray -->
    @if (!isProtected)
    {
        <div class="storybook-card infra-tray-card">
            <h4 class="infra-title">Tap Any City Tile to Upgrade Drainage Infrastructure:</h4>
            <div class="infra-legend-row">
                <span class="legend-item">🏢 Asphalt (10% absorb)</span>
                <span class="legend-item">🌿 Bioswale (80% absorb)</span>
                <span class="legend-item">🧱 Permeable Brick (60% absorb)</span>
                <span class="legend-item">💧 Retention Pond (100% absorb)</span>
            </div>
        </div>
    }
    else
    {
        <div class="next-storm-row">
            <button class="storybook-btn next-storm-btn" type="button" @onclick="AdvanceStorm">
                <span>🏙️ City Protected! Next Storm Level ➔</span>
            </button>
        </div>
    }
</div>

<style>
    .game-viewport {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: clamp(0.75rem, 2vw, 1.25rem);
        max-width: 680px;
        margin: 0 auto;
        padding: clamp(8px, 2vw, 16px);
        padding-bottom: 2.5rem;
        width: 100%;
        box-sizing: border-box;
    }

    .game-hud-card {
        width: 100%;
        padding: 0.75rem 1.25rem;
    }

    .hud-top-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.5rem;
    }

    .hud-game-title {
        font-family: var(--font-heading);
        font-size: clamp(1.2rem, 3.2vw, 1.6rem);
        margin: 0;
        color: var(--color-storybook-ink);
    }

    .round-stepper {
        display: flex;
        justify-content: center;
        gap: 0.5rem;
    }

    .round-dot {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        border: 2px solid var(--color-storybook-ink);
        background: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 0.85rem;
    }

    .round-dot.completed {
        background: var(--color-sunny-yellow);
        color: var(--color-storybook-ink);
    }

    .round-dot.current {
        background: var(--color-mint);
        color: white;
        transform: scale(1.15);
    }

    /* Watershed Arena */
    .watershed-arena {
        width: 100%;
        background: #F8FAFC;
        border: var(--border-ink-thick);
        border-radius: var(--border-radius-lg);
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        box-sizing: border-box;
    }

    .storm-alert-bar {
        border: 2px solid var(--color-storybook-ink);
        border-radius: var(--border-radius-pill);
        padding: 0.35rem 1rem;
        font-family: var(--font-heading);
        font-size: 0.95rem;
        font-weight: 800;
        box-shadow: 0 3px 0 var(--color-storybook-ink);
        margin-bottom: 0.75rem;
        text-align: center;
    }

    .storm-warning {
        background: #FEE2E2;
        color: #991B1B;
    }

    .storm-safe {
        background: #DCFCE7;
        color: #15803D;
    }

    .city-grid-wrapper {
        width: 100%;
    }

    .watershed-meter-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        margin-top: 0.75rem;
        font-family: var(--font-heading);
        font-size: 0.88rem;
        font-weight: 800;
        color: var(--color-storybook-ink);
        gap: 0.5rem;
    }

    .meter-track {
        flex: 1;
        height: 12px;
        background: #E2E8F0;
        border: 2px solid var(--color-storybook-ink);
        border-radius: 6px;
        overflow: hidden;
    }

    .meter-fill {
        height: 100%;
        transition: width 0.3s ease;
    }

    .fill-danger {
        background: #EF4444;
    }

    .fill-safe {
        background: #10B981;
    }

    /* Infra Tray */
    .infra-tray-card {
        width: 100%;
        padding: 1rem;
        background: white;
    }

    .infra-title {
        font-family: var(--font-heading);
        font-size: 0.95rem;
        margin: 0 0 0.5rem 0;
        text-align: center;
        color: var(--color-storybook-ink);
    }

    .infra-legend-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        justify-content: center;
        font-size: 0.8rem;
        font-weight: 700;
        color: #475569;
    }

    .legend-item {
        background: #F1F5F9;
        border: 1.5px solid #CBD5E1;
        border-radius: var(--border-radius-pill);
        padding: 0.2rem 0.65rem;
    }

    .next-storm-row {
        width: 100%;
    }

    .next-storm-btn {
        width: 100%;
        background: var(--color-mint);
        color: white;
        font-size: 1.15rem !important;
    }
</style>

@code {
    protected override SkillCategory GameCategory => SkillCategory.Storytelling;
    protected override string GameTitle => "HydroCity Watershed";

    private record TileType(string Title, string Emoji, string BgColor, int RunoffPercent);

    private static readonly TileType Asphalt = new TileType("Asphalt", "🏢", "#E2E8F0", 90);
    private static readonly TileType Bioswale = new TileType("Bioswale", "🌿", "#BBF7D0", 20);
    private static readonly TileType Permeable = new TileType("Permeable", "🧱", "#FED7AA", 40);
    private static readonly TileType Pond = new TileType("Pond", "💧", "#BAE6FD", 0);

    private List<TileType> cityGrid = new();
    private int currentRunoffPercent = 75;
    private bool isProtected = false;

    private static readonly string[] StormTiers = new[] { "Spring Shower", "Flash Cloudburst", "Monsoon Torrent", "Canyon Surge", "100-Year Flood" };
    private string ActiveStormTitle => StormTiers[Math.Min(CurrentRound - 1, StormTiers.Length - 1)];

    protected override Task<GameChallenge> GenerateChallengeAsync(int round, DifficultyLevel difficulty)
    {
        isProtected = false;
        cityGrid = Enumerable.Repeat(Asphalt, 16).ToList();
        // Give 2 pre-existing ponds
        cityGrid[5] = Pond;
        cityGrid[10] = Bioswale;

        currentRunoffPercent = (int)cityGrid.Average(t => t.RunoffPercent);

        var challenge = new GameChallenge
        {
            Category = GameCategory,
            Difficulty = difficulty,
            Prompt = $"Upgrade city tiles to bioswales and ponds to lower flood runoff under 25% for {ActiveStormTitle}!",
            TargetAnswer = "drain",
            AcceptedAnswers = new() { "drain", "water", "flood", "city", "protect" },
            DisplayItem = "🌊",
            RewardStars = 2
        };

        return Task.FromResult(challenge);
    }

    private async Task CycleTile(int index)
    {
        if (isProtected) return;

        var current = cityGrid[index];
        if (current == Asphalt) cityGrid[index] = Bioswale;
        else if (current == Bioswale) cityGrid[index] = Permeable;
        else if (current == Permeable) cityGrid[index] = Pond;
        else cityGrid[index] = Asphalt;

        await AudioService.PlaySoundAsync(SoundEffect.Click);
        await CalculateRunoffAsync();
    }

    private async Task CalculateRunoffAsync()
    {
        currentRunoffPercent = (int)cityGrid.Average(t => t.RunoffPercent);

        if (currentRunoffPercent <= 25)
        {
            isProtected = true;
            await AudioService.PlaySoundAsync(SoundEffect.SuccessChime);

            if (ProgressService.ActiveProfile != null)
            {
                ProgressService.ActiveProfile.NourishGardenSkill(
                    "life_watershed_sim", 
                    "Watershed Flood Planning", 
                    OutcomeCategory.LifeSkills, 
                    30, 
                    $"Protected HydroCity from {ActiveStormTitle} with {currentRunoffPercent}% runoff."
                );
                await ProgressService.RecordChallengeAttemptAsync(SkillCategory.Storytelling, true, 2);
            }
            StateHasChanged();
        }
    }

    private async Task AdvanceStorm()
    {
        if (CurrentRound < 5)
        {
            await SkipRoundAsync();
        }
        else
        {
            await AudioService.PlaySoundAsync(SoundEffect.Fanfare);
            await ReturnToMapAsync();
        }
    }
}
