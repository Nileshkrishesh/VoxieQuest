@page "/game/beacon-bridge"
@page "/games/beacon-bridge"
@inherits BaseGameComponent

<GameShell GameTitle="@GameTitle"
           CurrentRound="@CurrentRound"
           TotalRounds="5"
           Stars="@SessionStars"
           Theme="ParallaxBackground.ParallaxTheme.Hills"
           ThemeClass="beacon-bridge-theme"
           Prompt="@(ActiveChallenge?.Prompt ?? "Guide the friendly light beam safely home!")"
           HintText="Say 'Voxie, light the way!' or turn the mirrors!"
           ShowHint="@(!isBeamLit)"
           MascotMood="@(isBeamLit ? Mascot.MascotState.Happy : Mascot.MascotState.Idle)"
           IsListening="@VoiceManager.IsListening"
           VolumeLevel="@CurrentVolume"
           MicButtonState="@GetMicButtonState()"
           IsPracticeMode="@(VoiceManager.CurrentEngine == VoiceEngineType.PracticeManual)"
           PracticeChoices="@(new List<string> { "Light the way!", "Turn Mirror 1", "Turn Mirror 2" })"
           ShowSuccessBurst="@isBeamLit"
           IsRewardOpen="@(CurrentRound >= 5 && isBeamLit)"
           StarsEarned="3"
           IsMicDenied="false"
           OnBack="ReturnToMapAsync"
           OnRepeatPrompt="RepeatPromptAloudAsync"
           OnToggleListening="ToggleListeningAsync"
           OnSelectPracticeChoice="HandlePracticeChoice"
           OnPlayAgain="StartGameSessionAsync"
           OnNextQuest="AdvanceBeacon"
           OnSwitchToPractice="SwitchToPracticeMode">

    <SceneContent>
        <!-- Picture-Book Sea, Lighthouse, and Optics Grid Scene -->
        <div class="beacon-stage-scene">
            <svg class="beacon-svg-viewport" viewBox="0 0 540 280" preserveAspectRatio="xMidYMid meet">
                <!-- Night Sea Water -->
                <rect x="0" y="0" width="540" height="280" rx="16" fill="#1E293B" />
                <path d="M0 210 Q 135 195 270 210 T 540 210 V 280 H 0 Z" fill="#0F172A" />
                <path d="M0 225 Q 135 215 270 225 T 540 225 V 280 H 0 Z" fill="#0284C7" opacity="0.7" />

                <!-- Optical Grid Grid Cells -->
                @for (int row = 0; row < 3; row++)
                {
                    for (int col = 0; col < 4; col++)
                    {
                        var cx = 35 + col * 90;
                        var cy = 25 + row * 65;
                        <rect x="@cx" y="@cy" width="80" height="55" rx="10" fill="#334155" stroke="#475569" stroke-width="2" />
                    }
                }

                <!-- Glowing Hand-Drawn Light Path -->
                @if (isBeamLit)
                {
                    <!-- Dotted golden beam with star sparkles -->
                    <polyline points="75,52 255,52 255,182 435,182" 
                              stroke="#FFC93C" 
                              stroke-width="8" 
                              stroke-linecap="round" 
                              stroke-linejoin="round" 
                              class="glowing-beam" />
                    <circle cx="75" cy="52" r="6" fill="#FFF8E7" />
                    <circle cx="255" cy="52" r="6" fill="#FFF8E7" />
                    <circle cx="255" cy="182" r="6" fill="#FFF8E7" />
                    <circle cx="435" cy="182" r="8" fill="#FFF8E7" />
                }

                <!-- Beacon Light Source at (0, 0) -->
                <g transform="translate(75, 52)">
                    <circle cx="0" cy="0" r="22" fill="#FFC93C" stroke="#2B2D42" stroke-width="3" />
                    <circle cx="0" cy="0" r="14" fill="#FFF8E7" />
                    <circle cx="0" cy="0" r="6" fill="#FF9F43" />
                </g>

                <!-- Rotatable Mirror 1 at (2, 0) - Centered at (255, 52) -->
                <g transform="translate(255, 52) rotate(@mirror1Angle)" @onclick="RotateMirror1" style="cursor:pointer;" class="interactive-mirror">
                    <circle cx="0" cy="0" r="26" fill="rgba(255, 255, 255, 0.2)" stroke="#5BC0EB" stroke-width="2" />
                    <rect x="-20" y="-4" width="40" height="8" rx="4" fill="#5BC0EB" stroke="#2B2D42" stroke-width="2.5" />
                    <circle cx="0" cy="0" r="5" fill="#FFC93C" stroke="#2B2D42" stroke-width="2" />
                    <!-- Handle -->
                    <circle cx="-16" cy="0" r="4" fill="#FF6B6B" />
                    <circle cx="16" cy="0" r="4" fill="#FF6B6B" />
                </g>

                <!-- Rotatable Mirror 2 at (2, 2) - Centered at (255, 182) -->
                <g transform="translate(255, 182) rotate(@mirror2Angle)" @onclick="RotateMirror2" style="cursor:pointer;" class="interactive-mirror">
                    <circle cx="0" cy="0" r="26" fill="rgba(255, 255, 255, 0.2)" stroke="#5BC0EB" stroke-width="2" />
                    <rect x="-20" y="-4" width="40" height="8" rx="4" fill="#5BC0EB" stroke="#2B2D42" stroke-width="2.5" />
                    <circle cx="0" cy="0" r="5" fill="#FFC93C" stroke="#2B2D42" stroke-width="2" />
                    <!-- Handle -->
                    <circle cx="-16" cy="0" r="4" fill="#FF6B6B" />
                    <circle cx="16" cy="0" r="4" fill="#FF6B6B" />
                </g>

                <!-- Friendly Striped Lighthouse on Rocky Cliff at (435, 182) -->
                <g transform="translate(435, 182)">
                    <!-- Rocky Cliff Base -->
                    <ellipse cx="0" cy="24" rx="35" ry="14" fill="#475569" stroke="#2B2D42" stroke-width="3" />
                    <!-- Lighthouse Tower -->
                    <polygon points="-16,20 -10,-32 10,-32 16,20" fill="#FFF8E7" stroke="#2B2D42" stroke-width="3" />
                    <!-- Red Stripes -->
                    <polygon points="-14,8 -12,-8 12,-8 14,8" fill="#FF6B6B" stroke="#2B2D42" stroke-width="2" />
                    <!-- Lantern Cupola -->
                    <rect x="-12" y="-46" width="24" height="14" rx="4" fill="@(isBeamLit ? "#FFC93C" : "#94A3B8")" stroke="#2B2D42" stroke-width="2.5" />
                    <!-- Roof Peak -->
                    <polygon points="-14,-46 0,-58 14,-46" fill="#FF6B6B" stroke="#2B2D42" stroke-width="2.5" />
                    <!-- Lighthouse Glow -->
                    @if (isBeamLit)
                    {
                        <circle cx="0" cy="-39" r="18" fill="#FFC93C" opacity="0.4" class="bloom-glow" />
                    }
                </g>

                <!-- Little Wooden Boat at Sea with White Sails -->
                <g transform="translate(110, 225)" class="boat-bobbing">
                    <!-- Boat Hull -->
                    <path d="M-22,0 L22,0 L16,14 L-16,14 Z" fill="#92400E" stroke="#2B2D42" stroke-width="2.5" />
                    <!-- Mast -->
                    <line x1="0" y1="0" x2="0" y2="-28" stroke="#2B2D42" stroke-width="2.5" />
                    <!-- Sail -->
                    <polygon points="0,-26 18,-6 0,-6" fill="#FFF8E7" stroke="#2B2D42" stroke-width="2" />
                    <!-- Little Flag -->
                    <polygon points="0,-28 -8,-24 0,-20" fill="#FF6B6B" />
                </g>

                <!-- Clearing Fog Effect (Puffs out when lit) -->
                @if (!isBeamLit)
                {
                    <g opacity="0.35" class="fog-drift">
                        <ellipse cx="180" cy="120" rx="90" ry="25" fill="#E2E8F0" />
                        <ellipse cx="360" cy="140" rx="100" ry="28" fill="#E2E8F0" />
                    </g>
                }
            </svg>
        </div>
    </SceneContent>

    <QuestionExtraContent>
        <!-- In-Question Interactive Mirror Rotation Buttons -->
        <div class="mirror-action-row">
            <button class="pill mirror-tap-btn" type="button" @onclick="RotateMirror1">
                <NextIcon Size="18" />
                <span>Turn Mirror 1 (@(mirror1Angle)°)</span>
            </button>
            <button class="pill mirror-tap-btn" type="button" @onclick="RotateMirror2">
                <NextIcon Size="18" />
                <span>Turn Mirror 2 (@(mirror2Angle)°)</span>
            </button>
            @if (isBeamLit && CurrentRound < 5)
            {
                <button class="pill next-ship-btn" type="button" @onclick="AdvanceBeacon">
                    <StarIcon Size="18" FillColor="#FFC93C" />
                    <span>Next Ship Safe! ➔</span>
                </button>
            }
        </div>
    </QuestionExtraContent>
</GameShell>

<style>
    .beacon-stage-scene {
        width: 100%;
        max-width: 600px;
        margin: 0 auto;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .beacon-svg-viewport {
        width: 100%;
        height: auto;
        max-height: 250px;
        border-radius: var(--radius-lg);
        border: var(--border-storybook);
        box-shadow: var(--shadow-hard-md);
    }

    .glowing-beam {
        filter: drop-shadow(0 0 10px #FFC93C);
        animation: beam-shine 1.6s infinite alternate ease-in-out;
    }

    .interactive-mirror {
        transition: transform 0.25s var(--spring-squish);
    }

    .boat-bobbing {
        animation: boat-sway 2.5s infinite ease-in-out alternate;
    }

    .fog-drift {
        animation: fog-sway 4s infinite ease-in-out alternate;
    }

    .mirror-action-row {
        display: flex;
        gap: 0.5rem;
        justify-content: center;
        flex-wrap: wrap;
        margin-top: 0.5rem;
    }

    .mirror-tap-btn {
        background: #FFFFFF;
        border: var(--border-storybook);
        border-radius: var(--radius-pill);
        padding: 0.45rem 0.85rem;
        font-family: var(--font-heading);
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--color-storybook-ink);
        box-shadow: var(--shadow-hard-sm);
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
    }

    .next-ship-btn {
        background: var(--color-mint);
        border: var(--border-storybook);
        border-radius: var(--radius-pill);
        padding: 0.45rem 1rem;
        font-family: var(--font-heading);
        font-size: 1rem;
        font-weight: 700;
        color: var(--color-storybook-ink);
        box-shadow: var(--shadow-hard-sm);
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
    }

    @@keyframes beam-shine {
        0% { stroke-width: 6; opacity: 0.85; }
        100% { stroke-width: 10; opacity: 1; }
    }

    @@keyframes boat-sway {
        0% { transform: translate(110px, 225px) rotate(-3deg); }
        100% { transform: translate(110px, 225px) rotate(3deg); }
    }

    @@keyframes fog-sway {
        0% { transform: translateX(-15px); }
        100% { transform: translateX(15px); }
    }
</style>

@code {
    protected override SkillCategory GameCategory => SkillCategory.Numbers;
    protected override string GameTitle => "Team Light Quest";

    private int mirror1Angle = 0;
    private int mirror2Angle = 90;
    private bool isBeamLit = false;

    protected override Task<GameChallenge> GenerateChallengeAsync(int round, DifficultyLevel difficulty)
    {
        isBeamLit = false;
        mirror1Angle = (round * 45) % 180;
        mirror2Angle = ((round + 1) * 90) % 180;

        var challenge = new GameChallenge
        {
            Category = GameCategory,
            Difficulty = difficulty,
            Prompt = "Say 'Voxie, light the way!' or turn the mirrors to guide the ship safely home!",
            TargetAnswer = "light the way",
            AcceptedAnswers = new() { "light", "beam", "mirror", "light the way", "turn mirror" },
            DisplayItem = "Lighthouse",
            RewardStars = 2
        };

        CheckBeamAlignment();
        return Task.FromResult(challenge);
    }

    private async Task RotateMirror1()
    {
        if (isBeamLit) return;
        mirror1Angle = (mirror1Angle + 45) % 360;
        await AudioService.PlaySoundAsync(SoundEffect.Click);
        CheckBeamAlignment();
    }

    private async Task RotateMirror2()
    {
        if (isBeamLit) return;
        mirror2Angle = (mirror2Angle + 45) % 360;
        await AudioService.PlaySoundAsync(SoundEffect.Click);
        CheckBeamAlignment();
    }

    private async void CheckBeamAlignment()
    {
        if ((mirror1Angle % 180 == 0) && (mirror2Angle % 180 == 0))
        {
            isBeamLit = true;
            await AudioService.PlaySoundAsync(SoundEffect.SuccessChime);

            if (ProgressService.ActiveProfile != null)
            {
                ProgressService.ActiveProfile.NourishGardenSkill(
                    "soc_coop_optics", 
                    "Teamwork & Shared Light", 
                    OutcomeCategory.Social, 
                    30, 
                    $"Aligned optics grid to illuminate Lighthouse {CurrentRound}."
                );
                await ProgressService.RecordChallengeAttemptAsync(SkillCategory.Numbers, true, 2);
            }
            StateHasChanged();
        }
    }

    private async Task AdvanceBeacon()
    {
        if (CurrentRound < 5)
        {
            await SkipRoundAsync();
        }
        else
        {
            await AudioService.PlaySoundAsync(SoundEffect.Fanfare);
            await ReturnToMapAsync();
        }
    }

    private async Task HandlePracticeChoice(string choice)
    {
        if (choice.Contains("Mirror 1"))
        {
            await RotateMirror1();
        }
        else if (choice.Contains("Mirror 2"))
        {
            await RotateMirror2();
        }
        else
        {
            // Light the way command
            mirror1Angle = 0;
            mirror2Angle = 0;
            CheckBeamAlignment();
        }
    }

    private MicButton.MicState GetMicButtonState()
    {
        if (isBeamLit) return MicButton.MicState.Done;
        if (VoiceManager.IsListening) return MicButton.MicState.Listening;
        return MicButton.MicState.Ready;
    }

    private void SwitchToPracticeMode()
    {
        VoiceManager.SetEngine(VoiceEngineType.PracticeManual);
    }
}
