@page "/game/tumble-scale"
@page "/games/tumble-scale"
@inherits BaseGameComponent

<GameShell GameTitle="@GameTitle"
           CurrentRound="@CurrentRound"
           TotalRounds="5"
           Stars="@SessionStars"
           Theme="ParallaxBackground.ParallaxTheme.Hills"
           ThemeClass="tumble-scale-theme"
           Prompt="@(ActiveChallenge?.Prompt ?? "Add weights to balance the friendly island seesaw!")"
           HintText="Shout 'Add two!' or tap a fruit weight!"
           ShowHint="@(!isBalanced)"
           MascotMood="@(isBalanced ? Mascot.MascotState.Happy : Mascot.MascotState.Thinking)"
           IsListening="@VoiceManager.IsListening"
           VolumeLevel="@CurrentVolume"
           MicButtonState="@GetMicButtonState()"
           IsPracticeMode="@(VoiceManager.CurrentEngine == VoiceEngineType.PracticeManual)"
           PracticeChoices="@(new List<string> { "Add 1", "Add 2", "Add 3", "Reset" })"
           ShowSuccessBurst="@isBalanced"
           IsRewardOpen="@(CurrentRound >= 5 && isBalanced)"
           StarsEarned="3"
           IsMicDenied="false"
           VoiceErrorMessage="@VoiceErrorMessage"
           HeardTranscript="@LastTranscript"
           LastResultStatus="@(isBalanced ? (bool?)true : null)"
           OnBack="ReturnToMapAsync"
           OnRepeatPrompt="RepeatPromptAloudAsync"
           OnToggleListening="ToggleListeningAsync"
           OnSelectPracticeChoice="HandlePracticeChoice"
           OnPlayAgain="StartGameSessionAsync"
           OnNextQuest="AdvanceIsland"
           OnSwitchToPractice="SwitchToPracticeMode">

    <SceneContent>
        <!-- Picture-Book Island Seesaw Balance Scene -->
        <div class="scale-stage-scene">
            <svg class="scale-svg-viewport" viewBox="0 0 540 240" preserveAspectRatio="xMidYMid meet">
                <!-- Gentle Sandy Beach & Ocean Ripples -->
                <rect x="0" y="0" width="540" height="240" rx="16" fill="#E0F2FE" />
                <path d="M0 190 Q 135 180 270 190 T 540 190 V 240 H 0 Z" fill="#FEF08A" stroke="#2B2D42" stroke-width="2.5" />
                <path d="M0 210 Q 135 200 270 210 T 540 210 V 240 H 0 Z" fill="#5BC0EB" opacity="0.6" />

                <!-- Smooth Round Pebble Fulcrum on Beach -->
                <ellipse cx="270" cy="170" rx="28" ry="20" fill="#94A3B8" stroke="#2B2D42" stroke-width="3" />
                <ellipse cx="270" cy="155" rx="8" ry="6" fill="#FFC93C" stroke="#2B2D42" stroke-width="2" />

                <!-- Tilting Palm Log Beam (Rotates around (270, 155)) -->
                <g transform="rotate(@beamAngle, 270, 155)" class="balance-beam-group">
                    <!-- Palm Log Beam -->
                    <rect x="40" y="148" width="460" height="16" rx="8" fill="#92400E" stroke="#2B2D42" stroke-width="3.5" />
                    <!-- Green Grass Strip along Log -->
                    <rect x="42" y="144" width="456" height="6" rx="3" fill="#7ED9A8" stroke="#2B2D42" stroke-width="1.5" />

                    <!-- Left Palm Tree Sticker & Weight Slots (Positions 1, 2, 3) -->
                    <g transform="translate(60, 95)">
                        <!-- Hand-drawn Palm Trunk -->
                        <path d="M12,50 Q16,25 24,0" stroke="#92400E" stroke-width="4.5" stroke-linecap="round" fill="none" />
                        <!-- Palm Fronds -->
                        <path d="M24,0 Q5,-15 -10,0" stroke="#22C55E" stroke-width="4" stroke-linecap="round" fill="none" />
                        <path d="M24,0 Q35,-20 45,-5" stroke="#22C55E" stroke-width="4" stroke-linecap="round" fill="none" />
                        <path d="M24,0 Q24,-24 20,-30" stroke="#22C55E" stroke-width="4" stroke-linecap="round" fill="none" />
                    </g>

                    <!-- Placed Items on Left Arm -->
                    @foreach (var placed in placedWeights)
                    {
                        var posX = placed.Slot switch { 1 => 200, 2 => 140, _ => 90 };
                        <g transform="translate(@(posX - 14), 105)">
                            <!-- Tactile Wooden Weight Token -->
                            <circle cx="14" cy="14" r="14" fill="#FFC93C" stroke="#2B2D42" stroke-width="2.5" />
                            <text x="14" y="19" font-family="var(--font-heading)" font-size="14" font-weight="700" fill="#2B2D42" text-anchor="middle">
                                @placed.Weight
                            </text>
                        </g>
                    }

                    <!-- Right Arm Target Basket with Target Weight -->
                    <g transform="translate(380, 100)">
                        <!-- Woven Basket -->
                        <path d="M0,15 L60,15 L52,45 L8,45 Z" fill="#F59E0B" stroke="#2B2D42" stroke-width="3" />
                        <!-- Basket Rim -->
                        <rect x="-3" y="10" width="66" height="8" rx="4" fill="#D97706" stroke="#2B2D42" stroke-width="2" />
                        <!-- Target Weight Pill on Basket -->
                        <rect x="10" y="22" width="40" height="18" rx="9" fill="#FFF8E7" stroke="#2B2D42" stroke-width="2" />
                        <text x="30" y="35" font-family="var(--font-heading)" font-size="14" font-weight="700" fill="#2B2D42" text-anchor="middle">
                            @targetTorque
                        </text>
                    </g>
                </g>

                <!-- Cheerful Wooden Flag popping up when Level -->
                @if (isBalanced)
                {
                    <g transform="translate(255, 60)" class="flag-pop-anim">
                        <!-- Flagpole -->
                        <line x1="15" y1="0" x2="15" y2="80" stroke="#2B2D42" stroke-width="3.5" />
                        <!-- Cheerful Triangular Banner -->
                        <polygon points="15,0 55,16 15,32" fill="#7ED9A8" stroke="#2B2D42" stroke-width="2.5" />
                        <!-- Star on Banner -->
                        <polygon points="28,16 30,12 34,12 31,14 32,18 28,15 24,18 25,14 22,12 26,12" fill="#FFC93C" stroke="#2B2D42" stroke-width="1" />
                    </g>
                }
            </svg>
        </div>
    </SceneContent>

    <QuestionExtraContent>
        <!-- Weight Selector Buttons -->
        <div class="weight-controls-row">
            <button class="pill weight-token-btn" type="button" @onclick='() => AddWeight(1, 1, "1")'>
                <span class="weight-badge">+1</span>
                <span>Coconut</span>
            </button>
            <button class="pill weight-token-btn" type="button" @onclick='() => AddWeight(2, 1, "2")'>
                <span class="weight-badge">+2</span>
                <span>Pineapple</span>
            </button>
            <button class="pill weight-token-btn" type="button" @onclick='() => AddWeight(3, 1, "3")'>
                <span class="weight-badge">+3</span>
                <span>Melon</span>
            </button>
            <button class="pill weight-token-btn" type="button" @onclick='() => AddWeight(5, 1, "5")'>
                <span class="weight-badge">+5</span>
                <span>Stone</span>
            </button>

            <button class="pill clear-weight-btn" type="button" @onclick="ResetWeights" disabled="@(!placedWeights.Any())">
                <ReplayIcon Size="16" />
                <span>Clear</span>
            </button>

            @if (isBalanced && CurrentRound < 5)
            {
                <button class="pill next-island-btn" type="button" @onclick="AdvanceIsland">
                    <StarIcon Size="18" FillColor="#FFC93C" />
                    <span>Next Island ➔</span>
                </button>
            }
        </div>
    </QuestionExtraContent>
</GameShell>

<style>
    .scale-stage-scene {
        width: 100%;
        max-width: 600px;
        margin: 0 auto;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .scale-svg-viewport {
        width: 100%;
        height: auto;
        max-height: clamp(130px, 28vh, 220px);
        border-radius: var(--radius-lg);
        border: var(--border-storybook);
        box-shadow: var(--shadow-hard-md);
    }

    .balance-beam-group {
        transition: transform 0.4s var(--spring-squish);
    }

    .flag-pop-anim {
        animation: flag-rise 0.5s var(--spring-squish) forwards;
    }

    .weight-controls-row {
        display: flex;
        gap: 0.5rem;
        justify-content: center;
        flex-wrap: wrap;
        margin-top: 0.5rem;
    }

    .weight-token-btn {
        background: #FFFFFF;
        border: var(--border-storybook);
        border-radius: var(--radius-pill);
        padding: 0.35rem 0.75rem;
        font-family: var(--font-heading);
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--color-storybook-ink);
        box-shadow: var(--shadow-hard-sm);
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
    }

    .weight-badge {
        background: var(--color-sunny-yellow);
        border: 2px solid var(--color-storybook-ink);
        border-radius: var(--radius-pill);
        padding: 1px 6px;
        font-size: 0.85rem;
        font-weight: 700;
    }

    .clear-weight-btn {
        background: var(--color-paper-light);
        border: var(--border-storybook);
        border-radius: var(--radius-pill);
        padding: 0.35rem 0.75rem;
        font-family: var(--font-heading);
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--color-storybook-ink);
        box-shadow: var(--shadow-hard-sm);
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
    }

    .next-island-btn {
        background: var(--color-mint);
        border: var(--border-storybook);
        border-radius: var(--radius-pill);
        padding: 0.35rem 0.95rem;
        font-family: var(--font-heading);
        font-size: 1rem;
        font-weight: 700;
        color: var(--color-storybook-ink);
        box-shadow: var(--shadow-hard-sm);
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
    }

    @@keyframes flag-rise {
        0% { transform: translate(255px, 120px) scale(0.4); opacity: 0; }
        100% { transform: translate(255px, 60px) scale(1); opacity: 1; }
    }
</style>

@code {
    protected override SkillCategory GameCategory => SkillCategory.Numbers;
    protected override string GameTitle => "Island Balance";

    private int targetTorque = 6;
    private int currentTorque = 0;
    private double beamAngle = 10;
    private bool isBalanced = false;

    private record PlacedWeight(int Weight, int Slot, string Label);
    private List<PlacedWeight> placedWeights = new();

    private static readonly int[] TargetChallenges = new[] { 4, 6, 8, 10, 12 };

    protected override Task<GameChallenge> GenerateChallengeAsync(int round, DifficultyLevel difficulty)
    {
        isBalanced = false;
        placedWeights.Clear();
        currentTorque = 0;
        beamAngle = 12;

        var index = Math.Min(round - 1, TargetChallenges.Length - 1);
        targetTorque = TargetChallenges[index] + (difficulty == DifficultyLevel.Hard ? 2 : 0);

        var challenge = new GameChallenge
        {
            Category = GameCategory,
            Difficulty = difficulty,
            Prompt = $"Add friendly weights to match {targetTorque} and level the island seesaw!",
            TargetAnswer = targetTorque.ToString(),
            AcceptedAnswers = new() { targetTorque.ToString(), $"add {targetTorque}", "level", "balanced" },
            DisplayItem = $"{targetTorque}",
            RewardStars = 2
        };

        return Task.FromResult(challenge);
    }

    private async Task AddWeight(int weight, int slot, string label)
    {
        if (isBalanced) return;

        placedWeights.Add(new PlacedWeight(weight, (placedWeights.Count % 3) + 1, label));
        await AudioService.PlaySoundAsync(SoundEffect.Pop);
        CalculateTorque();
    }

    private void ResetWeights()
    {
        placedWeights.Clear();
        CalculateTorque();
    }

    private async void CalculateTorque()
    {
        currentTorque = placedWeights.Sum(p => p.Weight);

        if (currentTorque == targetTorque)
        {
            beamAngle = 0;
            isBalanced = true;
            await AudioService.PlaySoundAsync(SoundEffect.SuccessChime);

            if (ProgressService.ActiveProfile != null)
            {
                ProgressService.ActiveProfile.NourishGardenSkill(
                    "acad_math_balance", 
                    "Maths & Lever Balance", 
                    OutcomeCategory.Academic, 
                    30, 
                    $"Balanced Island {CurrentRound} with weight {targetTorque}."
                );
                await ProgressService.RecordChallengeAttemptAsync(SkillCategory.Numbers, true, 2);
            }
        }
        else if (currentTorque < targetTorque)
        {
            var diff = targetTorque - currentTorque;
            beamAngle = Math.Min(16, 4 + diff * 2);
        }
        else
        {
            var diff = currentTorque - targetTorque;
            beamAngle = -Math.Min(16, 4 + diff * 2);
        }

        StateHasChanged();
    }

    private async Task AdvanceIsland()
    {
        if (CurrentRound < 5)
        {
            await SkipRoundAsync();
        }
        else
        {
            await AudioService.PlaySoundAsync(SoundEffect.Fanfare);
            await ReturnToMapAsync();
        }
    }

    private async Task HandlePracticeChoice(string choice)
    {
        if (choice.Contains("Add 1")) await AddWeight(1, 1, "1");
        else if (choice.Contains("Add 2")) await AddWeight(2, 1, "2");
        else if (choice.Contains("Add 3")) await AddWeight(3, 1, "3");
        else ResetWeights();
    }

    private MicButton.MicState GetMicButtonState()
    {
        if (isBalanced) return MicButton.MicState.Done;
        if (VoiceManager.IsListening) return MicButton.MicState.Listening;
        return MicButton.MicState.Ready;
    }
}
