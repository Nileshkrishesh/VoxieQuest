@page "/game/number-jump"
@page "/game/frog"
@inherits BaseGameComponent

<GameShell GameTitle="@GameTitle"
           CurrentRound="@CurrentRound"
           TotalRounds="@TotalRounds"
           Stars="@SessionStars"
           Theme="ParallaxBackground.ParallaxTheme.Hills"
           ThemeClass="frog-theme"
           Prompt="@(ActiveChallenge?.Prompt ?? "Solve the sum and say the number to hop!")"
           HintText="@(ActiveChallenge?.Hint ?? string.Empty)"
           ShowHint="@(AttemptState.ShowHint && !string.IsNullOrWhiteSpace(ActiveChallenge?.Hint))"
           MascotMood="@MascotState"
           IsListening="@VoiceManager.IsListening"
           VolumeLevel="@CurrentVolume"
           MicButtonState="@(IsBusyAnimating ? MicState.Success : VoiceManager.CurrentState)"
           IsPracticeMode="@(VoiceManager.CurrentEngine == VoiceEngineType.PracticeManual)"
           PracticeChoices="@GetPracticeChoices()"
           ShowSuccessBurst="@ShowStarBurst"
           ShowEncourageBurst="@(AttemptState.AttemptCount > 0 && !LastAnswerSuccess && !AttemptState.IsExhausted)"
           IsRewardOpen="@IsRewardScreenOpen"
           StarsEarned="@(SessionStars >= 6 ? 3 : (SessionStars >= 3 ? 2 : 1))"
           IsMicDenied="false"
           VoiceErrorMessage="@VoiceErrorMessage"
           HeardTranscript="@LastTranscript"
           LastResultStatus="@(AttemptState.AttemptCount > 0 ? (bool?)LastAnswerSuccess : (LastAnswerSuccess ? (bool?)true : null))"
           OnBack="ReturnToMapAsync"
           OnRepeatPrompt="RepeatPromptAloudAsync"
           OnToggleListening="ToggleListeningAsync"
           OnSelectPracticeChoice="SubmitManualAnswerAsync"
           OnPlayAgain="StartGameSessionAsync"
           OnNextQuest="ReturnToMapAsync"
           OnSwitchToPractice="SwitchToPracticeMode">

    <SceneContent>
        <!-- Scaling Sunny Pond Scene with Lily Pads and Hopping Frog -->
        <div class="pond-stage-wrapper">
            <div class="sunny-pond-canvas">
                <!-- Layered Hills, Sky and Dragonflies SVG -->
                <svg class="pond-skyline-svg" viewBox="0 0 600 180" preserveAspectRatio="none" fill="none">
                    <!-- Distant Green Hills -->
                    <path d="M0 80C120 40 240 70 360 45C460 25 540 60 600 50V180H0V80Z" fill="#C8F2D5" stroke="#2B2D42" stroke-width="2.5"/>
                    <!-- Foreground Pond Meadow -->
                    <path d="M0 110C100 95 250 115 400 90C500 75 560 100 600 95V180H0V110Z" fill="#7ED9A8" stroke="#2B2D42" stroke-width="2.5"/>
                    <!-- Pond Water Lagoon -->
                    <path d="M0 135C150 125 320 140 480 128C540 124 580 132 600 130V180H0V135Z" fill="#5BC0EB" stroke="#2B2D42" stroke-width="3"/>

                    <!-- Fluttering Dragonflies in Background -->
                    <g class="dragonfly-fly-1">
                        <ellipse cx="140" cy="50" rx="12" ry="2.5" fill="#FFC93C" stroke="#2B2D42" stroke-width="1.2"/>
                        <ellipse cx="136" cy="45" rx="8" ry="3" fill="#FFF8E7" opacity="0.8"/>
                        <ellipse cx="144" cy="45" rx="8" ry="3" fill="#FFF8E7" opacity="0.8"/>
                    </g>
                    <g class="dragonfly-fly-2">
                        <ellipse cx="440" cy="65" rx="10" ry="2.2" fill="#FF6B6B" stroke="#2B2D42" stroke-width="1.2"/>
                        <ellipse cx="437" cy="61" rx="7" ry="2.5" fill="#FFF8E7" opacity="0.8"/>
                        <ellipse cx="443" cy="61" rx="7" ry="2.5" fill="#FFF8E7" opacity="0.8"/>
                    </g>
                </svg>

                <!-- Big Chunky Equation Sticker -->
                <div class="equation-pill storybook-card-tilt">
                    <span class="equation-label">@(ActiveChallenge?.DisplayItem ?? "1 + 1 = ?")</span>
                </div>

                <!-- Water Lily Pads Container -->
                <div class="lily-pad-pond-row">
                    @for (int i = 0; i < padNumbers.Count; i++)
                    {
                        var padNum = padNumbers[i];
                        var isTarget = ActiveChallenge != null && padNum == ActiveChallenge.FrogTargetNumber;

                        <div class="lily-pad-anchor" style="left: @(GetPadLeftPercent(padNum))%;">
                            @if (isFrogLanding && isTarget)
                            {
                                <div class="water-ripple-ring"></div>
                            }

                            <!-- Tactile SVG Lily Pad with Flower -->
                            <svg class="lily-pad-svg" viewBox="0 0 90 54" fill="none">
                                <path d="M45 4C22 4 4 14 4 27C4 39 22 49 45 49C68 49 86 39 86 27C86 22 82 17 76 13L45 27L55 8C52 5 48 4 45 4Z" 
                                      fill="#7ED9A8" stroke="#2B2D42" stroke-width="3.5" stroke-linejoin="round"/>
                                <circle cx="24" cy="18" r="5" fill="#FF6B6B" stroke="#2B2D42" stroke-width="1.8"/>
                                <circle cx="24" cy="18" r="2.5" fill="#FFC93C"/>
                                <text x="48" y="42" font-family="var(--font-heading)" font-size="20" font-weight="700" fill="#2B2D42" text-anchor="middle">
                                    @padNum
                                </text>
                            </svg>

                            <!-- Idle Frog Sitting on Pad -->
                            @if (currentFrogPad == padNum && !isHopping)
                            {
                                <div class="frog-passenger frog-idle-bounce">
                                    <svg class="frog-body-svg" viewBox="0 0 64 56" fill="none">
                                        <ellipse cx="32" cy="35" rx="22" ry="16" fill="#7ED9A8" stroke="#2B2D42" stroke-width="3.5"/>
                                        <ellipse cx="32" cy="38" rx="14" ry="10" fill="#FFF8E7"/>

                                        <circle cx="21" cy="18" r="9" fill="#7ED9A8" stroke="#2B2D42" stroke-width="3.5"/>
                                        <circle cx="21" cy="18" r="5.5" fill="#FFFFFF"/>
                                        <circle cx="22" cy="17" r="2.5" fill="#2B2D42"/>

                                        <circle cx="43" cy="18" r="9" fill="#7ED9A8" stroke="#2B2D42" stroke-width="3.5"/>
                                        <circle cx="43" cy="18" r="5.5" fill="#FFFFFF"/>
                                        <circle cx="44" cy="17" r="2.5" fill="#2B2D42"/>

                                        <path d="M24 33C28 37 36 37 40 33" stroke="#2B2D42" stroke-width="2.5" stroke-linecap="round"/>
                                        <circle cx="17" cy="33" r="3" fill="#FF6B6B" opacity="0.7"/>
                                        <circle cx="47" cy="33" r="3" fill="#FF6B6B" opacity="0.7"/>
                                    </svg>
                                </div>
                            }
                        </div>
                    }

                    <!-- Flying Frog in Mid-Air Leap -->
                    @if (isHopping && ActiveChallenge != null)
                    {
                        <div class="frog-leaper anim-frog-jump"
                             style="--hop-start: @(GetPadLeftPercent(currentFrogPad))%; --hop-end: @(GetPadLeftPercent(ActiveChallenge.FrogTargetNumber))%;">
                            <svg class="frog-body-svg" viewBox="0 0 64 56" fill="none">
                                <ellipse cx="32" cy="32" rx="20" ry="14" fill="#7ED9A8" stroke="#2B2D42" stroke-width="3.5"/>
                                <circle cx="21" cy="16" r="8" fill="#7ED9A8" stroke="#2B2D42" stroke-width="3.5"/>
                                <circle cx="21" cy="16" r="5" fill="#FFFFFF"/>
                                <circle cx="22" cy="15" r="2" fill="#2B2D42"/>

                                <circle cx="43" cy="16" r="8" fill="#7ED9A8" stroke="#2B2D42" stroke-width="3.5"/>
                                <circle cx="43" cy="16" r="5" fill="#FFFFFF"/>
                                <circle cx="44" cy="15" r="2" fill="#2B2D42"/>

                                <ellipse cx="32" cy="34" rx="4" ry="5" fill="#FF6B6B" stroke="#2B2D42" stroke-width="2"/>
                            </svg>
                        </div>
                    }
                </div>
            </div>
        </div>
    </SceneContent>
</GameShell>

<style>
    .pond-stage-wrapper {
        width: 100%;
        height: 100%;
        max-width: 560px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
    }

    .sunny-pond-canvas {
        width: 100%;
        height: 100%;
        max-height: clamp(140px, 28vh, 230px);
        background: var(--color-bg-sky);
        border: var(--border-storybook);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-hard-md);
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-end;
    }

    .pond-skyline-svg {
        position: absolute;
        top: 0; left: 0; width: 100%; height: 100%;
        pointer-events: none;
    }

    .equation-pill {
        position: absolute;
        top: clamp(8px, 1.8vh, 14px);
        left: clamp(10px, 3vw, 20px);
        background: var(--color-sunny-yellow);
        border: var(--border-storybook);
        border-radius: var(--radius-sm);
        padding: clamp(0.2rem, 1vh, 0.4rem) clamp(0.6rem, 2vw, 1.2rem);
        box-shadow: var(--shadow-hard-sm);
        z-index: 5;
    }

    .equation-label {
        font-family: var(--font-heading);
        font-size: clamp(1.2rem, 3.5vw, 2rem);
        font-weight: 700;
        color: var(--color-storybook-ink);
        letter-spacing: 0.04em;
    }

    .lily-pad-pond-row {
        position: relative;
        width: 100%;
        height: clamp(80px, 15vh, 120px);
        z-index: 3;
    }

    .lily-pad-anchor {
        position: absolute;
        bottom: clamp(6px, 1.5vh, 14px);
        transform: translateX(-50%);
        width: clamp(56px, 14vw, 86px);
        height: clamp(34px, 8vh, 52px);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .lily-pad-svg {
        width: 100%;
        height: 100%;
    }

    .frog-passenger {
        position: absolute;
        bottom: clamp(16px, 4vh, 24px);
        width: clamp(36px, 9vw, 54px);
        height: clamp(32px, 8vh, 48px);
    }

    .frog-body-svg {
        width: 100%;
        height: 100%;
    }

    .frog-leaper {
        position: absolute;
        width: clamp(40px, 10vw, 58px);
        height: clamp(34px, 9vh, 50px);
        z-index: 10;
        pointer-events: none;
    }

    .water-ripple-ring {
        position: absolute;
        bottom: -4px;
        width: clamp(50px, 12vw, 80px);
        height: clamp(18px, 4vh, 26px);
        border-radius: 50%;
        border: 3px solid var(--color-sky-blue);
        animation: ripple-bloom 0.6s ease-out forwards;
    }

    /* Animation States */
    .frog-idle-bounce {
        animation: frog-squish-breathe 2s infinite ease-in-out alternate;
    }

    .anim-frog-jump {
        animation: frog-parabolic-leap 1.1s var(--spring-squish) forwards;
    }

    .dragonfly-fly-1 { animation: dragonfly-drift 4s infinite ease-in-out alternate; }
    .dragonfly-fly-2 { animation: dragonfly-drift 3.5s infinite ease-in-out alternate-reverse; }

    @@keyframes frog-squish-breathe {
        0% { transform: scale(1, 1); }
        100% { transform: scale(1.05, 0.95); }
    }

    @@keyframes frog-parabolic-leap {
        0% { left: var(--hop-start); bottom: 20px; transform: scale(1, 1) rotate(0deg); }
        30% { left: calc(var(--hop-start) + (var(--hop-end) - var(--hop-start)) * 0.3); bottom: 90px; transform: scale(0.9, 1.2) rotate(-15deg); }
        70% { left: calc(var(--hop-start) + (var(--hop-end) - var(--hop-start)) * 0.7); bottom: 85px; transform: scale(1.1, 0.9) rotate(15deg); }
        100% { left: var(--hop-end); bottom: 20px; transform: scale(1.2, 0.8) rotate(0deg); }
    }

    @@keyframes ripple-bloom {
        0% { transform: scale(0.3); opacity: 1; }
        100% { transform: scale(1.6); opacity: 0; }
    }

    @@keyframes dragonfly-drift {
        0% { transform: translate(0, 0); }
        100% { transform: translate(30px, -15px); }
    }
</style>

@code {
    protected override SkillCategory GameCategory => SkillCategory.Numbers;
    protected override string GameTitle => "Number Jump";

    private bool isHopping = false;
    private bool isFrogLanding = false;
    private int currentFrogPad = 1;
    private List<int> padNumbers = new() { 1, 2, 3, 4, 5 };

    private static readonly (string Equation, int Answer, string Clue)[] EasySums = new[]
    {
        ("1 + 1 = ?", 2, "One plus one"), ("2 + 1 = ?", 3, "Two plus one"),
        ("3 + 1 = ?", 4, "Three plus one"), ("2 + 2 = ?", 4, "Double two"),
        ("3 + 2 = ?", 5, "Three plus two"), ("4 + 1 = ?", 5, "Four plus one"),
        ("1 + 2 = ?", 3, "One plus two"), ("1 + 3 = ?", 4, "One plus three"),
        ("2 + 3 = ?", 5, "Two plus three"), ("4 + 0 = ?", 4, "Four plus zero")
    };

    private static readonly (string Equation, int Answer, string Clue)[] MediumSums = new[]
    {
        ("4 + 2 = ?", 6, "Four plus two"), ("5 + 3 = ?", 8, "Five plus three"),
        ("6 + 2 = ?", 8, "Six plus two"), ("5 + 5 = ?", 10, "Both hands together"),
        ("7 + 2 = ?", 9, "Seven plus two"), ("4 + 4 = ?", 8, "Double four"),
        ("6 + 3 = ?", 9, "Six plus three"), ("7 + 1 = ?", 8, "Seven plus one"),
        ("3 + 4 = ?", 7, "Three plus four"), ("5 + 4 = ?", 9, "Five plus four")
    };

    private static readonly (string Equation, int Answer, string Clue)[] HardSums = new[]
    {
        ("8 + 4 = ?", 12, "Eight plus four"), ("10 + 2 = ?", 12, "Ten plus two"),
        ("9 + 5 = ?", 14, "Nine plus five"), ("10 + 5 = ?", 15, "Ten plus five"),
        ("12 - 2 = ?", 10, "Twelve take away two"), ("15 - 5 = ?", 10, "Fifteen take away five"),
        ("8 + 8 = ?", 16, "Double eight"), ("11 + 4 = ?", 15, "Eleven plus four"),
        ("14 - 4 = ?", 10, "Fourteen take away four"), ("10 + 10 = ?", 20, "Double ten")
    };

    protected override Task<GameChallenge> GenerateChallengeAsync(int round, DifficultyLevel difficulty)
    {
        var index = (round - 1) % 10;
        (string Equation, int Answer, string Clue) item;

        if (difficulty == DifficultyLevel.Hard)
        {
            item = HardSums[index];
        }
        else if (difficulty == DifficultyLevel.Medium)
        {
            item = MediumSums[index];
        }
        else
        {
            item = EasySums[index];
        }

        var targetAns = item.Answer;
        var startPad = Math.Max(1, targetAns - 2);
        padNumbers = Enumerable.Range(startPad, 5).ToList();
        currentFrogPad = padNumbers[0];

        var wordForm = NumberToWords(targetAns);

        var challenge = new GameChallenge
        {
            Id = $"numjump_{round}_{index}",
            Category = SkillCategory.Numbers,
            Difficulty = difficulty,
            Prompt = $"Solve the puzzle: {item.Equation.Replace("= ?", "")}! Speak the answer number!",
            TargetAnswer = targetAns.ToString(),
            AcceptedAnswers = new() { targetAns.ToString(), wordForm, $"number {targetAns}", $"it is {targetAns}", $"it's {targetAns}" },
            DisplayItem = item.Equation,
            FrogStartNumber = currentFrogPad,
            FrogTargetNumber = targetAns,
            Hint = item.Clue,
            RewardStars = difficulty == DifficultyLevel.Hard ? 3 : (difficulty == DifficultyLevel.Medium ? 2 : 1)
        };

        return Task.FromResult(challenge);
    }

    private List<string> GetPracticeChoices()
    {
        if (ActiveChallenge == null) return new();
        return padNumbers.Select(p => p.ToString()).Take(4).ToList();
    }

    protected override async Task OnChallengeSolvedAsync(GameChallenge challenge)
    {
        isHopping = true;
        StateHasChanged();

        await Task.Delay(1100);

        isHopping = false;
        currentFrogPad = challenge.FrogTargetNumber;
        isFrogLanding = true;
        await AudioService.PlaySoundAsync(SoundEffect.Pop);
        StateHasChanged();

        await Task.Delay(500);
        isFrogLanding = false;
    }

    private int GetPadLeftPercent(int padNum)
    {
        var idx = padNumbers.IndexOf(padNum);
        if (idx < 0) idx = 0;
        return 10 + (idx * 18);
    }

    private static string NumberToWords(int number) => number switch
    {
        1 => "one", 2 => "two", 3 => "three", 4 => "four", 5 => "five",
        6 => "six", 7 => "seven", 8 => "eight", 9 => "nine", 10 => "ten",
        11 => "eleven", 12 => "twelve", 13 => "thirteen", 14 => "fourteen",
        15 => "fifteen", 16 => "sixteen", 20 => "twenty",
        _ => number.ToString()
    };
}
