@page "/game/number-jump"
@page "/game/frog"
@inherits BaseGameComponent

<div class="game-viewport">
    <ParallaxBackground Theme="ParallaxBackground.ParallaxTheme.Hills" />

    <!-- Top HUD: Round 1 to 10 & Stars -->
    <div class="storybook-card game-hud-card">
        <div style="display:flex; justify-content:space-between; align-items:center;">
            <button class="pill" @onclick="ReturnToMapAsync" type="button">
                <span>◀ Map</span>
            </button>
            <h3 style="margin:0; font-size:1.4rem; color:var(--color-storybook-ink);">
                🐸 @GameTitle
            </h3>
            <div class="star-badge">
                <span>⭐</span>
                <span>@SessionStars</span>
            </div>
        </div>

        <div class="round-stepper">
            @for (int r = 1; r <= TotalRounds; r++)
            {
                var isCompleted = r < CurrentRound;
                var isCurrent = r == CurrentRound;
                <div class="round-dot @(isCompleted ? "completed" : "") @(isCurrent ? "current" : "")" title="Round @r">
                    @(isCompleted ? "★" : r.ToString())
                </div>
            }
        </div>
    </div>

    @if (ActiveChallenge != null)
    {
        <div class="storybook-card river-stage">
            <!-- Mascot and Spoken Sum Prompt -->
            <div class="mascot-stage" style="justify-content:center; position:relative; margin-bottom:1rem;">
                <Mascot State="@MascotState" Width="120" Height="120" />
                <StarBurst IsActive="@ShowStarBurst" />
                
                <div class="speech-bubble" style="max-width:440px;">
                    <span style="font-size:1.3rem;">@ActiveChallenge.Prompt</span>
                    <div style="margin-top:0.4rem; display:flex; gap:0.5rem;">
                        <button class="pill" @onclick="RepeatPromptAloudAsync" type="button" style="font-size:0.85rem;">
                            <span>🔊 Read Aloud</span>
                        </button>
                        @if (AttemptState.ShowHint && !string.IsNullOrWhiteSpace(ActiveChallenge.Hint))
                        {
                            <span class="pill" style="background:#FFE5EC; color:var(--color-coral); border-color:var(--color-coral); font-size:0.85rem;">
                                💡 @ActiveChallenge.Hint
                            </span>
                        }
                    </div>
                </div>
            </div>

            <!-- River Scene with Lily Pads and Hopping Frog -->
            <div class="river-pond-arena">
                <!-- Floating Equation Badge -->
                <div class="equation-banner">
                    <span>@ActiveChallenge.DisplayItem</span>
                </div>

                <!-- Lily Pads Row in River -->
                <div class="lily-pads-container">
                    @for (int i = 0; i < padNumbers.Count; i++)
                    {
                        var padNum = padNumbers[i];
                        var isTarget = padNum == ActiveChallenge.FrogTargetNumber;
                        var isStart = padNum == currentFrogPad;

                        <div class="lily-pad-slot" style="left:@(10 + (i * 18))%;">
                            <!-- SVG Lily Pad -->
                            <svg width="84" height="48" viewBox="0 0 90 50" fill="none">
                                <!-- Water Ripple if frog landed here -->
                                @if (isFrogLanding && isTarget)
                                {
                                    <ellipse cx="45" cy="25" rx="42" ry="22" stroke="#4EA8DE" stroke-width="3" stroke-dasharray="4 4" class="anim-ripple"/>
                                }
                                <!-- Green Lily Pad with Notch -->
                                <path d="M45 4C22 4 4 13 4 25C4 36 22 46 45 46C67 46 86 36 86 25C86 21 82 17 76 13L45 25L55 8C52 5 48 4 45 4Z" 
                                      fill="#06D6A0" stroke="#2B2D42" stroke-width="3.5"/>
                                <!-- Lily Pad Flower -->
                                <circle cx="28" cy="18" r="4.5" fill="#FFD166"/>
                                <!-- Number Label -->
                                <text x="45" y="38" font-family="var(--font-heading)" font-size="16" font-weight="700" fill="#2B2D42" text-anchor="middle">
                                    @padNum
                                </text>
                            </svg>

                            <!-- Frog Sitting on its Pad -->
                            @if (currentFrogPad == padNum && !isHopping)
                            {
                                <div class="frog-avatar anim-frog-idle">
                                    <svg width="60" height="52" viewBox="0 0 60 52" fill="none">
                                        <!-- Frog Body -->
                                        <ellipse cx="30" cy="32" rx="20" ry="15" fill="#06D6A0" stroke="#2B2D42" stroke-width="3.5"/>
                                        <ellipse cx="30" cy="35" rx="12" ry="9" fill="#FFF9DB"/>

                                        <!-- Big Frog Eyes -->
                                        <circle cx="20" cy="16" r="8" fill="#06D6A0" stroke="#2B2D42" stroke-width="3"/>
                                        <circle cx="20" cy="16" r="5" fill="#FFFDF7"/>
                                        <circle cx="21" cy="15" r="2.5" fill="#2B2D42"/>

                                        <circle cx="40" cy="16" r="8" fill="#06D6A0" stroke="#2B2D42" stroke-width="3"/>
                                        <circle cx="40" cy="16" r="5" fill="#FFFDF7"/>
                                        <circle cx="41" cy="15" r="2.5" fill="#2B2D42"/>

                                        <!-- Frog Smile -->
                                        <path d="M22 30C26 34 34 34 38 30" stroke="#2B2D42" stroke-width="2.5" stroke-linecap="round"/>
                                        <!-- Rosy Cheeks -->
                                        <circle cx="16" cy="30" r="3" fill="#EF476F" opacity="0.6"/>
                                        <circle cx="44" cy="30" r="3" fill="#EF476F" opacity="0.6"/>
                                    </svg>
                                </div>
                            }
                        </div>
                    }

                    <!-- Animated Flying / Jumping Frog during jump -->
                    @if (isHopping)
                    {
                        <div class="frog-avatar anim-frog-leap" 
                             style="--hop-start: @(GetPadLeftPercent(currentFrogPad))%; --hop-end: @(GetPadLeftPercent(ActiveChallenge.FrogTargetNumber))%;">
                            <svg width="68" height="58" viewBox="0 0 60 52" fill="none">
                                <ellipse cx="30" cy="30" rx="18" ry="14" fill="#06D6A0" stroke="#2B2D42" stroke-width="3.5"/>
                                <circle cx="20" cy="15" r="7" fill="#06D6A0" stroke="#2B2D42" stroke-width="3"/>
                                <circle cx="20" cy="15" r="4.5" fill="#FFFDF7"/>
                                <circle cx="21" cy="14" r="2" fill="#2B2D42"/>
                                <circle cx="40" cy="15" r="7" fill="#06D6A0" stroke="#2B2D42" stroke-width="3"/>
                                <circle cx="40" cy="15" r="4.5" fill="#FFFDF7"/>
                                <circle cx="41" cy="14" r="2" fill="#2B2D42"/>
                                <!-- Happy Hop Mouth -->
                                <ellipse cx="30" cy="32" rx="4" ry="5" fill="#EF476F" stroke="#2B2D42" stroke-width="2"/>
                            </svg>
                        </div>
                    }
                </div>
            </div>

            <!-- Speech Feedback Display -->
            <div style="min-height:48px; margin: 0.5rem 0;">
                @if (!string.IsNullOrWhiteSpace(LastTranscript))
                {
                    <div class="pill" style="background:@(LastAnswerSuccess ? "var(--color-mint)" : "var(--color-sunny-yellow)"); font-size:1.15rem;">
                        @(LastAnswerSuccess ? "🌟 Ribbit! You said: " : "👂 You said: ") "@LastTranscript"
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(AttemptState.FeedbackMessage))
                {
                    <div style="color:var(--color-coral); font-family:var(--font-heading); font-weight:700; font-size:1.1rem; margin-top:0.3rem;">
                        @AttemptState.FeedbackMessage
                    </div>
                }
            </div>

            <!-- Mic Character or Practice Mode -->
            @if (VoiceManager.Mode == VoiceMode.PracticeButtons || VoiceManager.CurrentEngine == VoiceEngineType.PracticeManual)
            {
                <PracticeInputPanel Question="@(new QuestionItem { TargetAnswer = ActiveChallenge.TargetAnswer, Category = GameCategory })" 
                                    OnAnswerSelected="SubmitManualAnswerAsync" />
            }
            else
            {
                <div style="margin: 0.5rem 0;">
                    <MicCharacter VolumeLevel="@CurrentVolume" IsListening="@VoiceManager.IsListening" OnClick="ToggleListeningAsync" />
                </div>
            }

            <div style="margin-top:1rem; display:flex; justify-content:center; gap:0.75rem;">
                <button class="pill" @onclick="SkipRoundAsync" type="button" style="opacity:0.8;">
                    <span>Next Sum ➔</span>
                </button>
            </div>
        </div>
    }
</div>

<Confetti IsActive="@IsRewardScreenOpen" />
<CelebrationModal IsVisible="@IsRewardScreenOpen" 
                  StarsEarned="@SessionStars" 
                  OnPlayAgain="StartGameSessionAsync" 
                  OnReturnHome="ReturnToMapAsync" />

<style>
    .river-stage {
        text-align: center;
        background: linear-gradient(180deg, #FFFDF7 0%, #E0F2FE 100%);
        overflow: hidden;
    }

    .river-pond-arena {
        position: relative;
        height: 250px;
        background: #BAE6FD;
        border: 4px solid var(--color-storybook-ink);
        border-radius: var(--border-radius-lg);
        box-shadow: inset 0 6px 0 rgba(43, 45, 66, 0.1);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 1rem;
        overflow: hidden;
    }

    .equation-banner {
        align-self: center;
        background: white;
        border: 3.5px solid var(--color-storybook-ink);
        border-radius: var(--border-radius-pill);
        box-shadow: 0 4px 0 var(--color-storybook-ink);
        padding: 0.4rem 1.6rem;
        font-family: var(--font-heading);
        font-size: 2rem;
        font-weight: 700;
        color: var(--color-storybook-ink);
        z-index: 10;
    }

    .lily-pads-container {
        position: relative;
        width: 100%;
        height: 120px;
    }

    .lily-pad-slot {
        position: absolute;
        bottom: 10px;
        transform: translateX(-50%);
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .frog-avatar {
        position: absolute;
        bottom: 25px;
        z-index: 20;
    }

    .anim-frog-idle {
        animation: frog-breathing 2s ease-in-out infinite alternate;
    }

    .anim-frog-leap {
        animation: frog-parabolic-jump 1.1s cubic-bezier(0.25, 1, 0.5, 1) forwards;
    }

    .anim-ripple {
        animation: ripple-grow 1.2s ease-out infinite;
    }

    @@keyframes frog-breathing {
        0% { transform: scale(1, 1); }
        100% { transform: scale(1.04, 0.96) translateY(2px); }
    }

    @@keyframes frog-parabolic-jump {
        0% {
            left: var(--hop-start);
            bottom: 25px;
            transform: translateX(-50%) scale(1.2, 0.8);
        }
        40% {
            bottom: 95px;
            transform: translateX(-50%) scale(0.9, 1.2) rotate(15deg);
        }
        80% {
            bottom: 30px;
            transform: translateX(-50%) scale(1.1, 0.9);
        }
        100% {
            left: var(--hop-end);
            bottom: 25px;
            transform: translateX(-50%) scale(1, 1);
        }
    }

    @@keyframes ripple-grow {
        0% { transform: scale(0.7); opacity: 1; }
        100% { transform: scale(1.4); opacity: 0; }
    }
</style>

@code {
    protected override SkillCategory GameCategory => SkillCategory.Numbers;
    protected override string GameTitle => "Number Jump";

    private bool isHopping = false;
    private bool isFrogLanding = false;
    private int currentFrogPad = 1;
    private List<int> padNumbers = new() { 1, 2, 3, 4, 5 };

    private static readonly (string Equation, int Answer, string Clue)[] EasySums = new[]
    {
        ("1 + 1 = ?", 2, "One plus one"), ("2 + 1 = ?", 3, "Two plus one"),
        ("3 + 1 = ?", 4, "Three plus one"), ("2 + 2 = ?", 4, "Double two"),
        ("3 + 2 = ?", 5, "Three plus two"), ("4 + 1 = ?", 5, "Four plus one"),
        ("1 + 2 = ?", 3, "One plus two"), ("1 + 3 = ?", 4, "One plus three"),
        ("2 + 3 = ?", 5, "Two plus three"), ("4 + 0 = ?", 4, "Four plus zero")
    };

    private static readonly (string Equation, int Answer, string Clue)[] MediumSums = new[]
    {
        ("4 + 2 = ?", 6, "Four plus two"), ("5 + 3 = ?", 8, "Five plus three"),
        ("6 + 2 = ?", 8, "Six plus two"), ("5 + 5 = ?", 10, "Both hands together"),
        ("7 + 2 = ?", 9, "Seven plus two"), ("4 + 4 = ?", 8, "Double four"),
        ("6 + 3 = ?", 9, "Six plus three"), ("7 + 1 = ?", 8, "Seven plus one"),
        ("3 + 4 = ?", 7, "Three plus four"), ("5 + 4 = ?", 9, "Five plus four")
    };

    private static readonly (string Equation, int Answer, string Clue)[] HardSums = new[]
    {
        ("8 + 4 = ?", 12, "Eight plus four"), ("10 + 2 = ?", 12, "Ten plus two"),
        ("9 + 5 = ?", 14, "Nine plus five"), ("10 + 5 = ?", 15, "Ten plus five"),
        ("12 - 2 = ?", 10, "Twelve take away two"), ("15 - 5 = ?", 10, "Fifteen take away five"),
        ("8 + 8 = ?", 16, "Double eight"), ("11 + 4 = ?", 15, "Eleven plus four"),
        ("14 - 4 = ?", 10, "Fourteen take away four"), ("10 + 10 = ?", 20, "Double ten")
    };

    protected override Task<GameChallenge> GenerateChallengeAsync(int round, DifficultyLevel difficulty)
    {
        var index = (round - 1) % 10;
        (string Equation, int Answer, string Clue) item;

        if (difficulty == DifficultyLevel.Hard)
        {
            item = HardSums[index];
        }
        else if (difficulty == DifficultyLevel.Medium)
        {
            item = MediumSums[index];
        }
        else
        {
            item = EasySums[index];
        }

        // Configure 5 visible lily pads around the answer
        var targetAns = item.Answer;
        var startPad = Math.Max(1, targetAns - 2);
        padNumbers = Enumerable.Range(startPad, 5).ToList();
        currentFrogPad = padNumbers[0];

        var wordForm = NumberToWords(targetAns);

        var challenge = new GameChallenge
        {
            Id = $"numjump_{round}_{index}",
            Category = SkillCategory.Numbers,
            Difficulty = difficulty,
            Prompt = $"Solve the puzzle: {item.Equation.Replace("= ?", "")}! Speak the answer number!",
            TargetAnswer = targetAns.ToString(),
            AcceptedAnswers = new() { targetAns.ToString(), wordForm, $"number {targetAns}", $"it is {targetAns}", $"it's {targetAns}" },
            DisplayItem = item.Equation,
            FrogStartNumber = currentFrogPad,
            FrogTargetNumber = targetAns,
            Hint = item.Clue,
            RewardStars = difficulty == DifficultyLevel.Hard ? 3 : (difficulty == DifficultyLevel.Medium ? 2 : 1)
        };

        return Task.FromResult(challenge);
    }

    protected override async Task OnChallengeSolvedAsync(GameChallenge challenge)
    {
        // Animate frog jumping in high parabolic arc to target lily pad
        isHopping = true;
        StateHasChanged();

        await Task.Delay(1100);

        isHopping = false;
        currentFrogPad = challenge.FrogTargetNumber;
        isFrogLanding = true;
        await AudioService.PlaySoundAsync(SoundEffect.Pop);
        StateHasChanged();

        await Task.Delay(500);
        isFrogLanding = false;
    }

    private int GetPadLeftPercent(int padNum)
    {
        var idx = padNumbers.IndexOf(padNum);
        if (idx < 0) idx = 0;
        return 10 + (idx * 18);
    }

    private static string NumberToWords(int number) => number switch
    {
        1 => "one", 2 => "two", 3 => "three", 4 => "four", 5 => "five",
        6 => "six", 7 => "seven", 8 => "eight", 9 => "nine", 10 => "ten",
        11 => "eleven", 12 => "twelve", 13 => "thirteen", 14 => "fourteen",
        15 => "fifteen", 16 => "sixteen", 20 => "twenty",
        _ => number.ToString()
    };
}
