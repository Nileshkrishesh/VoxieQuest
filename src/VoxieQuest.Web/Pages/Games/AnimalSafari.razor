@page "/game/animal-safari"
@page "/game/safari"
@inherits BaseGameComponent

<div class="game-viewport">
    <ParallaxBackground Theme="ParallaxBackground.ParallaxTheme.Jungle" />

    <!-- Top HUD: Round 1 to 10 Stepper & Star Counter -->
    <div class="storybook-card game-hud-card">
        <div style="display:flex; justify-content:space-between; align-items:center;">
            <button class="pill" @onclick="ReturnToMapAsync" type="button">
                <span>◀ Map</span>
            </button>
            <h3 style="margin:0; font-size:1.4rem; color:var(--color-mint); text-shadow:0 1px 0 #fff;">
                🦁 @GameTitle
            </h3>
            <div class="star-badge">
                <span>⭐</span>
                <span>@SessionStars</span>
            </div>
        </div>

        <!-- 10 Round Stepper -->
        <div class="round-stepper">
            @for (int r = 1; r <= TotalRounds; r++)
            {
                var isCompleted = r < CurrentRound;
                var isCurrent = r == CurrentRound;
                <div class="round-dot @(isCompleted ? "completed" : "") @(isCurrent ? "current" : "")" title="Round @r">
                    @(isCompleted ? "★" : r.ToString())
                </div>
            }
        </div>
    </div>

    @if (ActiveChallenge != null)
    {
        <!-- Main Safari Expedition Stage -->
        <div class="storybook-card safari-stage">
            <!-- Voxie Safari Guide & Speech Bubble -->
            <div class="mascot-stage" style="justify-content:center; position:relative; margin-bottom:1rem;">
                <Mascot State="@MascotState" Width="120" Height="120" />
                <StarBurst IsActive="@ShowStarBurst" />

                <div class="speech-bubble" style="max-width:460px;">
                    <span style="font-size:1.25rem;">@ActiveChallenge.Prompt</span>
                    <div style="margin-top:0.4rem; display:flex; flex-wrap:wrap; gap:0.5rem; justify-content:center;">
                        <button class="pill" @onclick="PlayCurrentAnimalSoundAsync" type="button" style="font-size:0.9rem; background:var(--color-sunny-yellow);">
                            <span>🔊 Listen to Sound</span>
                        </button>
                        <button class="pill" @onclick="RepeatPromptAloudAsync" type="button" style="font-size:0.9rem;">
                            <span>🗣️ Repeat Prompt</span>
                        </button>
                        @if (AttemptState.ShowHint && !string.IsNullOrWhiteSpace(ActiveChallenge.Hint))
                        {
                            <span class="pill" style="background:#FFE5EC; color:var(--color-coral); border-color:var(--color-coral); font-size:0.85rem;">
                                💡 @ActiveChallenge.Hint
                            </span>
                        }
                    </div>
                </div>
            </div>

            <!-- Safari Visual Arena: Jeep, Rustling Bush / Discovered Animal -->
            <div class="safari-arena">
                <!-- Center Stage: The Animal Encounter -->
                <div class="encounter-zone">
                    @if (isAnimalDiscovered)
                    {
                        <!-- Revealed Happy Animal -->
                        <div class="discovered-animal-card animal-bounce-in">
                            <div class="animal-avatar-halo">
                                <span class="animal-emoji-large">@ActiveChallenge.AnimalEmoji</span>
                            </div>
                            <div class="animal-discovered-name">
                                @ActiveChallenge.TargetAnswer.ToUpperInvariant()!
                            </div>
                            <span class="pill" style="background:var(--color-mint); color:var(--color-storybook-ink); font-size:0.95rem; margin-top:0.35rem;">
                                ✨ Joining the Safari Caravan!
                            </span>
                        </div>
                    }
                    else
                    {
                        <!-- Mysterious Rustling Jungle Bush with sound waves -->
                        <div class="jungle-bush-container @(isListeningToAudio ? "bush-listening-glow" : "")" @onclick="PlayCurrentAnimalSoundAsync" title="Click to hear sound!">
                            <svg width="220" height="150" viewBox="0 0 220 150" fill="none" class="jungle-bush-svg @(isRustling ? "bush-shake" : "bush-idle")">
                                <!-- Sound Waves radiating from bush -->
                                @if (isListeningToAudio)
                                {
                                    <path d="M110 30 C 130 10, 160 10, 180 30" stroke="#FFD166" stroke-width="4" stroke-linecap="round" fill="none" class="sound-wave-pulse" />
                                    <path d="M100 20 C 130 -5, 170 -5, 200 20" stroke="#EF476F" stroke-width="3" stroke-linecap="round" fill="none" class="sound-wave-pulse" style="animation-delay:0.2s;" />
                                }

                                <!-- Back Foliage -->
                                <circle cx="65" cy="85" r="45" fill="#2D6A4F" stroke="#1B4332" stroke-width="4"/>
                                <circle cx="155" cy="85" r="45" fill="#2D6A4F" stroke="#1B4332" stroke-width="4"/>
                                <circle cx="110" cy="65" r="50" fill="#40916C" stroke="#1B4332" stroke-width="4"/>

                                <!-- Front Luscious Leaves -->
                                <circle cx="85" cy="100" r="38" fill="#52B788" stroke="#1B4332" stroke-width="4"/>
                                <circle cx="135" cy="100" r="38" fill="#52B788" stroke="#1B4332" stroke-width="4"/>
                                <circle cx="110" cy="95" r="32" fill="#74C69D" stroke="#1B4332" stroke-width="3.5"/>

                                <!-- Cute Peeking Eyes inside the bush -->
                                <g class="peeking-eyes">
                                    <ellipse cx="98" cy="85" rx="8" ry="11" fill="white" stroke="#1B4332" stroke-width="2.5"/>
                                    <ellipse cx="122" cy="85" rx="8" ry="11" fill="white" stroke="#1B4332" stroke-width="2.5"/>
                                    <circle cx="100" cy="85" r="4.5" fill="#1B4332"/>
                                    <circle cx="124" cy="85" r="4.5" fill="#1B4332"/>
                                    <circle cx="102" cy="82" r="1.5" fill="white"/>
                                    <circle cx="126" cy="82" r="1.5" fill="white"/>
                                </g>

                                <!-- Speaker Badge floating over the bush -->
                                <g transform="translate(85, 30)">
                                    <rect width="50" height="32" rx="16" fill="#FFD166" stroke="#2B2D42" stroke-width="3"/>
                                    <text x="25" y="22" font-size="18" text-anchor="middle">🔊</text>
                                </g>
                            </svg>
                            <div class="tap-hint-pill">
                                🔊 Tap to hear @ActiveChallenge.SoundOnomatopoeia!
                            </div>
                        </div>
                    }
                </div>

                <!-- Safari Caravan Train: Voxie's Jeep & trailing animal carts -->
                <div class="safari-caravan-strip">
                    <!-- Voxie's Expedition Jeep -->
                    <div class="safari-jeep-wrapper">
                        <svg width="170" height="95" viewBox="0 0 170 95" fill="none">
                            <!-- Jeep Body -->
                            <rect x="25" y="32" width="120" height="36" rx="10" fill="#FFD166" stroke="#2B2D42" stroke-width="4"/>
                            <!-- Jungle camouflage stripes -->
                            <path d="M48 34L40 66M78 34L70 66M108 34L100 66" stroke="#52B788" stroke-width="5" stroke-linecap="round"/>
                            <!-- Jeep Cabin Frame -->
                            <path d="M55 32L68 8H122L134 32" stroke="#2B2D42" stroke-width="4" stroke-linejoin="round" fill="none"/>
                            <!-- Roof Canopy -->
                            <rect x="60" y="4" width="68" height="8" rx="4" fill="#EF476F" stroke="#2B2D42" stroke-width="3"/>
                            <!-- Spare Tire on rear -->
                            <rect x="14" y="38" width="12" height="24" rx="4" fill="#2B2D42"/>
                            <!-- Headlight -->
                            <circle cx="145" cy="48" r="8" fill="#F8FAFC" stroke="#2B2D42" stroke-width="3"/>
                            <polygon points="152,44 168,36 168,60 152,52" fill="rgba(255, 230, 109, 0.45)"/>
                            <!-- Front & Back Wheels -->
                            <g class="jeep-wheel">
                                <circle cx="55" cy="68" r="16" fill="#2B2D42"/>
                                <circle cx="55" cy="68" r="7" fill="#CBD5E1" stroke="#2B2D42" stroke-width="2"/>
                            </g>
                            <g class="jeep-wheel">
                                <circle cx="120" cy="68" r="16" fill="#2B2D42"/>
                                <circle cx="120" cy="68" r="7" fill="#CBD5E1" stroke="#2B2D42" stroke-width="2"/>
                            </g>
                            <!-- Voxie Silhouette in Drivers Seat -->
                            <circle cx="95" cy="22" r="10" fill="#F78C6B" stroke="#2B2D42" stroke-width="2.5"/>
                            <polygon points="86,16 90,8 96,16" fill="#F78C6B" stroke="#2B2D42" stroke-width="2"/>
                            <polygon points="98,16 104,8 108,16" fill="#F78C6B" stroke="#2B2D42" stroke-width="2"/>
                        </svg>
                    </div>

                    <!-- Caravan Wagons holding rescued animals -->
                    <div class="safari-wagons-tray">
                        @if (_safariCaravan.Count == 0)
                        {
                            <div class="empty-caravan-hint">
                                <span>No animals in caravan yet. Call their names to invite them!</span>
                            </div>
                        }
                        else
                        {
                            @foreach (var member in _safariCaravan)
                            {
                                <div class="caravan-wagon wagon-pop-in" title="@member.Name">
                                    <div class="wagon-box">
                                        <span class="wagon-emoji">@member.Emoji</span>
                                    </div>
                                    <div class="wagon-label">@member.Name</div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            <!-- Speech Feedback Area (Never 'Wrong'!) -->
            <div style="min-height:50px; margin: 0.6rem 0;">
                @if (!string.IsNullOrWhiteSpace(LastTranscript))
                {
                    <div class="pill" style="background:@(LastAnswerSuccess ? "var(--color-mint)" : "var(--color-sunny-yellow)"); font-size:1.15rem;">
                        @(LastAnswerSuccess ? "🌟 Hooray! You said: " : "👂 You said: ") "@LastTranscript"
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(AttemptState.FeedbackMessage))
                {
                    <div style="color:var(--color-coral); font-family:var(--font-heading); font-weight:700; font-size:1.1rem; margin-top:0.35rem;">
                        @AttemptState.FeedbackMessage
                    </div>
                }
            </div>

            <!-- Voice Character or Practice Mode Fallback -->
            @if (VoiceManager.Mode == VoiceMode.PracticeButtons || VoiceManager.CurrentEngine == VoiceEngineType.PracticeManual)
            {
                <PracticeInputPanel Question="@(new QuestionItem { TargetAnswer = ActiveChallenge.TargetAnswer, Category = GameCategory })" 
                                    OnAnswerSelected="SubmitManualAnswerAsync" />
            }
            else
            {
                <div style="margin: 0.4rem 0;">
                    <MicCharacter VolumeLevel="@CurrentVolume" IsListening="@VoiceManager.IsListening" OnClick="ToggleListeningAsync" />
                </div>
            }

            <div style="margin-top:0.75rem; display:flex; justify-content:center; gap:0.75rem;">
                <button class="pill" @onclick="SkipRoundAsync" type="button" style="opacity:0.85;">
                    <span>Next Animal ➔</span>
                </button>
            </div>
        </div>
    }
</div>

<!-- Celebratory Confetti & 10-Round Reward Modal -->
<Confetti IsActive="@IsRewardScreenOpen" />
<CelebrationModal IsVisible="@IsRewardScreenOpen" 
                  StarsEarned="@SessionStars" 
                  OnPlayAgain="StartGameSessionAsync" 
                  OnReturnHome="ReturnToMapAsync" />

<style>
    .game-viewport {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        max-width: 780px;
        margin: 0 auto;
        position: relative;
    }

    .game-hud-card {
        padding: 0.85rem 1.4rem;
        background: rgba(255, 253, 247, 0.95);
    }

    .round-stepper {
        display: flex;
        justify-content: center;
        gap: 0.5rem;
        margin-top: 0.6rem;
    }

    .round-dot {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        border: 2.5px solid var(--color-storybook-ink);
        background: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: var(--font-heading);
        font-weight: 700;
        font-size: 0.85rem;
        color: var(--color-storybook-ink);
    }

    .round-dot.completed {
        background: var(--color-mint);
        color: var(--color-storybook-ink);
    }

    .round-dot.current {
        background: var(--color-sunny-yellow);
        transform: scale(1.15);
        box-shadow: 0 3px 0 var(--color-storybook-ink);
    }

    .safari-stage {
        text-align: center;
        background: var(--color-cream-paper);
        overflow: hidden;
    }

    .safari-arena {
        position: relative;
        min-height: 280px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
        padding: 0.5rem 0;
    }

    .encounter-zone {
        min-height: 165px;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
    }

    .jungle-bush-container {
        cursor: pointer;
        display: flex;
        flex-direction: column;
        align-items: center;
        transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .jungle-bush-container:hover {
        transform: scale(1.04);
    }

    .jungle-bush-svg {
        filter: drop-shadow(0 6px 0 rgba(43, 45, 66, 0.15));
    }

    .bush-idle {
        animation: gentle-sway 3s ease-in-out infinite alternate;
    }

    .bush-shake {
        animation: bush-rustle 0.4s ease-in-out infinite;
    }

    .bush-listening-glow {
        filter: drop-shadow(0 0 12px rgba(255, 209, 102, 0.85));
    }

    .tap-hint-pill {
        margin-top: 0.25rem;
        background: white;
        padding: 0.25rem 0.85rem;
        border-radius: 999px;
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--color-storybook-ink);
        border: 2px solid var(--color-storybook-ink);
        box-shadow: 0 2px 0 var(--color-storybook-ink);
    }

    .sound-wave-pulse {
        animation: sound-pulse 0.8s ease-out infinite;
    }

    .discovered-animal-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        background: white;
        border: 4px solid var(--color-storybook-ink);
        border-radius: 24px;
        padding: 1rem 1.8rem;
        box-shadow: 0 8px 0 var(--color-storybook-ink);
    }

    .animal-avatar-halo {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        background: #FEF3C7;
        border: 3.5px solid var(--color-storybook-ink);
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 0 var(--color-storybook-ink);
    }

    .animal-emoji-large {
        font-size: 3.8rem;
        line-height: 1;
    }

    .animal-discovered-name {
        font-family: var(--font-heading);
        font-size: 1.6rem;
        font-weight: 800;
        color: var(--color-storybook-ink);
        margin-top: 0.4rem;
        letter-spacing: 0.05em;
    }

    .animal-bounce-in {
        animation: animal-pop-jump 0.7s var(--spring-bounce) forwards;
    }

    /* Safari Caravan Strip */
    .safari-caravan-strip {
        display: flex;
        align-items: flex-end;
        width: 100%;
        overflow-x: auto;
        padding: 0.5rem 0.5rem 0.2rem 0.5rem;
        border-bottom: 3.5px dashed #CBD5E1;
        gap: 0.75rem;
        scrollbar-width: thin;
    }

    .safari-jeep-wrapper {
        flex-shrink: 0;
        animation: jeep-rumble 0.6s ease-in-out infinite alternate;
    }

    .safari-wagons-tray {
        display: flex;
        align-items: flex-end;
        gap: 0.6rem;
        flex-grow: 1;
        min-height: 75px;
    }

    .empty-caravan-hint {
        font-size: 0.9rem;
        font-style: italic;
        color: #64748B;
        padding-bottom: 0.8rem;
    }

    .caravan-wagon {
        display: flex;
        flex-direction: column;
        align-items: center;
        flex-shrink: 0;
    }

    .wagon-box {
        width: 52px;
        height: 44px;
        background: #DCFCE7;
        border: 3px solid var(--color-storybook-ink);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        box-shadow: 0 3px 0 var(--color-storybook-ink);
    }

    .wagon-emoji {
        font-size: 1.8rem;
    }

    .wagon-label {
        font-size: 0.75rem;
        font-family: var(--font-heading);
        font-weight: 700;
        color: var(--color-storybook-ink);
        margin-top: 0.15rem;
        text-transform: capitalize;
    }

    .wagon-pop-in {
        animation: wagon-hop 0.5s var(--spring-bounce);
    }

    @@keyframes gentle-sway {
        0% { transform: rotate(-2deg); }
        100% { transform: rotate(2deg); }
    }

    @@keyframes bush-rustle {
        0%, 100% { transform: translateX(0) scale(1); }
        25% { transform: translateX(-5px) rotate(-3deg) scale(1.02); }
        75% { transform: translateX(5px) rotate(3deg) scale(0.98); }
    }

    @@keyframes sound-pulse {
        0% { opacity: 0; transform: scale(0.85); }
        50% { opacity: 1; transform: scale(1.05); }
        100% { opacity: 0; transform: scale(1.25); }
    }

    @@keyframes animal-pop-jump {
        0% { transform: scale(0.3) translateY(40px); opacity: 0; }
        60% { transform: scale(1.15) translateY(-15px); opacity: 1; }
        80% { transform: scale(0.95) translateY(4px); }
        100% { transform: scale(1) translateY(0); }
    }

    @@keyframes jeep-rumble {
        0% { transform: translateY(0); }
        100% { transform: translateY(-2px); }
    }

    @@keyframes wagon-hop {
        0% { transform: scale(0.2) translateY(20px); opacity: 0; }
        100% { transform: scale(1) translateY(0); opacity: 1; }
    }
</style>

@code {
    protected override SkillCategory GameCategory => SkillCategory.Animals;
    protected override string GameTitle => "Animal Safari";

    private bool isAnimalDiscovered = false;
    private bool isRustling = false;
    private bool isListeningToAudio = false;

    private readonly List<(string Name, string Emoji)> _safariCaravan = new();
    private IReadOnlyList<QuestionItem>? _curriculumQuestions;

    private static readonly (string Animal, string SoundKey, string Emoji, string SoundText, string Hint)[] FallbackEasy = new[]
    {
        ("cat", "cat", "🐱", "Meow meow!", "A purring furry pet"),
        ("dog", "dog", "🐶", "Woof woof!", "A loyal friend who barks"),
        ("cow", "cow", "🐮", "Mooo!", "Gives milk and eats grass"),
        ("duck", "duck", "🦆", "Quack quack!", "Swims in the pond"),
        ("frog", "frog", "🐸", "Ribbit ribbit!", "Green lily pad hopper"),
        ("sheep", "sheep", "🐑", "Baaa baaa!", "Fluffy friend with wool"),
        ("pig", "pig", "🐷", "Oink oink!", "Pink and loves muddy puddles"),
        ("bird", "bird", "🐦", "Tweet tweet!", "Feathered singer in trees"),
        ("lion", "lion", "🦁", "Roooaar!", "Mighty king with a mane"),
        ("owl", "owl", "🦉", "Hoot hoot!", "Wise night bird with big eyes")
    };

    private static readonly (string Animal, string SoundKey, string Emoji, string SoundText, string Hint)[] FallbackMedium = new[]
    {
        ("elephant", "elephant", "🐘", "Paooov trumpet!", "Has a long trunk and big ears"),
        ("monkey", "monkey", "🐵", "Ooh ooh aah aah!", "Swings from vines and eats bananas"),
        ("wolf", "wolf", "🐺", "Awooooo!", "Howls at the moon in a pack"),
        ("bear", "bear", "🐻", "Grrr!", "Big furry fisher who loves honey"),
        ("rooster", "rooster", "🐓", "Cock-a-doodle-doo!", "Wakes up the farm at dawn"),
        ("horse", "horse", "🐴", "Neighhh!", "Gallops fast through green meadows"),
        ("bee", "bee", "🐝", "Bzzzz bzzzz!", "Makes sweet golden honey"),
        ("snake", "snake", "🐍", "Hissss!", "Slithers silently through the grass"),
        ("donkey", "donkey", "🫏", "Hee-haw!", "Helpful farm friend with long ears"),
        ("dolphin", "dolphin", "🐬", "Click-whistle!", "Playful sea mammal leaping in waves")
    };

    private static readonly (string Animal, string SoundKey, string Emoji, string SoundText, string Hint)[] FallbackHard = new[]
    {
        ("tiger", "tiger", "🐯", "Rooaaar!", "Striped predator of the deep jungle"),
        ("whale", "whale", "🐋", "Ocean hum!", "Giant singer in the deep blue sea"),
        ("penguin", "penguin", "🐧", "Honk squawk!", "Waddles on ice in a tuxedo"),
        ("camel", "camel", "🐫", "Desert grunt!", "Travels dunes with water humps"),
        ("zebra", "zebra", "🦓", "Savanna whinny!", "Horse cousin painted in zebra stripes"),
        ("rhino", "rhino", "🦏", "Heavy snort!", "Armored herbivore with a snout horn"),
        ("kangaroo", "kangaroo", "🦘", "Chuff chuff!", "Hops with a baby joey in its pouch"),
        ("leopard", "leopard", "🐆", "Low growl!", "Golden spotted cat lounging in tall trees"),
        ("seal", "seal", "🦭", "Arf arf!", "Claps flippers and slides across ice"),
        ("gorilla", "gorilla", "🦍", "Chest beat!", "Gentle giant leader in mountain mist")
    };

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        // Load static JSON curriculum if possible
        try
        {
            _curriculumQuestions = await QuestionService.LoadCustomQuestionsAsync("data/animalsafari.json");
        }
        catch
        {
            // Fallback list is used seamlessly
        }
    }

    protected override async Task<GameChallenge> GenerateChallengeAsync(int round, DifficultyLevel difficulty)
    {
        isAnimalDiscovered = false;
        var index = (round - 1) % 10;

        // Check if question is available from loaded JSON file
        if (_curriculumQuestions != null && _curriculumQuestions.Count > 0)
        {
            var matchingTier = _curriculumQuestions.Where(q => q.Difficulty == difficulty).ToList();
            if (matchingTier.Count > index)
            {
                var q = matchingTier[index];
                var emoji = GetEmojiForAnimal(q.TargetAnswer);
                var soundKey = GetSoundKeyForAnimal(q.TargetAnswer);

                return new GameChallenge
                {
                    Id = q.Id,
                    Category = SkillCategory.Vocabulary,
                    Difficulty = difficulty,
                    Prompt = q.Prompt,
                    TargetAnswer = q.TargetAnswer.ToLowerInvariant(),
                    AcceptedAnswers = q.AcceptedAnswers,
                    Hint = q.Hint,
                    RewardStars = q.RewardStars,
                    DisplayItem = q.TargetAnswer,
                    AnimalSoundKey = soundKey,
                    AnimalEmoji = emoji,
                    SoundOnomatopoeia = GetSoundTextForAnimal(q.TargetAnswer)
                };
            }
        }

        // Resilient Fallback Catalog
        var catalog = difficulty switch
        {
            DifficultyLevel.Hard => FallbackHard,
            DifficultyLevel.Medium => FallbackMedium,
            _ => FallbackEasy
        };

        var item = catalog[index];
        return new GameChallenge
        {
            Id = $"safari_{(int)difficulty}_{index + 1}",
            Category = SkillCategory.Vocabulary,
            Difficulty = difficulty,
            Prompt = $"Listen! Who makes this sound? Say the animal name!",
            TargetAnswer = item.Animal.ToLowerInvariant(),
            AcceptedAnswers = new() { item.Animal.ToLowerInvariant(), $"a {item.Animal.ToLowerInvariant()}", $"the {item.Animal.ToLowerInvariant()}" },
            Hint = item.Hint,
            RewardStars = (int)difficulty,
            DisplayItem = item.Animal,
            AnimalSoundKey = item.SoundKey,
            AnimalEmoji = item.Emoji,
            SoundOnomatopoeia = item.SoundText
        };
    }

    protected override async Task OnChallengeSolvedAsync(GameChallenge challenge)
    {
        isAnimalDiscovered = true;
        StateHasChanged();

        // Play the animal sound again in joy!
        await PlayCurrentAnimalSoundAsync();

        // Add animal to the safari caravan
        if (!_safariCaravan.Any(m => m.Name.Equals(challenge.TargetAnswer, StringComparison.OrdinalIgnoreCase)))
        {
            _safariCaravan.Add((challenge.TargetAnswer, challenge.AnimalEmoji));
        }

        StateHasChanged();
    }

    private async Task PlayCurrentAnimalSoundAsync()
    {
        if (ActiveChallenge == null || string.IsNullOrWhiteSpace(ActiveChallenge.AnimalSoundKey))
            return;

        isRustling = true;
        isListeningToAudio = true;
        StateHasChanged();

        await AudioService.PlayAnimalSoundAsync(ActiveChallenge.AnimalSoundKey);

        await Task.Delay(800);
        isRustling = false;
        isListeningToAudio = false;
        StateHasChanged();
    }

