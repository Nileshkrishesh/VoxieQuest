@page "/game/animal-safari"
@page "/game/safari"
@inherits BaseGameComponent

<GameShell GameTitle="@GameTitle"
           CurrentRound="@CurrentRound"
           TotalRounds="@TotalRounds"
           Stars="@SessionStars"
           Theme="ParallaxBackground.ParallaxTheme.Jungle"
           ThemeClass="safari-theme"
           Prompt="@(ActiveChallenge?.Prompt ?? "Listen to the wild call! Name the animal!")"
           HintText="@(ActiveChallenge?.Hint ?? string.Empty)"
           ShowHint="@(AttemptState.ShowHint && !string.IsNullOrWhiteSpace(ActiveChallenge?.Hint))"
           MascotMood="@MascotState"
           IsListening="@VoiceManager.IsListening"
           VolumeLevel="@CurrentVolume"
           MicButtonState="@(IsBusyAnimating ? MicButton.MicState.Done : (VoiceManager.IsListening ? MicButton.MicState.Listening : MicButton.MicState.Ready))"
           IsPracticeMode="@(VoiceManager.CurrentEngine == VoiceEngineType.PracticeManual)"
           PracticeChoices="@GetPracticeChoices()"
           ShowSuccessBurst="@ShowStarBurst"
           ShowEncourageBurst="@(AttemptState.AttemptCount > 0 && !LastAnswerSuccess && !AttemptState.IsExhausted)"
           IsRewardOpen="@IsRewardScreenOpen"
           StarsEarned="@(SessionStars >= 6 ? 3 : (SessionStars >= 3 ? 2 : 1))"
           IsMicDenied="false"
           VoiceErrorMessage="@VoiceErrorMessage"
           HeardTranscript="@LastTranscript"
           LastResultStatus="@(AttemptState.AttemptCount > 0 ? (bool?)LastAnswerSuccess : (LastAnswerSuccess ? (bool?)true : null))"
           OnBack="ReturnToMapAsync"
           OnRepeatPrompt="RepeatPromptAloudAsync"
           OnToggleListening="ToggleListeningAsync"
           OnSelectPracticeChoice="SubmitManualAnswerAsync"
           OnPlayAgain="StartGameSessionAsync"
           OnNextQuest="ReturnToMapAsync"
           OnSwitchToPractice="SwitchToPracticeMode">

    <SceneContent>
        <!-- Scaling Safari Jungle Stage with Swaying Leaves & Mystery Bush -->
        <div class="safari-encounters-stage">
            @if (ActiveChallenge != null)
            {
                <!-- Sound Wave Button -->
                <div class="safari-speaker-trigger">
                    <button class="pill sound-wave-pill @(isListeningToAudio ? "listening-pulse" : "")" 
                            @onclick="PlayCurrentAnimalSoundAsync" 
                            type="button">
                        <SpeakerIcon Size="20" FillColor="#2B2D42" />
                        <span>Hear Call: "@ActiveChallenge.SoundOnomatopoeia"</span>
                    </button>
                </div>

                <div class="jungle-clearing-box">
                    @if (isAnimalDiscovered)
                    {
                        <!-- Revealed Animal Jumping into the Jeep -->
                        <div class="discovered-animal-plaque animal-jump-in">
                            <div class="animal-avatar-halo">
                                <SafariIcon Size="48" />
                            </div>
                            <span class="animal-revealed-title">@ActiveChallenge.TargetAnswer.ToUpperInvariant()</span>
                            <span class="sticker-pill sticker-pill-mint">
                                In the Jeep!
                            </span>
                        </div>
                    }
                    else
                    {
                        <!-- Mysterious Rustling Bush with Peeking Eyes -->
                        <div class="mystery-bush-rig @(isRustling ? "bush-shake-anim" : "bush-idle-sway")" 
                             @onclick="PlayCurrentAnimalSoundAsync" 
                             title="Tap to listen to the animal sound!">
                            <svg class="jungle-bush-svg" viewBox="0 0 220 140" fill="none">
                                @if (isListeningToAudio)
                                {
                                    <path d="M110 24 C 130 5, 160 5, 180 24" stroke="#FFC93C" stroke-width="4" stroke-linecap="round" fill="none" class="sound-wave-ripple"/>
                                    <path d="M100 15 C 130 -10, 170 -10, 200 15" stroke="#FF6B6B" stroke-width="3" stroke-linecap="round" fill="none" class="sound-wave-ripple" style="animation-delay:0.2s;"/>
                                }

                                <!-- Back Palm Foliage -->
                                <circle cx="65" cy="80" r="42" fill="#2D6A4F" stroke="#2B2D42" stroke-width="4"/>
                                <circle cx="155" cy="80" r="42" fill="#2D6A4F" stroke="#2B2D42" stroke-width="4"/>
                                <circle cx="110" cy="60" r="46" fill="#40916C" stroke="#2B2D42" stroke-width="4"/>

                                <!-- Front Mint Green Leaves -->
                                <circle cx="85" cy="92" r="35" fill="#52B788" stroke="#2B2D42" stroke-width="4"/>
                                <circle cx="135" cy="92" r="35" fill="#52B788" stroke="#2B2D42" stroke-width="4"/>
                                <circle cx="110" cy="88" r="30" fill="#7ED9A8" stroke="#2B2D42" stroke-width="3.5"/>

                                <!-- Cute Peeking Eyes in Foliage -->
                                <ellipse cx="98" cy="80" rx="8" ry="10" fill="white" stroke="#2B2D42" stroke-width="2.5"/>
                                <ellipse cx="122" cy="80" rx="8" ry="10" fill="white" stroke="#2B2D42" stroke-width="2.5"/>
                                <circle cx="100" cy="80" r="4.5" fill="#2B2D42"/>
                                <circle cx="124" cy="80" r="4.5" fill="#2B2D42"/>
                                <circle cx="102" cy="77" r="1.5" fill="white"/>
                                <circle cx="126" cy="77" r="1.5" fill="white"/>
                            </svg>
                            <span class="tap-bush-label">Tap bush to listen!</span>
                        </div>
                    }
                </div>

                <!-- Expedition Jeep Caravan Strip -->
                <div class="safari-jeep-strip">
                    <div class="safari-jeep-car">
                        <svg class="jeep-svg" viewBox="0 0 170 95" fill="none">
                            <rect x="25" y="32" width="120" height="36" rx="10" fill="#FFC93C" stroke="#2B2D42" stroke-width="4"/>
                            <path d="M48 34L40 66M78 34L70 66M108 34L100 66" stroke="#7ED9A8" stroke-width="5" stroke-linecap="round"/>
                            <path d="M55 32L68 8H122L134 32" stroke="#2B2D42" stroke-width="4" stroke-linejoin="round" fill="none"/>
                            <rect x="60" y="4" width="68" height="8" rx="4" fill="#FF6B6B" stroke="#2B2D42" stroke-width="3"/>
                            <rect x="14" y="38" width="12" height="24" rx="4" fill="#2B2D42"/>
                            <circle cx="145" cy="48" r="8" fill="#FFF8E7" stroke="#2B2D42" stroke-width="3"/>
                            <circle cx="55" cy="68" r="16" fill="#2B2D42"/>
                            <circle cx="55" cy="68" r="7" fill="#CBD5E1" stroke="#2B2D42" stroke-width="2"/>
                            <circle cx="120" cy="68" r="16" fill="#2B2D42"/>
                            <circle cx="120" cy="68" r="7" fill="#CBD5E1" stroke="#2B2D42" stroke-width="2"/>
                            <circle cx="95" cy="22" r="10" fill="#FF9F43" stroke="#2B2D42" stroke-width="2.5"/>
                        </svg>
                    </div>

                    <div class="caravan-wagons-row">
                        @if (_safariCaravan.Any())
                        {
                            @foreach (var member in _safariCaravan)
                            {
                                <div class="caravan-cart wagon-pop-anim">
                                    <div class="wagon-badge">
                                        <SafariIcon Size="22" />
                                    </div>
                                    <span class="wagon-title">@member.Name</span>
                                </div>
                            }
                        }
                        else
                        {
                            <span class="empty-caravan-msg">Caravan ready for animals!</span>
                        }
                    </div>
                </div>
            }
        </div>
    </SceneContent>
</GameShell>

<style>
    .safari-encounters-stage {
        width: 100%;
        height: 100%;
        max-width: 560px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
        position: relative;
    }

    .safari-speaker-trigger {
        margin-bottom: clamp(2px, 0.8vh, 6px);
    }

    .sound-wave-pill {
        background: var(--color-sunny-yellow);
        border: var(--border-storybook);
        border-radius: var(--radius-pill);
        padding: clamp(0.25rem, 0.8vh, 0.45rem) clamp(0.6rem, 2vw, 1.2rem);
        font-family: var(--font-heading);
        font-size: clamp(0.85rem, 2.5vw, 1rem);
        font-weight: 700;
        color: var(--color-storybook-ink);
        box-shadow: var(--shadow-hard-sm);
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        cursor: pointer;
        transition: transform 0.15s ease;
    }

    .sound-wave-pill:hover {
        transform: translateY(-2px);
    }

    .listening-pulse {
        animation: pulse-speaker 0.6s infinite alternate ease-in-out;
        background: var(--color-mint);
    }

    .jungle-clearing-box {
        width: 100%;
        height: clamp(80px, 15vh, 125px);
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
    }

    .mystery-bush-rig {
        width: clamp(140px, 35vw, 200px);
        height: clamp(80px, 14vh, 115px);
        cursor: pointer;
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .jungle-bush-svg {
        width: 100%;
        height: 100%;
    }

    .tap-bush-label {
        position: absolute;
        bottom: -2px;
        background: rgba(255, 255, 255, 0.9);
        border: 1.5px solid var(--color-storybook-ink);
        border-radius: var(--radius-pill);
        padding: 1px 8px;
        font-family: var(--font-heading);
        font-size: 0.75rem;
        font-weight: 700;
        color: var(--color-storybook-ink);
    }

    .discovered-animal-plaque {
        background: #FFFFFF;
        border: var(--border-storybook);
        border-radius: var(--radius-md);
        padding: clamp(0.4rem, 1vh, 0.8rem) clamp(0.8rem, 2vw, 1.5rem);
        box-shadow: var(--shadow-hard-md);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.25rem;
    }

    .animal-revealed-title {
        font-family: var(--font-heading);
        font-size: clamp(1.1rem, 3vw, 1.4rem);
        font-weight: 700;
        color: var(--color-storybook-ink);
    }

    .sticker-pill-mint {
        background: var(--color-mint);
        border: 1.5px solid var(--color-storybook-ink);
        border-radius: var(--radius-pill);
        padding: 1px 8px;
        font-family: var(--font-heading);
        font-size: 0.75rem;
        font-weight: 700;
    }

    .safari-jeep-strip {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        width: 100%;
        max-width: 520px;
        margin-top: clamp(2px, 0.8vh, 6px);
        overflow-x: auto;
        padding-bottom: 2px;
    }

    .safari-jeep-car {
        width: clamp(75px, 18vw, 110px);
        flex-shrink: 0;
        animation: jeep-rumble 0.25s infinite alternate;
    }

    .jeep-svg {
        width: 100%;
        height: auto;
    }

    .caravan-wagons-row {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        overflow-x: auto;
    }

    .caravan-cart {
        background: #FFFFFF;
        border: 2px solid var(--color-storybook-ink);
        border-radius: var(--radius-sm);
        padding: 2px 6px;
        display: inline-flex;
        align-items: center;
        gap: 3px;
        box-shadow: var(--shadow-hard-sm);
        flex-shrink: 0;
    }

    .wagon-title {
        font-family: var(--font-heading);
        font-size: 0.75rem;
        font-weight: 700;
        color: var(--color-storybook-ink);
        text-transform: capitalize;
    }

    .empty-caravan-msg {
        font-family: var(--font-body);
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--color-storybook-ink);
        opacity: 0.7;
    }

    /* Animation States */
    .bush-idle-sway {
        animation: bush-sway 3s infinite ease-in-out alternate;
    }

    .bush-shake-anim {
        animation: bush-shake 0.4s infinite ease-in-out alternate;
    }

    .animal-jump-in {
        animation: animal-hop 0.6s var(--spring-squish) forwards;
    }

    .wagon-pop-anim {
        animation: wagon-pop 0.4s var(--spring-squish) forwards;
    }

    @@keyframes bush-sway {
        0% { transform: rotate(-2deg); }
        100% { transform: rotate(2deg); }
    }

    @@keyframes bush-shake {
        0% { transform: translate(-3px, 1px) rotate(-3deg); }
        100% { transform: translate(3px, -1px) rotate(3deg); }
    }

    @@keyframes animal-hop {
        0% { transform: scale(0.3) translateY(30px); opacity: 0; }
        70% { transform: scale(1.15) translateY(-10px); opacity: 1; }
        100% { transform: scale(1) translateY(0); opacity: 1; }
    }

    @@keyframes wagon-pop {
        0% { transform: scale(0.4); opacity: 0; }
        100% { transform: scale(1); opacity: 1; }
    }

    @@keyframes jeep-rumble {
        0% { transform: translateY(0); }
        100% { transform: translateY(-2px); }
    }

    @@keyframes pulse-speaker {
        0% { transform: scale(1); }
        100% { transform: scale(1.04); }
    }
</style>

@code {
    protected override SkillCategory GameCategory => SkillCategory.Animals;
    protected override string GameTitle => "Animal Safari";

    private bool isAnimalDiscovered = false;
    private bool isRustling = false;
    private bool isListeningToAudio = false;

    private readonly List<(string Name, string Emoji)> _safariCaravan = new();
    private IReadOnlyList<QuestionItem>? _curriculumQuestions;

    private static readonly (string Animal, string SoundKey, string SoundText, string Hint)[] FallbackEasy = new[]
    {
        ("cat", "cat", "Meow meow!", "A purring furry pet"),
        ("dog", "dog", "Woof woof!", "A loyal friend who barks"),
        ("cow", "cow", "Mooo!", "Gives milk and eats grass"),
        ("duck", "duck", "Quack quack!", "Swims in the pond"),
        ("frog", "frog", "Ribbit ribbit!", "Green lily pad hopper"),
        ("sheep", "sheep", "Baaa baaa!", "Fluffy friend with wool"),
        ("pig", "pig", "Oink oink!", "Pink and loves muddy puddles"),
        ("bird", "bird", "Tweet tweet!", "Feathered singer in trees"),
        ("lion", "lion", "Roooaar!", "Mighty king with a mane"),
        ("owl", "owl", "Hoot hoot!", "Wise night bird with big eyes")
    };

    private static readonly (string Animal, string SoundKey, string SoundText, string Hint)[] FallbackMedium = new[]
    {
        ("elephant", "elephant", "Trumpet sound!", "Has a long trunk and big ears"),
        ("monkey", "monkey", "Ooh ooh aah aah!", "Swings from vines and eats bananas"),
        ("wolf", "wolf", "Awooooo!", "Howls at the moon in a pack"),
        ("bear", "bear", "Grrr!", "Big furry fisher who loves honey"),
        ("rooster", "rooster", "Cock-a-doodle-doo!", "Wakes up the farm at dawn"),
        ("horse", "horse", "Neighhh!", "Gallops fast through green meadows"),
        ("bee", "bee", "Bzzzz bzzzz!", "Makes sweet golden honey"),
        ("snake", "snake", "Hissss!", "Slithers silently through the grass"),
        ("donkey", "donkey", "Hee-haw!", "Helpful farm friend with long ears"),
        ("dolphin", "dolphin", "Click-whistle!", "Playful sea mammal leaping in waves")
    };

    private static readonly (string Animal, string SoundKey, string SoundText, string Hint)[] FallbackHard = new[]
    {
        ("tiger", "tiger", "Rooaaar!", "Striped predator of the deep jungle"),
        ("whale", "whale", "Ocean hum!", "Giant singer in the deep blue sea"),
        ("penguin", "penguin", "Honk squawk!", "Waddles on ice in a tuxedo"),
        ("camel", "camel", "Desert grunt!", "Travels dunes with water humps"),
        ("zebra", "zebra", "Savanna whinny!", "Horse cousin painted in zebra stripes"),
        ("rhino", "rhino", "Heavy snort!", "Armored herbivore with a snout horn"),
        ("kangaroo", "kangaroo", "Chuff chuff!", "Hops with a baby joey in its pouch"),
        ("leopard", "leopard", "Low growl!", "Golden spotted cat lounging in tall trees"),
        ("seal", "seal", "Arf arf!", "Claps flippers and slides across ice"),
        ("gorilla", "gorilla", "Chest beat!", "Gentle giant leader in mountain mist")
    };

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        try
        {
            _curriculumQuestions = await QuestionService.LoadCustomQuestionsAsync("data/animalsafari.json");
        }
        catch
        {
            // Fallback list is used seamlessly
        }
    }

    protected override Task<GameChallenge> GenerateChallengeAsync(int round, DifficultyLevel difficulty)
    {
        isAnimalDiscovered = false;
        var index = (round - 1) % 10;

        var catalog = difficulty switch
        {
            DifficultyLevel.Hard => FallbackHard,
            DifficultyLevel.Medium => FallbackMedium,
            _ => FallbackEasy
        };

        var item = catalog[index];
        return Task.FromResult(new GameChallenge
        {
            Id = $"safari_{(int)difficulty}_{index + 1}",
            Category = SkillCategory.Vocabulary,
            Difficulty = difficulty,
            Prompt = $"Listen! Who makes this sound? Say the animal name!",
            TargetAnswer = item.Animal.ToLowerInvariant(),
            AcceptedAnswers = new() { item.Animal.ToLowerInvariant(), $"a {item.Animal.ToLowerInvariant()}", $"the {item.Animal.ToLowerInvariant()}" },
            Hint = item.Hint,
            RewardStars = (int)difficulty,
            DisplayItem = item.Animal,
            AnimalSoundKey = item.SoundKey,
            SoundOnomatopoeia = item.SoundText
        });
    }

    private List<string> GetPracticeChoices()
    {
        if (ActiveChallenge == null) return new();
        var target = ActiveChallenge.TargetAnswer;
        return new List<string> { target, "lion", "elephant", "monkey" }.Distinct().Take(4).ToList();
    }

    protected override async Task OnChallengeSolvedAsync(GameChallenge challenge)
    {
        isAnimalDiscovered = true;
        StateHasChanged();

        await PlayCurrentAnimalSoundAsync();

        if (!_safariCaravan.Any(m => m.Name.Equals(challenge.TargetAnswer, StringComparison.OrdinalIgnoreCase)))
        {
            _safariCaravan.Add((challenge.TargetAnswer, "🐾"));
        }

        StateHasChanged();
    }

    private async Task PlayCurrentAnimalSoundAsync()
    {
        if (ActiveChallenge == null || string.IsNullOrWhiteSpace(ActiveChallenge.AnimalSoundKey))
            return;

        isRustling = true;
        isListeningToAudio = true;
        StateHasChanged();

        await AudioService.PlayAnimalSoundAsync(ActiveChallenge.AnimalSoundKey);

        await Task.Delay(800);
        isRustling = false;
        isListeningToAudio = false;
        StateHasChanged();
    }
}
