@page "/game/color-splash"
@page "/game/paint"
@inherits BaseGameComponent

<div class="game-viewport paint-theme">
    <!-- Sunny Meadow Parallax Backdrop -->
    <ParallaxBackground Theme="ParallaxBackground.ParallaxTheme.Hills" />

    <!-- Unified Game Header with 10 Sprouting Flowers Stepper -->
    <GameHeader Title="@GameTitle" 
                CurrentRound="@CurrentRound" 
                TotalRounds="@TotalRounds" 
                Stars="@SessionStars" 
                OnBack="ReturnToMapAsync" 
                OnPause="() => isPauseOpen = true" />

    @if (ActiveChallenge != null)
    {
        <!-- Main Paper-Cut Question Stage -->
        <QuestionCard Prompt="@ActiveChallenge.Prompt"
                      HintText="@ActiveChallenge.Hint"
                      ShowHint="@(AttemptState.ShowHint && !string.IsNullOrWhiteSpace(ActiveChallenge.Hint))"
                      MascotMood="@MascotState"
                      OnRepeatPrompt="RepeatPromptAloudAsync">

            <!-- Art Studio Easel & Paint Splat Stage -->
            <div class="art-studio-stage">
                <!-- Color Swatch Badge with Colorblind Texture Pattern -->
                <div class="color-swatch-badge storybook-card-tilt" style="background-color: @ActiveChallenge.TargetColor;">
                    <div class="swatch-pattern-layer @GetPatternClass(ActiveChallenge.TargetAnswer)"></div>
                    <span class="swatch-label">@ActiveChallenge.TargetAnswer.ToUpperInvariant()</span>
                </div>

                <div class="easel-canvas-container">
                    <!-- Smiling Paint Bucket Character -->
                    <div class="paint-bucket-rig @(isSplashing ? "bucket-pour" : "bucket-breathe")">
                        <svg class="bucket-svg" viewBox="0 0 100 110" fill="none">
                            <path d="M25 45C25 15 75 15 75 45" stroke="#2B2D42" stroke-width="4.5" fill="none"/>
                            <path d="M20 40H80L72 100H28L20 40Z" fill="#FFF8E7" stroke="#2B2D42" stroke-width="4.5" stroke-linejoin="round"/>
                            <ellipse cx="50" cy="40" rx="30" ry="8" fill="@ActiveChallenge.TargetColor" stroke="#2B2D42" stroke-width="3"/>

                            <!-- Bucket Eyes & Smile -->
                            <circle cx="40" cy="65" r="5" fill="#2B2D42"/>
                            <circle cx="60" cy="65" r="5" fill="#2B2D42"/>
                            <circle cx="41.5" cy="63.5" r="1.5" fill="#FFFFFF"/>
                            <circle cx="61.5" cy="63.5" r="1.5" fill="#FFFFFF"/>
                            <path d="M44 76C47 80 53 80 56 76" stroke="#2B2D42" stroke-width="2.5" stroke-linecap="round"/>
                        </svg>

                        <!-- Liquid Splat Animation during splash -->
                        @if (isSplashing)
                        {
                            <div class="paint-liquid-splat" style="--paint-fill: @ActiveChallenge.TargetColor;">
                                <svg viewBox="0 0 80 80" fill="none">
                                    <path d="M40 10C50 10 65 25 60 40C68 45 75 55 65 65C55 75 45 68 40 70C35 68 25 75 15 65C5 55 12 45 20 40C15 25 30 10 40 10Z" 
                                          fill="@ActiveChallenge.TargetColor" stroke="#2B2D42" stroke-width="3"/>
                                </svg>
                            </div>
                        }
                    </div>

                    <!-- White Sketch Canvas Picture -->
                    <div class="picture-canvas-frame @(isColoredIn ? "canvas-painted" : "canvas-sketch")">
                        <svg class="canvas-artwork-svg" viewBox="0 0 180 180" fill="none">
                            @RenderPictureOutline(ActiveChallenge.DisplayItem, isColoredIn ? ActiveChallenge.TargetColor : "#FFF8E7")
                        </svg>
                    </div>
                </div>
            </div>

            <!-- Practice Mode 2x2 Answer Chips Fallback -->
            @if (VoiceManager.CurrentEngine == VoiceEngineType.PracticeManual && GetPracticeChoices().Any())
            {
                <AnswerChips Options="@GetPracticeChoices()" OnAnswerSelected="SubmitManualAnswerAsync" />
            }
        </QuestionCard>

        <!-- Giant Bottom Center Voice Microphone Button -->
        <MicButton IsListening="@VoiceManager.IsListening" 
                   VolumeLevel="@CurrentVolume" 
                   State="@(IsBusyAnimating ? MicButton.MicState.Done : (VoiceManager.IsListening ? MicButton.MicState.Listening : MicButton.MicState.Ready))"
                   OnToggleListening="ToggleListeningAsync" />
    }

    <!-- Celebratory Burst / Gentle Encouragement -->
    <FeedbackBurst ShowSuccess="@ShowStarBurst" 
                   ShowEncourage="@(AttemptState.AttemptCount > 0 && !LastAnswerSuccess && !AttemptState.IsExhausted)"
                   HintText="@ActiveChallenge?.Hint" />

    <!-- 10-Round Quest Completion Celebration -->
    <RewardScreen IsOpen="@IsRewardScreenOpen" 
                  StarsEarned="@(SessionStars >= 6 ? 3 : (SessionStars >= 3 ? 2 : 1))" 
                  OnPlayAgain="StartGameSessionAsync" 
                  OnNextQuest="ReturnToMapAsync" />

    <!-- Paper Card Pause Sheet -->
    <PauseSheet IsOpen="@isPauseOpen" 
                OnResume="() => isPauseOpen = false" 
                OnReturnToMap="ReturnToMapAsync" />
</div>

<style>
    .paint-theme {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
        min-height: 100vh;
        min-height: 100dvh;
        padding: clamp(0.75rem, 2vw, 1.25rem);
        padding-top: calc(var(--header-h) + 0.5rem);
        padding-bottom: calc(var(--nav-h) + 1rem);
        position: relative;
    }

    .art-studio-stage {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        margin: 0.5rem 0;
        position: relative;
    }

    .color-swatch-badge {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: var(--border-storybook);
        border-radius: var(--radius-sm);
        padding: 0.45rem 1.4rem;
        box-shadow: var(--shadow-hard-sm);
        margin-bottom: 0.5rem;
        overflow: hidden;
    }

    .swatch-pattern-layer {
        position: absolute;
        top: 0; left: 0; width: 100%; height: 100%;
        pointer-events: none;
    }

    .swatch-label {
        font-family: var(--font-heading);
        font-size: clamp(1.2rem, 1rem + 0.5vw, 1.6rem);
        font-weight: 700;
        color: var(--color-storybook-ink);
        background: rgba(255, 255, 255, 0.85);
        padding: 0.15rem 0.6rem;
        border-radius: var(--radius-pill);
        border: 2px solid var(--color-storybook-ink);
        position: relative;
        z-index: 2;
    }

    .easel-canvas-container {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1.5rem;
        width: 100%;
        max-width: 620px;
        min-height: 220px;
    }

    .paint-bucket-rig {
        width: 90px;
        height: 100px;
        position: relative;
        flex-shrink: 0;
    }

    .bucket-svg {
        width: 100%;
        height: 100%;
    }

    .paint-liquid-splat {
        position: absolute;
        top: 15px;
        right: -60px;
        width: 70px;
        height: 70px;
        z-index: 5;
        animation: splat-burst 0.5s var(--spring-squish) forwards;
    }

    .picture-canvas-frame {
        width: 180px;
        height: 180px;
        background: #FFFFFF;
        border: var(--border-storybook-thick);
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-hard-md);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0.5rem;
        transition: transform 0.3s ease;
    }

    .canvas-artwork-svg {
        width: 100%;
        height: 100%;
    }

    /* Animation States */
    .bucket-breathe {
        animation: bucket-gentle-bob 2.2s infinite ease-in-out alternate;
    }

    .bucket-pour {
        animation: bucket-tilt-pour 0.8s var(--spring-squish) forwards;
    }

    .canvas-painted {
        transform: scale(1.05) rotate(1deg);
        animation: canvas-sparkle 0.4s var(--spring-squish);
    }

    @@keyframes bucket-gentle-bob {
        0% { transform: translateY(0); }
        100% { transform: translateY(-6px); }
    }

    @@keyframes bucket-tilt-pour {
        0% { transform: rotate(0deg); }
        40% { transform: rotate(35deg) translateY(-8px); }
        100% { transform: rotate(0deg); }
    }

    @@keyframes splat-burst {
        0% { transform: scale(0.2) rotate(-30deg); opacity: 0; }
        70% { transform: scale(1.3) rotate(10deg); opacity: 1; }
        100% { transform: scale(1) rotate(0deg); opacity: 1; }
    }

    @@keyframes canvas-sparkle {
        0% { transform: scale(0.95); }
        50% { transform: scale(1.08); }
        100% { transform: scale(1.05) rotate(1deg); }
    }
</style>

@code {
    protected override SkillCategory GameCategory => SkillCategory.Colors;
    protected override string GameTitle => "Color Splash";

    private bool isSplashing = false;
    private bool isColoredIn = false;
    private bool isPauseOpen = false;

    private static readonly (string ObjectName, string ColorName, string Hex, string Clue)[] EasyColors = new[]
    {
        ("apple", "red", "#FF6B6B", "Like a sweet crunchy apple"),
        ("sun", "yellow", "#FFC93C", "Shines warm in the sky"),
        ("leaf", "green", "#7ED9A8", "Grows on big green trees"),
        ("ocean", "blue", "#5BC0EB", "Splashes in ocean waves"),
        ("orange_fruit", "orange", "#FF9F43", "Sweet citrus fruit"),
        ("heart", "red", "#FF6B6B", "Symbol of love"),
        ("banana", "yellow", "#FFC93C", "Peel it and eat it!"),
        ("frog_pic", "green", "#7ED9A8", "Jumps across lily pads"),
        ("sky", "blue", "#5BC0EB", "Look up at the daytime sky"),
        ("carrot", "orange", "#FF9F43", "Crunchy rabbit snack")
    };

    private static readonly (string ObjectName, string ColorName, string Hex, string Clue)[] MediumColors = new[]
    {
        ("grapes", "purple", "#C77DFF", "Juicy round berries"),
        ("flamingo", "pink", "#FF85A1", "Graceful wading bird"),
        ("bear", "brown", "#8D5B4C", "Fuzzy teddy bear"),
        ("cloud_pic", "white", "#FFFFFF", "Fluffy white clouds"),
        ("night_sky", "black", "#2B2D42", "Midnight sky with stars"),
        ("plum", "purple", "#C77DFF", "Sweet stone fruit"),
        ("rose", "pink", "#FF85A1", "Blooms in the garden"),
        ("acorn", "brown", "#8D5B4C", "Falls from oak trees"),
        ("snowman", "white", "#FFFFFF", "Built of cold snow"),
        ("panther", "black", "#2B2D42", "Sleek jungle cat")
    };

    private static readonly (string ObjectName, string ColorName, string Hex, string Clue)[] HardColors = new[]
    {
        ("gold_star", "golden", "#FFC93C", "Bright shining trophy"),
        ("emerald_gem", "emerald", "#7ED9A8", "Sparkling green jewel"),
        ("coral_reef", "coral", "#FF6B6B", "Deep sea coral habitat"),
        ("lavender_flower", "lavender", "#C77DFF", "Fragrant purple flowers"),
        ("amber_sun", "amber", "#FF9F43", "Warm glow of sunset"),
        ("silver_coin", "silver", "#CBD5E1", "Gleaming shiny coin"),
        ("turquoise_wave", "turquoise", "#5BC0EB", "Tropical lagoon water"),
        ("ruby_ring", "ruby", "#FF6B6B", "Deep red precious stone"),
        ("indigo_night", "indigo", "#2B2D42", "Deep shade of midnight"),
        ("rainbow_arch", "rainbow", "#FFC93C", "Seven colors in the sky")
    };

    protected override Task<GameChallenge> GenerateChallengeAsync(int round, DifficultyLevel difficulty)
    {
        isColoredIn = false;
        isSplashing = false;

        var index = (round - 1) % 10;
        (string ObjectName, string ColorName, string Hex, string Clue) item;

        if (difficulty == DifficultyLevel.Hard)
        {
            item = HardColors[index];
        }
        else if (difficulty == DifficultyLevel.Medium)
        {
            item = MediumColors[index];
        }
        else
        {
            item = EasyColors[index];
        }

        var challenge = new GameChallenge
        {
            Id = $"color_{round}_{index}",
            Category = SkillCategory.Vocabulary,
            Difficulty = difficulty,
            Prompt = $"What color is a {item.ObjectName.Replace("_pic", "").Replace("_fruit", "")}? Say {item.ColorName.ToUpperInvariant()}!",
            TargetAnswer = item.ColorName,
            AcceptedAnswers = new() { item.ColorName, $"color {item.ColorName}", $"it is {item.ColorName}", $"it's {item.ColorName}" },
            DisplayItem = item.ObjectName,
            TargetColor = item.Hex,
            Hint = item.Clue,
            RewardStars = difficulty == DifficultyLevel.Hard ? 3 : (difficulty == DifficultyLevel.Medium ? 2 : 1)
        };

        return Task.FromResult(challenge);
    }

    private string GetPatternClass(string colorName) => colorName.ToLowerInvariant() switch
    {
        "red" or "coral" => "pattern-stripes",
        "blue" or "turquoise" => "pattern-dots",
        "green" or "emerald" => "pattern-grid",
        _ => ""
    };

    private List<string> GetPracticeChoices()
    {
        if (ActiveChallenge == null) return new();
        var target = ActiveChallenge.TargetAnswer;
        return new List<string> { target, "red", "blue", "yellow" }.Distinct().Take(4).ToList();
    }

    protected override async Task OnChallengeSolvedAsync(GameChallenge challenge)
    {
        isSplashing = true;
        await AudioService.PlaySoundAsync(SoundEffect.Pop);
        StateHasChanged();

        await Task.Delay(400);
        isColoredIn = true;
        StateHasChanged();

        await Task.Delay(1100);
        isSplashing = false;
    }

    private static RenderFragment RenderPictureOutline(string objectName, string fillColor) => builder =>
    {
        if (objectName.Contains("apple"))
        {
            builder.AddMarkupContent(0, $@"
                <path d='M90 35C90 15 105 15 110 25C110 25 100 35 90 35Z' fill='#7ED9A8' stroke='#2B2D42' stroke-width='3.5'/>
                <path d='M90 35V20' stroke='#2B2D42' stroke-width='4' stroke-linecap='round'/>
                <path d='M90 50C70 30 35 45 35 85C35 135 75 160 90 160C105 160 145 135 145 85C145 45 110 30 90 50Z' 
                      fill='{fillColor}' stroke='#2B2D42' stroke-width='4.5' stroke-linejoin='round'/>
                <circle cx='65' cy='75' r='6' fill='#FFF8E7' opacity='0.6'/>
            ");
        }
        else if (objectName.Contains("sun"))
        {
            builder.AddMarkupContent(0, $@"
                <circle cx='90' cy='90' r='45' fill='{fillColor}' stroke='#2B2D42' stroke-width='4.5'/>
                <line x1='90' y1='25' x2='90' y2='10' stroke='#2B2D42' stroke-width='4.5' stroke-linecap='round'/>
                <line x1='90' y1='155' x2='90' y2='170' stroke='#2B2D42' stroke-width='4.5' stroke-linecap='round'/>
                <line x1='25' y1='90' x2='10' y2='90' stroke='#2B2D42' stroke-width='4.5' stroke-linecap='round'/>
                <line x1='155' y1='90' x2='170' y2='90' stroke='#2B2D42' stroke-width='4.5' stroke-linecap='round'/>
                <circle cx='76' cy='85' r='5' fill='#2B2D42'/>
                <circle cx='104' cy='85' r='5' fill='#2B2D42'/>
                <path d='M80 100C85 106 95 106 100 100' stroke='#2B2D42' stroke-width='3.5' stroke-linecap='round'/>
            ");
        }
        else if (objectName.Contains("heart"))
        {
            builder.AddMarkupContent(0, $@"
                <path d='M90 55C75 25 35 35 35 75C35 115 80 145 90 155C100 145 145 115 145 75C145 35 105 25 90 55Z' 
                      fill='{fillColor}' stroke='#2B2D42' stroke-width='4.5' stroke-linejoin='round'/>
                <circle cx='60' cy='65' r='7' fill='#FFF8E7' opacity='0.5'/>
            ");
        }
        else
        {
            builder.AddMarkupContent(0, $@"
                <path d='M40 140C40 140 30 80 80 40C130 80 140 140 140 140C90 155 50 150 40 140Z' 
                      fill='{fillColor}' stroke='#2B2D42' stroke-width='4.5' stroke-linejoin='round'/>
                <line x1='80' y1='40' x2='90' y2='155' stroke='#2B2D42' stroke-width='4' stroke-linecap='round'/>
            ");
        }
    };
}
