@page "/game/word-builder"
@page "/game/builder"
@inherits BaseGameComponent

<div class="game-viewport builder-theme">
    <!-- Cloud & Sky Parallax Backdrop -->
    <ParallaxBackground Theme="ParallaxBackground.ParallaxTheme.Clouds" />

    <!-- Unified Game Header with 10 Sprouting Flowers Stepper -->
    <GameHeader Title="@GameTitle" 
                CurrentRound="@CurrentRound" 
                TotalRounds="@TotalRounds" 
                Stars="@SessionStars" 
                OnBack="ReturnToMapAsync" 
                OnPause="() => isPauseOpen = true" />

    @if (ActiveChallenge != null)
    {
        <!-- Main Paper-Cut Question Stage -->
        <QuestionCard Prompt="@ActiveChallenge.Prompt"
                      HintText="@ActiveChallenge.Hint"
                      ShowHint="@(AttemptState.ShowHint && !string.IsNullOrWhiteSpace(ActiveChallenge.Hint))"
                      MascotMood="@MascotState"
                      OnRepeatPrompt="RepeatPromptAloudAsync">

            <!-- Wooden Workbench Arena -->
            <div class="workbench-arena">
                @if (isWordAssembled)
                {
                    <!-- Completed Toy Comes to Life with Eyes and Celebration Wiggle -->
                    <div class="assembled-toy-showcase toy-wiggle-anim">
                        <div class="toy-icon-plaque">
                            <BlocksIcon Size="64" />
                        </div>
                        <div class="assembled-word-badge storybook-card-tilt">
                            <span class="assembled-text">@ActiveChallenge.TargetAnswer.ToUpperInvariant()</span>
                        </div>
                        <span class="sticker-pill sticker-pill-mint">
                            Snap! Toy Built Perfectly!
                        </span>
                    </div>
                }
                else
                {
                    <!-- Chunky Wooden Letter Blocks Tray with Gravity Bounce -->
                    <div class="blocks-shelf-tray @(isSnapping ? "blocks-snapping-anim" : "")">
                        @for (int i = 0; i < ActiveChallenge.LetterBlocks.Count; i++)
                        {
                            var letter = ActiveChallenge.LetterBlocks[i];
                            var blockBg = GetBlockColor(i);
                            <div class="wooden-letter-block block-drop-in" 
                                 style="background-color: @blockBg; animation-delay: @(i * 0.12)s;">
                                <div class="block-grain-inset">
                                    <span class="block-char">@letter</span>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Magnetic Workbench Slot Rail that fills as spoken -->
                    <div class="workbench-rail-base">
                        <div class="rail-slots-groove">
                            @for (int i = 0; i < ActiveChallenge.LetterBlocks.Count; i++)
                            {
                                <div class="groove-slot">
                                    <span class="groove-placeholder">•</span>
                                </div>
                            }
                        </div>
                        <span class="rail-instruction-label">Speak the whole word to assemble!</span>
                    </div>
                }
            </div>

            <!-- Practice Mode 2x2 Answer Chips Fallback -->
            @if (VoiceManager.CurrentEngine == VoiceEngineType.PracticeManual && GetPracticeChoices().Any())
            {
                <AnswerChips Options="@GetPracticeChoices()" OnAnswerSelected="SubmitManualAnswerAsync" />
            }
        </QuestionCard>

        <!-- Giant Bottom Center Voice Microphone Button -->
        <MicButton IsListening="@VoiceManager.IsListening" 
                   VolumeLevel="@CurrentVolume" 
                   State="@(IsBusyAnimating ? MicButton.MicState.Done : (VoiceManager.IsListening ? MicButton.MicState.Listening : MicButton.MicState.Ready))"
                   OnToggleListening="ToggleListeningAsync" />
    }

    <!-- Celebratory Burst / Gentle Encouragement -->
    <FeedbackBurst ShowSuccess="@ShowStarBurst" 
                   ShowEncourage="@(AttemptState.AttemptCount > 0 && !LastAnswerSuccess && !AttemptState.IsExhausted)"
                   HintText="@ActiveChallenge?.Hint" />

    <!-- 10-Round Quest Completion Celebration -->
    <RewardScreen IsOpen="@IsRewardScreenOpen" 
                  StarsEarned="@(SessionStars >= 6 ? 3 : (SessionStars >= 3 ? 2 : 1))" 
                  OnPlayAgain="StartGameSessionAsync" 
                  OnNextQuest="ReturnToMapAsync" />

    <!-- Paper Card Pause Sheet -->
    <PauseSheet IsOpen="@isPauseOpen" 
                OnResume="() => isPauseOpen = false" 
                OnReturnToMap="ReturnToMapAsync" />
</div>

<style>
    .builder-theme {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
        min-height: 100vh;
        min-height: 100dvh;
        padding: clamp(0.75rem, 2vw, 1.25rem);
        padding-top: calc(var(--header-h) + 0.5rem);
        padding-bottom: calc(var(--nav-h) + 1rem);
        position: relative;
    }

    .workbench-arena {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        margin: 0.5rem 0;
    }

    .blocks-shelf-tray {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: clamp(0.5rem, 1.5vw, 1rem);
        min-height: 110px;
        width: 100%;
        max-width: 600px;
        padding: 0.5rem;
    }

    .wooden-letter-block {
        width: clamp(60px, 12vw, 76px);
        height: clamp(60px, 12vw, 76px);
        border: var(--border-storybook);
        border-radius: var(--radius-sm);
        box-shadow: var(--shadow-hard-md);
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        cursor: default;
    }

    .block-grain-inset {
        width: 82%;
        height: 82%;
        border: 2px dashed rgba(43, 45, 66, 0.3);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.35);
    }

    .block-char {
        font-family: var(--font-heading);
        font-size: clamp(1.8rem, 1.5rem + 0.8vw, 2.4rem);
        font-weight: 700;
        color: var(--color-storybook-ink);
    }

    .workbench-rail-base {
        width: 100%;
        max-width: 540px;
        background: #E8D5B5;
        border: var(--border-storybook);
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-hard-md);
        padding: 0.75rem 1.25rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.4rem;
        margin-top: 0.5rem;
    }

    .rail-slots-groove {
        display: flex;
        gap: 0.75rem;
    }

    .groove-slot {
        width: 52px;
        height: 14px;
        background: #C4A482;
        border-radius: 4px;
        border: 2px solid var(--color-storybook-ink);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .groove-placeholder {
        color: var(--color-storybook-ink);
        font-size: 0.8rem;
    }

    .rail-instruction-label {
        font-family: var(--font-heading);
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--color-storybook-ink);
    }

    .assembled-toy-showcase {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        background: var(--color-cloud-white);
        border: var(--border-storybook);
        border-radius: var(--radius-md);
        padding: 1.25rem 2rem;
        box-shadow: var(--shadow-hard-md);
    }

    .toy-icon-plaque {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .assembled-word-badge {
        background: var(--color-sunny-yellow);
        border: var(--border-storybook);
        border-radius: var(--radius-pill);
        padding: 0.4rem 1.5rem;
        box-shadow: var(--shadow-hard-sm);
    }

    .assembled-text {
        font-family: var(--font-heading);
        font-size: clamp(1.6rem, 1.4rem + 0.8vw, 2.2rem);
        font-weight: 700;
        color: var(--color-storybook-ink);
        letter-spacing: 0.08em;
    }

    /* Animation States */
    .block-drop-in {
        animation: block-drop 0.6s var(--spring-squish) backwards;
    }

    .blocks-snapping-anim {
        animation: blocks-snap 0.4s var(--spring-squish);
    }

    .toy-wiggle-anim {
        animation: toy-wiggle-joy 0.8s var(--spring-squish) forwards;
    }

    @@keyframes block-drop {
        0% { transform: translateY(-60px) rotate(-10deg); opacity: 0; }
        70% { transform: translateY(6px) rotate(4deg); opacity: 1; }
        100% { transform: translateY(0) rotate(0); opacity: 1; }
    }

    @@keyframes blocks-snap {
        0% { transform: scale(1); }
        50% { transform: scale(1.15) translateY(-8px); }
        100% { transform: scale(1); }
    }

    @@keyframes toy-wiggle-joy {
        0% { transform: scale(0.5); opacity: 0; }
        50% { transform: scale(1.1) rotate(6deg); opacity: 1; }
        75% { transform: scale(0.95) rotate(-6deg); }
        100% { transform: scale(1) rotate(0deg); opacity: 1; }
    }
</style>

@code {
    protected override SkillCategory GameCategory => SkillCategory.Phonics;
    protected override string GameTitle => "Word Builder";

    private bool isWordAssembled = false;
    private bool isSnapping = false;
    private bool isPauseOpen = false;

    private static readonly (string Word, string[] Blocks, string Hint)[] FallbackEasy = new[]
    {
        ("cat", new[] { "C", "A", "T" }, "Purring fluffy pet that says meow"),
        ("sun", new[] { "S", "U", "N" }, "Warm bright star in our daytime sky"),
        ("dog", new[] { "D", "O", "G" }, "Loyal four-legged friend who barks"),
        ("pig", new[] { "P", "I", "G" }, "Pink farm buddy who says oink"),
        ("bat", new[] { "B", "A", "T" }, "Flies at night or hits a baseball"),
        ("bus", new[] { "B", "U", "S" }, "Big yellow vehicle carrying students"),
        ("hat", new[] { "H", "A", "T" }, "You wear it on top of your head"),
        ("bug", new[] { "B", "U", "G" }, "Little crawling beetle in the garden"),
        ("cup", new[] { "C", "U", "P" }, "You drink sweet cocoa or juice from it"),
        ("bed", new[] { "B", "E", "D" }, "Cozy place you sleep and dream at night")
    };

    private static readonly (string Word, string[] Blocks, string Hint)[] FallbackMedium = new[]
    {
        ("frog", new[] { "F", "R", "O", "G" }, "Green hopper in the lily pond"),
        ("star", new[] { "S", "T", "A", "R" }, "Twinkles high in the dark night sky"),
        ("fish", new[] { "F", "I", "S", "H" }, "Swims with shiny fins and gills"),
        ("duck", new[] { "D", "U", "C", "K" }, "Feathered friend who says quack quack"),
        ("moon", new[] { "M", "O", "O", "N" }, "Glows silver in our night sky"),
        ("tree", new[] { "T", "R", "E", "E" }, "Tall with green leaves and brown branches"),
        ("bird", new[] { "B", "I", "R", "D" }, "Feathered singer soaring in the breeze"),
        ("ship", new[] { "S", "H", "I", "P" }, "Sails proudly across ocean waves"),
        ("lion", new[] { "L", "I", "O", "N" }, "Golden king of the grassy savanna"),
        ("ball", new[] { "B", "A", "L", "L" }, "Round toy you kick, bounce, and throw")
    };

    private static readonly (string Word, string[] Blocks, string Hint)[] FallbackHard = new[]
    {
        ("apple", new[] { "A", "P", "P", "L", "E" }, "Sweet crunchy red orchard fruit"),
        ("tiger", new[] { "T", "I", "G", "E", "R" }, "Striped mighty cat in the jungle"),
        ("river", new[] { "R", "I", "V", "E", "R" }, "Flows fresh water winding to the ocean"),
        ("heart", new[] { "H", "E", "A", "R", "T" }, "Beats inside your chest with love"),
        ("cloud", new[] { "C", "L", "O", "U", "D" }, "Fluffy white shape floating in sky"),
        ("plant", new[] { "P", "L", "A", "N", "T" }, "Grows from soil toward the sun"),
        ("robot", new[] { "R", "O", "B", "O", "T" }, "Mechanical buddy with gears and lights"),
        ("train", new[] { "T", "R", "A", "I", "N" }, "Travels on rails saying choo-choo"),
        ("space", new[] { "S", "P", "A", "C", "E" }, "Realm of stars, planets, and rockets"),
        ("magic", new[] { "M", "A", "G", "I", "C" }, "Sparkling wonder with a star wand")
    };

    protected override Task<GameChallenge> GenerateChallengeAsync(int round, DifficultyLevel difficulty)
    {
        isWordAssembled = false;
        isSnapping = false;
        var index = (round - 1) % 10;

        var catalog = difficulty switch
        {
            DifficultyLevel.Hard => FallbackHard,
            DifficultyLevel.Medium => FallbackMedium,
            _ => FallbackEasy
        };

        var item = catalog[index];
        var spelled = string.Join(" - ", item.Blocks);

        return Task.FromResult(new GameChallenge
        {
            Id = $"builder_{(int)difficulty}_{index + 1}",
            Category = SkillCategory.Phonics,
            Difficulty = difficulty,
            Prompt = $"Assemble the blocks: {spelled}! Say the word to snap them together!",
            TargetAnswer = item.Word.ToLowerInvariant(),
            AcceptedAnswers = new() { item.Word.ToLowerInvariant(), $"a {item.Word.ToLowerInvariant()}", $"the {item.Word.ToLowerInvariant()}" },
            Hint = item.Hint,
            RewardStars = (int)difficulty,
            DisplayItem = item.Word,
            LetterBlocks = item.Blocks.ToList()
        });
    }

    private List<string> GetPracticeChoices()
    {
        if (ActiveChallenge == null) return new();
        var target = ActiveChallenge.TargetAnswer;
        return new List<string> { target, "cat", "dog", "sun" }.Distinct().Take(4).ToList();
    }

    protected override async Task OnChallengeSolvedAsync(GameChallenge challenge)
    {
        isSnapping = true;
        StateHasChanged();
        await AudioService.PlaySoundAsync(SoundEffect.Pop);

        await Task.Delay(450);

        isWordAssembled = true;
        isSnapping = false;
        StateHasChanged();
    }

    private static string GetBlockColor(int index) => (index % 5) switch
    {
        0 => "#FFC93C", // Sunny Yellow
        1 => "#5BC0EB", // Sky Blue
        2 => "#FF6B6B", // Coral
        3 => "#7ED9A8", // Mint
        _ => "#FF9F43"  // Soft Orange
    };
}
