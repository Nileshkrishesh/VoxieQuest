@page "/game/word-builder"
@page "/game/builder"
@inherits BaseGameComponent

<div class="game-viewport">
    <ParallaxBackground Theme="ParallaxBackground.ParallaxTheme.Clouds" />

    <!-- Top HUD: Round 1 to 10 Stepper & Star Counter -->
    <div class="storybook-card game-hud-card">
        <div style="display:flex; justify-content:space-between; align-items:center;">
            <button class="pill" @onclick="ReturnToMapAsync" type="button">
                <span>◀ Map</span>
            </button>
            <h3 style="margin:0; font-size:1.4rem; color:var(--color-coral); text-shadow:0 1px 0 #fff;">
                🧱 @GameTitle
            </h3>
            <div class="star-badge">
                <span>⭐</span>
                <span>@SessionStars</span>
            </div>
        </div>

        <!-- 10 Round Stepper -->
        <div class="round-stepper">
            @for (int r = 1; r <= TotalRounds; r++)
            {
                var isCompleted = r < CurrentRound;
                var isCurrent = r == CurrentRound;
                <div class="round-dot @(isCompleted ? "completed" : "") @(isCurrent ? "current" : "")" title="Round @r">
                    @(isCompleted ? "★" : r.ToString())
                </div>
            }
        </div>
    </div>

    @if (ActiveChallenge != null)
    {
        <!-- Main Word Workshop Stage -->
        <div class="storybook-card builder-stage">
            <!-- Mascot Voxie Builder & Prompt -->
            <div class="mascot-stage" style="justify-content:center; position:relative; margin-bottom:1rem;">
                <Mascot State="@MascotState" Width="120" Height="120" />
                <StarBurst IsActive="@ShowStarBurst" />

                <div class="speech-bubble" style="max-width:460px;">
                    <span style="font-size:1.25rem;">@ActiveChallenge.Prompt</span>
                    <div style="margin-top:0.4rem; display:flex; flex-wrap:wrap; gap:0.5rem; justify-content:center;">
                        <button class="pill" @onclick="SpellLettersAloudAsync" type="button" style="font-size:0.9rem; background:var(--color-sunny-yellow);">
                            <span>🔊 Spell Aloud</span>
                        </button>
                        <button class="pill" @onclick="RepeatPromptAloudAsync" type="button" style="font-size:0.9rem;">
                            <span>🗣️ Repeat Prompt</span>
                        </button>
                        @if (AttemptState.ShowHint && !string.IsNullOrWhiteSpace(ActiveChallenge.Hint))
                        {
                            <span class="pill" style="background:#FFE5EC; color:var(--color-coral); border-color:var(--color-coral); font-size:0.85rem;">
                                💡 @ActiveChallenge.Hint
                            </span>
                        }
                    </div>
                </div>
            </div>

            <!-- The Workbench: Toy Blocks Assembly Arena -->
            <div class="workshop-arena">
                @if (isWordAssembled)
                {
                    <!-- Revealed Picture & Assembled Word Banner -->
                    <div class="assembled-showcase showcase-pop-in">
                        <div class="picture-card-wrapper">
                            <span class="picture-card-emoji">@ActiveChallenge.RevealedPicture</span>
                        </div>
                        <div class="assembled-word-tag">
                            @ActiveChallenge.TargetAnswer.ToUpperInvariant()!
                        </div>
                        <span class="pill" style="background:var(--color-mint); color:var(--color-storybook-ink); font-size:1rem; margin-top:0.4rem;">
                            ✨ Snap! Built perfectly!
                        </span>
                    </div>
                }
                else
                {
                    <!-- Separated Interactive Wooden Blocks Waiting to be Built -->
                    <div class="blocks-tray @(isSnapping ? "blocks-snapping" : "")">
                        @for (int i = 0; i < ActiveChallenge.LetterBlocks.Count; i++)
                        {
                            var letter = ActiveChallenge.LetterBlocks[i];
                            var blockBg = GetBlockColor(i);
                            <div class="toy-letter-block block-float" style="background:@blockBg; animation-delay:@(i * 0.12)s;">
                                <div class="block-bevel">
                                    <span class="block-letter">@letter</span>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Magnetic Workbench Rail -->
                    <div class="workbench-rail">
                        <div class="rail-groove"></div>
                        <span class="rail-label">Say the word to snap blocks together!</span>
                    </div>
                }
            </div>

            <!-- Speech Feedback Area (Never 'Wrong'!) -->
            <div style="min-height:50px; margin: 0.6rem 0;">
                @if (!string.IsNullOrWhiteSpace(LastTranscript))
                {
                    <div class="pill" style="background:@(LastAnswerSuccess ? "var(--color-mint)" : "var(--color-sunny-yellow)"); font-size:1.15rem;">
                        @(LastAnswerSuccess ? "🌟 Click! You said: " : "👂 You said: ") "@LastTranscript"
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(AttemptState.FeedbackMessage))
                {
                    <div style="color:var(--color-coral); font-family:var(--font-heading); font-weight:700; font-size:1.1rem; margin-top:0.35rem;">
                        @AttemptState.FeedbackMessage
                    </div>
                }
            </div>

            <!-- Voice Character or Practice Mode Fallback -->
            @if (VoiceManager.Mode == VoiceMode.PracticeButtons || VoiceManager.CurrentEngine == VoiceEngineType.PracticeManual)
            {
                <PracticeInputPanel Question="@(new QuestionItem { TargetAnswer = ActiveChallenge.TargetAnswer, Category = GameCategory })" 
                                    OnAnswerSelected="SubmitManualAnswerAsync" />
            }
            else
            {
                <div style="margin: 0.4rem 0;">
                    <MicCharacter VolumeLevel="@CurrentVolume" IsListening="@VoiceManager.IsListening" OnClick="ToggleListeningAsync" />
                </div>
            }

            <div style="margin-top:0.75rem; display:flex; justify-content:center; gap:0.75rem;">
                <button class="pill" @onclick="SkipRoundAsync" type="button" style="opacity:0.85;">
                    <span>Next Word ➔</span>
                </button>
            </div>
        </div>
    }
</div>

<!-- Celebratory Confetti & 10-Round Reward Modal -->
<Confetti IsActive="@IsRewardScreenOpen" />
<CelebrationModal IsVisible="@IsRewardScreenOpen" 
                  StarsEarned="@SessionStars" 
                  OnPlayAgain="StartGameSessionAsync" 
                  OnReturnHome="ReturnToMapAsync" />

<style>
    .game-viewport {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        max-width: 780px;
        margin: 0 auto;
        position: relative;
    }

    .game-hud-card {
        padding: 0.85rem 1.4rem;
        background: rgba(255, 253, 247, 0.95);
    }

    .round-stepper {
        display: flex;
        justify-content: center;
        gap: 0.5rem;
        margin-top: 0.6rem;
    }

    .round-dot {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        border: 2.5px solid var(--color-storybook-ink);
        background: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: var(--font-heading);
        font-weight: 700;
        font-size: 0.85rem;
        color: var(--color-storybook-ink);
    }

    .round-dot.completed {
        background: var(--color-mint);
        color: var(--color-storybook-ink);
    }

    .round-dot.current {
        background: var(--color-sunny-yellow);
        transform: scale(1.15);
        box-shadow: 0 3px 0 var(--color-storybook-ink);
    }

    .builder-stage {
        text-align: center;
        background: var(--color-cream-paper);
        overflow: hidden;
    }

    .workshop-arena {
        position: relative;
        min-height: 250px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 1rem 0;
    }

    /* Blocks Tray */
    .blocks-tray {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1.25rem;
        flex-wrap: wrap;
        margin-bottom: 1.5rem;
        transition: gap 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .blocks-snapping {
        gap: 0.2rem !important;
        animation: snap-rumble 0.4s ease-in-out;
    }

    /* Chunky Toy Letter Blocks */
    .toy-letter-block {
        width: 76px;
        height: 76px;
        border-radius: 18px;
        border: 4px solid var(--color-storybook-ink);
        box-shadow: 0 7px 0 var(--color-storybook-ink);
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        cursor: pointer;
        user-select: none;
        transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .toy-letter-block:hover {
        transform: translateY(-6px) scale(1.06);
    }

    .block-bevel {
        width: 60px;
        height: 60px;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.35);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .block-letter {
        font-family: var(--font-heading);
        font-size: 2.4rem;
        font-weight: 800;
        color: var(--color-storybook-ink);
        line-height: 1;
        text-shadow: 0 2px 0 rgba(255, 255, 255, 0.6);
    }

    .block-float {
        animation: block-hover 2.4s ease-in-out infinite alternate;
    }

    /* Magnetic Workbench Rail */
    .workbench-rail {
        width: 85%;
        max-width: 480px;
        height: 24px;
        background: #E2E8F0;
        border: 3.5px solid var(--color-storybook-ink);
        border-radius: 12px;
        position: relative;
        box-shadow: 0 4px 0 var(--color-storybook-ink);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .rail-groove {
        position: absolute;
        width: 90%;
        height: 6px;
        background: #CBD5E1;
        border-radius: 3px;
    }

    .rail-label {
        position: absolute;
        bottom: -28px;
        font-size: 0.85rem;
        font-weight: 700;
        color: #64748B;
        font-family: var(--font-heading);
    }

    /* Assembled Word Showcase */
    .assembled-showcase {
        display: flex;
        flex-direction: column;
        align-items: center;
        background: white;
        border: 4px solid var(--color-storybook-ink);
        border-radius: 24px;
        padding: 1.2rem 2.2rem;
        box-shadow: 0 8px 0 var(--color-storybook-ink);
    }

    .picture-card-wrapper {
        width: 96px;
        height: 96px;
        border-radius: 50%;
        background: #E0F2FE;
        border: 4px solid var(--color-storybook-ink);
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 0 var(--color-storybook-ink);
    }

    .picture-card-emoji {
        font-size: 4rem;
        line-height: 1;
    }

    .assembled-word-tag {
        font-family: var(--font-heading);
        font-size: 2rem;
        font-weight: 800;
        color: var(--color-storybook-ink);
        margin-top: 0.5rem;
        letter-spacing: 0.08em;
    }

    .showcase-pop-in {
        animation: showcase-bounce 0.7s var(--spring-bounce) forwards;
    }

    @@keyframes block-hover {
        0% { transform: translateY(0); }
        100% { transform: translateY(-5px); }
    }

    @@keyframes snap-rumble {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.05); }
    }

    @@keyframes showcase-bounce {
        0% { transform: scale(0.3) rotate(-5deg); opacity: 0; }
        60% { transform: scale(1.1) rotate(2deg); opacity: 1; }
        80% { transform: scale(0.96) rotate(-1deg); }
        100% { transform: scale(1) rotate(0deg); }
    }
</style>

@code {
    protected override SkillCategory GameCategory => SkillCategory.Spelling;
    protected override string GameTitle => "Word Builder";

    private bool isWordAssembled = false;
    private bool isSnapping = false;

    private IReadOnlyList<QuestionItem>? _curriculumQuestions;

    private static readonly (string Word, string[] Blocks, string Emoji, string Hint)[] FallbackEasy = new[]
    {
        ("cat", new[] { "C", "A", "T" }, "🐱", "A purring furry pet who loves yarn"),
        ("sun", new[] { "S", "U", "N" }, "☀️", "Shines warm and bright in daytime"),
        ("dog", new[] { "D", "O", "G" }, "🐶", "Loyal puppy friend who wags its tail"),
        ("pig", new[] { "P", "I", "G" }, "🐷", "Pink farm animal who says oink"),
        ("bat", new[] { "B", "A", "T" }, "🦇", "Nocturnal creature who flies with wings"),
        ("bus", new[] { "B", "U", "S" }, "🚌", "Big yellow vehicle carrying students"),
        ("hat", new[] { "H", "A", "T" }, "🎩", "You wear it proudly on your head"),
        ("bug", new[] { "B", "U", "G" }, "🐛", "Little crawler resting on a garden leaf"),
        ("cup", new[] { "C", "U", "P" }, "☕", "You drink sweet cocoa or juice from it"),
        ("bed", new[] { "B", "E", "D" }, "🛏️", "Cozy place you sleep and dream at night")
    };

    private static readonly (string Word, string[] Blocks, string Emoji, string Hint)[] FallbackMedium = new[]
    {
        ("frog", new[] { "F", "R", "O", "G" }, "🐸", "Green hopper in the lily pond"),
        ("star", new[] { "S", "T", "A", "R" }, "⭐", "Twinkles high in the dark night sky"),
        ("fish", new[] { "F", "I", "S", "H" }, "🐟", "Swims with shiny fins and gills"),
        ("duck", new[] { "D", "U", "C", "K" }, "🦆", "Feathered friend who says quack quack"),
        ("moon", new[] { "M", "O", "O", "N" }, "🌙", "Glows silver in our night sky"),
        ("tree", new[] { "T", "R", "E", "E" }, "🌳", "Tall with green leaves and brown branches"),
        ("bird", new[] { "B", "I", "R", "D" }, "🐦", "Feathered singer soaring in the breeze"),
        ("ship", new[] { "S", "H", "I", "P" }, "🚢", "Sails proudly across ocean waves"),
        ("lion", new[] { "L", "I", "O", "N" }, "🦁", "Golden king of the grassy savanna"),
        ("ball", new[] { "B", "A", "L", "L" }, "⚽", "Round toy you kick, bounce, and throw")
    };

    private static readonly (string Word, string[] Blocks, string Emoji, string Hint)[] FallbackHard = new[]
    {
        ("apple", new[] { "A", "P", "P", "L", "E" }, "🍎", "Sweet crunchy red orchard fruit"),
        ("tiger", new[] { "T", "I", "G", "E", "R" }, "🐯", "Striped mighty cat in the jungle"),
        ("river", new[] { "R", "I", "V", "E", "R" }, "🏞️", "Flows fresh water winding to the ocean"),
        ("heart", new[] { "H", "E", "A", "R", "T" }, "❤️", "Beats inside your chest with love"),
        ("cloud", new[] { "C", "L", "O", "U", "D" }, "☁️", "Fluffy white shape floating in sky"),
        ("plant", new[] { "P", "L", "A", "N", "T" }, "🌱", "Grows from soil toward the sun"),
        ("robot", new[] { "R", "O", "B", "O", "T" }, "🤖", "Mechanical buddy with gears and lights"),
        ("train", new[] { "T", "R", "A", "I", "N" }, "🚂", "Travels on rails saying choo-choo"),
        ("space", new[] { "S", "P", "A", "C", "E" }, "🪐", "Realm of stars, planets, and rockets"),
        ("magic", new[] { "M", "A", "G", "I", "C" }, "🪄", "Sparkling wonder with a star wand")
    };

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        try
        {
            _curriculumQuestions = await QuestionService.LoadCustomQuestionsAsync("data/wordbuilder.json");
        }
        catch
        {
            // Fallback list used seamlessly
        }
    }

    protected override async Task<GameChallenge> GenerateChallengeAsync(int round, DifficultyLevel difficulty)
    {
        isWordAssembled = false;
        isSnapping = false;
        var index = (round - 1) % 10;

        // Try loaded curriculum first
        if (_curriculumQuestions != null && _curriculumQuestions.Count > 0)
        {
            var matchingTier = _curriculumQuestions.Where(q => q.Difficulty == difficulty).ToList();
            if (matchingTier.Count > index)
            {
                var q = matchingTier[index];
                var blocks = q.TargetAnswer.ToUpperInvariant().Select(c => c.ToString()).ToList();
                var emoji = !string.IsNullOrWhiteSpace(q.IconSvg) ? q.IconSvg : GetEmojiForWord(q.TargetAnswer);

                return new GameChallenge
                {
                    Id = q.Id,
                    Category = SkillCategory.Phonics,
                    Difficulty = difficulty,
                    Prompt = q.Prompt,
                    TargetAnswer = q.TargetAnswer.ToLowerInvariant(),
                    AcceptedAnswers = q.AcceptedAnswers,
                    Hint = q.Hint,
                    RewardStars = q.RewardStars,
                    DisplayItem = q.TargetAnswer,
                    LetterBlocks = blocks,
                    RevealedPicture = emoji
                };
            }
        }

        // Resilient Fallback Catalog
        var catalog = difficulty switch
        {
            DifficultyLevel.Hard => FallbackHard,
            DifficultyLevel.Medium => FallbackMedium,
            _ => FallbackEasy
        };

        var item = catalog[index];
        var spelled = string.Join(" - ", item.Blocks);

        return new GameChallenge
        {
            Id = $"builder_{(int)difficulty}_{index + 1}",
            Category = SkillCategory.Phonics,
            Difficulty = difficulty,
            Prompt = $"Assemble the blocks: {spelled}! Say the word to snap them together!",
            TargetAnswer = item.Word.ToLowerInvariant(),
            AcceptedAnswers = new() { item.Word.ToLowerInvariant(), $"a {item.Word.ToLowerInvariant()}", $"the {item.Word.ToLowerInvariant()}" },
            Hint = item.Hint,
            RewardStars = (int)difficulty,
            DisplayItem = item.Word,
            LetterBlocks = item.Blocks.ToList(),
            RevealedPicture = item.Emoji
        };
    }

    protected override async Task OnChallengeSolvedAsync(GameChallenge challenge)
    {
        // 1. Trigger snapping animation
        isSnapping = true;
        StateHasChanged();
        await AudioService.PlaySoundAsync(SoundEffect.Pop);

        await Task.Delay(450);

        // 2. Reveal assembled word card and picture
        isWordAssembled = true;
        isSnapping = false;
        StateHasChanged();
    }

    private async Task SpellLettersAloudAsync()
    {
        if (ActiveChallenge == null || ActiveChallenge.LetterBlocks.Count == 0) return;
        var spelledOut = string.Join(", ", ActiveChallenge.LetterBlocks);
        await VoiceManager.SpeakAsync($"{spelledOut}! What word does that build?");
    }

    private static string GetBlockColor(int index)
    {
        var colors = new[] { "#FFD166", "#4EA8DE", "#EF476F", "#06D6A0", "#F78C6B", "#C084FC" };
        return colors[index % colors.Length];
    }

    private static string GetEmojiForWord(string word) => (word ?? "").ToLowerInvariant().Trim() switch
    {
        "cat" => "🐱",
        "sun" => "☀️",
        "dog" => "🐶",
        "pig" => "🐷",
        "bat" => "🦇",
        "bus" => "🚌",
        "hat" => "🎩",
        "bug" => "🐛",
        "cup" => "☕",
        "bed" => "🛏️",
        "frog" => "🐸",
        "star" => "⭐",
        "fish" => "🐟",
        "duck" => "🦆",
        "moon" => "🌙",
        "tree" => "🌳",
        "bird" => "🐦",
        "ship" => "🚢",
        "lion" => "🦁",
        "ball" => "⚽",
        "apple" => "🍎",
        "tiger" => "🐯",
        "river" => "🏞️",
        "heart" => "❤️",
        "cloud" => "☁️",
        "plant" => "🌱",
        "robot" => "🤖",
        "train" => "🚂",
        "space" => "🪐",
        "magic" => "🪄",
        _ => "🌟"
    };
}
