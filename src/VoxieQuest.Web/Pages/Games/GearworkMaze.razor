        border-radius: var(--radius-pill);
        padding: 4px 12px;
        font-weight: 700;
        cursor: pointer;
    }

    .command-tape-strip {
        display: flex;
        gap: 8px;
        min-height: 58px;
        background: #E2E8F0;
        border-radius: 12px;
        padding: 8px;
