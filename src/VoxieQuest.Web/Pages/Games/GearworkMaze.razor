@page "/game/gearwork-maze"
@page "/games/gearwork-maze"
@inherits BaseGameComponent

<div class="game-viewport">
    <ParallaxBackground Theme="ParallaxBackground.ParallaxTheme.Clouds" />

    <!-- Top HUD -->
    <div class="storybook-card game-hud-card">
        <div class="hud-top-row">
            <button class="pill hud-back-btn" @onclick="ReturnToMapAsync" type="button" aria-label="Return to map">
                <span>◀ Map</span>
            </button>
            <h3 class="hud-game-title">
                ⚙️ @GameTitle
            </h3>
            <div class="star-badge hud-star-badge">
                <span>⭐</span>
                <span>@SessionStars</span>
            </div>
        </div>

        <div class="round-stepper">
            @for (int r = 1; r <= 5; r++)
            {
                var isCompleted = r < CurrentRound;
                var isCurrent = r == CurrentRound;
                <div class="round-dot @(isCompleted ? "completed" : "") @(isCurrent ? "current" : "")" title="Maze Level @r">
                    @(isCompleted ? "★" : r.ToString())
                </div>
            }
        </div>
    </div>

    <!-- Maze Arena -->
    <div class="storybook-card maze-arena">
        <div class="maze-header-bar">
            <span>🦔 Guide Grover to his Burrow 🏠 • Avoid Steam Vents 💨</span>
        </div>

        <!-- 5x5 SVG Clockwork Maze Grid -->
        <div class="maze-grid-wrapper">
            <svg width="100%" height="280" viewBox="0 0 300 280" preserveAspectRatio="xMidYMid meet">
                <!-- Maze Background Floor -->
                <rect x="10" y="10" width="280" height="260" rx="16" fill="#F1F5F9" stroke="#2B2D42" stroke-width="3" />

                <!-- 5x5 Grid Cells -->
                @for (int row = 0; row < 5; row++)
                {
                    for (int col = 0; col < 5; col++)
                    {
                        var cx = 20 + col * 52;
                        var cy = 20 + row * 50;
                        var isVent = obstacles.Contains((col, row));
                        var isGoal = (col == goalX && row == goalY);
                        var isGrover = (col == groverX && row == groverY);

                        <rect x="@cx" y="@cy" width="48" height="46" rx="8" 
                              fill="@(isVent ? "#FEE2E2" : (isGoal ? "#FEF08A" : "#FFFFFF"))" 
                              stroke="#CBD5E1" stroke-width="1.5" />

                        @if (isVent)
                        {
                            <g transform="translate(@cx, @cy)">
                                <text x="24" y="30" font-size="20" text-anchor="middle">💨</text>
                            </g>
                        }
                        else if (isGoal)
                        {
                            <g transform="translate(@cx, @cy)">
                                <text x="24" y="30" font-size="24" text-anchor="middle">🏠</text>
                            </g>
                        }
                        else if (isGrover)
                        {
                            <g transform="translate(@cx, @cy)">
                                <text x="24" y="32" font-size="26" text-anchor="middle">@groverFacingEmoji</text>
                            </g>
                        }
                    }
                }
            </svg>
        </div>

        <!-- Status message -->
        <div class="grover-status-bar @(isGoalReached ? "status-success" : (hasBumped ? "status-alert" : ""))">
            @if (isGoalReached)
            {
                <span>🎉 Hooray! Grover made it home safely!</span>
            }
            else if (hasBumped)
            {
                <span>⚠️ Ouch! Bumped into a barrier! Program reset — try again!</span>
            }
            else if (isRunningProgram)
            {
                <span>⚙️ Executing clockwork gears... Step @(executionStepIndex + 1)</span>
            }
            else
            {
                <span>Add move commands to Grover's command tape below!</span>
            }
        </div>
    </div>

    <!-- Command Tape Tray -->
    <div class="storybook-card command-tape-card">
        <div class="tape-header">
            <span class="tape-title">Command Tape (@commandTape.Count / 8):</span>
            <button class="pill-btn clear-tape-btn" type="button" @onclick="ClearTape" disabled="@(isRunningProgram || !commandTape.Any())">
                ↺ Clear
            </button>
        </div>

        <div class="command-tape-strip">
            @if (!commandTape.Any())
            {
                <span class="tape-empty-msg">Tape is empty. Tap commands below or shout "Forward"!</span>
            }
            else
            {
                @for (int i = 0; i < commandTape.Count; i++)
                {
                    var cmd = commandTape[i];
                    var isCurrentStep = isRunningProgram && executionStepIndex == i;
                    <div class="tape-slot @(isCurrentStep ? "active-step" : "")">
                        <span class="slot-num">@(i + 1)</span>
                        <span class="slot-icon">@GetCommandIcon(cmd)</span>
                    </div>
                }
            }
        </div>

        <!-- Command Palette Buttons -->
        @if (!isGoalReached)
        {
            <div class="commands-palette">
                <button class="cmd-btn" type="button" @onclick='() => AddCommand("F")' disabled="@(commandTape.Count >= 8 || isRunningProgram)">
                    <span class="cmd-icon">⬆</span>
                    <span class="cmd-label">Forward</span>
                </button>
                <button class="cmd-btn" type="button" @onclick='() => AddCommand("L")' disabled="@(commandTape.Count >= 8 || isRunningProgram)">
                    <span class="cmd-icon">↺</span>
                    <span class="cmd-label">Turn Left</span>
                </button>
                <button class="cmd-btn" type="button" @onclick='() => AddCommand("R")' disabled="@(commandTape.Count >= 8 || isRunningProgram)">
                    <span class="cmd-icon">↻</span>
                    <span class="cmd-label">Turn Right</span>
                </button>
            </div>

            <div class="run-actions-bar">
                <button class="btn-story btn-story-green run-btn" type="button" @onclick="RunProgramAsync" disabled="@(isRunningProgram || !commandTape.Any())">
                    <span>▶ Run Program!</span>
                </button>
            </div>
        }
        else
        {
            <div class="celebrate-next-bar">
                <button class="btn-story btn-story-yellow advance-btn" type="button" @onclick="AdvanceMaze">
                    <span>Next Level ➔</span>
                </button>
            </div>
        }
    </div>
</div>

<style>
    .game-viewport {
        width: 100%;
        max-width: 640px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
