        padding: var(--space-2) var(--space-3);
    }

    .hud-top-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: var(--space-2);
    }

    .hud-game-title {
        font-family: var(--font-heading);
        font-size: clamp(1.2rem, 3vw, 1.5rem);
        margin: 0;
        color: var(--color-storybook-ink);
    }

    .hud-star-badge {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 1.2rem;
        font-weight: 800;
        background: #FEF08A;
        padding: 4px 12px;
        border-radius: var(--radius-pill);
        border: 2px solid var(--color-storybook-ink);
    }

    .round-stepper {
        display: flex;
        justify-content: center;
        gap: var(--space-2);
    }

    .round-dot {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: #F1F5F9;
        border: 2px solid var(--color-storybook-ink);
        display: flex;
        align-items: center;
        justify-content: center;
