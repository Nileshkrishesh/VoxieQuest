</style>

@code {
    protected override string GameTitle => "Grover's Gearwork Maze";
    protected override SkillCategory GameCategory => SkillCategory.Numbers;

    private int groverX = 0;
    private int groverY = 0;
    private int groverDirection = 0; // 0 = East, 1 = South, 2 = West, 3 = North
    private int goalX = 4;
    private int goalY = 4;

    private HashSet<(int X, int Y)> obstacles = new();
    private List<string> commandTape = new();
    private bool isRunningProgram = false;
    private int executionStepIndex = -1;
    private bool isGoalReached = false;
    private bool hasBumped = false;

    private string groverFacingEmoji => groverDirection switch
    {
        0 => "🦔", // East
        1 => "🦔", // South
        2 => "🦔", // West
        _ => "🦔"  // North
    };

    protected override Task<GameChallenge> GenerateChallengeAsync(int round, DifficultyLevel difficulty)
    {
        groverX = 0;
        groverY = 0;
        groverDirection = 0;
        isGoalReached = false;
        hasBumped = false;
        isRunningProgram = false;
        commandTape.Clear();
        executionStepIndex = -1;

        goalX = 4;
        goalY = 4;

        // Level-specific maze obstacles
        obstacles.Clear();
        if (round <= 2)
        {
            obstacles.Add((2, 0));
            obstacles.Add((2, 1));
            obstacles.Add((2, 3));
        }
        else if (round <= 4)
        {
            obstacles.Add((1, 1));
            obstacles.Add((1, 2));
            obstacles.Add((3, 2));
            obstacles.Add((3, 3));
        }
        else
        {
            obstacles.Add((1, 0));
            obstacles.Add((1, 1));
            obstacles.Add((3, 1));
            obstacles.Add((1, 3));
            obstacles.Add((3, 3));
            obstacles.Add((2, 4));
        }

        var challenge = new GameChallenge
        {
            Category = GameCategory,
            Difficulty = difficulty,
            Prompt = "Slot Forward, Left, and Right commands to guide Grover around the steam vents into his cozy burrow!",
            TargetAnswer = "run",
            AcceptedAnswers = new() { "run", "go", "start", "forward", "left", "right" },
            DisplayItem = "⚙️",
            RewardStars = 2
        };

        return Task.FromResult(challenge);
    }

    protected override async Task OnChallengeSolvedAsync(GameChallenge challenge)
    {
        await RunProgramAsync();
    }

    private async Task AddCommand(string cmd)
    {
        if (commandTape.Count < 8 && !isRunningProgram)
        {
            commandTape.Add(cmd);
            await AudioService.PlaySoundAsync(SoundEffect.Click);
        }
    }

    private void ClearTape()
    {
        commandTape.Clear();
        hasBumped = false;
    }

    private string GetCommandIcon(string cmd) => cmd switch
    {
        "F" => "⬆",
        "L" => "↺",
        "R" => "↻",
        _ => "?"
    };

    private async Task RunProgramAsync()
    {
        if (!commandTape.Any() || isRunningProgram) return;

        isRunningProgram = true;
        hasBumped = false;
        groverX = 0;
        groverY = 0;
        groverDirection = 0;
        StateHasChanged();

        for (int i = 0; i < commandTape.Count; i++)
        {
            executionStepIndex = i;
            var cmd = commandTape[i];
            await AudioService.PlaySoundAsync(SoundEffect.Pop);

            if (cmd == "L")
            {
                groverDirection = (groverDirection + 3) % 4;
            }
            else if (cmd == "R")
            {
                groverDirection = (groverDirection + 1) % 4;
            }
            else if (cmd == "F")
            {
                var nextX = groverX;
                var nextY = groverY;

                if (groverDirection == 0) nextX++;
                else if (groverDirection == 1) nextY++;
                else if (groverDirection == 2) nextX--;
                else if (groverDirection == 3) nextY--;

                // Boundary & obstacle collision check
                if (nextX < 0 || nextX > 4 || nextY < 0 || nextY > 4 || obstacles.Contains((nextX, nextY)))
                {
                    hasBumped = true;
                    await AudioService.PlaySoundAsync(SoundEffect.EncourageChime);
                    isRunningProgram = false;
                    StateHasChanged();
                    return;
                }

                groverX = nextX;
                groverY = nextY;
            }

            StateHasChanged();
            await Task.Delay(400);

            if (groverX == goalX && groverY == goalY)
            {
                isGoalReached = true;
                isRunningProgram = false;
                await AudioService.PlaySoundAsync(SoundEffect.SuccessChime);

                if (ProgressService.ActiveProfile != null)
                {
                    ProgressService.ActiveProfile.NourishGardenSkill(
                        "cog_computational_logic",
                        "Computational Maze Routing",
                        OutcomeCategory.Cognitive,
                        30,
                        $"Routed Grover through subterranean steam maze level {CurrentRound} with {commandTape.Count} commands."
                    );
                    await ProgressService.RecordChallengeAttemptAsync(SkillCategory.Numbers, true, 2);
                }
                StateHasChanged();
                return;
            }
        }

        isRunningProgram = false;
        if (!isGoalReached)
        {
            hasBumped = true;
            await AudioService.PlaySoundAsync(SoundEffect.EncourageChime);
        }
        StateHasChanged();
    }

    private async Task AdvanceMaze()
    {
        if (CurrentRound < 5)
        {
            await SkipRoundAsync();
        }
        else
        {
            await AudioService.PlaySoundAsync(SoundEffect.Fanfare);
            await ReturnToMapAsync();
        }
    }
}
