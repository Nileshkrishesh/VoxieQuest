        background: #22C55E;
        color: white;
    }

    .round-dot.current {
        background: #FFD166;
        transform: scale(1.15);
    }

    .maze-arena {
        padding: var(--space-3);
        background: #FFFDF7;
        text-align: center;
    }

    .maze-header-bar {
        font-family: var(--font-heading);
        font-weight: 700;
        font-size: 0.95rem;
        color: #475569;
        margin-bottom: var(--space-2);
    }

    .maze-grid-wrapper {
        border-radius: 16px;
        overflow: hidden;
    }

    .grover-status-bar {
        margin-top: var(--space-2);
