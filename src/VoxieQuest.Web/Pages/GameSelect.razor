@page "/games"
@page "/game-select"
@inject IProgressService ProgressService
@inject IAudioService AudioService
@inject NavigationManager Navigation

<div class="games-select-container">
    <!-- Header Card -->
    <div class="storybook-card games-header-banner">
        <div class="header-banner-content">
            <div class="header-icon-wrap">
                <GamesIcon Size="52" FillColor="#FFC93C" />
            </div>
            <h1 class="games-header-title">Choose Your Quest!</h1>
            <p class="games-header-subtitle">
                Which magical voice adventure do you want to explore, <strong>@(ProgressService.ActiveProfile?.Name ?? "Explorer")</strong>?
            </p>
        </div>
    </div>

    <!-- 8 Big Chunky Cards in 2-Column Grid (1-Column on Phone) -->
    <div class="quest-games-grid">
        <!-- 1. Letter Rocket -->
        <div class="quest-card quest-card-rocket storybook-card" @onclick='() => LaunchGame("game/letter-rocket")'>
            <div class="quest-top-band band-rocket"></div>
            <div class="quest-card-body">
                <div class="quest-left-icon">
                    <RocketIcon Size="64" />
                </div>
                <div class="quest-details">
                    <div class="quest-tags-row">
                        <span class="pill quest-tag-pill">Letters &amp; Phonics</span>
                        <span class="quest-rounds-badge">10 Rounds</span>
                    </div>
                    <h2 class="quest-card-title">Letter Rocket</h2>
                    <p class="quest-card-desc">Say the letter aloud to blast your rocket into starlight!</p>
                </div>
                <div class="quest-action-col">
                    <BouncyButton Variant="BouncyButton.ButtonVariant.Blue" 
                                  Text="Play" 
                                  OnClick='() => LaunchGame("game/letter-rocket")'>
                        <IconTemplate><NextIcon Size="20" /></IconTemplate>
                    </BouncyButton>
                </div>
            </div>
        </div>

        <!-- 2. Number Jump -->
        <div class="quest-card quest-card-frog storybook-card" @onclick='() => LaunchGame("game/number-jump")'>
            <div class="quest-top-band band-frog"></div>
            <div class="quest-card-body">
                <div class="quest-left-icon">
                    <FrogIcon Size="64" />
                </div>
                <div class="quest-details">
                    <div class="quest-tags-row">
                        <span class="pill quest-tag-pill">Counting &amp; Math</span>
                        <span class="quest-rounds-badge">10 Rounds</span>
                    </div>
                    <h2 class="quest-card-title">Number Jump</h2>
                    <p class="quest-card-desc">Shout the sum number to hop across sunny water lilies!</p>
                </div>
                <div class="quest-action-col">
                    <BouncyButton Variant="BouncyButton.ButtonVariant.Mint" 
                                  Text="Play" 
                                  OnClick='() => LaunchGame("game/number-jump")'>
                        <IconTemplate><NextIcon Size="20" /></IconTemplate>
                    </BouncyButton>
                </div>
            </div>
        </div>

        <!-- 3. Color Splash -->
        <div class="quest-card quest-card-paint storybook-card" @onclick='() => LaunchGame("game/color-splash")'>
            <div class="quest-top-band band-paint"></div>
            <div class="quest-card-body">
                <div class="quest-left-icon">
                    <PaletteIcon Size="64" />
                </div>
                <div class="quest-details">
                    <div class="quest-tags-row">
                        <span class="pill quest-tag-pill">Rainbow Colors</span>
                        <span class="quest-rounds-badge">10 Rounds</span>
                    </div>
                    <h2 class="quest-card-title">Color Splash</h2>
                    <p class="quest-card-desc">Name the bright color to splash paint buckets onto drawings!</p>
                </div>
                <div class="quest-action-col">
                    <BouncyButton Variant="BouncyButton.ButtonVariant.Yellow" 
                                  Text="Play" 
                                  OnClick='() => LaunchGame("game/color-splash")'>
                        <IconTemplate><NextIcon Size="20" /></IconTemplate>
                    </BouncyButton>
                </div>
            </div>
        </div>

        <!-- 4. Animal Safari -->
        <div class="quest-card quest-card-safari storybook-card" @onclick='() => LaunchGame("game/animal-safari")'>
            <div class="quest-top-band band-safari"></div>
            <div class="quest-card-body">
                <div class="quest-left-icon">
                    <SafariIcon Size="64" />
                </div>
                <div class="quest-details">
                    <div class="quest-tags-row">
                        <span class="pill quest-tag-pill">Animal Calls</span>
                        <span class="quest-rounds-badge">10 Rounds</span>
                    </div>
                    <h2 class="quest-card-title">Animal Safari</h2>
                    <p class="quest-card-desc">Listen to wild calls and call the animal to your caravan!</p>
                </div>
                <div class="quest-action-col">
                    <BouncyButton Variant="BouncyButton.ButtonVariant.Coral" 
                                  Text="Play" 
                                  OnClick='() => LaunchGame("game/animal-safari")'>
                        <IconTemplate><NextIcon Size="20" /></IconTemplate>
                    </BouncyButton>
                </div>
            </div>
        </div>

        <!-- 5. Word Builder -->
        <div class="quest-card quest-card-blocks storybook-card" @onclick='() => LaunchGame("game/word-builder")'>
            <div class="quest-top-band band-blocks"></div>
            <div class="quest-card-body">
                <div class="quest-left-icon">
                    <BlocksIcon Size="64" />
                </div>
                <div class="quest-details">
                    <div class="quest-tags-row">
                        <span class="pill quest-tag-pill">Spelling &amp; Toys</span>
                        <span class="quest-rounds-badge">10 Rounds</span>
                    </div>
                    <h2 class="quest-card-title">Word Builder</h2>
                    <p class="quest-card-desc">Speak the word to snap puzzle blocks and reveal a toy surprise!</p>
                </div>
                <div class="quest-action-col">
                    <BouncyButton Variant="BouncyButton.ButtonVariant.Orange" 
                                  Text="Play" 
                                  OnClick='() => LaunchGame("game/word-builder")'>
                        <IconTemplate><NextIcon Size="20" /></IconTemplate>
                    </BouncyButton>
                </div>
            </div>
        </div>

        <!-- 6. Team Light Quest (Beacon Bridge) -->
        <div class="quest-card quest-card-beacon storybook-card" @onclick='() => LaunchGame("game/beacon-bridge")'>
            <div class="quest-top-band band-beacon"></div>
            <div class="quest-card-body">
                <div class="quest-left-icon">
                    <BeaconIcon Size="64" />
                </div>
                <div class="quest-details">
                    <div class="quest-tags-row">
                        <span class="pill quest-tag-pill">Teamwork &amp; Light</span>
                        <span class="quest-rounds-badge">5 Rounds</span>
                    </div>
                    <h2 class="quest-card-title">Team Light Quest</h2>
                    <p class="quest-card-desc">Turn light mirrors together to guide ships safely to the lighthouse!</p>
                </div>
                <div class="quest-action-col">
                    <BouncyButton Variant="BouncyButton.ButtonVariant.Blue" 
                                  Text="Play" 
                                  OnClick='() => LaunchGame("game/beacon-bridge")'>
                        <IconTemplate><NextIcon Size="20" /></IconTemplate>
                    </BouncyButton>
                </div>
            </div>
        </div>

        <!-- 7. Island Balance (Tumble Scale) -->
        <div class="quest-card quest-card-scale storybook-card" @onclick='() => LaunchGame("game/tumble-scale")'>
            <div class="quest-top-band band-scale"></div>
            <div class="quest-card-body">
                <div class="quest-left-icon">
                    <ScaleIcon Size="64" />
                </div>
                <div class="quest-details">
                    <div class="quest-tags-row">
                        <span class="pill quest-tag-pill">Maths &amp; Balance</span>
                        <span class="quest-rounds-badge">5 Rounds</span>
                    </div>
                    <h2 class="quest-card-title">Island Balance</h2>
                    <p class="quest-card-desc">Add coconut weights to balance the friendly seesaw bridge!</p>
                </div>
                <div class="quest-action-col">
                    <BouncyButton Variant="BouncyButton.ButtonVariant.Yellow" 
                                  Text="Play" 
                                  OnClick='() => LaunchGame("game/tumble-scale")'>
                        <IconTemplate><NextIcon Size="20" /></IconTemplate>
                    </BouncyButton>
                </div>
            </div>
        </div>

        <!-- 8. Mood Garden Sanctuary -->
        <div class="quest-card quest-card-mood storybook-card" @onclick='() => LaunchGame("game/mood-garden")'>
            <div class="quest-top-band band-mood"></div>
            <div class="quest-card-body">
                <div class="quest-left-icon">
                    <LotusIcon Size="64" />
                </div>
                <div class="quest-details">
                    <div class="quest-tags-row">
                        <span class="pill quest-tag-pill">Calm &amp; Breath</span>
                        <span class="quest-rounds-badge">5 Rounds</span>
                    </div>
                    <h2 class="quest-card-title">Mood Garden</h2>
                    <p class="quest-card-desc">Take gentle breaths to turn rainy clouds into warm sunshine!</p>
                </div>
                <div class="quest-action-col">
                    <BouncyButton Variant="BouncyButton.ButtonVariant.Mint" 
                                  Text="Play" 
                                  OnClick='() => LaunchGame("game/mood-garden")'>
                        <IconTemplate><NextIcon Size="20" /></IconTemplate>
                    </BouncyButton>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .games-select-container {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        max-width: 1040px;
        margin: 0 auto;
        padding-bottom: 2rem;
        width: 100%;
        box-sizing: border-box;
    }

    .games-header-banner {
        background: var(--color-paper-light, #FFF8E7);
        border: var(--border-storybook, 4px solid #2B2D42);
        border-radius: var(--radius-lg, 24px);
        box-shadow: var(--shadow-hard-md, 5px 5px 0 #2B2D42);
        padding: clamp(1.5rem, 3vw, 2rem);
        text-align: center;
        border-top: 10px solid var(--color-sunny-yellow);
    }

    .header-banner-content {
        max-width: 640px;
        margin: 0 auto;
    }

    .header-icon-wrap {
        display: inline-flex;
        margin-bottom: 0.5rem;
        animation: gentle-wobble 3s infinite ease-in-out;
    }

    .games-header-title {
        font-family: var(--font-heading);
        font-size: clamp(1.8rem, 4vw, 2.4rem);
        font-weight: 700;
        color: var(--color-storybook-ink);
        margin: 0 0 0.5rem 0;
    }

    .games-header-subtitle {
        font-family: var(--font-body);
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--color-storybook-ink);
        opacity: 0.88;
        margin: 0;
    }

    /* 2-Column Grid (1-Column on Phone) */
    .quest-games-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.25rem;
        width: 100%;
    }

    @@media (max-width: 768px) {
        .quest-games-grid {
            grid-template-columns: 1fr;
        }
    }

    .quest-card {
        background: #FFFFFF;
        border: var(--border-storybook, 4px solid #2B2D42);
        border-radius: var(--radius-lg, 24px);
        box-shadow: 6px 6px 0 var(--color-storybook-ink, #2B2D42);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        cursor: pointer;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
        touch-action: manipulation;
    }

    .quest-card:hover {
        transform: translateY(-3px);
        box-shadow: 8px 8px 0 var(--color-storybook-ink);
    }

    .quest-top-band {
        height: 10px;
        width: 100%;
        border-bottom: 2px solid var(--color-storybook-ink);
    }

    .band-rocket { background: var(--color-sky-blue); }
    .band-frog { background: var(--color-mint); }
    .band-paint { background: var(--color-sunny-yellow); }
    .band-safari { background: var(--color-coral); }
    .band-blocks { background: var(--color-soft-orange); }
    .band-beacon { background: #38BDF8; }
    .band-scale { background: #FBBF24; }
    .band-mood { background: #34D399; }

    .quest-card-body {
        padding: 1.25rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        flex: 1;
    }

    .quest-left-icon {
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .quest-details {
        flex: 1;
        min-width: 0;
    }

    .quest-tags-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.35rem;
    }

    .quest-tag-pill {
        background: var(--color-paper-light);
        border: 2px solid var(--color-storybook-ink);
        border-radius: var(--radius-pill);
        padding: 2px 8px;
        font-family: var(--font-heading);
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--color-storybook-ink);
    }

    .quest-rounds-badge {
        font-family: var(--font-heading);
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--color-sky-blue);
    }

    .quest-card-title {
        font-family: var(--font-heading);
        font-size: 24px;
        font-weight: 700;
        color: var(--color-storybook-ink);
        margin: 0 0 0.25rem 0;
    }

    .quest-card-desc {
        font-family: var(--font-body);
        font-size: 18px;
        font-weight: 700;
        color: var(--color-storybook-ink);
        opacity: 0.85;
        margin: 0;
        line-height: 1.35;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .quest-action-col {
        flex-shrink: 0;
    }

    @@media (max-width: 480px) {
        .quest-card-body {
            flex-direction: column;
            text-align: center;
        }
        .quest-tags-row {
            justify-content: center;
        }
        .quest-card-desc {
            white-space: normal;
        }
    }

    @@keyframes gentle-wobble {
        0%, 100% { transform: rotate(0deg); }
        50% { transform: rotate(4deg); }
    }
</style>

@code {
    private async Task LaunchGame(string route)
    {
        await AudioService.PlaySoundAsync(SoundEffect.Click);
        Navigation.NavigateTo(route);
    }
}
