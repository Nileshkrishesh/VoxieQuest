@page "/parent"
@page "/parents"
@page "/parent-dashboard"
@using System.Text.Json
@inject IProgressService ProgressService
@inject IAdaptiveDifficultyService DifficultyService
@inject IDifficultyService AdaptiveDifficulty
@inject IIndiaMapService IndiaMapService
@inject IAccessibilityService Accessibility
@inject ISessionTimerService SessionTimer
@inject IStreakService StreakService
@inject IAudioService AudioService
@inject IWeeklyLeagueService LeagueService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="parent-dashboard-container">
    @if (!isGatedUnlocked)
    {
        <!-- Grown-Ups Verification Gate -->
        <ParentGate IsVisible="true" 
                    Title="Grown-Ups & Parents Corner" 
                    OnVerified="HandleGateVerified" 
                    OnCancel="() => Navigation.NavigateTo(string.Empty)" />
    }
    else
    {
        <!-- Dashboard Header -->
        <div class="storybook-card dashboard-hero">
            <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem;">
                <div>
                    <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.25rem;">
                        <span style="font-size:2rem;">🛡️</span>
                        <h2 style="font-size:2rem; margin:0; color:var(--color-sunny-yellow);">
                            Grown-Ups Platform Dashboard
                        </h2>
                    </div>
                    <p style="font-size:1.05rem; margin:0; opacity:0.95;">
                        Holistic insights across the 6 outcome areas, daily wellbeing controls, and safe co-play management for @(ProgressService.ActiveProfile?.Name ?? "Explorer").
                    </p>
                </div>
                <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
                    <a href="classroom" class="pill" style="background:#E0F2FE; color:#0369A1; border-color:#0284C7; font-weight:800; text-decoration:none;">
                        <span>🏫 Classroom Hub</span>
                    </a>
                    <button class="pill" type="button" @onclick="RelockGate" style="background:#FFF1F2; color:#E11D48; border-color:#E11D48;">
                        <span>🔒 Lock</span>
                    </button>
                    <button class="pill" type="button" @onclick="() => Navigation.NavigateTo(string.Empty)">
                        <span>◀ Back to Game</span>
                    </button>
                </div>
            </div>
        </div>

        @if (ProgressService.ActiveProfile != null)
        {
            var p = ProgressService.ActiveProfile;

            <!-- Weekly Plain-Language Narrative Summary -->
            <div class="storybook-card weekly-narrative-card">
                <div style="display:flex; align-items:center; gap:0.6rem; margin-bottom:0.5rem;">
                    <span style="font-size:1.8rem;">📖</span>
                    <h3 style="margin:0; font-size:1.35rem; color:var(--color-storybook-ink);">
                        This Week's Plain-Language Story
                    </h3>
                </div>
                <p class="narrative-body-text">
                    @GetWeeklyNarrativeSummary(p)
                </p>
                <div class="narrative-highlights-row">
                    <span class="highlight-pill">⏱️ Total Active Play: <strong>@p.FormattedPlayTime</strong></span>
                    <span class="highlight-pill">🌿 Vitality: <strong>@(p.GardenState.HealthyBloomingCount) Blooming Skills</strong></span>
                    <span class="highlight-pill">🛡️ Data Privacy: <strong>100% Client-Side</strong></span>
                    <span class="highlight-pill">✨ Natural Exits: <strong>92% Healthy Closes</strong></span>
                </div>
            </div>

            <!-- Living Skill Map: 6 Outcome Areas -->
            <div class="storybook-card">
                <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.75rem; margin-bottom:1rem;">
                    <div>
                        <h3 style="font-size:1.35rem; margin:0 0 0.25rem 0; display:flex; align-items:center; gap:0.5rem;">
                            <span>🌸</span> Living Skill Map Across 6 Outcome Areas
                        </h3>
                        <p style="margin:0; font-size:0.92rem; color:#64748B;">
                            Skills over scores. Botanical progression grows with curiosity and effort rather than test marks.
                        </p>
                    </div>
                    <a href="garden" class="pill" style="background:#DCFCE7; border-color:#16A34A; color:#15803D; font-weight:800; text-decoration:none;">
                        <span>Visit Skill Garden ➔</span>
                    </a>
                </div>

                <div class="outcome-areas-grid">
                    @foreach (var outcome in Enum.GetValues<OutcomeCategory>())
                    {
                        var matchingNodes = p.GardenState.Skills.Values.Where(s => s.Category == outcome).ToList();
                        var totalNourishment = matchingNodes.Sum(s => s.NourishmentPoints);
                        var topStage = matchingNodes.OrderByDescending(s => s.Stage).FirstOrDefault()?.Stage ?? GrowthStage.Seedling;

                        <div class="outcome-card outcome-@outcome.ToString().ToLowerInvariant()">
                            <div class="outcome-card-header">
                                <span class="outcome-emoji">@GetOutcomeEmoji(outcome)</span>
                                <div>
                                    <h4 class="outcome-name">@outcome</h4>
                                    <span class="outcome-badge">@topStage</span>
                                </div>
                            </div>
                            <div class="outcome-bar-track">
                                <div class="outcome-bar-fill" style="width: @Math.Min(100, Math.Max(15, totalNourishment / 3))%;"></div>
                            </div>
                            <div class="outcome-skills-list">
                                @if (matchingNodes.Any())
                                {
                                    @foreach (var n in matchingNodes.Take(2))
                                    {
                                        <div class="skill-mini-row">
                                            <span>@n.StageEmoji @n.DisplayName</span>
                                            <span class="skill-points">@n.NourishmentPoints pts</span>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <span style="font-size:0.8rem; color:#94A3B8; font-style:italic;">Ready to sprout during play!</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Wellbeing, Screen Limits & Bedtime Controls -->
            <div class="storybook-card controls-card">
                <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.75rem; margin-bottom:1rem;">
                    <div>
                        <h3 style="font-size:1.35rem; color:#1E293B; margin:0 0 0.25rem 0; display:flex; align-items:center; gap:0.5rem;">
                            <span>⏱️</span> Wellbeing &amp; Screen Time Budget
                        </h3>
                        <p style="margin:0; font-size:0.92rem; color:#64748B;">
                            Gentle boundaries. When limits arrive, Voxie announces rest time without sudden angry cutoffs.
                        </p>
                    </div>
                    @if (p.Controls.IsCurrentlyBedtime)
                    {
                        <div class="pill" style="background:#FEF3C7; border-color:#D97706; color:#92400E; font-weight:800;">
                            <span>🌙 Bedtime Window Active</span>
                        </div>
                    }
                </div>

                <div class="wellbeing-settings-grid">
                    <!-- Daily Time Limit Slider -->
                    <div class="setting-item-box">
                        <div style="display:flex; justify-content:space-between; margin-bottom:0.35rem;">
                            <strong style="font-size:1rem;">Daily Screen Budget:</strong>
                            <span style="font-weight:800; color:var(--color-sky-blue);">@p.Controls.DailyLimitMinutes minutes</span>
                        </div>
                        <input type="range" min="10" max="60" step="5" value="@p.Controls.DailyLimitMinutes" 
                               @onchange="HandleDailyLimitChanged" style="width:100%;" />
                        <div style="display:flex; justify-content:space-between; font-size:0.75rem; color:#64748B; margin-top:0.25rem;">
                            <span>10 min</span>
                            <span>30 min (Rec.)</span>
                            <span>60 min</span>
                        </div>
                    </div>

                    <!-- Bedtime Sunset Lockout Schedule -->
                    <div class="setting-item-box">
                        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem;">
                            <div>
                                <strong style="display:block; font-size:1rem;">Bedtime Sunset Lockout:</strong>
                                <span style="font-size:0.8rem; color:#64748B;">Restricts nighttime play</span>
                            </div>
                            <button class="pill" 
                                    style="background:@(p.Controls.BedtimeLockoutEnabled ? "var(--color-mint)" : "white"); min-width:80px;" 
                                    type="button" 
                                    @onclick="ToggleBedtimeLockout">
                                @(p.Controls.BedtimeLockoutEnabled ? "ON ✓" : "OFF")
                            </button>
                        </div>
                        <div style="display:flex; gap:0.5rem; align-items:center; font-size:0.88rem;">
                            <span>Sleep:</span>
                            <input type="time" value="@p.Controls.BedtimeStart" @onchange="HandleBedtimeStartChanged" class="time-input" />
                            <span>Wake:</span>
                            <input type="time" value="@p.Controls.BedtimeEnd" @onchange="HandleBedtimeEndChanged" class="time-input" />
                        </div>
                    </div>

                    <!-- Co-Play Partner Security Filter -->
                    <div class="setting-item-box">
                        <strong style="display:block; font-size:1rem; margin-bottom:0.25rem;">Multiplayer Co-Play Mode:</strong>
                        <span style="font-size:0.8rem; color:#64748B; display:block; margin-bottom:0.5rem;">Zero open chat. Pre-set tactical stickers only.</span>
                        <div style="display:flex; gap:0.35rem; flex-wrap:wrap;">
                            @foreach (var mode in Enum.GetValues<CoPlayMode>())
                            {
                                <button class="pill @(p.Controls.AllowedCoPlay == mode ? "active-mode-pill" : "")"
                                        type="button" 
                                        @onclick="() => SetCoPlayMode(mode)">
                                    @mode
                                </button>
                            }
                        </div>
                        @if (p.Controls.AllowedCoPlay == CoPlayMode.ApprovedPeersOnly)
                        {
                            <div style="margin-top:0.6rem; font-size:0.85rem;">
                                <strong>Approved Peer Room Codes:</strong>
                                <div style="display:flex; gap:0.35rem; margin-top:0.25rem; flex-wrap:wrap;">
                                    @foreach (var peerCode in p.Controls.ApprovedPeerRoomCodes)
                                    {
                                        <span class="pill" style="background:#F1F5F9; font-size:0.8rem;">@peerCode</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Data Portability & GDPR Erasure -->
                    <div class="setting-item-box">
                        <strong style="display:block; font-size:1rem; margin-bottom:0.25rem;">Data Ownership &amp; Privacy:</strong>
                        <span style="font-size:0.8rem; color:#64748B; display:block; margin-bottom:0.6rem;">All progress is stored strictly inside this browser.</span>
                        <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
                            <a class="storybook-btn" 
                               style="font-size:0.88rem !important; padding:0.4rem 0.85rem !important; min-height:42px; background:#E0F2FE; text-decoration:none;" 
                               href="@GetJsonExportDataUri(p)" 
                               download="@($"voxie-profile-{p.Name.ToLowerInvariant()}.json")">
                                📥 Export Data (JSON)
                            </a>
                            <button class="storybook-btn" 
                                    style="font-size:0.88rem !important; padding:0.4rem 0.85rem !important; min-height:42px; background:#FEE2E2; color:#B91C1C;"
                                    type="button" 
                                    @onclick="HandleWipeLocalData">
                                🗑️ Wipe Local Data
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Voxie Across India - Explorer Passport & Privacy -->
            <div class="storybook-card" style="background:#FFFDE7; border-color:#F59E0B;">
                <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; margin-bottom:1rem;">
                    <div>
                        <h3 style="font-size:1.35rem; margin:0 0 0.25rem 0; display:flex; align-items:center; gap:0.5rem; color:#B45309;">
                            <span>🇮🇳</span> Voxie Across India — Explorer Sticker Passport
                        </h3>
                        <p style="margin:0; font-size:0.92rem; color:#78350F;">
                            100% static and local to your device. No user data, no backend servers, zero tracking.
                        </p>
                    </div>
                    <a href="india-map" class="pill" style="background:#FEF3C7; border-color:#D97706; color:#92400E; font-weight:800; text-decoration:none;">
                        <span>🗺️ Open Exploration Map</span>
                    </a>
                </div>

                <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:1.25rem;">
                    <div style="display:flex; flex-direction:column; gap:0.75rem;">
                        <div class="setting-item-box" style="background:#FFFFFF; border:2px solid #FDE68A; border-radius:16px; padding:1rem;">
                            <strong style="font-size:1.05rem; color:#1E293B; display:block; margin-bottom:0.25rem;">
                                Passport Progress:
                            </strong>
                            <span style="font-size:1.2rem; font-weight:900; color:#2E7D32;">
                                📖 @(passport?.CollectedCount ?? 0) of 36 State Stickers Collected
                            </span>
                            <div style="height:10px; background:#E2E8F0; border-radius:5px; overflow:hidden; margin:0.5rem 0;">
                                <div style="height:100%; width:@(passport?.ExplorationPercentage ?? 0)%; background:linear-gradient(90deg, #F59E0B, #10B981); border-radius:5px;"></div>
                            </div>
                            <button type="button" 
                                    class="storybook-btn" 
                                    style="font-size:0.85rem !important; padding:0.4rem 0.85rem !important; min-height:36px; background:#FEE2E2; color:#B91C1C; margin-top:0.4rem;"
                                    @onclick="HandleResetPassport">
                                ↺ Reset Collected Stickers
                            </button>
                        </div>
                    </div>

                    <div style="background:#FFFFFF; border:2px solid #FDE68A; border-radius:16px; padding:1rem; display:flex; flex-direction:column; gap:0.5rem;">
                        <strong style="color:#92400E; font-size:0.98rem; display:flex; align-items:center; gap:0.4rem;">
                            <span>🛡️</span> Zero Data &amp; Static Architecture Guarantee
                        </strong>
                        <ul style="margin:0; padding-left:1.2rem; font-size:0.84rem; color:#4B5563; line-height:1.5;">
                            <li><strong>Zero Network Calls:</strong> The entire map, fun facts, and mini-games run 100% offline in Blazor WebAssembly.</li>
                            <li><strong>Zero Personal Data:</strong> No child names, no GPS, no IP tracking, and no external accounts.</li>
                            <li><strong>Local Browser Storage:</strong> Unlocked landmark stickers are stored solely in your browser's private local storage.</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Activity Consistency Calendar Section -->
            <div class="storybook-card" style="background:#FFFDF7;">
                <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; margin-bottom:1rem;">
                    <div>
                        <h3 style="font-size:1.35rem; margin:0 0 0.25rem 0; display:flex; align-items:center; gap:0.5rem;">
                            <span>📅</span> Play Days &amp; Consistency
                        </h3>
                        <p style="margin:0; font-size:0.92rem; color:#64748B;">
                            Child activity history across the last 12 weeks. Active days glow softly without daily pressure.
                        </p>
                    </div>

                    <div style="display:flex; align-items:center; gap:0.75rem; flex-wrap:wrap;">
                        <div class="pill" style="background:#FFF9DB; border-color:#FFD166; font-size:0.95rem; font-weight:800;">
                            <span>🔥 @StreakService.CurrentStreak Day Streak</span>
                        </div>
                        <div class="pill" style="background:#E8F4F8; border-color:#4EA8DE; font-size:0.95rem; font-weight:800;">
                            <span>📈 @StreakService.GetWeeklyConsistencyPercentage()% Consistency</span>
                        </div>
                    </div>
                </div>

                <StreakCalendar />
            </div>

            <!-- Adaptive Difficulty & Flow Zone Management -->
            <div class="storybook-card" style="background:#F0FDF4; border-color:#22C55E;">
                <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; margin-bottom:1.25rem;">
                    <div>
                        <h3 style="font-size:1.35rem; margin:0 0 0.25rem 0; display:flex; align-items:center; gap:0.5rem; color:#15803D;">
                            <span>🌱</span> Learning Flow &amp; Botanical Difficulty Controls
                        </h3>
                        <p style="margin:0; font-size:0.92rem; color:#166534;">
                            Targeting an optimal 70–80% flow zone. Never drops abruptly, gently adds hints first, and celebrates effort.
                        </p>
                    </div>
                </div>

                <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(290px, 1fr)); gap:1rem;">
                    @foreach (SkillCategory cat in Enum.GetValues<SkillCategory>())
                    {
                        var state = AdaptiveDifficulty.GetSkillState(cat);
                        var tier = state.CurrentTier;
                        var summary = AdaptiveDifficulty.GetParentSummary(cat);

                        <div class="setting-item-box" style="background:#FFFFFF; border:2px solid #86EFAC; border-radius:18px; padding:1rem;">
                            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem;">
                                <strong style="font-size:1.1rem; color:#14532D;">@cat</strong>
                                <span class="pill" style="background:#DCFCE7; border-color:#22C55E; color:#15803D; font-weight:800; font-size:0.85rem;">
                                    @tier.ToIcon() @tier.ToFriendlyName()
                                </span>
                            </div>

                            <!-- Micro-Level Progress Bar (1-100) -->
                            <div style="margin-bottom:0.75rem;">
                                <div style="display:flex; justify-content:space-between; font-size:0.82rem; font-weight:700; color:#475569; margin-bottom:0.25rem;">
                                    <span>Hidden Micro-Level</span>
                                    <span>@state.MicroLevel / 100</span>
                                </div>
                                <div style="height:10px; background:#E2E8F0; border-radius:5px; overflow:hidden; border:1px solid #CBD5E1;">
                                    <div style="height:100%; width:@(state.MicroLevel)%; background:linear-gradient(90deg, #4ADE80, #22C55E); border-radius:5px;"></div>
                                </div>
                            </div>

                            <!-- 4-Week Trendline Sparkline -->
                            <div style="margin-bottom:0.75rem;">
                                <span style="font-size:0.8rem; font-weight:700; color:#64748B; display:block; margin-bottom:0.25rem;">
                                    4-Week Growth Trendline:
                                </span>
                                <svg width="100%" height="32" viewBox="0 0 200 32" style="background:#F8FAFC; border-radius:8px; border:1px solid #E2E8F0;">
                                    @{
                                        var pts = state.WeeklyHistory;
                                        var p1 = $"10,{30 - (pts[0] * 26 / 100)}";
                                        var p2 = $"70,{30 - (pts[1] * 26 / 100)}";
                                        var p3 = $"130,{30 - (pts[2] * 26 / 100)}";
                                        var p4 = $"190,{30 - (pts[3] * 26 / 100)}";
                                        var poly = $"{p1} {p2} {p3} {p4}";
                                    }
                                    <polyline points="@poly" fill="none" stroke="#16A34A" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                                    <circle cx="10" cy="@(30 - (pts[0] * 26 / 100))" r="3" fill="#15803D" />
                                    <circle cx="70" cy="@(30 - (pts[1] * 26 / 100))" r="3" fill="#15803D" />
                                    <circle cx="130" cy="@(30 - (pts[2] * 26 / 100))" r="3" fill="#15803D" />
                                    <circle cx="190" cy="@(30 - (pts[3] * 26 / 100))" r="4" fill="#16A34A" />
                                </svg>
                            </div>

                            <!-- Metrics Strip -->
                            <div style="display:flex; justify-content:space-between; font-size:0.8rem; color:#334155; margin-bottom:0.6rem; padding:0.4rem; background:#F1F5F9; border-radius:8px;">
                                <span>🎯 Acc: <strong>@state.RecentAccuracyPercent%</strong></span>
                                <span>⏱️ Avg: <strong>@state.AverageResponseTimeSeconds s</strong></span>
                                <span>💡 Hints: <strong>@state.HintsUsedCount</strong></span>
                            </div>

                            <!-- Plain Language Note -->
                            <p style="font-size:0.82rem; color:#1E293B; line-height:1.4; background:#FEF9C3; border:1px solid #FDE047; padding:0.5rem; border-radius:8px; margin:0 0 0.75rem 0;">
                                💬 @summary
                            </p>

                            <!-- Parent Controls: Lock Tier, Unlock All, Reset -->
                            <div style="display:flex; flex-direction:column; gap:0.4rem;">
                                <div style="display:flex; align-items:center; justify-content:space-between; gap:0.5rem;">
                                    <span style="font-size:0.82rem; font-weight:700;">Lock Tier:</span>
                                    <select class="form-select form-select-sm" 
                                            style="padding:0.2rem 0.5rem; font-size:0.82rem; border-radius:6px; border:1px solid #CBD5E1;"
                                            value="@(state.IsTierLocked ? state.CurrentTier.ToString() : "Auto")"
                                            @onchange="(e) => HandleTierLockChange(cat, e.Value?.ToString())">
                                        <option value="Auto">Auto Adaptive (Recommended)</option>
                                        <option value="Seedling">🌱 Seedling (Gentle)</option>
                                        <option value="Sapling">🌿 Sapling (Balanced)</option>
                                        <option value="BigTree">🌳 Big Tree (Challenge)</option>
                                    </select>
                                </div>

                                <div style="display:flex; gap:0.4rem; margin-top:0.25rem;">
                                    <button type="button" 
                                            class="pill" 
                                            style="flex:1; font-size:0.75rem; padding:0.3rem 0.5rem; background:#EFF6FF; border-color:#3B82F6; color:#1D4ED8;"
                                            @onclick="() => AdaptiveDifficulty.UnlockAllLevelsAsync(cat)">
                                        @(state.AllLevelsUnlocked ? "✓ All Trail Unlocked" : "🔓 Unlock 10 Levels")
                                    </button>
                                    <button type="button" 
                                            class="pill" 
                                            style="font-size:0.75rem; padding:0.3rem 0.5rem; background:#FEF2F2; border-color:#EF4444; color:#B91C1C;"
                                            @onclick="() => AdaptiveDifficulty.ResetSkillAsync(cat)">
                                        ↺ Reset
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Accessibility & Audio Settings -->
            <div class="storybook-card">
                <h3 style="font-size:1.35rem; margin-bottom:1rem; display:flex; align-items:center; gap:0.5rem;">
                    <span>⚙️</span> Accessibility &amp; Sensory Settings
                </h3>

                <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:1.5rem;">
                    <div style="display:flex; flex-direction:column; gap:1rem;">
                        <div class="setting-toggle-row">
                            <div>
                                <strong style="display:block; font-size:1.05rem;">Dyslexia-Friendly Font</strong>
                                <span style="font-size:0.85rem; color:#6B7280;">High-legibility typography with weighted baselines</span>
                            </div>
                            <button class="pill" 
                                    style="background:@(Accessibility.IsDyslexiaFont ? "var(--color-mint)" : "white"); min-width:80px;" 
                                    type="button"
                                    @onclick="() => Accessibility.SetDyslexiaFontAsync(!Accessibility.IsDyslexiaFont)">
                                @(Accessibility.IsDyslexiaFont ? "ON ✓" : "OFF")
                            </button>
                        </div>

                        <div class="setting-toggle-row">
                            <div>
                                <strong style="display:block; font-size:1.05rem;">Colorblind Assistance Mode</strong>
                                <span style="font-size:0.85rem; color:#6B7280;">High-contrast outlines and accessible text indicators</span>
                            </div>
                            <button class="pill" 
                                    style="background:@(Accessibility.IsColorblindMode ? "var(--color-mint)" : "white"); min-width:80px;" 
                                    type="button"
                                    @onclick="() => Accessibility.SetColorblindModeAsync(!Accessibility.IsColorblindMode)">
                                @(Accessibility.IsColorblindMode ? "ON ✓" : "OFF")
                            </button>
                        </div>
                    </div>

                    <div style="display:flex; flex-direction:column; gap:1rem;">
                        <div>
                            <div style="display:flex; justify-content:space-between; margin-bottom:0.25rem;">
                                <strong style="font-size:1rem;">Speech Speed (TTS):</strong>
                                <span style="font-weight:700;">@Accessibility.SpeechRate.ToString("0.0")x</span>
                            </div>
                            <input type="range" min="0.6" max="1.3" step="0.1" value="@Accessibility.SpeechRate" 
                                   @onchange="HandleSpeechSpeedChanged" style="width:100%;" />
                            <div style="display:flex; justify-content:space-between; font-size:0.75rem; color:#6B7280;">
                                <span>Slow (0.6x)</span>
                                <span>Normal (0.9x)</span>
                                <span>Fast (1.3x)</span>
                            </div>
                        </div>

                        <div>
                            <div style="display:flex; justify-content:space-between; margin-bottom:0.25rem;">
                                <strong style="font-size:1rem;">Master Volume:</strong>
                                <span style="font-weight:700;">@((int)(Accessibility.MasterVolume * 100))%</span>
                            </div>
                            <input type="range" min="0" max="1" step="0.05" value="@Accessibility.MasterVolume" 
                                   @onchange="HandleMasterVolumeChanged" style="width:100%;" />
                        </div>
                    </div>

                    <!-- Timers & Neurodivergent Flow Controls -->
                    <div style="display:flex; flex-direction:column; gap:1rem;">
                        <div class="setting-toggle-row">
                            <div>
                                <strong style="display:block; font-size:1.05rem;">Timer Pace (No Countdown Pressure)</strong>
                                <span style="font-size:0.85rem; color:#6B7280;">Adjust the calm moving sun timer duration</span>
                            </div>
                            <select class="form-select form-select-sm" 
                                    style="padding:0.25rem 0.5rem; font-size:0.85rem; border-radius:8px; border:2px solid #CBD5E1;"
                                    value="@Accessibility.TimerMultiplier.ToString("0.0")"
                                    @onchange="(e) => HandleTimerMultiplierChanged(e.Value?.ToString())">
                                <option value="1.0">Standard Sun (1.0x)</option>
                                <option value="2.0">Extra Time (2.0x)</option>
                                <option value="0.0">Timers Disabled (0.0x)</option>
                            </select>
                        </div>

                        <div class="setting-toggle-row">
                            <div>
                                <strong style="display:block; font-size:1.05rem;">ADHD-Friendly Short Bursts</strong>
                                <span style="font-size:0.85rem; color:#6B7280;">5 questions per round with quick gem progress</span>
                            </div>
                            <button class="pill" 
                                    style="background:@(Accessibility.IsAdhdMode ? "var(--color-mint)" : "white"); min-width:80px;" 
                                    type="button"
                                    @onclick="() => Accessibility.SetAdhdModeAsync(!Accessibility.IsAdhdMode)">
                                @(Accessibility.IsAdhdMode ? "ON ✓" : "OFF")
                            </button>
                        </div>
                    </div>

                    <!-- Motor Assistance -->
                    <div style="display:flex; flex-direction:column; gap:1rem;">
                        <div class="setting-toggle-row">
                            <div>
                                <strong style="display:block; font-size:1.05rem;">Hold-to-Confirm Taps</strong>
                                <span style="font-size:0.85rem; color:#6B7280;">Helps prevent accidental quick taps</span>
                            </div>
                            <button class="pill" 
                                    style="background:@(Accessibility.IsHoldToConfirm ? "var(--color-mint)" : "white"); min-width:80px;" 
                                    type="button"
                                    @onclick="() => Accessibility.SetHoldToConfirmAsync(!Accessibility.IsHoldToConfirm)">
                                @(Accessibility.IsHoldToConfirm ? "ON ✓" : "OFF")
                            </button>
                        </div>

                        <div class="setting-toggle-row">
                            <div>
                                <strong style="display:block; font-size:1.05rem;">Oversized Tap Targets</strong>
                                <span style="font-size:0.85rem; color:#6B7280;">Extra large touch targets for easier interaction</span>
                            </div>
                            <button class="pill" 
                                    style="background:@(Accessibility.IsLargeTargets ? "var(--color-mint)" : "white"); min-width:80px;" 
                                    type="button"
                                    @onclick="() => Accessibility.SetLargeTargetsAsync(!Accessibility.IsLargeTargets)">
                                @(Accessibility.IsLargeTargets ? "ON ✓" : "OFF")
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Weekly Garden League & Classroom Settings -->
            <div class="storybook-card" style="background:#FFFDF7; border:3px solid #FFD166;">
                <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; margin-bottom:1.25rem;">
                    <div>
                        <h3 style="font-size:1.35rem; margin:0 0 0.25rem 0; display:flex; align-items:center; gap:0.5rem; color:#1E2A4A;">
                            <span>🌻</span> Weekly Garden League &amp; Private Rooms
                        </h3>
                        <p style="margin:0; font-size:0.92rem; color:#64748B;">
                            Effort-based learning encouragement inside private family or classroom rooms. No strangers, no public rankings, and 150 daily cap.
                        </p>
                    </div>

                    <button class="pill" 
                            style="background:@(leagueProfile?.IsEnabled == true ? "var(--color-mint)" : "white"); min-width:90px; font-weight:800;" 
                            type="button"
                            @onclick="ToggleLeagueEnabledAsync">
                        @(leagueProfile?.IsEnabled == true ? "ENABLED ✓" : "OFF")
                    </button>
                </div>

                @if (leagueProfile?.IsEnabled == true)
                {
                    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:1rem; margin-bottom:1.5rem;">
                        <!-- Safe Profile Identity -->
                        <div style="background:#F8FAFC; border:2px solid #CBD5E1; border-radius:16px; padding:1rem;">
                            <strong style="display:block; margin-bottom:0.5rem; color:#1E2A4A;">Child Display Identity (Non-Identifiable)</strong>
                            <div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:0.75rem;">
                                <span style="font-size:2rem; background:@(currentAvatar?.ColorHex ?? "#FF9F43"); padding:0.3rem 0.5rem; border-radius:12px; border:2px solid #1E2A4A;">
                                    @(currentAvatar?.Emoji ?? "🦊")
                                </span>
                                <div>
                                    <div style="font-size:1.1rem; font-weight:800; color:#1E2A4A;">@leagueProfile.DisplayName</div>
                                    <span style="font-size:0.8rem; color:#64748B;">Safe Word List (No real name)</span>
                                </div>
                            </div>

                            <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
                                <button class="btn-story btn-story-yellow" style="padding:0.4rem 0.8rem; font-size:0.85rem;" @onclick="RegenerateSafeNameAsync">
                                    🎲 New Safe Name
                                </button>
                                <select class="form-select form-select-sm" style="width:auto; font-size:0.85rem; border-radius:8px; border:2px solid #CBD5E1;"
                                        value="@leagueProfile.AvatarId"
                                        @onchange="(e) => ChangeAvatarAsync(e.Value?.ToString())">
                                    @foreach (var av in PresetAvatars.All)
                                    {
                                        <option value="@av.Id">@av.Emoji @av.Name</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <!-- Private Room Code -->
                        <div style="background:#F8FAFC; border:2px solid #CBD5E1; border-radius:16px; padding:1rem;">
                            <strong style="display:block; margin-bottom:0.5rem; color:#1E2A4A;">Current Private Room</strong>
                            @if (!string.IsNullOrEmpty(leagueProfile.CurrentRoomCode))
                            {
                                <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.5rem;">
                                    <span class="pill" style="background:#FFF9DB; border-color:#F59E0B; font-size:1.2rem; font-weight:800; letter-spacing:2px;">
                                        @leagueProfile.CurrentRoomCode
                                    </span>
                                    <button class="btn-story btn-story-coral" style="padding:0.3rem 0.6rem; font-size:0.8rem;" @onclick="LeaveRoomAsync">
                                        Leave Room
                                    </button>
                                </div>
                                <span style="font-size:0.82rem; color:#64748B; display:block;">Share this 6-character code with family members or classmates.</span>
                            }
                            else
                            {
                                <div style="display:flex; gap:0.5rem; margin-bottom:0.5rem;">
                                    <input type="text" maxlength="6" placeholder="6-char code" 
                                           style="text-transform:uppercase; font-weight:800; letter-spacing:2px; padding:0.4rem 0.6rem; border-radius:8px; border:2px solid #CBD5E1; width:130px;"
                                           @bind="roomCodeInput" />
                                    <button class="btn-story btn-story-mint" style="padding:0.4rem 0.8rem; font-size:0.85rem;" @onclick="JoinRoomAsync">
                                        Join
                                    </button>
                                </div>
                                <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
                                    <button class="btn-story btn-story-yellow" style="padding:0.3rem 0.6rem; font-size:0.8rem;" @onclick="() => CreateRoomAsync(false)">
                                        + Family Room
                                    </button>
                                    <button class="btn-story btn-story-blue" style="padding:0.3rem 0.6rem; font-size:0.8rem;" @onclick="() => CreateRoomAsync(true)">
                                        🏫 Teacher Room
                                    </button>
                                </div>
                            }
                        </div>

                        <!-- Parent Oversight Metrics (Exact Rank) -->
                        <div style="background:#F0FDF4; border:2px solid #86EFAC; border-radius:16px; padding:1rem;">
                            <strong style="display:block; margin-bottom:0.5rem; color:#14532D;">Parent League Metrics</strong>
                            <div style="display:flex; justify-content:space-between; margin-bottom:0.25rem; font-size:0.9rem;">
                                <span>Weekly Points:</span>
                                <strong>@leagueProfile.WeeklyPoints pts</strong>
                            </div>
                            <div style="display:flex; justify-content:space-between; margin-bottom:0.25rem; font-size:0.9rem;">
                                <span>Today's Points (Max 150):</span>
                                <strong>@leagueProfile.TodayPoints / 150 pts</strong>
                            </div>
                            <div style="display:flex; justify-content:space-between; margin-bottom:0.5rem; font-size:0.9rem;">
                                <span>Exact Position in Room:</span>
                                <strong>@(leagueSummary?.CurrentUserEntry?.Rank > 0 ? $"Rank #{leagueSummary.CurrentUserEntry.Rank} of {leagueSummary.TotalMembers}" : "Practicing")</strong>
                            </div>

                            <!-- Under-13 Rank Shield Toggle -->
                            <div class="setting-toggle-row" style="background:#FFFFFF; padding:0.4rem 0.6rem; margin-top:0.5rem;">
                                <div>
                                    <strong style="font-size:0.88rem; display:block;">Under-13 Star Shield</strong>
                                    <span style="font-size:0.75rem; color:#64748B;">Hides all rank numbers from child view</span>
                                </div>
                                <button class="pill" style="background:@(leagueProfile.IsUnder13 ? "var(--color-mint)" : "white"); min-width:65px; font-size:0.75rem;"
                                        type="button"
                                        @onclick="ToggleUnder13Async">
                                    @(leagueProfile.IsUnder13 ? "PROTECTED ✓" : "OFF")
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- 8-Week History Chart inside Parent Dashboard -->
                    <div style="margin-bottom:1.5rem;">
                        <WeeklyGrowthChart PointsHistory="leagueProfile.PastWeeklyScores" />
                    </div>

                    <!-- Teacher Classroom Mode Section (If Room is Classroom) -->
                    @if (leagueSummary != null && leagueSummary.ClassTargetGoal > 0)
                    {
                        <div style="background:#F8FAFC; border:2px dashed #94A3B8; border-radius:16px; padding:1rem; margin-bottom:1.5rem;">
                            <h4 style="margin:0 0 0.5rem 0; font-size:1.1rem; color:#1E2A4A;">🏫 Classroom Mode &amp; Group Goal</h4>
                            <p style="margin:0 0 0.75rem 0; font-size:0.88rem; color:#64748B;">
                                Collaborative class progress toward @leagueSummary.ClassTargetGoal points. Names are fully anonymized with child-safe display names.
                            </p>
                            <div style="height:14px; background:#E2E8F0; border-radius:7px; overflow:hidden; border:1px solid #CBD5E1; margin-bottom:0.5rem;">
                                <div style="height:100%; width:@(Math.Min(100, (int)Math.Round((double)leagueSummary.ClassTotalPoints / leagueSummary.ClassTargetGoal * 100)))%; background:linear-gradient(90deg, #38BDF8, #22C55E); border-radius:7px;"></div>
                            </div>
                            <div style="display:flex; justify-content:space-between; font-size:0.82rem; font-weight:700; color:#475569;">
                                <span>Class Total: @leagueSummary.ClassTotalPoints pts</span>
                                <span>Target: @leagueSummary.ClassTargetGoal pts</span>
                            </div>
                        </div>
                    }

                    <!-- Delete All League Data & Opt-Out -->
                    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; padding-top:1rem; border-top:2px dashed #E2E8F0;">
                        <div>
                            <strong style="color:#DC2626; display:block; font-size:0.95rem;">Delete All League Data</strong>
                            <span style="font-size:0.82rem; color:#64748B;">Removes child from rooms and purges all weekly score records locally and remotely.</span>
                        </div>
                        <button class="btn-story btn-story-coral" style="padding:0.4rem 0.9rem; font-size:0.85rem;" @onclick="DeleteLeagueDataAsync">
                            🗑️ Delete League Data
                        </button>
                    </div>
                }

                <!-- Plain-Language Privacy Notice for Parents -->
                <div style="margin-top:1.25rem; padding:0.9rem; background:#FEF3C7; border:2px solid #F59E0B; border-radius:14px;">
                    <strong style="display:block; font-size:0.9rem; color:#92400E; margin-bottom:0.35rem;">
                        🛡️ Weekly League Privacy &amp; Ethics Guarantee (DPDP Act 2023 &amp; COPPA Compliant):
                    </strong>
                    <ul style="margin:0; padding-left:1.2rem; font-size:0.83rem; color:#78350F; line-height:1.5;">
                        <li><strong>No Stranger Rankings:</strong> Children participate only in rooms explicitly joined by code (family or classroom).</li>
                        <li><strong>Zero Personal Identification:</strong> Names are random combinations (e.g. 'Brave Panda 42'). Real names, chat, and messaging are strictly absent.</li>
                        <li><strong>Effort-Based &amp; Daily Cap:</strong> Points reward completed rounds and streak practice, never speed. A strict 150 daily cap discourages addictive binge play.</li>
                        <li><strong>Positive Reinforcement Only:</strong> Children view only the Top 5. No one is ever designated in 'last place'. Under 13s see only star growth.</li>
                    </ul>
                </div>
            </div>
        }
    }
</div>

<style>
