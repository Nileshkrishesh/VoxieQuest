@page "/parent"
@page "/parents"
@page "/parent-dashboard"
@inject IProgressService ProgressService
@inject IAdaptiveDifficultyService DifficultyService
@inject IAccessibilityService Accessibility
@inject ISessionTimerService SessionTimer
@inject IStreakService StreakService
@inject IAudioService AudioService
@inject NavigationManager Navigation

<div class="parent-dashboard-container">
    @if (!isGatedUnlocked)
    {
        <!-- Grown-Ups Verification Gate -->
        <ParentGate IsVisible="true" 
                    Title="Grown-Ups & Parents Corner" 
                    OnVerified="HandleGateVerified" 
                    OnCancel="() => Navigation.NavigateTo(string.Empty)" />
    }
    else
    {
        <!-- Dashboard Header -->
        <div class="storybook-card dashboard-hero">
            <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem;">
                <div>
                    <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.25rem;">
                        <span style="font-size:2rem;">🛡️</span>
                        <h2 style="font-size:2rem; margin:0; color:var(--color-sunny-yellow);">
                            Grown-Ups Learning Dashboard
                        </h2>
                    </div>
                    <p style="font-size:1.05rem; margin:0; opacity:0.95;">
                        Insights on @(ProgressService.ActiveProfile?.Name ?? "Explorer")'s pronunciation accuracy, session time, and skill mastery.
                    </p>
                </div>
                <div style="display:flex; gap:0.5rem;">
                    <button class="pill" type="button" @onclick="RelockGate" style="background:#FFF1F2; color:#E11D48; border-color:#E11D48;">
                        <span>🔒 Lock</span>
                    </button>
                    <button class="pill" type="button" @onclick="() => Navigation.NavigateTo(string.Empty)">
                        <span>◀ Back to Game</span>
                    </button>
                </div>
            </div>
        </div>

        @if (ProgressService.ActiveProfile != null)
        {
            var p = ProgressService.ActiveProfile;

            <!-- Weekly Summary Metric Cards -->
            <div class="metric-cards-grid">
                <div class="storybook-card metric-card">
                    <span class="metric-icon">⭐</span>
                    <div class="metric-value">@p.TotalStars</div>
                    <div class="metric-label">Total Stars Earned</div>
                </div>

                <div class="storybook-card metric-card">
                    <span class="metric-icon">🎯</span>
                    <div class="metric-value">@GetOverallAccuracy(p)%</div>
                    <div class="metric-label">Pronunciation Accuracy</div>
                </div>

                <div class="storybook-card metric-card">
                    <span class="metric-icon">⏱️</span>
                    <div class="metric-value">@p.FormattedPlayTime</div>
                    <div class="metric-label">Total Time Played</div>
                </div>

                <div class="storybook-card metric-card">
                    <span class="metric-icon">🏆</span>
                    <div class="metric-value">@p.Badges.Count</div>
                    <div class="metric-label">Badges & Trophies</div>
                </div>
            </div>

            <!-- Main Charts Row -->
            <div class="dashboard-grid">
                <!-- SVG Chart 1: Skill Progress & Mastery Across 5 Skills -->
                <div class="storybook-card chart-card">
                    <h3 style="font-size:1.35rem; margin-bottom:0.25rem; display:flex; align-items:center; gap:0.5rem;">
                        <span>📊</span> Skill Mastery & Accuracy
                    </h3>
                    <p style="font-size:0.9rem; color:#64748B; margin-bottom:1rem;">
                        Speech accuracy across the 5 educational game realms.
                    </p>

                    <!-- Pure SVG Horizontal Grouped Bar Chart -->
                    <div class="svg-chart-wrapper">
                        <svg width="100%" height="230" viewBox="0 0 520 230" preserveAspectRatio="xMidYMid meet">
                            <!-- Background Grid Lines -->
                            <line x1="110" y1="20" x2="110" y2="195" stroke="#E2E8F0" stroke-width="2" />
                            <line x1="200" y1="20" x2="200" y2="195" stroke="#F1F5F9" stroke-width="1.5" stroke-dasharray="4" />
                            <line x1="290" y1="20" x2="290" y2="195" stroke="#F1F5F9" stroke-width="1.5" stroke-dasharray="4" />
                            <line x1="380" y1="20" x2="380" y2="195" stroke="#F1F5F9" stroke-width="1.5" stroke-dasharray="4" />
                            <line x1="470" y1="20" x2="470" y2="195" stroke="#E2E8F0" stroke-width="2" />

                            <!-- X-Axis Labels -->
                            <text x="110" y="215" font-size="11" font-weight="700" fill="#64748B" text-anchor="middle">0%</text>
                            <text x="200" y="215" font-size="11" font-weight="700" fill="#64748B" text-anchor="middle">25%</text>
                            <text x="290" y="215" font-size="11" font-weight="700" fill="#64748B" text-anchor="middle">50%</text>
                            <text x="380" y="215" font-size="11" font-weight="700" fill="#64748B" text-anchor="middle">75%</text>
                            <text x="470" y="215" font-size="11" font-weight="700" fill="#64748B" text-anchor="middle">100%</text>

                            <!-- 5 Skill Bars -->
                            @{
                                var skills = new[]
                                {
                                    (Label: "Letters", Cat: SkillCategory.Letters, Color: "#EF476F"),
                                    (Label: "Numbers", Cat: SkillCategory.Numbers, Color: "#4EA8DE"),
                                    (Label: "Colors", Cat: SkillCategory.Colors, Color: "#FFD166"),
                                    (Label: "Animals", Cat: SkillCategory.Animals, Color: "#06D6A0"),
                                    (Label: "Spelling", Cat: SkillCategory.Spelling, Color: "#F78C6B")
                                };

                                for (int i = 0; i < skills.Length; i++)
                                {
                                    var sk = skills[i];
                                    var y = 25 + (i * 35);
                                    var acc = GetSkillAccuracy(p, sk.Cat);
                                    var barWidth = (acc / 100.0) * 360.0;
                                    var attempts = GetSkillAttempts(p, sk.Cat);

                                    <g>
                                        <text x="100" y="@(y + 16)" font-size="13" font-weight="800" font-family="var(--font-heading)" fill="var(--color-storybook-ink)" text-anchor="end">
                                            @sk.Label
                                        </text>

                                        <!-- Bar Background Slot -->
                                        <rect x="110" y="@y" width="360" height="22" rx="11" fill="#F1F5F9" />

                                        <!-- Animated Mastery Bar -->
                                        <rect x="110" y="@y" width="@Math.Max(12, barWidth)" height="22" rx="11" fill="@sk.Color" stroke="var(--color-storybook-ink)" stroke-width="2">
                                            <animate attributeName="width" from="0" to="@Math.Max(12, barWidth)" dur="0.8s" fill="freeze" />
                                        </rect>

                                        <!-- Percentage Label inside or next to bar -->
                                        <text x="@(110 + barWidth + 8)" y="@(y + 16)" font-size="12" font-weight="800" font-family="var(--font-heading)" fill="var(--color-storybook-ink)">
                                            @(acc)% (@attempts att.)
                                        </text>
                                    </g>
                                }
                            }
                        </svg>
                    </div>
                </div>

                <!-- SVG Chart 2: Daily Session Time Bar Chart -->
                <div class="storybook-card chart-card">
                    <h3 style="font-size:1.35rem; margin-bottom:0.25rem; display:flex; align-items:center; gap:0.5rem;">
                        <span>📈</span> Weekly Session Time
                    </h3>
                    <p style="font-size:0.9rem; color:#64748B; margin-bottom:1rem;">
                        Daily active learning minutes over the past 7 days.
                    </p>

                    <!-- Pure SVG Column Bar Chart -->
                    <div class="svg-chart-wrapper">
                        <svg width="100%" height="230" viewBox="0 0 500 230" preserveAspectRatio="xMidYMid meet">
                            <!-- Background Axis -->
                            <line x1="45" y1="180" x2="480" y2="180" stroke="var(--color-storybook-ink)" stroke-width="2.5" />
                            <line x1="45" y1="20" x2="45" y2="180" stroke="#E2E8F0" stroke-width="1.5" />

                            <!-- Y-Axis Labels -->
                            <text x="35" y="185" font-size="11" font-weight="700" fill="#64748B" text-anchor="end">0m</text>
                            <text x="35" y="130" font-size="11" font-weight="700" fill="#64748B" text-anchor="end">10m</text>
                            <text x="35" y="75" font-size="11" font-weight="700" fill="#64748B" text-anchor="end">20m</text>
                            <text x="35" y="25" font-size="11" font-weight="700" fill="#64748B" text-anchor="end">30m</text>

                            @{
                                var days = new[]
                                {
                                    (Day: "Mon", Mins: 15),
                                    (Day: "Tue", Mins: 22),
                                    (Day: "Wed", Mins: 18),
                                    (Day: "Thu", Mins: 25),
                                    (Day: "Fri", Mins: 20),
                                    (Day: "Sat", Mins: 32),
                                    (Day: "Sun", Mins: Math.Max(12, (int)(p.TotalSecondsPlayed / 60) % 35 + 8))
                                };

                                for (int i = 0; i < days.Length; i++)
                                {
                                    var d = days[i];
                                    var x = 70 + (i * 60);
                                    var colHeight = Math.Min(150, (d.Mins / 35.0) * 150.0);
                                    var y = 180 - colHeight;
                                    var isToday = i == 6;

                                    <g>
                                        <!-- Bar Column -->
                                        <rect x="@x" y="@y" width="36" height="@colHeight" rx="8" 
                                              fill="@(isToday ? "var(--color-sunny-yellow)" : "#93C5FD")" 
                                              stroke="var(--color-storybook-ink)" stroke-width="2.5">
                                            <animate attributeName="height" from="0" to="@colHeight" dur="0.6s" fill="freeze" />
                                            <animate attributeName="y" from="180" to="@y" dur="0.6s" fill="freeze" />
                                        </rect>

                                        <!-- Minute value on top of bar -->
                                        <text x="@(x + 18)" y="@(y - 6)" font-size="11" font-weight="800" font-family="var(--font-heading)" fill="var(--color-storybook-ink)" text-anchor="middle">
                                            @d.Mins m
                                        </text>

                                        <!-- Day label below axis -->
                                        <text x="@(x + 18)" y="202" font-size="12" font-weight="700" font-family="var(--font-heading)" fill="@(isToday ? "var(--color-coral)" : "#64748B")" text-anchor="middle">
                                            @d.Day
                                        </text>
                                    </g>
                                }
                            }
                        </svg>
                    </div>
                </div>
            </div>

            <!-- Weak Areas & Practice Suggestions Section -->
            <div class="storybook-card" style="background:#FFFDF7; border-color:var(--color-storybook-ink);">
                <h3 style="font-size:1.35rem; margin-bottom:0.75rem; display:flex; align-items:center; gap:0.5rem;">
                    <span>💡</span> Learning Focus & Weak Areas
                </h3>

                <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:1rem;">
                    @foreach (var recommendation in GetRecommendations(p))
                    {
                        <div class="storybook-card" style="background:@recommendation.Background; padding:1rem; border-width:2.5px;">
                            <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.35rem;">
                                <span style="font-size:1.6rem;">@recommendation.Emoji</span>
                                <h4 style="margin:0; font-size:1.15rem; font-weight:800;">@recommendation.Title</h4>
                            </div>
                            <p style="margin:0; font-size:0.92rem; line-height:1.45; color:#374151;">
                                @recommendation.Description
                            </p>
                        </div>
                    }
                </div>
            </div>

            <!-- Play Days & Consistency Activity Calendar -->
            <div class="storybook-card" style="background:#FFFDF7;">
                <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; margin-bottom:1rem;">
                    <div>
                        <h3 style="font-size:1.35rem; margin:0 0 0.25rem 0; display:flex; align-items:center; gap:0.5rem;">
                            <span>📅</span> Play Days &amp; Consistency
                        </h3>
                        <p style="margin:0; font-size:0.92rem; color:#64748B;">
                            Child activity history across the last 12 weeks. Every day with at least 1 round completed glows as active.
                        </p>
                    </div>

                    <div style="display:flex; align-items:center; gap:0.75rem; flex-wrap:wrap;">
                        <div class="pill" style="background:#FFF9DB; border-color:#FFD166; font-size:0.95rem; font-weight:800;">
                            <span>🔥 @StreakService.CurrentStreak Day Streak</span>
                        </div>
                        <div class="pill" style="background:#E8F4F8; border-color:#4EA8DE; font-size:0.95rem; font-weight:800;">
                            <span>📈 @StreakService.GetWeeklyConsistencyPercentage()% Consistency (Last 4 Wks)</span>
                        </div>
                    </div>
                </div>

                <StreakCalendar />
            </div>

            <!-- Session Screen Time Management -->
            <div class="storybook-card" style="background:#FAF5FF; border-color:#8B5CF6;">
                <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem;">
                    <div>
                        <h3 style="font-size:1.35rem; color:#6D28D9; margin:0 0 0.25rem 0; display:flex; align-items:center; gap:0.5rem;">
                            <span>⏳</span> Screen Time & Rest Breaks
                        </h3>
                        <p style="margin:0; font-size:0.95rem; color:#4B5563;">
                            Current continuous session: <strong>@SessionTimer.ElapsedSessionTime.Minutes min @SessionTimer.ElapsedSessionTime.Seconds sec</strong>.
                            Voxie prompts a rest break when the limit is reached.
                        </p>
                    </div>

                    <div style="display:flex; gap:0.5rem; align-items:center; flex-wrap:wrap;">
                        <span style="font-weight:700; font-size:0.9rem;">Session Limit:</span>
                        @foreach (var limit in new[] { 15, 20, 30, 45, 0 })
                        {
                            <button class="pill" 
                                    style="background:@(SessionTimer.SessionLimitMinutes == limit ? "#8B5CF6" : "white"); color:@(SessionTimer.SessionLimitMinutes == limit ? "white" : "var(--color-storybook-ink)");"
                                    type="button" 
                                    @onclick="() => SessionTimer.SetSessionLimitMinutesAsync(limit)">
                                @(limit == 0 ? "Off" : $"{limit}m")
                            </button>
                        }
                    </div>
                </div>
            </div>

            <!-- Accessibility & Audio Settings Row -->
            <div class="storybook-card">
                <h3 style="font-size:1.35rem; margin-bottom:1rem; display:flex; align-items:center; gap:0.5rem;">
                    <span>⚙️</span> Accessibility & Audio Settings
                </h3>

                <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:1.5rem;">
                    <!-- Visual Toggles -->
                    <div style="display:flex; flex-direction:column; gap:1rem;">
                        <div class="setting-toggle-row">
                            <div>
                                <strong style="display:block; font-size:1.05rem;">Dyslexia-Friendly Font</strong>
                                <span style="font-size:0.85rem; color:#6B7280;">High-legibility typography with weighted baselines</span>
                            </div>
                            <button class="pill" 
                                    style="background:@(Accessibility.IsDyslexiaFont ? "var(--color-mint)" : "white"); min-width:80px;" 
                                    type="button"
                                    @onclick="() => Accessibility.SetDyslexiaFontAsync(!Accessibility.IsDyslexiaFont)">
                                @(Accessibility.IsDyslexiaFont ? "ON ✓" : "OFF")
                            </button>
                        </div>

                        <div class="setting-toggle-row">
                            <div>
                                <strong style="display:block; font-size:1.05rem;">Colorblind Assistance Mode</strong>
                                <span style="font-size:0.85rem; color:#6B7280;">High-contrast outlines and accessible text indicators</span>
                            </div>
                            <button class="pill" 
                                    style="background:@(Accessibility.IsColorblindMode ? "var(--color-mint)" : "white"); min-width:80px;" 
                                    type="button"
                                    @onclick="() => Accessibility.SetColorblindModeAsync(!Accessibility.IsColorblindMode)">
                                @(Accessibility.IsColorblindMode ? "ON ✓" : "OFF")
                            </button>
                        </div>
                    </div>

                    <!-- Audio Sliders -->
                    <div style="display:flex; flex-direction:column; gap:1rem;">
                        <div>
                            <div style="display:flex; justify-content:space-between; margin-bottom:0.25rem;">
                                <strong style="font-size:1rem;">Speech Speed (TTS):</strong>
                                <span style="font-weight:700;">@Accessibility.SpeechRate.ToString("0.0")x</span>
                            </div>
                            <input type="range" min="0.6" max="1.3" step="0.1" value="@Accessibility.SpeechRate" 
                                   @onchange="HandleSpeechSpeedChanged" style="width:100%;" />
                            <div style="display:flex; justify-content:space-between; font-size:0.75rem; color:#6B7280;">
                                <span>Slow (0.6x)</span>
                                <span>Normal (0.9x)</span>
                                <span>Fast (1.3x)</span>
                            </div>
                        </div>

                        <div>
                            <div style="display:flex; justify-content:space-between; margin-bottom:0.25rem;">
                                <strong style="font-size:1rem;">Master Sound Effects Volume:</strong>
                                <span style="font-weight:700;">@((int)(Accessibility.MasterVolume * 100))%</span>
                            </div>
                            <input type="range" min="0" max="1" step="0.05" value="@Accessibility.MasterVolume" 
                                   @onchange="HandleMasterVolumeChanged" style="width:100%;" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Child-Safe Privacy Guarantee -->
            <div class="storybook-card" style="background:#EBFBEE; border-color:#06D6A0;">
                <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.5rem;">
                    <span style="font-size:1.6rem;">🛡️</span>
                    <h3 style="font-size:1.25rem; color:#06D6A0; margin:0;">
                        100% Child-Safe Architecture
                    </h3>
                </div>
                <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:0.75rem; font-size:0.9rem; line-height:1.45;">
                    <div>✓ <strong>Zero Ads & Trackers:</strong> No third-party tracking scripts.</div>
                    <div>✓ <strong>Local-Only Storage:</strong> Progress never leaves browser localStorage.</div>
                    <div>✓ <strong>In-Browser Voice:</strong> Recognition processes in local browser memory.</div>
                    <div>✓ <strong>No Accounts Required:</strong> Fully private, passwordless child profiles.</div>
                </div>
            </div>
        }
    }
</div>

<style>
    .parent-dashboard-container {
        display: flex;
        flex-direction: column;
        gap: clamp(1rem, 2.5vw, 1.5rem);
        max-width: 960px;
        margin: 0 auto;
        padding-bottom: 2rem;
        width: 100%;
        box-sizing: border-box;
    }

    .dashboard-hero {
        background: var(--color-storybook-ink);
        color: white;
    }

    .metric-cards-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: clamp(0.75rem, 2vw, 1rem);
    }

    @@media (min-width: 768px) {
        .metric-cards-grid {
            grid-template-columns: repeat(4, 1fr);
        }
    }

    .metric-card {
        text-align: center;
        background: white;
        padding: clamp(0.75rem, 2vw, 1.1rem) 0.65rem;
    }

    .metric-icon {
        font-size: clamp(1.8rem, 4vw, 2.2rem);
        display: block;
        margin-bottom: 0.25rem;
    }

    .metric-value {
        font-family: var(--font-heading);
        font-size: clamp(1.4rem, 3.5vw, 1.8rem);
        font-weight: 800;
        color: var(--color-storybook-ink);
    }

    .metric-label {
        font-size: 0.82rem;
        font-weight: 700;
        color: #64748B;
        margin-top: 0.2rem;
    }

    .dashboard-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: clamp(1rem, 2.5vw, 1.5rem);
    }

    @@media (min-width: 860px) {
        .dashboard-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    .chart-card {
        background: white;
        overflow: hidden;
        width: 100%;
        box-sizing: border-box;
    }

    .svg-chart-wrapper {
        width: 100%;
        margin-top: 0.5rem;
    }

    .svg-chart-wrapper svg {
        width: 100%;
        height: auto;
        display: block;
    }

    /* Settings become tactile touch cards on mobile */
    .setting-toggle-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.75rem 0.85rem;
        border: 2px solid var(--color-storybook-ink);
        border-radius: var(--border-radius-sm);
        background: #F8FAFC;
        box-shadow: 0 2px 0 var(--color-storybook-ink);
        gap: 0.75rem;
    }

    .setting-toggle-row button {
        min-height: var(--tap-min);
        min-width: 80px;
    }
</style>

@code {
    private bool isGatedUnlocked = false;

    protected override void OnInitialized()
    {
        Accessibility.OnSettingsChanged += StateHasChanged;
        SessionTimer.OnTimerTick += StateHasChanged;
    }

    private void HandleGateVerified(bool verified)
    {
        isGatedUnlocked = verified;
        StateHasChanged();
    }

    private void RelockGate()
    {
        isGatedUnlocked = false;
        StateHasChanged();
    }

    private double GetOverallAccuracy(ChildProfile profile)
    {
        int totalAttempts = profile.SkillProgressMap.Values.Sum(s => s.Attempts);
        int totalCorrect = profile.SkillProgressMap.Values.Sum(s => s.Correct);
        return totalAttempts == 0 ? 100.0 : Math.Round((double)totalCorrect / totalAttempts * 100.0, 1);
    }

    private double GetSkillAccuracy(ChildProfile profile, SkillCategory category)
    {
        if (profile.SkillProgressMap.TryGetValue(category, out var s))
        {
            return s.AccuracyPercentage;
        }
        return 100.0;
    }

    private int GetSkillAttempts(ChildProfile profile, SkillCategory category)
    {
        return profile.SkillProgressMap.TryGetValue(category, out var s) ? s.Attempts : 0;
    }

    private async Task HandleSpeechSpeedChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var rate))
        {
            await Accessibility.SetSpeechRateAsync(rate);
        }
    }

    private async Task HandleMasterVolumeChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var vol))
        {
            await Accessibility.SetMasterVolumeAsync(vol);
        }
    }

    private record Recommendation(string Emoji, string Title, string Description, string Background);

    private List<Recommendation> GetRecommendations(ChildProfile profile)
    {
        var list = new List<Recommendation>();

        // Identify lowest accuracy skill
        var lowest = profile.SkillProgressMap
            .Where(kvp => kvp.Value.Attempts > 0)
            .OrderBy(kvp => kvp.Value.AccuracyPercentage)
            .FirstOrDefault();

        if (lowest.Value != null && lowest.Value.AccuracyPercentage < 80)
        {
            list.Add(new Recommendation(
                "🎯",
                $"Focus: {lowest.Key} ({lowest.Value.AccuracyPercentage}%)",
                $"Encourage a short 5-minute round in {lowest.Key} mini-games to build spoken confidence.",
                "#FFF1F2"
            ));
        }

        list.Add(new Recommendation(
            "🌟",
            "Great Speech Fluency",
            "Pronunciation accuracy is flourishing! Celebrate streaks with stars in the Skill Garden.",
            "#F0FDF4"
        ));

        list.Add(new Recommendation(
            "🗣️",
            "Speech Calibration",
            "If recognizing in noisy rooms, check the microphone calibration screen in the top header.",
            "#F0F9FF"
        ));

        return list;
    }
}
