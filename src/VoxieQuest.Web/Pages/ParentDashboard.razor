@code {
    private bool isGatedUnlocked = false;
    private IndiaPassportProgress? passport;

    protected override void OnInitialized()
    {
        Accessibility.OnSettingsChanged += StateHasChanged;
        SessionTimer.OnTimerTick += StateHasChanged;
        _ = LoadPassportAsync();
        _ = LoadLeagueAsync();
    }

    private async Task LoadPassportAsync()
    {
        passport = await IndiaMapService.GetPassportProgressAsync();
        StateHasChanged();
    }

    private async Task HandleResetPassport()
    {
        await IndiaMapService.ResetPassportAsync();
        passport = await IndiaMapService.GetPassportProgressAsync();
        StateHasChanged();
    }

    private void HandleGateVerified(bool verified)
    {
        isGatedUnlocked = verified;
        StateHasChanged();
    }

    private void RelockGate()
    {
        isGatedUnlocked = false;
        StateHasChanged();
    }

    private static string GetOutcomeEmoji(OutcomeCategory cat) => cat switch
    {
        OutcomeCategory.Cognitive => "🧠",
        OutcomeCategory.Academic => "📚",
        OutcomeCategory.Social => "🤝",
        OutcomeCategory.Emotional => "💛",
        OutcomeCategory.Creativity => "🎨",
        OutcomeCategory.LifeSkills => "🌍",
        _ => "🌱"
    };

    private string GetWeeklyNarrativeSummary(ChildProfile profile)
    {
        var activeDays = StreakService.CurrentStreak;
        var blooming = profile.GardenState.HealthyBloomingCount;
        var name = profile.Name;

        return $"{name} engaged with curiosity this week across {Math.Max(1, activeDays)} active play days. " +
               $"Their living Skill Garden currently has {blooming} blooming and perennial branches. " +
               $"They showed marked perseverance when testing balance and acoustics, and frequently gravitated toward thoughtful reflection at natural chapter endings.";
    }

    private async Task HandleDailyLimitChanged(ChangeEventArgs e)
    {
        if (ProgressService.ActiveProfile != null && int.TryParse(e.Value?.ToString(), out var mins))
        {
            ProgressService.ActiveProfile.Controls.DailyLimitMinutes = mins;
            await ProgressService.UpdateProfileAsync(ProgressService.ActiveProfile);
        }
    }

    private async Task ToggleBedtimeLockout()
    {
        if (ProgressService.ActiveProfile != null)
        {
            ProgressService.ActiveProfile.Controls.BedtimeLockoutEnabled = !ProgressService.ActiveProfile.Controls.BedtimeLockoutEnabled;
            await ProgressService.UpdateProfileAsync(ProgressService.ActiveProfile);
        }
    }

    private async Task HandleBedtimeStartChanged(ChangeEventArgs e)
    {
        if (ProgressService.ActiveProfile != null && e.Value != null)
        {
            ProgressService.ActiveProfile.Controls.BedtimeStart = e.Value.ToString() ?? "19:30";
            await ProgressService.UpdateProfileAsync(ProgressService.ActiveProfile);
        }
    }

    private async Task HandleBedtimeEndChanged(ChangeEventArgs e)
    {
        if (ProgressService.ActiveProfile != null && e.Value != null)
        {
            ProgressService.ActiveProfile.Controls.BedtimeEnd = e.Value.ToString() ?? "07:00";
            await ProgressService.UpdateProfileAsync(ProgressService.ActiveProfile);
        }
    }

    private async Task SetCoPlayMode(CoPlayMode mode)
    {
        if (ProgressService.ActiveProfile != null)
        {
            ProgressService.ActiveProfile.Controls.AllowedCoPlay = mode;
            await ProgressService.UpdateProfileAsync(ProgressService.ActiveProfile);
        }
    }

    private static string GetJsonExportDataUri(ChildProfile profile)
    {
        var json = JsonSerializer.Serialize(profile, new JsonSerializerOptions { WriteIndented = true });
        return $"data:application/json;charset=utf-8,{Uri.EscapeDataString(json)}";
    }

    private async Task HandleWipeLocalData()
    {
        if (ProgressService.ActiveProfile != null)
        {
            // Reset to clean seeded state
            var fresh = new ChildProfile
            {
                Name = ProceduralNameGenerator.Generate(AgeBand.Ages6To8),
                Avatar = AvatarType.VoxieChameleon,
                Age = 6,
                AgeBand = AgeBand.Ages6To8
            };
            await ProgressService.UpdateProfileAsync(fresh);
            await AudioService.PlaySoundAsync(SoundEffect.Pop);
            StateHasChanged();
        }
    }

    private async Task HandleSpeechSpeedChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var rate))
        {
            await Accessibility.SetSpeechRateAsync(rate);
        }
    }

    private async Task HandleMasterVolumeChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var vol))
        {
            await Accessibility.SetMasterVolumeAsync(vol);
        }
    }

    private async Task HandleTierLockChange(SkillCategory skill, string? tierStr)
    {
        if (string.Equals(tierStr, "Auto", StringComparison.OrdinalIgnoreCase) || string.IsNullOrEmpty(tierStr))
        {
            await AdaptiveDifficulty.UnlockManualTierAsync(skill);
        }
        else if (Enum.TryParse<DifficultyTier>(tierStr, out var tier))
        {
            await AdaptiveDifficulty.SetManualTierAsync(skill, tier, lockTier: true);
        }
    }

    private async Task HandleTimerMultiplierChanged(string? multStr)
    {
        if (double.TryParse(multStr, out var mult))
        {
            await Accessibility.SetTimerMultiplierAsync(mult);
        }
    }

    private WeeklyLeagueProfile? leagueProfile;
    private LeagueRoomSummary? leagueSummary;
    private AvatarOption? currentAvatar;
    private string roomCodeInput = string.Empty;

    private async Task LoadLeagueAsync()
    {
        leagueProfile = await LeagueService.GetProfileAsync();
        currentAvatar = PresetAvatars.GetById(leagueProfile.AvatarId);
        if (leagueProfile.IsEnabled)
        {
            leagueSummary = await LeagueService.GetRoomSummaryAsync();
        }
        StateHasChanged();
    }

    private async Task ToggleLeagueEnabledAsync()
    {
        if (leagueProfile != null)
        {
            await LeagueService.EnableLeagueAsync(!leagueProfile.IsEnabled);
            await LoadLeagueAsync();
        }
    }

    private async Task RegenerateSafeNameAsync()
    {
        await LeagueService.RegenerateSafeNameAsync();
        await LoadLeagueAsync();
    }

    private async Task ChangeAvatarAsync(string? avatarId)
    {
        if (!string.IsNullOrEmpty(avatarId))
        {
            await LeagueService.SetAvatarAsync(avatarId);
            await LoadLeagueAsync();
        }
    }

    private async Task JoinRoomAsync()
    {
        if (!string.IsNullOrWhiteSpace(roomCodeInput))
        {
            bool ok = await LeagueService.JoinRoomAsync(roomCodeInput.Trim());
            if (ok)
            {
                roomCodeInput = string.Empty;
                await LoadLeagueAsync();
            }
        }
    }

    private async Task LeaveRoomAsync()
    {
        await LeagueService.LeaveRoomAsync();
        await LoadLeagueAsync();
    }

    private async Task CreateRoomAsync(bool isTeacher)
    {
        await LeagueService.CreateRoomAsync(isTeacher, isTeacher ? 500 : 250);
        await LoadLeagueAsync();
    }

    private async Task ToggleUnder13Async()
    {
        if (leagueProfile != null)
        {
            await LeagueService.SetUnder13Async(!leagueProfile.IsUnder13);
            await LoadLeagueAsync();
        }
    }

    private async Task DeleteLeagueDataAsync()
    {
        await LeagueService.DeleteAllLeagueDataAsync();
        await LoadLeagueAsync();
        await AudioService.PlaySoundAsync(SoundEffect.Pop);
    }
}
