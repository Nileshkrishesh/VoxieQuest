@inherits LayoutComponentBase
@inject IProgressService ProgressService
@inject IAudioService AudioService
@inject IAccessibilityService Accessibility
@inject ISessionTimerService SessionTimer
@inject IStreakService StreakService
@inject NavigationManager Navigation
@implements IDisposable

<div class="storybook-app @(Accessibility.IsDyslexiaFont ? "dyslexia-font" : "") @(Accessibility.IsColorblindMode ? "colorblind-mode" : "")">
    <!-- Cloud Wipe Page Transition Overlay -->
    <CloudWipeTransition />

    <!-- Atmospheric Parallax Backdrop -->
    <ParallaxBackground Theme="ParallaxBackground.ParallaxTheme.Hills" />

    <!-- Screen Time Rest Break Modal -->
    <BreakScreenModal />

    <!-- Clean, Colorful Storybook Responsive Sticky Header -->
    <header class="storybook-header">
        <a href="" class="brand-badge" title="Voxie Quest Home">
            <span class="brand-mascot-emoji">🦊</span>
            <span class="brand-title-text">VOXIE QUEST</span>
        </a>

        <div class="header-status-pills">
            <!-- Total Stars Display with SVG Star -->
            <div class="star-pill-badge" title="Total Stars Collected!">
                <StarIcon Size="22" FillColor="#FFD166" Class="star-spin-hover" />
                <span class="star-count-num">@(ProgressService.ActiveProfile?.TotalStars ?? 0)</span>
            </div>

            <!-- Streak Fire Flame Counter -->
            <StreakBadge Size="22" />

            <!-- Desktop and Tablet Pill Items 600px and up -->
            <div class="desktop-header-items">
                <!-- Active Profile Pill -->
                <a href="profile" class="pill kid-profile-pill" title="Change explorer profile">
                    <span class="avatar-emoji">@GetAvatarEmoji(ProgressService.ActiveProfile?.Avatar)</span>
                    <span class="profile-name">@(ProgressService.ActiveProfile?.Name ?? "Explorer")</span>
                </a>

                <!-- Audio Mute Toggle Button -->
                <button class="pill header-action-btn sound-btn @(AudioService.IsMuted ? "muted" : "")" 
                        @onclick="ToggleMute" 
                        type="button" 
                        title="@(AudioService.IsMuted ? "Sound: Muted (Click to Unmute)" : "Sound: Playing (Click to Mute)")">
                    <SpeakerIcon Size="22" IsMuted="@AudioService.IsMuted" FillColor="#FFFDF7" />
                    <span class="btn-label-text">@(AudioService.IsMuted ? "Muted" : "Sound")</span>
                </button>

                <!-- Classroom Pods -->
                <a href="classroom" class="pill header-action-btn classroom-btn" title="Classroom & Group Pods">
                    <span style="font-size: 1.15rem;">🏫</span>
                    <span class="btn-label-text">Class</span>
                </a>

                <!-- Grown-Ups and Settings Gate -->
                <a href="parent" class="pill header-action-btn parent-btn" title="Grown-Ups Dashboard &amp; Settings">
                    <ShieldIcon Size="22" FillColor="#FFFDF7" />
                    <span class="btn-label-text">Parents</span>
                </a>
            </div>

            <!-- Phone Menu Button for screens under 600px -->
            <div class="phone-menu-container">
                <button class="pill header-menu-btn" 
                        @onclick="ToggleMobileMenu" 
                        type="button" 
                        aria-label="Open menu" 
                        title="Open Quick Menu">
                    <span class="menu-icon-bars">☰</span>
                </button>

                @if (isMobileMenuOpen)
                {
                    <div class="phone-popover-backdrop" @onclick="CloseMobileMenu"></div>
                    <div class="phone-popover-menu animate-pop">
                        <a href="profile" class="popover-item profile-popover-link" @onclick="CloseMobileMenu">
                            <span class="avatar-emoji">@GetAvatarEmoji(ProgressService.ActiveProfile?.Avatar)</span>
                            <span>@(ProgressService.ActiveProfile?.Name ?? "Explorer")</span>
                        </a>

                        <button class="popover-item sound-popover-btn @(AudioService.IsMuted ? "muted" : "")" 
                                @onclick="ToggleMuteFromPopover" 
                                type="button">
                            <SpeakerIcon Size="24" IsMuted="@AudioService.IsMuted" FillColor="@(AudioService.IsMuted ? "#2B2D42" : "#FFFDF7")" />
                            <span>@(AudioService.IsMuted ? "Unmute Sound" : "Mute Sound")</span>
                        </button>

                        <a href="classroom" class="popover-item classroom-popover-link" @onclick="CloseMobileMenu" style="background:#E0F2FE; color:#0369A1;">
                            <span style="font-size: 1.25rem;">🏫</span>
                            <span>Classroom Pods</span>
                        </a>

                        <a href="parent" class="popover-item parent-popover-link" @onclick="CloseMobileMenu">
                            <ShieldIcon Size="24" FillColor="#FFFDF7" />
                            <span>Grown-Ups (Parents)</span>
                        </a>
                    </div>
                }
            </div>
        </div>
    </header>

    <!-- Main Game Page Body with Fixed Overlap Padding and Safe Area Insets -->
    <main class="storybook-main-body">
        @Body
    </main>

    <!-- Simple, Chunky 4-Tab Fixed Bottom Navigation for Kids -->
    <nav class="storybook-nav-kids" aria-label="Game navigation">
        <NavLink href="" Match="NavLinkMatch.All" class="nav-kid-big-tab">
            <HouseIcon Size="26" RoofColor="#EF476F" WallColor="#FFFDF7" DoorColor="#FFD166" />
            <span class="nav-kid-label">Home</span>
        </NavLink>
        <NavLink href="games" class="nav-kid-big-tab">
            <GameControllerIcon Size="26" BodyColor="#4EA8DE" />
            <span class="nav-kid-label">Games</span>
        </NavLink>
        <NavLink href="garden" class="nav-kid-big-tab">
            <FlowerIcon Size="26" PetalColor="#06D6A0" CenterColor="#FFD166" />
            <span class="nav-kid-label">Garden</span>
        </NavLink>
        <NavLink href="stickers" class="nav-kid-big-tab">
            <TrophyIcon Size="26" CupColor="#FFD166" />
            <span class="nav-kid-label">Rewards</span>
        </NavLink>
    </nav>
</div>

<style>
    .storybook-app {
        display: flex;
        flex-direction: column;
        min-height: 100dvh;
        width: 100%;
        background: #FFFDF7;
        box-sizing: border-box;
        overflow-x: hidden;
    }

    /* Fixed Sticky Header with responsive fluid height */
    .storybook-header {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: var(--header-h);
        background: var(--color-sunny-yellow);
        border-bottom: var(--border-ink-thick);
        box-shadow: 0 4px 0 rgba(43, 45, 66, 0.15);
        padding-top: env(safe-area-inset-top);
        padding-left: max(0.85rem, env(safe-area-inset-left));
        padding-right: max(0.85rem, env(safe-area-inset-right));
        display: flex;
        justify-content: space-between;
        align-items: center;
        z-index: 1000;
        box-sizing: border-box;
    }

    .brand-badge {
        display: flex;
        align-items: center;
        gap: clamp(0.3rem, 1.5vw, 0.5rem);
        text-decoration: none;
        color: var(--color-storybook-ink);
        transition: transform 0.15s ease;
        flex-shrink: 0;
    }

    .brand-badge:hover {
        transform: scale(1.04);
        color: var(--color-storybook-ink);
    }

    .brand-mascot-emoji {
        font-size: clamp(1.6rem, 4vw, 2.2rem);
        filter: drop-shadow(0 2px 0 rgba(43, 45, 66, 0.3));
    }

    .brand-title-text {
        font-family: var(--font-heading);
        font-size: clamp(1.1rem, 3.2vw, 1.65rem);
        font-weight: 800;
        letter-spacing: 0.02em;
        text-shadow: 2px 2px 0 #FFFFFF;
        white-space: nowrap;
    }

    .header-status-pills {
        display: flex;
        align-items: center;
        gap: clamp(0.35rem, 1.2vw, 0.65rem);
        position: relative;
    }

    .star-pill-badge {
        background: linear-gradient(135deg, #FFD166 0%, #FFB703 100%);
        border: 2.5px solid var(--color-storybook-ink);
        border-radius: var(--border-radius-pill);
        padding: 0.3rem clamp(0.5rem, 1.5vw, 0.85rem);
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        box-shadow: 0 3px 0 var(--color-storybook-ink);
        min-height: 40px;
        box-sizing: border-box;
    }

    .star-count-num {
        font-family: var(--font-heading);
        font-size: clamp(1rem, 2.5vw, 1.25rem);
        font-weight: 800;
        color: var(--color-storybook-ink);
    }

    .desktop-header-items {
        display: flex;
        align-items: center;
        gap: 0.55rem;
    }

    .kid-profile-pill {
        background: #FFFFFF;
        border: 2.5px solid var(--color-storybook-ink);
        font-size: 1rem;
        font-weight: 700;
        padding: 0.3rem 0.75rem;
        min-height: 40px;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        text-decoration: none;
        color: var(--color-storybook-ink);
    }

    .avatar-emoji {
        font-size: 1.25rem;
    }

    .header-action-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.35rem 0.85rem;
        min-height: 40px;
        border: 2.5px solid var(--color-storybook-ink);
        box-shadow: 0 3px 0 var(--color-storybook-ink);
        transition: transform 0.12s ease, box-shadow 0.12s ease;
        text-decoration: none;
        cursor: pointer;
    }

    @@media (hover: hover) and (pointer: fine) {
        .header-action-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 0 var(--color-storybook-ink);
        }
    }

    .sound-btn {
        background: #06D6A0;
        color: var(--color-storybook-ink);
    }

    .sound-btn.muted {
        background: #FFD166;
        color: var(--color-storybook-ink);
    }

    .parent-btn {
        background: #F78C6B;
        color: #FFFFFF;
    }

    .btn-label-text {
        font-family: var(--font-heading);
        font-size: 0.92rem;
        font-weight: 800;
    }

    /* Phone Menu Button under 600px */
    .phone-menu-container {
        display: none;
        position: relative;
    }

    .header-menu-btn {
        min-width: var(--tap-min);
        min-height: var(--tap-min);
        padding: 0;
        background: #FFFFFF;
        border: 2.5px solid var(--color-storybook-ink);
        box-shadow: 0 3px 0 var(--color-storybook-ink);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 1.4rem;
        color: var(--color-storybook-ink);
    }

    .phone-popover-backdrop {
        position: fixed;
        inset: 0;
        z-index: 1050;
        background: rgba(43, 45, 66, 0.4);
    }

    .phone-popover-menu {
        position: absolute;
        top: calc(100% + 8px);
        right: 0;
        width: 230px;
        background: #FFFDF7;
        border: var(--border-ink-thick);
        border-radius: var(--border-radius-md);
        box-shadow: var(--shadow-chunky-lg);
        padding: 0.6rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        z-index: 1100;
    }

    .popover-item {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        padding: 0.75rem 0.85rem;
        min-height: var(--tap-min);
        border-radius: var(--border-radius-sm);
        border: 2px solid var(--color-storybook-ink);
        font-family: var(--font-heading);
        font-size: 1rem;
        font-weight: 800;
        text-decoration: none;
        box-shadow: 0 2px 0 var(--color-storybook-ink);
        box-sizing: border-box;
    }

    .profile-popover-link {
        background: #FFFFFF;
        color: var(--color-storybook-ink);
    }

    .sound-popover-btn {
        background: #06D6A0;
        color: #FFFFFF;
        text-align: left;
        cursor: pointer;
    }

    .sound-popover-btn.muted {
        background: #FFD166;
        color: var(--color-storybook-ink);
    }

    .parent-popover-link {
        background: #F78C6B;
        color: #FFFFFF;
    }

    /* Main body with fluid safe padding */
    .storybook-main-body {
        flex: 1;
        padding-top: calc(var(--header-h) + var(--space-3));
        padding-bottom: calc(var(--nav-h) + max(0.5rem, env(safe-area-inset-bottom)) + var(--space-3));
        padding-left: max(0.75rem, env(safe-area-inset-left));
        padding-right: max(0.75rem, env(safe-area-inset-right));
        max-width: 1180px;
        margin: 0 auto;
        width: 100%;
        box-sizing: border-box;
    }

    /* Fixed Sticky Bottom Navigation */
    .storybook-nav-kids {
        position: fixed;
        bottom: 0;
        left: 0;
        width: 100%;
        height: var(--nav-h);
        background: #FFFFFF;
        border-top: var(--border-ink-thick);
        padding-top: 0.35rem;
        padding-bottom: max(0.35rem, env(safe-area-inset-bottom));
        padding-left: max(0.5rem, env(safe-area-inset-left));
        padding-right: max(0.5rem, env(safe-area-inset-right));
        display: flex;
        justify-content: space-around;
        align-items: center;
        z-index: 1000;
        box-shadow: 0 -4px 0 rgba(43, 45, 66, 0.08);
        box-sizing: border-box;
    }

    .nav-kid-big-tab {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        color: var(--color-storybook-ink);
        min-height: var(--tap-min);
        min-width: var(--tap-min);
        padding: 0.25rem clamp(0.5rem, 2vw, 1.5rem);
        border-radius: var(--border-radius-sm);
        border: 2.5px solid transparent;
        transition: all 0.15s cubic-bezier(0.34, 1.56, 0.64, 1);
        touch-action: manipulation;
    }

    @@media (hover: hover) and (pointer: fine) {
        .nav-kid-big-tab:hover {
            transform: translateY(-2px);
            background: #FFF9DB;
        }
    }

    .nav-kid-big-tab.active {
        background: var(--color-sunny-yellow);
        border: 2.5px solid var(--color-storybook-ink);
        box-shadow: 0 3px 0 var(--color-storybook-ink);
        transform: translateY(-2px);
    }

    .nav-kid-label {
        font-family: var(--font-heading);
        font-size: clamp(0.78rem, 2vw, 0.95rem);
        font-weight: 800;
        margin-top: 0.15rem;
    }

    /* Breakpoint: Phone under 600px */
    @@media (max-width: 599px) {
        .desktop-header-items {
            display: none;
        }

        .phone-menu-container {
            display: block;
        }

        .brand-title-text {
            display: none; /* Icon-first branding on very compact phones */
        }
    }

    /* Breakpoint: Desktop Nav Centering 1024px and up */
    @@media (min-width: 1024px) {
        .storybook-nav-kids {
            max-width: 820px;
            left: 50%;
            transform: translateX(-50%);
            border-left: var(--border-ink-thick);
            border-right: var(--border-ink-thick);
            border-top-left-radius: var(--border-radius-md);
            border-top-right-radius: var(--border-radius-md);
            box-shadow: 0 -4px 0 rgba(43, 45, 66, 0.12);
        }
    }
</style>

@code {
    private bool isMobileMenuOpen = false;

    protected override async Task OnInitializedAsync()
    {
        ProgressService.OnProfileChanged += HandleStateChanged;
        Accessibility.OnSettingsChanged += HandleStateChanged;
        SessionTimer.OnTimerTick += HandleStateChanged;

        try
        {
            await ProgressService.InitializeAsync();
            await Accessibility.InitializeAsync();
            await SessionTimer.InitializeAsync();
            await StreakService.InitializeAsync();
        }
        catch
        {
            // Fallbacks safely retained
        }
    }

    private void HandleStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void ToggleMobileMenu()
    {
        isMobileMenuOpen = !isMobileMenuOpen;
    }

    private void CloseMobileMenu()
    {
        isMobileMenuOpen = false;
    }

    private async Task ToggleMute()
    {
        await AudioService.SetMutedAsync(!AudioService.IsMuted);
    }

    private async Task ToggleMuteFromPopover()
    {
        await ToggleMute();
        CloseMobileMenu();
    }

    private static string GetAvatarEmoji(AvatarType? avatar) => avatar switch
    {
        AvatarType.LeoLion => "🦁",
        AvatarType.PipPenguin => "🐧",
        AvatarType.MiaMonkey => "🐵",
        _ => "🦎"
    };

    public void Dispose()
    {
        ProgressService.OnProfileChanged -= HandleStateChanged;
        Accessibility.OnSettingsChanged -= HandleStateChanged;
        SessionTimer.OnTimerTick -= HandleStateChanged;
    }
}
