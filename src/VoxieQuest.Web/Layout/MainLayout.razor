@inherits LayoutComponentBase
@inject IProgressService ProgressService
@inject IAudioService AudioService
@inject IAccessibilityService Accessibility
@inject ISessionTimerService SessionTimer
@inject IStreakService StreakService
@inject NavigationManager Navigation
@implements IDisposable

<div class="storybook-app @(Accessibility.IsDyslexiaFont ? "dyslexia-font" : "") @(Accessibility.IsColorblindMode ? "colorblind-mode" : "") @(IsGameRoute ? "in-game-mode" : "")">
    <!-- Cloud Wipe Page Transition Overlay -->
    <CloudWipeTransition />

    @if (!IsGameRoute)
    {
        <!-- Atmospheric Parallax Backdrop for Main Pages -->
        <ParallaxBackground Theme="ParallaxBackground.ParallaxTheme.Hills" />

        <!-- Screen Time Rest Break Modal -->
        <BreakScreenModal />

        <!-- Clean, Single-Row Sticky Header (64px, never wraps) -->
        <header class="storybook-header" role="banner">
            <a href="" class="brand-badge" title="Voxie Quest Home">
                <FoxieFaceIcon Size="36" />
                <span class="brand-title-text">VOXIE QUEST</span>
            </a>

            <div class="header-status-pills">
                <!-- Total Stars Counter with SVG Star -->
                <div class="star-pill-badge" title="Total Stars Collected!">
                    <StarIcon Size="22" FillColor="#FFC93C" />
                    <span class="star-count-num">@(ProgressService.ActiveProfile?.TotalStars ?? 0)</span>
                </div>

                <!-- Streak Fire Flame Counter -->
                <StreakBadge Size="24" />

                <!-- Desktop Navigation Items (>= 1280px only) -->
                <div class="desktop-header-items">
                    <a href="profile" class="pill kid-profile-pill" title="Explorer profile">
                        <FoxieFaceIcon Size="20" />
                        <span class="profile-name">@(ProgressService.ActiveProfile?.Name ?? "Explorer")</span>
                    </a>

                    <button class="pill header-action-btn sound-btn @(AudioService.IsMuted ? "muted" : "")" 
                            @onclick="ToggleMute" 
                            type="button" 
                            title="@(AudioService.IsMuted ? "Sound: Muted" : "Sound: Playing")">
                        <SpeakerIcon Size="20" IsMuted="@AudioService.IsMuted" FillColor="#2B2D42" />
                        <span class="btn-label-text">@(AudioService.IsMuted ? "Muted" : "Sound")</span>
                    </button>

                    <a href="classroom" class="pill header-action-btn classroom-btn" title="Classroom Adventure">
                        <BackpackIcon Size="20" />
                        <span class="btn-label-text">Class</span>
                    </a>

                    <a href="league" class="pill header-action-btn league-btn" title="Weekly League">
                        <FlowerIcon Size="20" PetalColor="#FFC93C" CenterColor="#FF9F43" />
                        <span class="btn-label-text">League</span>
                    </a>

                    <a href="parent" class="pill header-action-btn parent-btn" title="Grown-Ups Dashboard">
                        <ShieldIcon Size="20" FillColor="#FFF8E7" />
                        <span class="btn-label-text">Parents</span>
                    </a>
                </div>

                <!-- Compact Menu Pill Button (< 1280px) -->
                <div class="compact-menu-container">
                    <button class="pill header-menu-pill" 
                            @onclick="ToggleMobileMenu" 
                            type="button" 
                            aria-label="Open Quick Menu" 
                            title="Menu">
                        <span class="menu-icon-bars">☰</span>
                        <span class="menu-pill-text">Menu</span>
                    </button>

                    @if (isMobileMenuOpen)
                    {
                        <div class="menu-popover-backdrop" @onclick="CloseMobileMenu"></div>
                        <div class="menu-popover-panel animate-pop">
                            <a href="profile" class="popover-link-item" @onclick="CloseMobileMenu">
                                <FoxieFaceIcon Size="24" />
                                <span>@(ProgressService.ActiveProfile?.Name ?? "Explorer Profile")</span>
                            </a>

                            <button class="popover-link-item sound-popover-btn" 
                                    @onclick="ToggleMuteFromPopover" 
                                    type="button">
                                <SpeakerIcon Size="24" IsMuted="@AudioService.IsMuted" FillColor="#2B2D42" />
                                <span>@(AudioService.IsMuted ? "Unmute Sound" : "Mute Sound")</span>
                            </button>

                            <a href="classroom" class="popover-link-item" @onclick="CloseMobileMenu">
                                <BackpackIcon Size="24" />
                                <span>Classroom Adventure</span>
                            </a>

                            <a href="league" class="popover-link-item" @onclick="CloseMobileMenu">
                                <FlowerIcon Size="24" PetalColor="#FFC93C" CenterColor="#FF9F43" />
                                <span>Garden League</span>
                            </a>

                            <a href="parent" class="popover-link-item parent-item" @onclick="CloseMobileMenu">
                                <ShieldIcon Size="24" FillColor="#FFF8E7" />
                                <span>Grown-Ups Area</span>
                            </a>
                        </div>
                    }
                </div>
            </div>
        </header>
    }

    <!-- Main Game Page Body -->
    <main class="storybook-main-body @(IsGameRoute ? "game-route-body" : "")">
        @Body

        @if (!IsGameRoute)
        {
            <footer class="storybook-app-footer" role="contentinfo">
                <div class="footer-badge-pill">
                    <StarIcon Size="20" FillColor="#FFC93C" />
                    <span class="footer-author-text">Made by <strong>Nilesh Gupta</strong></span>
                    <StarIcon Size="20" FillColor="#5BC0EB" />
                </div>
            </footer>
        }
    </main>

    @if (!IsGameRoute)
    {
        <!-- Simple, Chunky 4-Tab Fixed Bottom Navigation for Kids (72px) -->
        <nav class="storybook-nav-kids" aria-label="Main Navigation">
            <NavLink href="" Match="NavLinkMatch.All" class="nav-kid-big-tab">
                <HomeIcon Size="28" FillColor="#2B2D42" />
                <span class="nav-kid-label">Home</span>
            </NavLink>
            <NavLink href="games" class="nav-kid-big-tab">
                <GamesIcon Size="28" FillColor="#2B2D42" />
                <span class="nav-kid-label">Games</span>
            </NavLink>
            <NavLink href="garden" class="nav-kid-big-tab">
                <FlowerIcon Size="28" PetalColor="#7ED9A8" CenterColor="#FFC93C" />
                <span class="nav-kid-label">Garden</span>
            </NavLink>
            <NavLink href="stickers" class="nav-kid-big-tab">
                <TrophyIcon Size="28" CupColor="#FFC93C" />
                <span class="nav-kid-label">Rewards</span>
            </NavLink>
        </nav>
    }
</div>

<style>
    .storybook-app {
        display: flex;
        flex-direction: column;
        min-height: 100dvh;
        width: 100%;
        background: var(--color-paper-light, #FFF8E7);
        box-sizing: border-box;
        overflow-x: hidden;
    }

    .storybook-app.in-game-mode {
        min-height: 100dvh;
        height: 100dvh;
        overflow-x: hidden;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
        background: transparent;
    }

    /* Fixed Sticky Header with fluid height (64px) */
    .storybook-header {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: var(--header-height, 64px);
        background: var(--color-sunny-yellow, #FFC93C);
        border-bottom: var(--border-storybook, 4px solid #2B2D42);
        box-shadow: 0 4px 0 rgba(43, 45, 66, 0.15);
        padding-top: env(safe-area-inset-top);
        padding-left: max(1rem, env(safe-area-inset-left));
        padding-right: max(1rem, env(safe-area-inset-right));
        display: flex;
        justify-content: space-between;
        align-items: center;
        z-index: 1000;
        box-sizing: border-box;
    }

    .brand-badge {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
        color: var(--color-storybook-ink, #2B2D42);
        flex-shrink: 0;
    }

    .brand-title-text {
        font-family: var(--font-heading, 'Fredoka', cursive);
        font-size: clamp(1.15rem, 2.5vw, 1.55rem);
        font-weight: 700;
        letter-spacing: 0.02em;
        text-shadow: 2px 2px 0 #FFFFFF;
        white-space: nowrap;
    }

    .header-status-pills {
        display: flex;
        align-items: center;
        gap: clamp(0.4rem, 1vw, 0.75rem);
        position: relative;
    }

    .star-pill-badge {
        background: var(--color-paper-light, #FFF8E7);
        border: var(--border-storybook, 4px solid #2B2D42);
        border-radius: var(--radius-pill, 999px);
        padding: 0.25rem 0.75rem;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        box-shadow: var(--shadow-hard-sm, 3px 3px 0 #2B2D42);
        min-height: 44px;
        box-sizing: border-box;
    }

    .star-count-num {
        font-family: var(--font-heading, 'Fredoka', cursive);
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--color-storybook-ink, #2B2D42);
    }

    .desktop-header-items {
        display: none;
        align-items: center;
        gap: 0.5rem;
    }

    @@media (min-width: 1280px) {
        .desktop-header-items {
            display: flex;
        }
        .compact-menu-container {
            display: none !important;
        }
    }

    .kid-profile-pill {
        background: #FFFFFF;
        border: var(--border-storybook, 4px solid #2B2D42);
        border-radius: var(--radius-pill, 999px);
        font-family: var(--font-heading);
        font-size: 1rem;
        font-weight: 700;
        padding: 0.25rem 0.85rem;
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        text-decoration: none;
        color: var(--color-storybook-ink);
        box-shadow: var(--shadow-hard-sm);
    }

    .header-action-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.25rem 0.85rem;
        min-height: 44px;
        border: var(--border-storybook, 4px solid #2B2D42);
        border-radius: var(--radius-pill, 999px);
        box-shadow: var(--shadow-hard-sm);
        text-decoration: none;
        cursor: pointer;
        font-family: var(--font-heading);
        font-size: 1rem;
        font-weight: 700;
        color: var(--color-storybook-ink);
        transition: transform 0.1s var(--spring-squish);
    }
    .header-action-btn:active {
        transform: translate(2px, 2px);
        box-shadow: var(--shadow-hard-pressed);
    }

    .sound-btn { background: var(--color-mint, #7ED9A8); }
    .sound-btn.muted { background: var(--color-soft-orange, #FF9F43); }
    .classroom-btn { background: var(--color-sky-blue, #5BC0EB); }
    .league-btn { background: #FFF9DB; }
    .parent-btn { background: var(--color-coral, #FF6B6B); color: #FFF8E7; }

    /* Compact Menu Button under 1280px */
    .compact-menu-container {
        display: block;
        position: relative;
    }

    .header-menu-pill {
        min-height: 44px;
        padding: 0.25rem 0.85rem;
        background: #FFFFFF;
        border: var(--border-storybook, 4px solid #2B2D42);
        border-radius: var(--radius-pill);
        box-shadow: var(--shadow-hard-sm);
        display: flex;
        align-items: center;
        gap: 0.4rem;
        cursor: pointer;
        font-family: var(--font-heading);
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--color-storybook-ink);
    }

    .menu-popover-backdrop {
        position: fixed;
        inset: 0;
        z-index: 1050;
        background: rgba(43, 45, 66, 0.45);
    }

    .menu-popover-panel {
        position: absolute;
        top: calc(100% + 10px);
        right: 0;
        width: 250px;
        background: var(--color-paper-light, #FFF8E7);
        border: var(--border-storybook, 4px solid #2B2D42);
        border-radius: var(--radius-lg, 24px);
        box-shadow: var(--shadow-hard-lg, 8px 8px 0 #2B2D42);
        padding: 0.75rem;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        z-index: 1100;
    }

    .popover-link-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.65rem 0.95rem;
        min-height: 52px;
        border-radius: var(--radius-md, 16px);
        border: var(--border-storybook, 4px solid #2B2D42);
        background: #FFFFFF;
        font-family: var(--font-heading);
        font-size: 1.1rem;
        font-weight: 700;
        text-decoration: none;
        color: var(--color-storybook-ink);
        box-shadow: var(--shadow-hard-sm);
        box-sizing: border-box;
    }

    .popover-link-item.parent-item {
        background: var(--color-coral);
        color: #FFFFFF;
    }

    /* Main Content Body */
    .storybook-main-body {
        flex: 1;
        display: flex;
        flex-direction: column;
        padding-top: calc(var(--header-height, 64px) + 16px);
        padding-bottom: calc(var(--nav-height, 72px) + max(0.5rem, env(safe-area-inset-bottom)) + 24px);
        padding-left: max(1rem, env(safe-area-inset-left));
        padding-right: max(1rem, env(safe-area-inset-right));
        max-width: 1180px;
        margin: 0 auto;
        width: 100%;
        box-sizing: border-box;
    }

    /* Storybook App Footer */
    .storybook-app-footer {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 2.5rem 1rem 0.5rem;
        margin-top: auto;
        width: 100%;
        box-sizing: border-box;
    }

    .footer-badge-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        background: var(--color-paper-light, #FFFDF9);
        border: var(--border-storybook, 4px solid #2B2D42);
        border-radius: var(--radius-pill, 999px);
        padding: 0.45rem 1.25rem;
        box-shadow: var(--shadow-hard-md, 4px 4px 0 #2B2D42);
        font-family: var(--font-heading, 'Fredoka', cursive);
        font-size: clamp(0.95rem, 2vw, 1.15rem);
        color: var(--color-storybook-ink, #2B2D42);
        text-align: center;
        transition: transform 0.15s var(--spring-squish), box-shadow 0.15s ease;
    }

    .footer-badge-pill:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-hard-lg, 6px 6px 0 #2B2D42);
    }

    .footer-author-text strong {
        font-weight: 700;
        color: var(--color-storybook-ink, #2B2D42);
        text-decoration: underline wavy var(--color-sunny-yellow, #FFC93C);
        text-underline-offset: 3px;
    }

    .storybook-main-body.game-route-body {
        padding: 0 !important;
        max-width: 100% !important;
        margin: 0 !important;
        min-height: 100dvh !important;
        height: 100% !important;
        overflow-x: hidden !important;
        overflow-y: auto !important;
        -webkit-overflow-scrolling: touch;
        display: flex;
        flex-direction: column;
    }

    /* 4-Tab Bottom Navigation (72px) */
    .storybook-nav-kids {
        position: fixed;
        bottom: 0;
        left: 0;
        width: 100%;
        height: var(--nav-height, 72px);
        background: #FFFFFF;
        border-top: var(--border-storybook, 4px solid #2B2D42);
        padding-top: 0.25rem;
        padding-bottom: max(0.25rem, env(safe-area-inset-bottom));
        padding-left: max(0.5rem, env(safe-area-inset-left));
        padding-right: max(0.5rem, env(safe-area-inset-right));
        display: flex;
        justify-content: space-around;
        align-items: center;
        z-index: 1000;
        box-shadow: 0 -4px 0 rgba(43, 45, 66, 0.08);
        box-sizing: border-box;
    }

    .nav-kid-big-tab {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        color: var(--color-storybook-ink);
        min-height: 56px;
        min-width: 68px;
        padding: 0.2rem 0.8rem;
        border-radius: var(--radius-md, 16px);
        border: 3px solid transparent;
        transition: transform 0.1s var(--spring-squish);
        touch-action: manipulation;
    }

    .nav-kid-big-tab.active {
        background: var(--color-sunny-yellow, #FFC93C);
        border: 3px solid var(--color-storybook-ink, #2B2D42);
        box-shadow: var(--shadow-hard-sm, 3px 3px 0 #2B2D42);
        transform: translateY(-2px);
    }

    .nav-kid-label {
        font-family: var(--font-heading);
        font-size: 14px;
        font-weight: 700;
        margin-top: 2px;
    }

    @@media (min-width: 1024px) {
        .storybook-nav-kids {
            max-width: 800px;
            left: 50%;
            transform: translateX(-50%);
            border-left: var(--border-storybook);
            border-right: var(--border-storybook);
            border-top-left-radius: var(--radius-lg);
            border-top-right-radius: var(--radius-lg);
            box-shadow: 0 -4px 0 rgba(43, 45, 66, 0.12);
        }
    }
</style>

@code {
    private bool isMobileMenuOpen = false;

    private bool IsGameRoute
    {
        get
        {
            var uri = Navigation.Uri.ToLowerInvariant();
            if (uri.Contains("/game/") || uri.Contains("/games/"))
            {
                return true;
            }
            return false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        ProgressService.OnProfileChanged += HandleStateChanged;
        Accessibility.OnSettingsChanged += HandleStateChanged;
        SessionTimer.OnTimerTick += HandleStateChanged;
        Navigation.LocationChanged += HandleLocationChanged;

        try
        {
            await ProgressService.InitializeAsync();
            await Accessibility.InitializeAsync();
            await SessionTimer.InitializeAsync();
            await StreakService.InitializeAsync();
        }
        catch
        {
            // Fallbacks safely retained
        }
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        isMobileMenuOpen = false;
        InvokeAsync(StateHasChanged);
    }

    private void HandleStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void ToggleMobileMenu()
    {
        isMobileMenuOpen = !isMobileMenuOpen;
    }

    private void CloseMobileMenu()
    {
        isMobileMenuOpen = false;
    }

    private async Task ToggleMute()
    {
        await AudioService.SetMutedAsync(!AudioService.IsMuted);
    }

    private async Task ToggleMuteFromPopover()
    {
        await ToggleMute();
        CloseMobileMenu();
    }

    public void Dispose()
    {
        ProgressService.OnProfileChanged -= HandleStateChanged;
        Accessibility.OnSettingsChanged -= HandleStateChanged;
        SessionTimer.OnTimerTick -= HandleStateChanged;
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}
